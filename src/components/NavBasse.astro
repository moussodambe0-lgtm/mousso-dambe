---
/**
 * La barre basse : cinq onglets, dans l'ordre voulu par Arthur le 12 octobre
 * 2026. Dambé est au MILIEU, à la place où le pouce tombe naturellement, et
 * le compte a quitté le coin de l'accueil pour venir ici, aligné avec le
 * reste.
 *
 * Elle porte « IA Dambé » et non « Dambé » : une utilisatrice qui lit un
 * prénom ne devine pas qu'elle parle à une machine. Le dire est une question
 * d'honnêteté autant que de compréhension.
 */
import Icone from './Icone.astro';

interface Props {
  actif: 'accueil' | 'cycle' | 'dambe' | 'boutique' | 'compte';
  panier?: number;
}

const { actif, panier = 0 } = Astro.props;

const ONGLETS = [
  { id: 'accueil', lien: '/', icone: 'accueil', libelle: 'Accueil' },
  { id: 'cycle', lien: '/cycle', icone: 'cycle', libelle: 'Mon cycle' },
  { id: 'dambe', lien: '/dambe', icone: 'dambe', libelle: 'IA Dambé' },
  { id: 'boutique', lien: '/boutique', icone: 'boutique', libelle: 'Boutique' },
  { id: 'compte', lien: '/compte', icone: 'compte', libelle: 'Mon compte' },
] as const;
---

<nav class="nav-basse" aria-label="Navigation principale">
  {
    ONGLETS.map((o) => (
      <a class="nav-item" href={o.lien} aria-current={actif === o.id ? 'page' : undefined}>
        <span class="nav-icone">
          <Icone nom={o.icone} taille={21} />
          {o.id === 'boutique' && panier > 0 && (
            <span class="nav-pastille">
              {panier}
              <span class="lecture-seule">articles dans ton panier</span>
            </span>
          )}
        </span>
        {o.libelle}
      </a>
    ))
  }
</nav>

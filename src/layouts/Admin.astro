---
/**
 * Le gabarit de l'administration.
 *
 * LES ONGLETS SONT EN BAS, dans une barre à bulle, comme l'espace vendeur.
 * Arthur, le 5 novembre 2026 : « au niveau de l'administration, on va faire la
 * même chose. Vue d'ensemble, Commandes, Conversations, Monde, ça sera en bas
 * aussi, au lieu d'être en haut. Et avec le même effet de bulle que dans
 * l'espace vendeur. »
 *
 * C'EST LE SEUL ENDROIT OÙ NOUS NOUS ÉCARTONS DE JIA, et c'est pour une bonne
 * raison. Chez Jia l'administration a ses onglets en haut, en rangée qui
 * défile, parce qu'elle en a cinq longs (Vérification, Litiges, Conversations,
 * Produits, Paiements). Cette rangée déborde d'un écran de 390 px : les
 * derniers onglets sont hors de vue, et la barre semble dire qu'on est ailleurs
 * qu'on n'est. Arthur l'a vu tout de suite le 5 novembre, sur l'onglet
 * Produits. En bas, les quatre tiennent côte à côte, le pouce les atteint, et
 * les deux espaces de la gestion se parcourent du même geste.
 *
 * CE QUI RESTE DE JIA : l'en-tête sombre et collant, son sur-titre orange en
 * capitales, et la sortie alignée à droite. Les classes `.entete-sombre` et
 * toutes les couleurs viennent de ses feuilles de style.
 *
 * LE TITRE DE LA PAGE N'EST PLUS ÉCRIT dans l'en-tête (Arthur, le même jour :
 * « si je clique sur Commandes, en bas de Administration Mousso Dambé on écrit
 * Commandes encore, faut enlever »). L'onglet actif le dit déjà. Il reste pour
 * les lecteurs d'écran, qui ne voient ni la bulle ni le blanc.
 */
import BaseGestion from './BaseGestion.astro';
import NavAdmin, { type OngletAdmin } from '../components/NavAdmin.astro';

export type { OngletAdmin };

interface Props {
  titre: string;
  onglet: OngletAdmin;
}

const { titre, onglet } = Astro.props;
---

<BaseGestion titre={`${titre} · Administration`} description="Administration de Mousso Dambé.">
  <header class="entete-sombre entete-admin">
    <div class="ligne">
      <h1 class="lecteur-ecran-seul">{titre}</h1>
      <div class="sur-titre">ADMINISTRATION MOUSSO DAMBÉ</div>
      <div class="sorties">
        {/* Chez Jia il y a ici « Espace vendeur » et « Quitter ». « Quitter »
            est retiré, comme Arthur l'a demandé le 5 novembre 2026 : il menait
            au site des clientes, sur une autre adresse, et faisait croire que
            les deux ne font qu'un. */}
        <a href="/vendeur" class="sortie">Espace vendeur</a>
      </div>
    </div>
  </header>

  <slot />

  <NavAdmin actif={onglet} />
</BaseGestion>

<style>
  /* `padding-bottom: 0` n'a plus lieu d'être : l'en-tête ne porte plus de
     rangée d'onglets collée à son bord bas, il reprend donc son fond complet. */
  .entete-admin { position: sticky; top: 0; z-index: 10; }
  /* La ligne du haut ne porte plus que deux mots : ils s'alignent sur leur
     milieu, et non plus en haut. */
  .ligne { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .sur-titre { font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; color: var(--orange); }
  .sortie { color: var(--sur-sombre); font-size: 14px; font-weight: 700; }
  .sortie:hover { color: #FFFFFF; }
  .sorties { display: flex; gap: 7px; flex: 0 0 auto; }
</style>

---
/**
 * Les icônes du site, en trait, dessinées une fois ici.
 *
 * Jamais d'émoji comme icône : il change de dessin d'un téléphone à l'autre,
 * et les lecteurs d'écran le lisent à voix haute au milieu d'une phrase.
 *
 * Une icône décorative est cachée des lecteurs d'écran (aria-hidden). Une
 * icône qui porte l'information à elle seule reçoit un `titre`, qui devient
 * son nom accessible.
 */
interface Props {
  nom: string;
  taille?: number;
  classe?: string;
  titre?: string;
  epaisseur?: number;
}


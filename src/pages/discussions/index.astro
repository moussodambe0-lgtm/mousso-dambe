---
/**
 * L'onglet DISCUSSIONS.
 *
 * Section 7 du cahier d'Arthur : une liste à la façon d'une messagerie. IA
 * Dambé est épinglée tout en haut avec son badge « IA », et en dessous vient
 * la conversation avec la boutique.
 *
 * Ce que cet écran ne montre pas, volontairement : la réponse de l'IA. On
 * n'affiche que l'aperçu de la question posée, et seulement les 90 premiers
 * caractères. Une liste de discussions se regarde dans un taxi, par-dessus
 * l'épaule de quelqu'un, et une question sur des douleurs ou sur une
 * grossesse n'a pas à s'étaler là.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Symbole from '../../components/Symbole.astro';
import Mascotte from '../../components/Mascotte.astro';
import { clientSession, baseConfiguree } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import { quandCourt } from '../../lib/format';
import { MEDECIN_DISPONIBLE, MEDECIN_BIENTOT } from '../../lib/medecin';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);

const client = clientSession(Astro)!;
const panier = comptePanier(lirePanier(Astro));

interface Causerie {
  fil: string;
  apercu: string;
  apercu_de: 'elle' | 'boutique';
  quand: string;
  non_lus: number;
}

const { data } = await client.rpc('mes_discussions');
const ia = (data?.ia ?? null) as { apercu: string; quand: string; combien: number } | null;
const boutique = (data?.boutique ?? null) as Causerie | null;
const medecin = (data?.medecin ?? null) as Causerie | null;
const nonLus = Number(data?.non_lus ?? 0);
---

<Base titre="Discussions" nav="discussions" panier={panier} messages={nonLus}>
  <main class="page">
    <header class="tete">
      <h1>Discussions</h1>
    </header>

    <ul class="causeries">
      {/* --- IA Dambé, épinglée --- */}
      <li class="apparait">
        <a class="causerie causerie-ia" href="/dambe">
          <span class="causerie-visage">
            <Mascotte etat="visage" taille={52} titre="IA Dambé" />
          </span>
          <span class="causerie-corps">
            <span class="causerie-haut">
              <span class="causerie-nom">
                IA Dambé
                <span class="badge-ia">IA</span>
              </span>
              <span class="causerie-epingle" aria-label="Conversation épinglée">
                <Icone nom="epingle" taille={14} />
              </span>
            </span>
            <span class="causerie-apercu">
              {
                ia
                  ? `Tu as demandé : ${ia.apercu}`
                  : "Pose-lui une question sur tes règles, ton corps, nos produits. Elle répond sans juger."
              }
            </span>
          </span>
        </a>
      </li>

      {/* --- La boutique --- */}
      <li class="apparait" data-ordre="2">
        <a class="causerie" href="/discussions/boutique">
          <span class="causerie-visage causerie-visage-boutique">
            {/* Le logo de Mousso Dambé comme photo de profil de la boutique
                (demande d'Arthur, 13 octobre 2026). Sur un rond blanc : le logo
                ne se pose pas sur un fond sombre. */}
            <Symbole forme="fleur" taille={54} titre="Mousso Dambé" />
          </span>
          <span class="causerie-corps">
            <span class="causerie-haut">
              <span class="causerie-nom">Boutique Mousso Dambé</span>
              {boutique?.quand && <span class="causerie-heure">{quandCourt(boutique.quand)}</span>}
            </span>
            <span class="causerie-bas">
              <span class:list={['causerie-apercu', boutique && boutique.non_lus > 0 && 'causerie-apercu-gras']}>
                {
                  boutique?.apercu
                    ? `${boutique.apercu_de === 'elle' ? 'Toi : ' : ''}${boutique.apercu}`
                    : 'Écris-nous pour une commande, une taille, une livraison. On répond nous-mêmes.'
                }
              </span>
              {
                boutique && boutique.non_lus > 0 && (
                  <span class="causerie-nombre">
                    {boutique.non_lus}
                    <span class="lecture-seule">messages non lus</span>
                  </span>
                )
              }
            </span>
          </span>
        </a>
      </li>

      {/* --- Le médecin, en dernier et pas encore ouvert ---

           Arthur, le 26 octobre 2026 : « pour le médecin on va mettre bientôt
           disponible », et « il doit être en bas de Boutique Mousso Dambé
           aussi ». Il était au-dessus de la boutique ; il passe après elle.

           La carte reste visible pour annoncer ce qui arrive, mais ce n'est
           plus un lien : tant que personne ne répond de l'autre côté, laisser
           une femme écrire serait lui faire attendre une réponse qui ne
           viendrait jamais, sur une question qu'elle n'ose peut-être poser à
           personne d'autre. Pour ouvrir : voir src/lib/medecin.ts. */}
      <li class="apparait" data-ordre="3">
        {
          MEDECIN_DISPONIBLE ? (
            <a class="causerie" href="/discussions/medecin">
              <span class="causerie-visage causerie-visage-medecin">
                <Icone nom="coeur" taille={24} />
              </span>
              <span class="causerie-corps">
                <span class="causerie-haut">
                  <span class="causerie-nom">Le médecin</span>
                  {medecin?.quand && <span class="causerie-heure">{quandCourt(medecin.quand)}</span>}
                </span>
                <span class="causerie-bas">
                  <span class:list={['causerie-apercu', medecin && medecin.non_lus > 0 && 'causerie-apercu-gras']}>
                    {
                      medecin?.apercu
                        ? `${medecin.apercu_de === 'elle' ? 'Toi : ' : ''}${medecin.apercu}`
                        : 'Une douleur, un retard, une question que tu n’oses poser. Un conseil, pas un diagnostic.'
                    }
                  </span>
                  {
                    medecin && medecin.non_lus > 0 && (
                      <span class="causerie-nombre">
                        {medecin.non_lus}
                        <span class="lecture-seule">messages non lus</span>
                      </span>
                    )
                  }
                </span>
              </span>
            </a>
          ) : (
            /* Un lien, meme fermee. Arthur, le 26 octobre 2026 : « on doit
               pouvoir entrer dans la discussion medecin, et dans la discussion
               medecin on ne pourra pas ecrire ». Une ligne morte ici renvoyait
               a l'ecran ou Dambe est en haut, et on croyait que le medecin
               etait Dambe. */
            <a class="causerie causerie-bientot" href="/discussions/medecin">
              <span class="causerie-visage causerie-visage-medecin">
                <Icone nom="coeur" taille={24} />
              </span>
              <span class="causerie-corps">
                <span class="causerie-haut">
                  <span class="causerie-nom">Le médecin</span>
                  <span class="causerie-etiquette">{MEDECIN_BIENTOT}</span>
                </span>
                <span class="causerie-bas">
                  <span class="causerie-apercu">
                    Tu pourras poser une question à un médecin, pour un conseil. Pas encore ouvert.
                  </span>
                </span>
              </span>
            </a>
          )
        }
      </li>
    </ul>

    {/* La phrase sur ce que voient la boutique et le médecin, et la ligne
        « Chacun dans son coin » ont été retirées le 13 octobre 2026, à la
        demande d'Arthur. Les promesses elles-mêmes tiennent toujours : elles
        sont dans la base (aucun écran d'administration ne lit un journal) et
        dans « Ce qu'on sait de toi ». */}

    <div class="espace"></div>
  </main>
</Base>

<style>
  .tete {
    padding: var(--e5) 0 var(--e4);
  }

  .tete h1 {
    font-size: 29px;
    font-weight: 800;
  }

  .causeries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }

  .causerie {
    display: flex;
    gap: var(--e3);
    align-items: center;
    padding: var(--e3);
    border: 1px solid var(--bordure);
    border-radius: 20px;
    background: var(--surface);
    color: var(--encre);
    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .causerie:active {
    transform: scale(0.98);
  }

  /* La carte du médecin, tant que le fil n'est pas ouvert. Elle s'annonce mais
     ne s'ouvre pas : donc ni geste au toucher, ni couleur d'encre pleine, et un
     fond sans relief. Elle reste lisible, elle n'invite pas à appuyer.
     `pointer-events: none` serait de trop : ce n'est pas un lien, il n'y a rien
     à neutraliser. */
  .causerie-bientot {
    border-style: dashed;
    background: transparent;
    color: var(--texte-2);
    transition: none;
  }

  .causerie-bientot .causerie-visage {
    opacity: 0.55;
  }

  /* L'étiquette prend la place de l'heure, à droite du nom : c'est là que l'oeil
     va chercher l'état de la conversation. */
  .causerie-etiquette {
    flex: none;
    padding: 2px 8px;
    border-radius: 999px;
    background: var(--surface-douce);
    color: var(--texte-2);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  /* La conversation épinglée se distingue par son fond, pas par un cadre de
     plus : il y a déjà l'épingle et le badge pour le dire. */
  .causerie-ia {
    border-color: transparent;
    background: var(--surface-douce);
  }

  .causerie-visage {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    flex: none;
    border-radius: 50%;
    background: #fff;
  }

  .causerie-visage-boutique {
    width: 66px;
    height: 66px;
    background: #fff;
    border: 1px solid var(--bordure);
  }

  .causerie-visage-medecin {
    background: var(--rose);
    color: #fff;
  }

  .causerie-corps {
    flex: 1;
    min-width: 0;
  }

  .causerie-haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e2);
  }

  .causerie-nom {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 17.5px;
    font-weight: 700;
  }

  .badge-ia {
    padding: 2px 7px;
    border-radius: var(--r-ronde);
    background: var(--rose);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.4px;
  }

  .causerie-epingle {
    display: flex;
    color: var(--texte-3);
  }

  .causerie-heure {
    flex: none;
    font-size: 13px;
    color: var(--texte-3);
  }

  .causerie-bas {
    display: flex;
    align-items: center;
    gap: var(--e2);
  }

  .causerie-apercu {
    display: block;
    flex: 1;
    min-width: 0;
    margin-top: 3px;
    font-size: 14.5px;
    color: var(--texte-2);
    line-height: 1.35;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .causerie-apercu-gras {
    color: var(--encre);
    font-weight: 600;
  }

  .causerie-nombre {
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    flex: none;
    padding: 0 6px;
    border-radius: var(--r-ronde);
    background: var(--rose);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
  }
</style>

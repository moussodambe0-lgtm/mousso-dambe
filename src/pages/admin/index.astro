---
/**
 * VUE D'ENSEMBLE : la première page de l'administration.
 *
 * Arthur, le 5 novembre 2026 : « dans espace administration, faut copier tout,
 * tout ce que tu vas voir dans espace administrateur, LA MANIÈRE DONT C'EST
 * PRÉSENTÉ, tout. Tu copies tout. Même les couleurs. »
 *
 * CE QUI EST COPIÉ DE `pages/admin/index.astro` DE JIA, et dans son ordre :
 *
 *   1. la rangée de quatre chiffres collée sous l'en-tête
 *      (`.section-serree.chiffres`, quatre colonnes égales, `<strong
 *      class="chiffre">` à 19 px et son `<span>` à 11,5 px dessous, fond
 *      `--surface` et trait de séparation en bas) ;
 *   2. la rangée de filtres en pilules qui défile horizontalement
 *      (`.filtres` / `.filtre` / `.filtre.actif` en encre et blanc), avec son
 *      compteur accolé au libellé par un point médian ;
 *   3. la rangée d'alertes (`.section-serree.alertes`) ;
 *   4. la liste de cartes (`.section.liste`, `.carte`, `.tete` avec son carré
 *      d'encre à gauche, `.infos` avec `.nom` et `.meta`, `.quand` à droite,
 *      puis `.accroche`, `.contact`, les `.libelle` en capitales, les
 *      `.ligne-mention`, les blocs d'action repliés `details.repli` et la
 *      `.rangee-btn`) ;
 *   5. l'état vide avec sa grande icône grise ;
 *   6. l'encadré de politique en bas de page.
 *
 * Pas une classe inventée, pas une couleur inventée : tout vient du fichier de
 * Jia et des feuilles de style recopiées dans `src/styles/gestion/`.
 *
 * CE QUE CET ÉCRAN MONTRE, puisque ce n'est pas ce que Jia montre. Chez Jia,
 * cette page est la FILE DE VÉRIFICATION DES BOUTIQUES : chaque carte est un
 * vendeur tiers qui demande son badge, avec ses pièces d'identité et trois
 * contrôles à cocher. Ici il n'y a qu'une boutique, la maison, et personne ne
 * la vérifie : la file serait vide pour toujours. La présentation est donc
 * remplie avec ce que Mousso Dambé a vraiment, c'est-à-dire des commandes qui
 * attendent une décision et des avis qui viennent d'arriver.
 *
 * LA DIFFÉRENCE AVEC LE RÉSUMÉ DE L'ESPACE VENDEUR, qui ressemble à ceci : le
 * vendeur regarde ce qu'il doit FAIRE aujourd'hui (préparer, envoyer, remettre
 * en stock). Cette page-ci regarde comment va la boutique, et ouvre sur ce qui
 * réclame une décision. Deux métiers, deux écrans, comme chez Jia.
 *
 * RIEN DE CE QUI SORT D'ICI NE TOUCHE AU CYCLE NI AU JOURNAL. `monde()` le
 * garantit dans sa propre migration, et aucune requête de cette page ne nomme
 * les tables `cycles` ou `journal`. Les noms et les numéros qui s'affichent
 * viennent de `commandes_admin`, qui existe pour qu'on puisse livrer.
 */
import Admin from '../../layouts/Admin.astro';
import Icone from '../../components/IconeJia.astro';
import Alerte from '../../components/AlerteJia.astro';
import { exigerGestion } from '../../lib/gestion';
import { prix, entier, depuis, dateCourte, etoiles, telephone, lienWhatsApp, normaliserTelephone } from '../../lib/format-gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

// Les filtres, dans l'ordre où une commande traverse sa vie. Chez Jia ce sont
// les quatre statuts d'une boutique ; ici les cinq états d'une commande, et le
// premier est celui qui attend une main.
const ETATS = [
  { cle: 'nouvelle', libelle: 'À traiter' },
  { cle: 'preparee', libelle: 'Préparées' },
  { cle: 'envoyee', libelle: 'En route' },
  { cle: 'livree', libelle: 'Livrées' },
  { cle: 'annulee', libelle: 'Annulées' },
] as const;
const filtre = ETATS.find((e) => e.cle === Astro.url.searchParams.get('etat')) ?? ETATS[0];

const [tdb, boite, mondeRep, cmdRep, prodRep] = await Promise.all([
  sb.rpc('tableau_de_bord_vendeur'),
  sb.rpc('boite_de_reception', { p_recherche: null, p_sujet: null }),
  sb.rpc('monde'),
  sb.rpc('commandes_admin', { p_etat: filtre.cle }),
  sb.rpc('produits_admin'),
]);

const t = (tdb.data ?? {}) as any;
const b = (boite.data ?? {}) as any;
const m = (mondeRep.data ?? {}) as any;
const c = (cmdRep.data ?? {}) as any;

// La somme de la semaine vient de `tableau_de_bord_vendeur`, qui écarte les
// commandes annulées : un panier annulé n'est pas une vente.
const ventes7j = ((t.ventes_7j ?? []) as { jour: string; total_cfa: number }[]).reduce(
  (s, j) => s + Number(j.total_cfa ?? 0),
  0
);

// Le nombre de commandes de la semaine vient de `monde()`, seule fonction qui
// les compte par jour. Attention : elle les compte TOUTES, annulées comprises,
// parce qu'elle répond à « qui vient », pas à « combien on a vendu ». Les deux
// chiffres de la rangée ne disent donc pas la même chose, et c'est voulu.
const joursMonde = (m.jours ?? []) as { jour: string; inscriptions: number; commandes: number }[];
const commandes7j = joursMonde.slice(-7).reduce((s, j) => s + Number(j.commandes ?? 0), 0);

const messagesSansReponse = Number(b.non_lus ?? 0);
const comptes = Number(m.comptes ?? 0);

const compteParEtat = (c.compte ?? {}) as Record<string, number>;
const commandes = (c.commandes ?? []) as any[];

/**
 * LES DERNIERS AVIS, assemblés produit par produit.
 *
 * Il n'existe pas de fonction `avis_recents()` : la table `avis` est fermée en
 * lecture directe (aucune règle d'accès ne laisse passer, migration du
 * 26 octobre 2026) et la seule porte ouverte est `avis_du_produit(slug)`. On
 * appelle donc une fois par produit publié, en parallèle, puis on fusionne et
 * on garde les cinq plus récents. Le catalogue compte une poignée de fiches :
 * c'est tenable. Le jour où il en comptera cent, une fonction `avis_recents()`
 * remplacera cette boucle par un seul appel, et cette page ne changera que
 * d'une ligne.
 */
const produits = ((prodRep.data as any)?.produits ?? []) as any[];
const publies = produits.filter((p) => p.publie);
const paquetsAvis = await Promise.all(
  publies.map((p) => sb.rpc('avis_du_produit', { p_slug: p.slug, p_combien: 5 }))
);
const derniersAvis = paquetsAvis
  .flatMap((r, i) =>
    (((r.data as any)?.liste ?? []) as any[]).map((a) => ({ ...a, produit: publies[i]!.nom as string }))
  )
  .sort((x, y) => String(y.cree_le).localeCompare(String(x.cree_le)))
  .slice(0, 5);

// La note de la boutique, telle que le tableau de bord la calcule sur tous les
// avis déposés. La boutique et le catalogue ne font qu'un ici.
const note = Number(t.shop?.rating_avg ?? 0);
const nombreAvis = Number(t.shop?.rating_count ?? 0);

// Une fonction absente de la base ne doit pas s'afficher en zéros : des zéros
// feraient croire que personne ne vient, et on prendrait des décisions dessus.
const manquantes = [
  tdb.error || t.ok !== true ? 'tableau_de_bord_vendeur' : '',
  mondeRep.error || m.ok !== true ? 'monde' : '',
  cmdRep.error || c.ok !== true ? 'commandes_admin' : '',
]
  .filter(Boolean)
  .join(', ');
const erreur = manquantes
  ? `Ces fonctions n'ont pas répondu : ${manquantes}. Les chiffres correspondants sont incomplets, applique les migrations avant de t'y fier.`
  : null;

const PASTILLES: Record<string, string> = {
  nouvelle: 'pastille-orange',
  preparee: 'pastille-jaune',
  envoyee: 'pastille-action',
  livree: 'pastille-neutre',
  annulee: 'pastille-neutre',
};
const MOTS: Record<string, string> = {
  nouvelle: 'À traiter',
  preparee: 'Préparée',
  envoyee: 'En route',
  livree: 'Livrée',
  annulee: 'Annulée',
};
---

<Admin titre="Vue d'ensemble" onglet="vue">
  <section class="section-serree chiffres">
    <div><strong class="chiffre">{commandes7j}</strong><span>commandes 7 j</span></div>
    <div><strong class="chiffre">{entier(ventes7j)}</strong><span>FCFA 7 j</span></div>
    <div><strong class="chiffre">{messagesSansReponse}</strong><span>sans réponse</span></div>
    <div><strong class="chiffre">{entier(comptes)}</strong><span>comptes créés</span></div>
  </section>

  <nav class="filtres" aria-label="État des commandes">
    {ETATS.map((e) => (
      <a href={`/admin?etat=${e.cle}`} class:list={['filtre', { actif: e.cle === filtre.cle }]}>
        {e.libelle}{compteParEtat[e.cle] ? ` · ${compteParEtat[e.cle]}` : ''}
      </a>
    ))}
  </nav>

  <div class="section-serree alertes">
    <Alerte message={erreur} />
  </div>

  <section class="section liste">
    {
      commandes.length === 0 ? (
        <div class="etat-vide">
          <Icone name="receipt" size={34} class="icone-vide" />
          <div class="titre">Aucune commande ici</div>
          <div class="texte">Rien dans l'état « {filtre.libelle.toLowerCase()} ».</div>
        </div>
      ) : (
        commandes.slice(0, 10).map((o: any) => {
          const articles = (o.articles ?? []) as { nom: string; taille: string | null; quantite: number; prix_cfa: number }[];
          const pieces = articles.reduce((s, a) => s + Number(a.quantite ?? 0), 0);
          const numero = String(o.numero ?? '');
          return (
            <article class="carte">
              <div class="tete">
                <span class="logo">{numero.slice(-2) || '?'}</span>
                <span class="infos">
                  <a href={`/vendeur/commandes?etat=${o.etat}`} class="nom">Commande {numero}</a>
                  <span class="meta">
                    {[o.quartier, `${pieces} article${pieces > 1 ? 's' : ''}`].filter(Boolean).join(' · ')}
                  </span>
                </span>
                <span class="quand">{o.quand ? depuis(o.quand) : ''}</span>
              </div>

              <p class="accroche">
                <span class:list={['pastille', PASTILLES[o.etat] ?? 'pastille-neutre']}>
                  <span class="point" />{MOTS[o.etat] ?? o.etat}
                </span>
                <span class="total prix">{prix(Number(o.total_cfa ?? 0))}</span>
              </p>

              <p class="contact">
                Cliente : <strong>{o.nom || 'non renseigné'}</strong>
                {o.telephone && (
                  <>
                    {' · '}
                    <a href={`tel:+226${String(o.telephone).replace(/[^0-9]/g, '')}`}>{telephone(String(o.telephone))}</a>
                  </>
                )}
              </p>

              {o.repere && (
                <div class="encadre encadre-neutre repere">
                  <Icone name="map-pin" size={16} />
                  <span>{o.repere}</span>
                </div>
              )}

              {o.livreur_nom && (
                <div class="mentions">
                  <div class="libelle">LIVREUR</div>
                  <div class="ligne-mention"><span>Nom</span><strong>{o.livreur_nom}</strong></div>
                  {o.livreur_telephone && (
                    <div class="ligne-mention"><span>Téléphone</span><strong>{telephone(String(o.livreur_telephone))}</strong></div>
                  )}
                  {o.livreur_vu_le && (
                    <div class="ligne-mention"><span>A ouvert son lien</span><strong>{dateCourte(o.livreur_vu_le)}</strong></div>
                  )}
                </div>
              )}

              {articles.length > 0 && (
                <details class="repli">
                  <summary>Ce qu'il y a dans le colis</summary>
                  <div class="form-repli">
                    {articles.map((a) => (
                      <div class="ligne-mention">
                        <span>{a.quantite} × {a.nom}{a.taille ? ` (${a.taille})` : ''}</span>
                        <strong>{prix(Number(a.prix_cfa ?? 0) * Number(a.quantite ?? 0))}</strong>
                      </div>
                    ))}
                    {o.livraison_cfa != null && (
                      <div class="ligne-mention"><span>Livraison</span><strong>{prix(Number(o.livraison_cfa))}</strong></div>
                    )}
                  </div>
                </details>
              )}

              {/* Le bloc d'action, dans la forme de celui de Jia. Les décisions
                  elles-mêmes (préparer, envoyer, annuler) se prennent sur
                  l'écran des commandes, qui a les formulaires et les garde-fous
                  de la base. Cette page ouvre la bonne porte, elle ne la
                  remplace pas : deux écrans qui changent le même état finissent
                  par se contredire. */}
              <div class="rangee-btn actions">
                {o.telephone && (
                  <a
                    class="btn btn-whatsapp btn-petit"
                    href={lienWhatsApp(
                      normaliserTelephone(String(o.telephone)) ?? String(o.telephone),
                      `Bonjour ${o.nom ?? ''}, ici Mousso Dambé au sujet de votre commande ${numero}.`
                    )}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Écrire sur WhatsApp
                  </a>
                )}
                <a class="btn btn-contour btn-petit" href={`/vendeur/commandes?etat=${o.etat}`}>Ouvrir la commande</a>
              </div>
            </article>
          );
        })
      )
    }

    {commandes.length > 10 && (
      <p class="reste">
        et {commandes.length - 10} autre{commandes.length - 10 > 1 ? 's' : ''} dans cet état.
        <a href={`/vendeur/commandes?etat=${filtre.cle}`}> Tout voir</a>
      </p>
    )}
  </section>

  <section class="section liste">
    <div class="entete-section">
      <h2>Les derniers avis</h2>
      {nombreAvis > 0 && (
        <span class="note-boutique">
          <span class="etoiles">{etoiles(note)}</span>
          {note.toFixed(1).replace('.', ',')} · {nombreAvis} avis
        </span>
      )}
    </div>

    {
      derniersAvis.length === 0 ? (
        <div class="etat-vide">
          <Icone name="message-star" size={34} class="icone-vide" />
          <div class="titre">Aucun avis déposé</div>
          <div class="texte">
            Un avis ne peut être donné qu'après une livraison. Les premiers arriveront avec les premières commandes
            livrées.
          </div>
        </div>
      ) : (
        derniersAvis.map((a: any) => (
          <article class="carte">
            <div class="tete">
              <span class="logo note-carree chiffre">{a.note}</span>
              <span class="infos">
                <span class="nom">{a.produit}</span>
                <span class="meta">
                  <span class="etoiles">{etoiles(Number(a.note))}</span>
                  {(a.photos ?? []).length > 0 && ` · ${(a.photos ?? []).length} photo${(a.photos ?? []).length > 1 ? 's' : ''}`}
                </span>
              </span>
              <span class="quand">{a.cree_le ? dateCourte(a.cree_le) : ''}</span>
            </div>
            {a.texte ? <p class="accroche">{a.texte}</p> : <p class="accroche muet">Note sans commentaire.</p>}
          </article>
        ))
      )
    }

    {/* Les photos d'avis ne sont pas montrées ici : la route qui les sert,
        `/photo-avis/[id]`, ne répond que sur l'adresse des clientes
        (`CHEMINS_PARTAGES` dans lib/hotes.ts ne la contient pas), donc chaque
        vignette serait une image cassée sur cet écran. Leur nombre est dit, ce
        qui suffit à savoir qu'il y a quelque chose à aller regarder. */}

  </section>
</Admin>

<style>
  .chiffres { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; background: var(--surface); border-bottom: 1px solid var(--bordure); }
  .chiffres div { text-align: center; }
  .chiffres strong { display: block; font-size: 19px; }
  .chiffres span { display: block; font-size: 11.5px; color: var(--texte-secondaire); margin-top: 1px; }

  .filtres { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; padding: 12px var(--gouttiere) 0; }
  .filtres::-webkit-scrollbar { display: none; }
  .filtre { flex: 0 0 auto; font-size: 14px; font-weight: 700; color: var(--texte-secondaire); padding: 7px 12px; border-radius: var(--r-pilule); border: 1px solid var(--bordure); background: var(--surface); white-space: nowrap; }
  .filtre.actif { background: var(--encre); border-color: var(--encre); color: #FFFFFF; }

  .alertes { display: grid; padding-top: 0; padding-bottom: 0; }
  .alertes :global(.alerte) { margin-top: 12px; }
  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }

  .liste { display: grid; gap: 11px; }
  .carte { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 14px; }
  .tete { display: flex; align-items: center; gap: 11px; }
  .logo { width: 40px; height: 40px; border-radius: 11px; background: var(--encre); color: #FFFFFF; font-family: 'Outfit', sans-serif; font-weight: 800; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .note-carree { background: var(--jaune); color: var(--encre); font-size: 17px; }
  .infos { flex: 1; min-width: 0; }
  .nom { display: block; font-weight: 700; font-size: 16px; color: var(--encre); }
  .meta { display: block; font-size: 13px; color: var(--texte-secondaire); margin-top: 2px; }
  .quand { font-size: 12.5px; color: var(--texte-tertiaire); white-space: nowrap; }
  .accroche { margin: 9px 0 0; font-size: 14px; color: var(--texte-corps); display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
  .accroche.muet { color: var(--texte-tertiaire); font-style: italic; }
  .total { margin-left: auto; font-size: 15px; }
  .contact { margin: 8px 0 0; font-size: 14px; color: var(--texte-secondaire); }
  .contact a { white-space: nowrap; }

  .repere { margin-top: 10px; }

  .mentions { margin-top: 12px; border-top: 1px solid var(--bordure); padding-top: 12px; }
  .ligne-mention { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; margin-top: 5px; }
  .ligne-mention span { color: var(--texte-secondaire); }

  .repli { margin-top: 12px; border-top: 1px solid var(--bordure); padding-top: 10px; }
  .repli summary { cursor: pointer; font-size: 14px; font-weight: 700; color: var(--texte-secondaire); min-height: 28px; }
  .form-repli { margin-top: 10px; }

  .actions { margin-top: 13px; }
  .actions .btn { flex: 1; text-align: center; display: block; width: auto; }

  .entete-section { margin-bottom: 2px; }
  .note-boutique { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 700; color: var(--texte-secondaire); flex: 0 0 auto; }

  .reste { font-size: 13px; color: var(--texte-secondaire); margin: 0; }
</style>

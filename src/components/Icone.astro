const trait = TRAITS[nom] ?? TRAITS.info;
---

<svg
  width={taille}
  height={taille}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={epaisseur}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={classe}
  role={titre ? 'img' : undefined}
  aria-label={titre}
  aria-hidden={titre ? undefined : 'true'}
  set:html={trait}
/>

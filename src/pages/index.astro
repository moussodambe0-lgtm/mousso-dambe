---
/**
 * L'accueil, dans ses deux états.
 *
 * Visiteuse : une page qui explique en trois lignes et montre la boutique.
 * Elle doit pouvoir regarder les prix sans compte, sinon un lien partagé sur
 * WhatsApp ne mène à rien.
 *
 * Connectée : son cycle, d'abord. C'est la raison d'ouvrir l'application, et
 * elle doit être lisible en une seconde, sans faire défiler.
 */
import Base from '../layouts/Base.astro';
import Symbole from '../components/Symbole.astro';
import Icone from '../components/Icone.astro';
import Anneau from '../components/Anneau.astro';
import Anim from '../components/Anim.astro';
import CarteProduit from '../components/CarteProduit.astro';
import Alerte from '../components/Alerte.astro';
import { clientPublic, clientSession, baseConfiguree } from '../lib/supabase';
import { visiteuse, monCycle, lirePanier, comptePanier } from '../lib/session';
import { PHASES } from '../lib/cycle';
import { dateLongue, dateCourte, dateDe, enIso, aujourdhui, enJours, pluriel } from '../lib/format';

const installee = baseConfiguree();
const moi = installee ? await visiteuse(Astro) : null;

// Elle a un compte mais n'a pas répondu au questionnaire : on ne peut rien
// calculer, et un accueil vide ne dit pas quoi faire.
if (moi && !moi.questionnaireFini) {
  return Astro.redirect('/bienvenue', 302);
}

const cycle = moi ? await monCycle(Astro) : null;
const panier = comptePanier(lirePanier(Astro));

let produits: any[] = [];
if (installee) {
  const { data } = await clientPublic(Astro)
    .from('produits')
    .select('slug, nom, prix_cfa, rayon, image, etiquette, stock')
    .eq('publie', true)
    .order('ordre')
    .limit(4);
  produits = data ?? [];
}

const phase = cycle?.aDesDonnees ? PHASES[cycle.phase] : null;
const ICONE_PHASE = { regles: 'goutte', elan: 'pousse', fertile: 'soleil', lune: 'lune' } as const;

// Les journées qu'elle a notées depuis le début de ce cycle : elles
// apparaissent en points sur l'anneau, pour que ce soit son carnet et pas
// seulement un calcul.
let notesDuCycle: { jour: number; saigne: boolean }[] = [];
if (moi && cycle?.aDesDonnees && cycle.debutDernieresRegles) {
  const client = clientSession(Astro);
  const { data } = await client!
    .from('journal')
    .select('jour, flux')
    .gte('jour', cycle.debutDernieresRegles)
    .limit(45);
  const depart = dateDe(cycle.debutDernieresRegles).getTime();
  notesDuCycle = (data ?? []).map((n: { jour: string; flux: string }) => ({
    jour: Math.round((dateDe(n.jour).getTime() - depart) / 86400000) + 1,
    saigne: n.flux !== 'rien',
  }));
}

// Les trois repères qui comptent dans un cycle : la fin des règles, la
// fenêtre fertile, les prochaines règles.
const reperes: { quoi: string; quand: string; icone: string; couleur: string; passe: boolean }[] = [];
if (cycle?.aDesDonnees && !cycle.depasse) {
  const jours = (iso: string | null) =>
    iso ? Math.round((dateDe(iso).getTime() - dateDe(aujourdhui()).getTime()) / 86400000) : null;

  const finRegles = cycle.debutDernieresRegles
    ? enIso(new Date(dateDe(cycle.debutDernieresRegles).getTime() + (cycle.dureeRegles - 1) * 86400000))
    : null;
  const dFin = jours(finRegles);
  if (dFin !== null) {
    reperes.push({
      quoi: dFin >= 0 ? 'Fin de tes règles' : 'Tes règles sont finies',
      quand: dFin >= 0 ? enJours(dFin) : dateCourte(finRegles!),
      icone: 'goutte',
      couleur: 'rose',
      passe: dFin < 0,
    });
  }

  const dFertile = jours(cycle.fertileDebut);
  if (cycle.fertileDebut && cycle.fertileFin) {
    const dFin2 = jours(cycle.fertileFin) ?? 0;
    reperes.push({
      quoi: dFin2 < 0 ? 'Période fertile passée' : dFertile !== null && dFertile <= 0 ? 'Période fertile, maintenant' : 'Période fertile',
      quand:
        dFin2 < 0
          ? `du ${dateCourte(cycle.fertileDebut)} au ${dateCourte(cycle.fertileFin)}`
          : dFertile !== null && dFertile <= 0
            ? `jusqu'au ${dateCourte(cycle.fertileFin)}`
            : `${enJours(dFertile ?? 0)}, le ${dateCourte(cycle.fertileDebut)}`,
      icone: 'soleil',
      couleur: 'violette',
      passe: dFin2 < 0,
    });
  }

  if (cycle.prochainesRegles) {
    reperes.push({
      quoi: 'Prochaines règles',
      quand: `${enJours(cycle.joursRestants)}, le ${dateCourte(cycle.prochainesRegles)}`,
      icone: 'cycle',
      couleur: 'neutre',
      passe: false,
    });
  }
}
---

<Base
  titre="Mousso Dambé"
  nav={moi ? 'accueil' : null}
  panier={panier}
  pleinEcran={!moi}
>
  {
    !installee && (
      <main class="page">
        <div class="espace" />
        <Alerte
          type="attention"
          texte="L'application n'est pas encore branchée à sa base de données. Les deux clés Supabase manquent dans le fichier .env."
        />
      </main>
    )
  }

  {
    installee && !moi && (
      <main class="accueil-visiteuse">
        <Anim nom="accueil" classe="bandeau" />
        <div class="page">
          <div class="haut apparait">
            <Symbole taille={54} anime titre="Mousso Dambé" />
            <h1>Mousso Dambé</h1>
            <p class="promesse">
              Tes règles, sans gêne et sans mauvaise surprise. Suis ton cycle, trouve tes protections, pose tes
              questions.
            </p>
          </div>

          <ul class="trois apparait" data-ordre="2">
            <li>
              <span class="rond-icone"><Icone nom="cycle" taille={20} /></span>
              <div>
                <strong>Sache quand elles arrivent</strong>
                <span>Tu réponds à six questions, l'application calcule le reste.</span>
              </div>
            </li>
            <li>
              <span class="rond-icone"><Icone nom="camion" taille={20} /></span>
              <div>
                <strong>Serviettes et culottes livrées</strong>
                <span>Colis neutre, livré à Ouaga, tu paies à la remise.</span>
              </div>
            </li>
            <li>
              <span class="rond-icone"><Icone nom="dambe" taille={20} /></span>
              <div>
                <strong>IA Dambé répond à tout</strong>
                <span>Les questions qu'on n'ose pas poser, sans jugement.</span>
              </div>
            </li>
          </ul>

          <div class="apparait" data-ordre="3">
            <a class="btn btn-rose btn-plein" href="/inscription">Commencer</a>
            <div class="centre">
              <a class="btn btn-texte" href="/connexion">J'ai déjà un compte</a>
            </div>
          </div>

          {produits.length > 0 && (
            <section class="apparait" data-ordre="4">
              <div class="section-titre">
                <h2>La boutique</h2>
                <a href="/boutique">Tout voir</a>
              </div>
              <div class="grille-produits">
                {produits.slice(0, 2).map((p) => (
                  <CarteProduit
                    slug={p.slug}
                    nom={p.nom}
                    prixCfa={p.prix_cfa}
                    rayon={p.rayon}
                    image={p.image}
                    etiquette={p.etiquette}
                    stock={p.stock}
                  />
                ))}
              </div>
            </section>
          )}

          <p class="discret apparait" data-ordre="5">
            Ce que tu notes reste à toi. Personne de ton entourage ne peut le voir, et rien n'est vendu à personne.
          </p>
        </div>
      </main>
    )
  }

  {
    moi && (
      <main class="page">
        <header class="barre-haute apparait">
          <div class="marque">
            <Symbole taille={30} anime />
            <div>
              <div class="nom-appli">Mousso Dambé</div>
              <div class="date">{dateLongue(aujourdhui())}</div>
            </div>
          </div>
          {/* Le compte a rejoint la barre du bas le 12 octobre 2026, sur
              demande d'Arthur : il est aligné avec les autres, et ce coin
              n'avait pas besoin de deux endroits pour la même chose. */}
        </header>

        {cycle?.aDesDonnees ? (
          <section class="carte bloc centre apparait" data-ordre="1">
            <Anneau
              jour={Math.min(cycle.jourDuCycle, cycle.cycleMoyen)}
              dureeRegles={cycle.dureeRegles}
              cycle={cycle.cycleMoyen}
              phase={phase?.nom ?? ''}
              notes={notesDuCycle}
            >
              <span class="etiquette-jour">Jour</span>
              <span class="chiffre grand chiffre-arrive">{cycle.jourDuCycle}</span>
              <span class:list={['phase-dedans', `phase-${phase?.couleur ?? 'rose'}`]}>
                <Icone nom={ICONE_PHASE[cycle.phase]} taille={14} />
                {phase?.nom}
              </span>
              <span class="sur-combien">sur {cycle.cycleMoyen} jours</span>
            </Anneau>

            {/* Ce qui vient, en trois repères. Un nombre seul ne dit pas où
                elle en est : ces trois dates, si. */}
            <div class="repères">
              {reperes.map((r) => (
                <div class:list={['repère', r.passe && 'repère-passe']}>
                  <span class:list={['pastille-repère', `pastille-${r.couleur}`]}>
                    <Icone nom={r.icone} taille={15} />
                  </span>
                  <span class="repère-texte">
                    <span class="repère-quoi">{r.quoi}</span>
                    <span class="repère-quand">{r.quand}</span>
                  </span>
                </div>
              ))}
            </div>

            {cycle.depasse ? (
              <div class="prevision">
                <div class="fort">Tes règles ont du retard</div>
                <div class="doux">
                  Rien n'est noté depuis {pluriel(cycle.jourDuCycle - 1, 'jour')}. Note-les quand elles arrivent, ou
                  parle à une sage-femme si le retard dure.
                </div>
              </div>
            ) : (
              /* Les trois repères disent déjà les dates : ici on ne répète pas,
                 on dit seulement d'où sort le calcul. */
              <p class="d-ou-ca-sort">
                {cycle.cyclesMesures > 0
                  ? `Calculé sur tes ${cycle.cyclesMesures === 1 ? 'deux derniers cycles' : `${cycle.cyclesMesures} derniers cycles`}`
                  : 'À affiner dès que tu auras noté un cycle entier'}
                {notesDuCycle.length > 0
                  ? ` · ${pluriel(notesDuCycle.length, 'journée notée', 'journées notées')} ce cycle`
                  : ''}
              </p>
            )}

            <div class="deux-boutons">
              <a class="btn btn-rose sans-retour" href="/journal">Noter aujourd'hui</a>
              <a class="btn btn-contour" href="/cycle">Calendrier</a>
            </div>
          </section>
        ) : (
          <section class="carte bloc apparait" data-ordre="1">
            <h2>On ne connaît pas encore ton cycle</h2>
            <p class="doux haut-marge">
              Dis-moi quand ont commencé tes dernières règles, et je te donne tes prochaines dates.
            </p>
            <a class="btn btn-rose btn-plein haut-marge" href="/cycle">Déclarer mes règles</a>
          </section>
        )}

        {phase && (
          <section class="carte bloc phase-carte apparait" data-ordre="2">
            <Anim nom={`phase-${cycle!.phase}` as never} classe="phase-dessin" />
            <div>
              <h3>{phase.nom}</h3>
              <p class="doux haut-marge">{phase.explique}</p>
              <p class="conseil">{phase.conseil}</p>
            </div>
          </section>
        )}

        <a class="carte-sombre bloc dambe apparait" data-ordre="3" href="/dambe">
          <span class="rond-rose-plein"><Icone nom="dambe" taille={22} /></span>
          <span class="dambe-texte">
            <strong>Demande à IA Dambé</strong>
            <span>Une intelligence artificielle, pour tes questions sur tes règles, tes douleurs, ton hygiène</span>
          </span>
          <Icone nom="avant" taille={18} />
        </a>

        {produits.length > 0 && (
          <section class="apparait" data-ordre="4">
            <div class="section-titre">
              <h2>Pour tes règles</h2>
              <a href="/boutique">Tout voir</a>
            </div>
            <Anim nom="accueil" classe="bandeau-mince" />
            <div class="grille-produits haut-marge">
              {produits.slice(0, 2).map((p) => (
                <CarteProduit
                  slug={p.slug}
                  nom={p.nom}
                  prixCfa={p.prix_cfa}
                  rayon={p.rayon}
                  image={p.image}
                  etiquette={p.etiquette}
                  stock={p.stock}
                />
              ))}
            </div>
          </section>
        )}

        <div class="espace" />
      </main>
    )
  }
</Base>

<style>
  /* --- Accueil de la visiteuse --- */
  .accueil-visiteuse {
    padding: var(--e6) 0 var(--e6);
  }

  .haut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e3);
    text-align: center;
    padding-bottom: var(--e5);
  }

  .haut h1 {
    font-size: 34px;
    font-weight: 800;
  }

  .promesse {
    max-width: 330px;
    font-size: 15.5px;
    color: var(--texte-2);
  }

  .trois {
    list-style: none;
    margin: var(--e5) 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--e4);
  }

  .trois li {
    display: flex;
    gap: var(--e3);
    align-items: flex-start;
  }

  .trois strong {
    display: block;
    font-size: 15px;
  }

  .trois span {
    font-size: 13.5px;
    color: var(--texte-2);
    line-height: 1.45;
  }

  .rond-icone {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 13px;
    background: var(--surface-douce);
    color: var(--rose);
  }

  .centre {
    display: flex;
    justify-content: center;
    margin-top: var(--e2);
  }

  .discret {
    margin-top: var(--e5);
    font-size: 12.5px;
    color: var(--texte-3);
    text-align: center;
    line-height: 1.5;
  }

  /* --- Accueil de la connectée --- */
  .barre-haute {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--e5) 0 var(--e3);
  }

  .marque {
    display: flex;
    align-items: center;
    gap: var(--e3);
  }

  .nom-appli {
    font-family: var(--titre);
    font-size: 16px;
    font-weight: 700;
  }

  .date {
    font-size: 11.5px;
    color: var(--texte-3);
    font-weight: 500;
  }

  .centre {
    text-align: center;
  }

  .carte.centre {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .etiquette-jour {
    font-size: 12px;
    font-weight: 600;
    color: var(--texte-3);
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }

  .grand {
    font-size: 58px;
    line-height: 1;
    letter-spacing: -2px;
  }

  /* La phase au centre de l'anneau, et non en pastille sous lui : le regard
     n'a plus à faire deux arrêts pour savoir où elle en est. */
  .phase-dedans {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 3px;
    padding: 3px 9px;
    border-radius: var(--r-ronde);
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.2;
    max-width: 128px;
  }

  .phase-rose {
    background: var(--rose-clair);
    color: var(--rose-fonce);
  }

  .phase-violet {
    background: var(--violet-clair);
    color: var(--violet-fonce);
  }

  .phase-encre {
    background: var(--surface-douce);
    color: var(--texte-2);
  }

  .sur-combien {
    margin-top: 3px;
    font-size: 11px;
    font-weight: 600;
    color: var(--texte-3);
  }

  /* Les trois repères du cycle. */
  .repères {
    width: 100%;
    margin-top: var(--e4);
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }

  .repère {
    display: flex;
    align-items: center;
    gap: var(--e3);
    padding: 9px 11px;
    border-radius: 14px;
    background: var(--fond);
  }

  .repère-passe {
    opacity: 0.55;
  }

  .pastille-repère {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    flex: none;
    border-radius: 10px;
  }

  .repère-texte {
    display: flex;
    flex-direction: column;
    min-width: 0;
    text-align: left;
  }

  .repère-quoi {
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1.25;
  }

  .repère-quand {
    font-size: 12.5px;
    color: var(--texte-2);
  }

  .pastille {
    margin-top: var(--e3);
    padding: 7px 14px;
    font-size: 14px;
  }

  .prevision {
    margin-top: var(--e3);
    text-align: center;
  }

  .d-ou-ca-sort {
    margin-top: var(--e3);
    text-align: center;
    font-size: 12.5px;
    color: var(--texte-3);
    line-height: 1.45;
  }

  .fort {
    font-size: 15px;
    font-weight: 600;
  }

  .doux {
    font-size: 13px;
    color: var(--texte-2);
    line-height: 1.5;
  }

  .conseil {
    margin-top: var(--e2);
    padding-top: var(--e2);
    border-top: 1px solid var(--bordure);
    font-size: 13.5px;
    color: var(--encre);
  }

  .haut-marge {
    margin-top: var(--e2);
  }

  .deux-boutons {
    display: flex;
    gap: var(--e2);
    width: 100%;
    margin-top: var(--e4);
  }

  .deux-boutons > * {
    flex: 1;
  }

  /* « Noter aujourd'hui » passait sur deux lignes dans la moitié d'écran :
     l'icône en plus ne tenait pas. On garde les mots, on enlève l'icône, et
     on donne un peu plus de place au bouton principal. */
  .sans-retour {
    flex: 1.25;
    white-space: nowrap;
    padding: 0 var(--e2);
  }

  .carte,
  .carte-sombre,
  section {
    margin-bottom: var(--e3);
  }

  .dambe {
    display: flex;
    align-items: center;
    gap: var(--e3);
    color: #fff;
  }

  .rond-rose-plein {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: none;
    border-radius: 13px;
    background: var(--rose);
    color: #fff;
  }

  .dambe-texte {
    flex: 1;
    min-width: 0;
  }

  .dambe-texte strong {
    display: block;
    font-size: 15px;
  }

  .dambe-texte span {
    font-size: 12.5px;
    color: var(--rose-clair);
    line-height: 1.4;
  }

  .section-titre {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--e2);
  }

  .section-titre a {
    font-size: 13px;
    font-weight: 600;
  }

  /* Le bandeau tissé de Motion, pleine largeur en haut de la page. */
  .bandeau {
    margin-bottom: var(--e5);
  }

  /* Le même, en séparateur fin : on ne garde qu'une tranche du tissage. */
  .bandeau-mince {
    height: 20px;
    overflow: hidden;
    margin-bottom: var(--e3);
    border-radius: 4px;
  }

  .bandeau-mince :global(svg) {
    margin-top: -42px;
  }

  .phase-carte {
    display: flex;
    gap: var(--e3);
    align-items: flex-start;
  }

  .phase-dessin {
    flex: none;
    width: 76px;
  }
</style>

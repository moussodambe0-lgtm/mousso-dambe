---
/**
 * Les produits : en ajouter, en modifier, en retirer.
 *
 * Arthur, le 14 octobre 2026 : « un endroit pour ajouter ou retirer les
 * produits ». C'est ce qui manquait le plus : jusqu'ici le catalogue ne se
 * touchait que dans l'éditeur SQL de Supabase.
 *
 * RETIRER N'EFFACE PAS. Des commandes déjà passées citent le produit, et leur
 * historique doit rester lisible : « retirer » le dépublie, il disparaît de la
 * boutique, reste ici, et se remet en vente d'un geste. C'est tenu par
 * `retirer_produit` en base, pas par cette page.
 *
 * Tout passe par des formulaires ordinaires : cet écran marche sans
 * JavaScript, sur le téléphone d'Arthur, dans un magasin, sans réseau stable.
 */
import Vendeur from '../../layouts/Vendeur.astro';
import Icone from '../../components/Icone.astro';
import Alerte from '../../components/Alerte.astro';
import { clientSession, baseConfiguree } from '../../lib/supabase';
import { visiteuse } from '../../lib/session';
import { prix, messageErreur } from '../../lib/format';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);

const client = clientSession(Astro)!;
const { data: admin } = await client.rpc('est_admin');
if (admin !== true) return Astro.redirect('/admin', 302);

let erreur = '';
let message = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const geste = String(f.get('geste') ?? '');

  if (geste === 'retirer' || geste === 'remettre') {
    const { data, error } = await client.rpc('retirer_produit', {
      p_slug: String(f.get('slug') ?? ''),
      p_remettre: geste === 'remettre',
    });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur ?? error?.message);
    else return Astro.redirect(`/vendeur/produits?ok=${geste}`, 303);
  } else if (geste === 'enregistrer') {
    const tailles = String(f.get('tailles') ?? '')
      .split(',')
      .map((x) => x.trim())
      .filter(Boolean)
      .slice(0, 6);
    const { data, error } = await client.rpc('enregistrer_produit', {
      p_slug: String(f.get('slug') ?? ''),
      p_nom: String(f.get('nom') ?? '').trim(),
      p_rayon: String(f.get('rayon') ?? ''),
      p_prix: Number(f.get('prix') ?? 0),
      p_stock: Number(f.get('stock') ?? 0),
      p_resume: String(f.get('resume') ?? '').trim(),
      p_description: String(f.get('description') ?? '').trim(),
      p_image: String(f.get('image') ?? '').trim() || null,
      p_etiquette: String(f.get('etiquette') ?? '').trim() || null,
      p_tailles: tailles,
      p_publie: f.get('publie') === 'oui',
    });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur ?? error?.message);
    else return Astro.redirect('/vendeur/produits?ok=enregistre', 303);
  }
}

const ok = Astro.url.searchParams.get('ok');
if (ok === 'enregistre') message = 'Le produit est enregistré.';
if (ok === 'retirer') message = 'Le produit est retiré de la boutique.';
if (ok === 'remettre') message = 'Le produit est remis en vente.';

const { data: liste } = await client.rpc('produits_admin');
const produits = (liste?.ok ? liste.produits : []) as any[];

// Le produit qu'on est en train de modifier, s'il y en a un.
const slugModifie = Astro.url.searchParams.get('modifier') ?? '';
const enCours = produits.find((p) => p.slug === slugModifie) ?? null;
const ouvrirFormulaire = !!enCours || Astro.url.searchParams.has('nouveau');

const RAYONS = [
  { id: 'serviettes', mot: 'Serviettes' },
  { id: 'lavables', mot: 'Lavables' },
  { id: 'culottes', mot: 'Culottes' },
  { id: 'kits', mot: 'Kits' },
];

const { data: tab } = await client.rpc('tableau_vendeur');
---

<Vendeur
  titre="Mes produits"
  onglet="produits"
  aPreparer={tab?.a_preparer ?? 0}
  messages={tab?.messages_boutique ?? 0}
>
  <div class="haut">
    <h1 class="titre-page">Mes produits</h1>
    {!ouvrirFormulaire && (
      <a class="btn btn-rose btn-petit" href="/vendeur/produits?nouveau">
        <Icone nom="plus" taille={18} />
        Ajouter
      </a>
    )}
  </div>

  {message && <div class="marge-bas"><Alerte type="reussite" texte={message} /></div>}
  {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

  {
    ouvrirFormulaire && (
      <form method="POST" class="carte formulaire">
        <input type="hidden" name="geste" value="enregistrer" />
        <input type="hidden" name="slug" value={enCours?.slug ?? ''} />

        <h2 class="titre-formulaire">{enCours ? `Modifier « ${enCours.nom} »` : 'Nouveau produit'}</h2>

        <div class="champ-bloc">
          <label class="libelle" for="nom">Le nom</label>
          <input class="champ" id="nom" name="nom" type="text" required maxlength="80" value={enCours?.nom ?? ''} />
        </div>

        <div class="deux">
          <div class="champ-bloc">
            <label class="libelle" for="prix">Prix (FCFA)</label>
            <input class="champ" id="prix" name="prix" type="number" inputmode="numeric" required min="1" max="999999" value={enCours?.prix_cfa ?? ''} />
          </div>
          <div class="champ-bloc">
            <label class="libelle" for="stock">Stock</label>
            <input class="champ" id="stock" name="stock" type="number" inputmode="numeric" required min="0" value={enCours?.stock ?? 0} />
          </div>
        </div>

        <div class="champ-bloc">
          <label class="libelle" for="rayon">Le rayon</label>
          <select class="champ" id="rayon" name="rayon" required>
            {RAYONS.map((r) => (
              <option value={r.id} selected={enCours?.rayon === r.id}>{r.mot}</option>
            ))}
          </select>
        </div>

        <div class="champ-bloc">
          <label class="libelle" for="resume">En une phrase</label>
          <input class="champ" id="resume" name="resume" type="text" maxlength="300" value={enCours?.resume ?? ''} placeholder="Ce qu'on en dit sur la fiche" />
        </div>

        <div class="champ-bloc">
          <label class="libelle" for="description">La description</label>
          <textarea class="champ zone" id="description" name="description" maxlength="2000" rows="4">{enCours?.description ?? ''}</textarea>
        </div>

        <div class="deux">
          <div class="champ-bloc">
            <label class="libelle" for="tailles">Tailles</label>
            <input class="champ" id="tailles" name="tailles" type="text" value={(enCours?.tailles ?? []).join(', ')} placeholder="S, M, L" />
            <p class="aide">Séparées par des virgules. Vide si le produit n'a pas de taille.</p>
          </div>
          <div class="champ-bloc">
            <label class="libelle" for="etiquette">Étiquette</label>
            <input class="champ" id="etiquette" name="etiquette" type="text" maxlength="40" value={enCours?.etiquette ?? ''} placeholder="Le plus pris" />
          </div>
        </div>

        <div class="champ-bloc">
          <label class="libelle" for="image">L'image</label>
          <input class="champ" id="image" name="image" type="text" maxlength="200" value={enCours?.image ?? ''} placeholder="/produits/serviette.webp" />
          <p class="aide">Le chemin du fichier déjà déposé dans le site. Vide, la fiche montre un dessin.</p>
        </div>

        <label class="ligne-case">
          <input type="checkbox" name="publie" value="oui" checked={enCours ? enCours.publie : true} />
          <span>En vente dans la boutique</span>
        </label>

        <div class="boutons">
          <button class="btn btn-rose btn-plein" type="submit">Enregistrer</button>
          <a class="btn btn-contour btn-plein" href="/vendeur/produits">Annuler</a>
        </div>
      </form>
    )
  }

  {
    produits.length === 0 ? (
      <p class="rien">Aucun produit pour l'instant.</p>
    ) : (
      <ul class="liste">
        {produits.map((p) => (
          <li class:list={['produit', !p.publie && 'produit-retire']}>
            <div class="produit-haut">
              <div class="produit-qui">
                <div class="produit-nom">{p.nom}</div>
                <div class="produit-detail">
                  <span class="chiffre">{prix(p.prix_cfa)} FCFA</span>
                  <span class="point">·</span>
                  <span class={p.stock === 0 ? 'rupture' : p.stock <= 3 ? 'bas' : ''}>
                    {p.stock === 0 ? 'En rupture' : `${p.stock} en stock`}
                  </span>
                  {!p.publie && <span class="pastille pastille-neutre">Retiré</span>}
                </div>
              </div>
              <a class="rond" href={`/vendeur/produits?modifier=${p.slug}`} aria-label={`Modifier ${p.nom}`}>
                <Icone nom="crayon" taille={18} />
              </a>
            </div>
            <form method="POST" class="produit-geste">
              <input type="hidden" name="slug" value={p.slug} />
              <input type="hidden" name="geste" value={p.publie ? 'retirer' : 'remettre'} />
              <button class="btn btn-contour btn-petit" type="submit">
                {p.publie ? 'Retirer de la boutique' : 'Remettre en vente'}
              </button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
</Vendeur>

<style>
  .haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e3);
    margin: var(--e4) 0 var(--e3);
  }

  .titre-page {
    font-size: 25px;
  }

  .btn-petit {
    min-height: 42px;
    padding: 0 var(--e3);
    font-size: 14px;
  }

  .formulaire {
    padding: var(--e4);
    margin-bottom: var(--e4);
  }

  .titre-formulaire {
    margin-bottom: var(--e3);
    font-size: 17px;
    font-weight: 700;
  }

  .champ-bloc {
    margin-bottom: var(--e3);
  }

  .deux {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e3);
  }

  .zone {
    min-height: 92px;
    padding-top: 10px;
    resize: vertical;
  }

  .aide {
    margin-top: 5px;
    font-size: 12.5px;
    color: var(--texte-3);
  }

  .ligne-case {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--e4);
    font-size: 14.5px;
    color: var(--texte-2);
  }

  .boutons {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }

  .liste {
    display: flex;
    flex-direction: column;
    gap: var(--e3);
    list-style: none;
  }

  .produit {
    padding: var(--e4);
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    background: var(--surface);
  }

  .produit-retire {
    opacity: 0.68;
  }

  .produit-haut {
    display: flex;
    align-items: flex-start;
    gap: var(--e3);
  }

  .produit-qui {
    flex: 1;
    min-width: 0;
  }

  .produit-nom {
    font-size: 15.5px;
    font-weight: 700;
  }

  .produit-detail {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 4px;
    font-size: 13.5px;
    color: var(--texte-2);
  }

  .produit-detail .chiffre {
    font-weight: 700;
    color: var(--rose);
  }

  .point {
    color: var(--texte-3);
  }

  .rupture {
    font-weight: 700;
    color: var(--rouge);
  }

  .bas {
    font-weight: 600;
    color: #a4660f;
  }

  .produit-geste {
    margin-top: var(--e3);
  }

  .rien {
    padding: var(--e5);
    border: 1px dashed var(--bordure);
    border-radius: var(--r-carte);
    color: var(--texte-2);
    text-align: center;
  }

  .marge-bas {
    margin-bottom: var(--e3);
  }
</style>

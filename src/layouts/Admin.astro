---
/**
 * Le gabarit de l'administration, copié de `layouts/Admin.astro` de Jia.
 *
 * Arthur, le 5 novembre 2026 : « dans espace administration, faut copier tout,
 * tout ce que tu vas voir dans espace administrateur, LA MANIÈRE DONT C'EST
 * PRÉSENTÉ, tout. Tu copies tout. Même les couleurs. »
 *
 * CE QUI EST COPIÉ TEL QUEL : l'en-tête sombre et collant, le sur-titre orange
 * en capitales, le titre de la page dessous, les sorties alignées à droite, et
 * la rangée d'onglets qui défile horizontalement avec son trait orange sous
 * l'onglet actif. Pas un pixel inventé : les classes `.entete-sombre`, les
 * couleurs `var(--sur-sombre)` et `var(--orange)`, les tailles, tout vient de Jia.
 *
 * L'administration n'a PAS de barre en bas, chez Jia comme ici : ses onglets
 * sont en haut. C'était une des erreurs que j'avais faites avant, avec une
 * barre basse à cinq onglets qui ne ressemblait à rien de Jia.
 *
 * LES ONGLETS. Jia en a cinq : Vérification, Litiges, Conversations, Produits,
 * Paiements. Trois d'entre eux n'existent que parce que Jia est une place de
 * marché avec des vendeurs tiers : vérifier une boutique qui entre, arbitrer
 * un litige entre une acheteuse et un vendeur, verser à ce vendeur sa part.
 * Mousso Dambé est sa propre et unique boutique : il n'y a personne à vérifier,
 * personne à arbitrer, personne à payer. Ces trois onglets ne pourraient jamais
 * afficher une seule ligne.
 *
 * Il y en a donc cinq ici aussi, au même endroit et dans la même forme, qui
 * portent ce que cette boutique a vraiment : une vue d'ensemble, les commandes,
 * les conversations, les produits, et « Monde » qu'Arthur avait réclamé le
 * 5 novembre. Si tu veux voir les trois autres malgré tout, même vides, dis-le
 * et je les ajoute : c'est une ligne dans le tableau ci-dessous.
 */
import BaseGestion from './BaseGestion.astro';

export type OngletAdmin = 'vue' | 'commandes' | 'conversations' | 'produits' | 'monde';

interface Props {
  titre: string;
  onglet: OngletAdmin;
}

const { titre, onglet } = Astro.props;

const onglets = [
  { cle: 'vue', libelle: 'Vue d’ensemble', href: '/admin' },
  { cle: 'commandes', libelle: 'Commandes', href: '/admin/commandes' },
  { cle: 'conversations', libelle: 'Conversations', href: '/admin/conversations' },
  { cle: 'produits', libelle: 'Produits', href: '/admin/produits' },
  { cle: 'monde', libelle: 'Monde', href: '/admin/monde' },
] as const;
---

<BaseGestion titre={`${titre} · Administration`} description="Administration de Mousso Dambé." sansNav>
  <header class="entete-sombre entete-admin">
    <div class="ligne">
      <div>
        <div class="sur-titre">ADMINISTRATION MOUSSO DAMBÉ</div>
        <h1>{titre}</h1>
      </div>
      <div class="sorties">
        {/* Chez Jia il y a ici « Espace vendeur » et « Quitter ». « Quitter »
            est retiré, comme Arthur l'a demandé le 5 novembre 2026 : il menait
            au site des clientes, sur une autre adresse, et faisait croire que
            les deux ne font qu'un. */}
        <a href="/vendeur" class="sortie">Espace vendeur</a>
      </div>
    </div>
    <nav class="onglets" aria-label="Administration">
      {onglets.map((o) => (
        <a
          href={o.href}
          class:list={['onglet', { actif: o.cle === onglet }]}
          aria-current={o.cle === onglet ? 'page' : undefined}
        >
          {o.libelle}
        </a>
      ))}
    </nav>
  </header>

  <slot />
</BaseGestion>

<style>
  .entete-admin { position: sticky; top: 0; z-index: 10; padding-bottom: 0; }
  .ligne { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
  .sur-titre { font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; color: var(--orange); }
  .entete-admin h1 { margin-top: 3px; }
  .sortie { color: var(--sur-sombre); font-size: 14px; font-weight: 700; }
  .sortie:hover { color: #FFFFFF; }
  .sorties { display: flex; gap: 7px; flex: 0 0 auto; }
  .onglets { display: flex; gap: 4px; margin-top: 14px; overflow-x: auto; }
  .onglet { color: var(--sur-sombre); font-size: 14.5px; font-weight: 700; padding: 10px 11px; border-bottom: 3px solid transparent; white-space: nowrap; }
  .onglet:hover { color: #FFFFFF; }
  .onglet.actif { color: #FFFFFF; border-bottom-color: var(--orange); }
</style>

---
/**
 * Le questionnaire de départ.
 *
 * Six écrans, une question par écran. Pourquoi pas un seul formulaire : ces
 * questions sont intimes, et un mur de champs sur ce sujet fait fermer
 * l'application. Une question à la fois, grosse, avec la raison de la poser.
 *
 * Il marche SANS JavaScript : chaque étape est un POST qui renvoie à la
 * suivante, et les réponses déjà données voyagent dans des champs cachés. Rien
 * n'est écrit en base avant le dernier écran, pour qu'une fille qui abandonne
 * en route n'ait rien laissé.
 */
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Anim from '../components/Anim.astro';
import Alerte from '../components/Alerte.astro';
import { clientSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { messageErreur, aujourdhui, dateDe, enIso, dateLongue, dateCourte } from '../lib/format';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);

const TOTAL = 6;
let etape = Number(Astro.url.searchParams.get('etape') ?? '1');
let erreur = '';

// Les réponses en cours de route.
let reponses = {
  prenom: moi.prenom,
  dernieres: '',
  sait: 'oui',
  duree: '5',
  cycle: '28',
};

/**
 * La dernière réponse non vide portant ce nom.
 *
 * Chaque champ existe deux fois dans le formulaire : une fois caché, qui
 * transporte la réponse des étapes précédentes, et une fois visible pour la
 * question en cours. Le champ caché vient en premier dans la page, donc
 * `formData.get()` renvoyait toujours LUI, et la réponse qu'elle venait de
 * donner était jetée. Sur l'écran de la date, cela bloquait le questionnaire :
 * quelle que soit la date choisie, l'écran redemandait la même chose.
 *
 * Le visible vient toujours après le caché dans la page, donc la dernière
 * valeur non vide est bien la réponse du moment.
 * Défaut trouvé par Arthur le 12 octobre 2026, en se servant de l'application.
 */
function derniereReponse(f: FormData, nom: string, defaut: string): string {
  const valeurs = f
    .getAll(nom)
    .map((v) => String(v).trim())
    .filter((v) => v !== '');
  return valeurs.length > 0 ? valeurs[valeurs.length - 1] : defaut;
}

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  reponses = {
    prenom: derniereReponse(f, 'prenom', moi.prenom),
    dernieres: derniereReponse(f, 'dernieres', ''),
    sait: derniereReponse(f, 'sait', 'oui'),
    duree: derniereReponse(f, 'duree', '5'),
    cycle: derniereReponse(f, 'cycle', '28'),
  };
  const venantDe = Number(f.get('etape') ?? '1');

  if (venantDe === 2 && reponses.sait === 'oui') {
    const d = reponses.dernieres;
    if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) {
      erreur = "Choisis la date du premier jour de tes dernières règles, ou dis que tu ne t'en souviens pas.";
      etape = 2;
    } else if (d > aujourdhui()) {
      erreur = "Cette date est dans le futur.";
      etape = 2;
    } else if (dateDe(d) < new Date(Date.now() - 120 * 86400000)) {
      erreur = 'Cette date est trop ancienne pour servir de point de départ.';
      etape = 2;
    } else {
      etape = 3;
    }
  } else if (venantDe === TOTAL) {
    // Dernier écran : on écrit, une seule fois, par la fonction de la base.
    const client = clientSession(Astro);
    const { data, error } = await client!.rpc('enregistrer_questionnaire', {
      p_prenom: reponses.prenom,
      p_cycle: Number(reponses.cycle),
      p_duree: Number(reponses.duree),
      p_dernieres_regles: reponses.sait === 'oui' && reponses.dernieres ? reponses.dernieres : null,
    });
    if (error || !data?.ok) {
      erreur = messageErreur(data?.erreur ?? null);
      etape = TOTAL;
    } else {
      return Astro.redirect('/?bienvenue=1', 303);
    }
  } else {
    etape = Math.min(venantDe + 1, TOTAL);
  }
}

etape = Math.min(Math.max(etape, 1), TOTAL);

// Les sept derniers jours proposés en un geste : taper une date au clavier sur
// un téléphone d'entrée de gamme est pénible, et la bonne réponse est presque
// toujours récente.
const joursRecents = Array.from({ length: 10 }, (_, i) => {
  const d = new Date();
  d.setDate(d.getDate() - i);
  return { iso: enIso(d), libelle: i === 0 ? "Aujourd'hui" : i === 1 ? 'Hier' : dateLongue(enIso(d)) };
});

// Ce qu'elle a déjà répondu, rappelé sous la barre d'avancement. Sans ça, deux
// écrans qui posent tous les deux une question en jours se ressemblent assez
// pour qu'on croie que rien ne s'est passé. Arthur, le 12 octobre : « ça fait
// comme si ça charge mais rien ».
const dejaDit: string[] = [];
if (etape >= 2 && reponses.prenom) dejaDit.push(reponses.prenom);
if (etape >= 3) {
  dejaDit.push(
    reponses.sait === 'oui' && reponses.dernieres ? dateCourte(reponses.dernieres) : 'date inconnue'
  );
}
if (etape >= 4) dejaDit.push(`règles ${reponses.duree} j`);
if (etape >= 5) dejaDit.push(`cycle ${reponses.cycle} j`);

const TITRES: Record<number, string> = {
  1: 'Comment tu veux qu’on t’appelle ?',
  2: 'Quand ont commencé tes dernières règles ?',
  3: 'Combien de jours durent tes règles, d’habitude ?',
  4: 'Combien de jours entre deux règles ?',
  5: 'Ce que l’application fait de tes réponses',
  6: 'C’est prêt',
};
---

<Base titre="Bienvenue" pleinEcran>
  <main class="page">
    <div class="haut">
      <a class="rond" href={etape === 1 ? '/' : `/bienvenue?etape=${etape - 1}`} aria-label="Question précédente">
        <Icone nom="retour" taille={20} epaisseur={2} />
      </a>
      <div class="progression">
        <div class="ligne-haute">
          <span>Question {etape} sur {TOTAL}</span>
          <span>{etape < 3 ? '1 minute' : etape < 5 ? '30 secondes' : 'presque fini'}</span>
        </div>
        <div class="rail">
          <div class="jauge" data-part={etape}></div>
        </div>
      </div>
    </div>

    <form method="POST" class="apparait">
      {/* Les réponses déjà données voyagent cachées d'une étape à l'autre.
          Celle que l'écran en cours demande n'est PAS reportée ici : sinon le
          champ caché et le champ visible portent le même nom, et la vieille
          valeur masque la nouvelle. C'est ce qui bloquait l'écran de la date. */}
      <input type="hidden" name="etape" value={etape} />
      {etape !== 1 && <input type="hidden" name="prenom" value={reponses.prenom} />}
      {etape !== 2 && <input type="hidden" name="dernieres" value={reponses.dernieres} />}
      {etape !== 2 && <input type="hidden" name="sait" value={reponses.sait} />}
      {etape !== 3 && <input type="hidden" name="duree" value={reponses.duree} />}
      {etape !== 4 && <input type="hidden" name="cycle" value={reponses.cycle} />}

      {
        dejaDit.length > 0 && (
          <div class="deja" aria-label="Ce que tu as déjà répondu">
            {dejaDit.map((bout) => (
              <span class="bout">
                <Icone nom="coche" taille={12} epaisseur={2.5} />
                {bout}
              </span>
            ))}
          </div>
        )
      }

      <h1>{TITRES[etape]}</h1>

      {erreur && <div class="marge"><Alerte type="erreur" texte={erreur} /></div>}

      {
        etape === 1 && (
          <div class="corps">
            <Anim nom="q-bienvenue" classe="dessin-q" />
            <p class="doux">Ton prénom suffit. Il ne sort pas de ton téléphone, sauf vers Dambé quand tu lui parles.</p>
            <label class="libelle" for="p">Ton prénom</label>
            <input class="champ" id="p" name="prenom" type="text" required maxlength="40" value={reponses.prenom} autocomplete="given-name" />
          </div>
        )
      }

      {
        etape === 2 && (
          <div class="corps">
            <Anim nom="phase-regles" classe="dessin-petit" />
            <p class="doux">
              Le premier jour de saignement, pas le dernier. C'est la seule date dont j'ai besoin pour calculer la
              suite.
            </p>
            <div class="jours">
              {joursRecents.map((j) => (
                <button class="puce" type="submit" name="dernieres" value={j.iso} aria-pressed={reponses.dernieres === j.iso}>
                  {j.libelle}
                </button>
              ))}
            </div>
            <label class="libelle marge" for="d">Ou une autre date</label>
            <input class="champ" id="d" name="dernieres" type="date" max={aujourdhui()} value={reponses.dernieres} />
            <button class="btn btn-contour btn-plein marge" type="submit" name="sait" value="non">
              Je ne m'en souviens pas
            </button>
          </div>
        )
      }

      {
        etape === 3 && (
          <div class="corps">
            <p class="doux">Du premier jour de saignement au dernier. Si ça change d'un mois à l'autre, donne une moyenne.</p>
            {/* Des gouttes plutôt qu'une grille de pastilles : l'écran suivant
                pose aussi une question en jours, et deux grilles identiques à
                la suite donnent l'impression que rien ne s'est passé. */}
            <div class="gouttes">
              {[2, 3, 4, 5, 6, 7, 8].map((n) => (
                <button class="goutte-choix" type="submit" name="duree" value={String(n)} aria-pressed={reponses.duree === String(n)}>
                  {/* Une goutte par jour, toutes les gouttes : un dessin qui
                      compte doit compter juste, sinon 5, 6 et 7 jours se
                      ressemblent et il ne sert plus à rien. */}
                  <span class="gouttes-dessin" aria-hidden="true">
                    {Array.from({ length: n }, () => (
                      <Icone nom="goutte" taille={11} />
                    ))}
                  </span>
                  <span class="nb-jours chiffre">{n}</span>
                  <span class="mot">jours</span>
                </button>
              ))}
            </div>
          </div>
        )
      }

      {
        etape === 4 && (
          <div class="corps">
            {/* L'anneau des 28 jours : il dit de quoi on parle, et il rend cet
                écran impossible à confondre avec le précédent. */}
            <Anim nom="q-cycle" classe="dessin-q" />
            <p class="doux">
              Du premier jour de règles au premier jour des règles suivantes. Si tu ne sais pas, laisse 28 jours : je
              corrigerai toute seule dès que tu auras noté un cycle.
            </p>
            <div class="choix-grille">
              {[21, 24, 26, 28, 30, 32, 35].map((n) => (
                <button class="puce grande" type="submit" name="cycle" value={String(n)} aria-pressed={reponses.cycle === String(n)}>
                  {n} jours
                </button>
              ))}
            </div>
            <button class="btn btn-contour btn-plein marge" type="submit" name="cycle" value="28">
              Je ne sais pas
            </button>
          </div>
        )
      }

      {
        etape === 5 && (
          <div class="corps">
            <Anim nom="q-vie-privee" classe="dessin-q" />
            <ul class="liste">
              <li>
                <span class="puce-icone verte"><Icone nom="bouclier-coche" taille={19} /></span>
                <div>
                  <strong>Ton journal n'est lisible que par toi</strong>
                  <span>Aucune administratrice ne peut l'ouvrir, et il n'existe aucun export.</span>
                </div>
              </li>
              <li>
                <span class="puce-icone"><Icone nom="oeil-barre" taille={19} /></span>
                <div>
                  <strong>Les notifications ne disent rien</strong>
                  <span>Ton téléphone affiche « Mousso Dambé » et rien de plus. C'est allumé d'office.</span>
                </div>
              </li>
              <li>
                <span class="puce-icone"><Icone nom="dambe" taille={19} /></span>
                <div>
                  <strong>Dambé ne reçoit que l'essentiel</strong>
                  <span>Ton prénom et ton jour de cycle, jamais ton numéro, ton quartier ni ton journal.</span>
                </div>
              </li>
              <li>
                <span class="puce-icone"><Icone nom="poubelle" taille={19} /></span>
                <div>
                  <strong>Tu peux tout effacer</strong>
                  <span>Un bouton dans ton compte, et il ne reste rien.</span>
                </div>
              </li>
            </ul>
          </div>
        )
      }

      {
        etape === 6 && (
          <div class="corps">
            <div class="recap carte bloc">
              <div class="ligne">
                <span>Ton prénom</span>
                <strong>{reponses.prenom || '—'}</strong>
              </div>
              <div class="ligne">
                <span>Dernières règles</span>
                <strong>
                  {reponses.sait === 'oui' && reponses.dernieres ? dateLongue(reponses.dernieres) : 'tu ne sais pas'}
                </strong>
              </div>
              <div class="ligne">
                <span>Durée des règles</span>
                <strong>{reponses.duree} jours</strong>
              </div>
              <div class="ligne">
                <span>Durée du cycle</span>
                <strong>{reponses.cycle} jours</strong>
              </div>
            </div>
            <p class="doux marge">
              Tu pourras tout changer dans ton compte. Rien n'est figé, et plus tu noteras, plus les dates seront
              justes.
            </p>
          </div>
        )
      }

      <div class="bas">
        {etape === 1 && <button class="btn btn-rose btn-plein" type="submit">Continuer</button>}
        {etape === 5 && <button class="btn btn-rose btn-plein" type="submit">J'ai compris</button>}
        {etape === 6 && <button class="btn btn-rose btn-plein" type="submit">Voir mon cycle</button>}
      </div>
    </form>
  </main>
</Base>

<style>
  .haut {
    display: flex;
    align-items: center;
    gap: var(--e3);
    padding: var(--e5) 0 var(--e5);
  }

  .progression {
    flex: 1;
  }

  .ligne-haute {
    display: flex;
    justify-content: space-between;
    margin-bottom: 6px;
    font-size: 12px;
    font-weight: 600;
    color: var(--texte-2);
  }

  .rail {
    height: 6px;
    border-radius: var(--r-ronde);
    background: var(--surface-douce);
    overflow: hidden;
  }

  .jauge {
    height: 100%;
    border-radius: var(--r-ronde);
    background: var(--rose);
    transition: width var(--normal) var(--sortie);
  }

  .jauge[data-part='1'] { width: 16.6%; }
  .jauge[data-part='2'] { width: 33.3%; }
  .jauge[data-part='3'] { width: 50%; }
  .jauge[data-part='4'] { width: 66.6%; }
  .jauge[data-part='5'] { width: 83.3%; }
  .jauge[data-part='6'] { width: 100%; }

  h1 {
    font-size: 27px;
    font-weight: 800;
    line-height: 1.15;
  }

  .corps {
    margin-top: var(--e4);
  }

  .dessin-q {
    width: 200px;
    margin: 0 auto var(--e4);
  }

  .dessin-petit {
    width: 110px;
    margin: 0 auto var(--e4);
  }

  /* Ce qu'elle a déjà répondu : la preuve, à chaque écran, que ça avance. */
  .deja {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: var(--e3);
  }

  .bout {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border-radius: var(--r-ronde);
    background: var(--vert-clair);
    color: var(--vert);
    font-size: 12px;
    font-weight: 600;
  }

  /* L'écran de la durée des règles : des gouttes, pas une grille de pastilles,
     pour qu'il ne se confonde pas avec celui du cycle qui vient après. */
  .gouttes {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
  }

  .goutte-choix {
    display: flex;
    align-items: center;
    gap: var(--e3);
    width: 100%;
    min-height: 56px;
    padding: 0 var(--e4);
    border: 1px solid var(--bordure);
    border-radius: var(--r-champ);
    background: var(--surface);
    cursor: pointer;
    transition: background-color var(--vite) ease, border-color var(--vite) ease;
  }

  .goutte-choix:hover {
    background: var(--surface-douce);
  }

  .goutte-choix[aria-pressed='true'] {
    background: var(--rose-clair);
    border-color: var(--rose);
  }

  .gouttes-dessin {
    display: flex;
    gap: 1px;
    width: 100px;
    flex: none;
    color: var(--rose);
  }

  .nb-jours {
    font-size: 19px;
    color: var(--encre);
  }

  .mot {
    font-size: 14px;
    color: var(--texte-2);
  }

  .doux {
    font-size: 14.5px;
    color: var(--texte-2);
    line-height: 1.5;
    margin-bottom: var(--e4);
  }

  .jours {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e2);
  }

  .choix-grille {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--e2);
  }

  .grande {
    min-height: 52px;
  }

  .marge {
    margin-top: var(--e4);
  }

  .liste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--e4);
  }

  .liste li {
    display: flex;
    gap: var(--e3);
    align-items: flex-start;
  }

  .liste strong {
    display: block;
    font-size: 14.5px;
  }

  .liste span {
    font-size: 13px;
    color: var(--texte-2);
    line-height: 1.45;
  }

  .puce-icone {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 12px;
    background: var(--surface-douce);
    color: var(--rose);
  }

  .puce-icone.verte {
    background: var(--vert-clair);
    color: var(--vert);
  }

  .ligne {
    display: flex;
    justify-content: space-between;
    gap: var(--e3);
    padding: 9px 0;
    border-bottom: 1px solid var(--bordure);
    font-size: 14px;
  }

  .ligne:last-child {
    border-bottom: none;
  }

  .ligne span {
    color: var(--texte-2);
  }

  .bas {
    margin-top: var(--e5);
    padding-bottom: var(--e6);
  }
</style>

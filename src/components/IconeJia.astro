---
// Jeu d'icônes Jia. Traits simples, grille 24, épaisseur 1.8.
//
// Les tracés sont écrits en balisage littéral plutôt qu'injectés depuis un
// dictionnaire de chaînes : cela évite `set:html`, que le CLAUDE.md du projet
// interdit sans exception, y compris pour du contenu que nous écrivons nous-mêmes.

export type IconName =
  // Navigation
  | 'home' | 'grid' | 'message' | 'bag' | 'cart' | 'receipt' | 'user' | 'search'
  // Statuts de commande
  | 'wallet' | 'package' | 'check-circle' | 'refund' | 'message-star' | 'cancel'
  // Actions
  | 'check' | 'chevron-right' | 'chevron-left' | 'chevron-down' | 'plus' | 'minus'
  | 'close' | 'phone' | 'map-pin' | 'heart' | 'share' | 'trash' | 'edit' | 'camera' | 'send'
  // Confiance et alertes
  | 'shield' | 'info' | 'warning' | 'bell' | 'star' | 'clock'
  // Vendeur
  | 'dashboard' | 'box' | 'trend-up' | 'card' | 'id-card' | 'store'
  // Réglages et compte
  | 'settings' | 'logout' | 'mail' | 'lock' | 'help'
  // Pièces jointes de la messagerie
  | 'image' | 'video' | 'mic' | 'file' | 'paperclip' | 'smile'
  // Rayons
  | 'smartphone' | 'shirt' | 'sparkles' | 'car' | 'sun' | 'utensils' | 'baby' | 'wrench'
  // Suggestions de la barre de recherche
  | 'cctv' | 'projector' | 'watch' | 'headphones' | 'bot' | 'lightbulb'
  // Micro de studio, pour la recherche a la voix : deux couleurs, donc ses
  // parties portent une classe pour etre peintes separement.
  | 'mic-studio'
  // Rangement de la messagerie
  | 'archive' | 'tag' | 'check-double' | 'more'
  // Categories du selecteur d'emojis
  | 'cat' | 'coffee' | 'backspace'
  // Pastilles des vignettes de categories
  | 'arrow-up-right' | 'flame';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Épaisseur du trait. 2.6+ pour les coches dans un petit badge. */
  stroke?: number;
}

const { name, size = 20, class: className, stroke = 1.8, ...portee } = Astro.props;

// `portee` reçoit l'attribut data-astro-cid-* que le composant parent transmet.
// Sans le reporter sur le <svg>, un style scopé du parent (.icone-info { color })
// ne l'atteint jamais et l'icône reste de la couleur du texte.
const attributsPortee = Object.fromEntries(
  Object.entries(portee).filter(([cle]) => cle.startsWith('data-astro-cid'))
);
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
  focusable="false"
  {...attributsPortee}
>
  {name === 'home' && (<><path d="M4 11L12 4l8 7" /><path d="M6 10v9a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-9" /></>)}
  {name === 'grid' && (<><rect x="4" y="4" width="7" height="7" rx="1.4" /><rect x="13" y="4" width="7" height="7" rx="1.4" /><rect x="4" y="13" width="7" height="7" rx="1.4" /><rect x="13" y="13" width="7" height="7" rx="1.4" /></>)}
  {name === 'message' && (<path d="M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V5a1 1 0 0 1 1-1z" />)}
  {name === 'bag' && (<><path d="M6 8h12l-1 12H7L6 8z" /><path d="M9 8V6a3 3 0 0 1 6 0v2" /></>)}
  {/* La charette : un panier, une anse, deux roues. Demande d'Arthur du
      27 septembre 2026 pour l'onglet Panier. Le « bag » restait un sac, qui se
      lit mal a 23 px et ne dit pas « achat en cours ». */}
  {name === 'cart' && (<><path d="M3 5h1.8l2.2 9.3a1 1 0 0 0 1 .7h8.2a1 1 0 0 0 1-.8L19 8H6.2" /><circle cx="10" cy="19" r="1.5" /><circle cx="17" cy="19" r="1.5" /></>)}
  {name === 'receipt' && (<><path d="M6 3h12v18l-2-1.5L14 21l-2-1.5L10 21l-2-1.5L6 21V3z" /><path d="M8.5 8h7M8.5 12h7" /></>)}
  {name === 'user' && (<><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-6 8-6s8 2 8 6" /></>)}
  {name === 'search' && (<><circle cx="11" cy="11" r="7" /><path d="M16.5 16.5L21 21" /></>)}

  {name === 'wallet' && (<><rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3 10h18" /></>)}
  {name === 'package' && (<><path d="M3 8l9-5 9 5-9 5-9-5z" /><path d="M3 8v9l9 5 9-5V8" /></>)}

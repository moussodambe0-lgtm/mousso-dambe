---
/**
 * La boutique.
 *
 * Ouverte sans compte : une fille doit pouvoir regarder les prix avant de
 * s'inscrire, et un lien partagé doit s'ouvrir sur le produit. Le compte
 * n'est exigé qu'au moment de commander.
 *
 * Les pages du catalogue sont mises en cache par le réseau de diffusion
 * (`s-maxage`) : elles ne contiennent donc rien de personnel, jamais.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import CarteProduit from '../../components/CarteProduit.astro';
import BandeauCommandes from '../../components/BandeauCommandes.astro';
import { clientPublic, clientSession, baseConfiguree, jetonDeSession } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import { enteteCatalogue } from '../../lib/cache';
import { motCherche, filtreRecherche } from '../../lib/recherche';
import PiedLegal from '../../components/PiedLegal.astro';

const RAYONS = [
  { id: '', libelle: 'Tout' },
  { id: 'serviettes', libelle: 'Serviettes' },
  { id: 'culottes', libelle: 'Culottes' },
  { id: 'lavables', libelle: 'Lavables' },
];

const rayon = Astro.url.searchParams.get('rayon') ?? '';
// Le mot cherché part dans un filtre que la base lit comme du texte : il est
// débarrassé de la ponctuation qui y change la structure (audit du 12 octobre).
const cherche = motCherche(Astro.url.searchParams.get('q'));

let produits: any[] = [];
if (baseConfiguree()) {
  let requete = clientPublic(Astro)
    .from('produits')
    .select('slug, nom, resume, prix_cfa, rayon, image, etiquette, stock')
    .eq('publie', true)
    .order('ordre');
  if (rayon && RAYONS.some((r) => r.id === rayon)) requete = requete.eq('rayon', rayon);
  if (cherche) requete = requete.or(filtreRecherche(cherche));
  const { data } = await requete;
  produits = data ?? [];
}

// Relevé AVANT de lire la session : si le cookie était périmé, `visiteuse()`
// demande au navigateur de l'effacer, et une réponse qui pose un cookie ne doit
// jamais être gardée par un cache partagé.
const avaitUnCookie = !!jetonDeSession(Astro);
const moi = await visiteuse(Astro);
const panier = comptePanier(lirePanier(Astro));

// Le bandeau « Mes commandes », sous la barre de recherche (Arthur, 26 octobre
// 2026 : « on met ça en haut, juste en dessous de la barre de recherche »).
// Seulement pour une femme connectée : une visiteuse de passage n'a aucune
// commande, et quatre compteurs à zéro ne lui diraient rien. Cela garde aussi
// la page cachable pour elle, puisque `connectee` est alors faux et que rien de
// personnel n'est écrit dedans (voir `catalogueGardable`).
const clienteConnectee = moi ? clientSession(Astro) : null;
const { data: mesCommandes } = clienteConnectee
  ? await clienteConnectee.rpc('mes_commandes')
  : { data: null };
const commandes = (mesCommandes ?? []) as { etat: string }[];

// Catalogue sans rien de personnel : le réseau peut le garder deux minutes.
// Le compteur du panier compte comme personnel : il est écrit dans la page, et
// un cache partagé le servirait à la visiteuse suivante (Cyber, 26 octobre
// 2026). La décision vit dans src/lib/cache.ts pour être testable.
Astro.response.headers.set(
  'Cache-Control',
  enteteCatalogue({ connectee: !!moi, avaitUnCookie, articlesAuPanier: panier })
);
---

<Base titre="Boutique" nav="boutique" panier={panier}>
  <main class="page">
    <form class="haut" method="GET" action="/boutique">
      <div class="recherche">
        <Icone nom="recherche" taille={18} />
        <label class="lecture-seule" for="q">Chercher un produit</label>
        <input id="q" name="q" type="search" placeholder="Serviettes, culottes…" value={cherche} />
      </div>
      <a class="rond" href="/panier" aria-label={`Mon panier, ${panier} articles`}>
        <Icone nom="panier" taille={20} />
        {panier > 0 && <span class="nav-pastille">{panier}</span>}
      </a>
    </form>

    {moi && <BandeauCommandes commandes={commandes} classe="apparait" serre />}

    <nav class="rayons" aria-label="Rayons">
      {
        RAYONS.map((r) => (
          <a
            class:list={['puce', rayon === r.id && 'puce-prise']}
            href={r.id ? `/boutique?rayon=${r.id}` : '/boutique'}
            aria-current={rayon === r.id ? 'page' : undefined}
          >
            {r.libelle}
          </a>
        ))
      }
    </nav>

    <section class="carte-sombre bloc rassure apparait">
      <Icone nom="camion" taille={22} />
      <div>
        <strong>Tu paies à la livraison</strong>
        <span>Livré à Ouaga en 24 h</span>
      </div>
    </section>

    {
      produits.length === 0 ? (
        <div class="etat-vide">
          <Icone nom="recherche" taille={34} />
          <h2>Rien trouvé</h2>
          <p>
            {cherche
              ? `Aucun produit ne correspond à « ${cherche} ».`
              : "Ce rayon est vide pour le moment."}
          </p>
          <a class="btn btn-contour" href="/boutique">Voir tout</a>
        </div>
      ) : (
        <div class="grille-produits apparait" data-ordre="2">
          {produits.map((p) => (
            <CarteProduit
              slug={p.slug}
              nom={p.nom}
              prixCfa={p.prix_cfa}
              rayon={p.rayon}
              image={p.image}
              etiquette={p.etiquette}
              stock={p.stock}
            />
          ))}
        </div>
      )
    }

    <div class="espace"></div>
  </main>

  {/* LE PIED DE PAGE AVEC LES DOCUMENTS LÉGAUX (7 novembre 2026).

      Il manquait ici, et c'est l'écran où il manquait le plus : la boutique
      est la seule page de l'application ouverte aux moteurs de recherche, et
      c'est la seule où quelqu'un achète. Les conditions générales de VENTE
      doivent être atteignables depuis l'endroit où l'on vend, pas seulement
      depuis l'accueil. */}
  <PiedLegal avecNav />
</Base>

<style>
  .haut {
    display: flex;
    gap: var(--e2);
    align-items: center;
    padding: var(--e5) 0 var(--e3);
  }

  .recherche {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 46px;
    padding: 0 13px;
    border: 1px solid var(--bordure);
    border-radius: 16px;
    background: var(--surface);
    color: var(--texte-3);
  }

  .recherche input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    font-size: 16px;
    color: var(--encre);
  }

  .rayons {
    display: flex;
    gap: var(--e2);
    overflow-x: auto;
    padding-bottom: var(--e3);
    scrollbar-width: none;
  }

  .rayons::-webkit-scrollbar {
    display: none;
  }

  .rayons .puce {
    flex: none;
    display: inline-flex;
    align-items: center;
  }

  /* La hauteur seulement, à la demande d'Arthur (13 octobre 2026) : le texte,
     l'icône et la largeur ne bougent pas. */
  .rassure {
    display: flex;
    align-items: center;
    gap: var(--e3);
    padding: 5px var(--e4);
    color: #fff;
  }

  .rassure strong {
    display: block;
    font-size: 15px;
    line-height: 1.2;
  }

  .rassure span {
    display: block;
    font-size: 13.5px;
    line-height: 1.2;
    color: var(--rose-clair);
  }

  .tisse {
    margin: var(--e3) 0 var(--e4);
  }

  .etat-vide :global(svg) {
    color: var(--texte-3);
  }
</style>

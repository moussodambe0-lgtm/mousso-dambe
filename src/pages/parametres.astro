---
/**
 * Paramètres.
 *
 * Demande d'Arthur du 13 octobre 2026, par message vocal : « une option
 * paramètre au niveau de mon compte, un logo de paramètre en haut à droite...
 * dans paramètres, la première chose, mon compte, en bas de mon compte il y a
 * quatre boutons : mes informations, mes adresses, mise à jour, service
 * client ».
 */
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Icone from '../components/Icone.astro';
import { visiteuse, lirePanier, comptePanier } from '../lib/session';
import { baseConfiguree } from '../lib/supabase';
import { sansCompte } from '../lib/porte';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return sansCompte(Astro);

const panier = comptePanier(lirePanier(Astro));

// « Service client » n'a pas encore de destination : Arthur a dit le 13
// octobre 2026 qu'il ne doit PAS mener à la conversation avec la boutique,
// mais à une page d'administration qu'il créera après. En attendant, la ligne
// garde sa place sans faire semblant de mener quelque part : un lien qui
// tombe sur une page absente est pire qu'une ligne qui annonce son retard.
const LIGNES = [
  { icone: 'compte', mot: 'Mes informations', href: '/parametres/informations' },
  { icone: 'lieu', mot: 'Mes adresses', href: '/compte/adresse' },
  { icone: 'cloche', mot: 'Mise à jour', href: '/parametres/mise-a-jour' },
  { icone: 'bulle', mot: 'Service client', href: null },
];

/*
 * LES DOCUMENTS LÉGAUX, DANS UNE SECTION À PART (Arthur, le 7 novembre
 * 2026 : « dans l'application, tu mets les documents dans paramètres. Quand
 * quelqu'un clique sur paramètres, il pourra voir les documents »).
 *
 * Pas mêlés à « Mon compte » : ce ne sont pas des réglages, on ne les ouvre
 * pas pour changer quelque chose mais pour vérifier ce à quoi on s'est
 * engagé. Les mélanger ferait chercher un bouton là où il n'y a qu'un texte.
 *
 * Ils sont aussi en bas de l'accueil, dans le pied de page, pour celles qui
 * n'ont pas de compte : la loi n°045-2009/AN veut qu'on puisse les lire sans
 * se connecter.
 */
const DOCUMENTS = [
  { icone: 'liste', mot: 'Conditions d’utilisation', href: '/legal/conditions-generales' },
  { icone: 'bouclier', mot: 'Cookies et traceurs', href: '/legal/cookies' },
  { icone: 'info', mot: 'Tous les documents légaux', href: '/legal' },
];
---

<Base titre="Paramètres" nav="compte" panier={panier}>
  <main class="page">
    <Entete titre="Paramètres" retour="/compte" />

    <h2 class="section-titre">Mon compte</h2>
    <nav class="liste apparait">
      {
        LIGNES.map((l) =>
          l.href ? (
            <a class="ligne" href={l.href}>
              <span class="ligne-rond"><Icone nom={l.icone} taille={19} /></span>
              <span class="ligne-mot">{l.mot}</span>
              <Icone nom="avant" taille={18} classe="ligne-fleche" />
            </a>
          ) : (
            <div class="ligne ligne-morte">
              <span class="ligne-rond"><Icone nom={l.icone} taille={19} /></span>
              <span class="ligne-mot">{l.mot}</span>
              <span class="ligne-bientot">Bientôt</span>
            </div>
          )
        )
      }
    </nav>

    <h2 class="section-titre">Documents légaux</h2>
    <nav class="liste apparait">
      {
        DOCUMENTS.map((l) => (
          <a class="ligne" href={l.href}>
            <span class="ligne-rond"><Icone nom={l.icone} taille={19} /></span>
            <span class="ligne-mot">{l.mot}</span>
            <Icone nom="avant" taille={18} classe="ligne-fleche" />
          </a>
        ))
      }
    </nav>

    {/* « Me déconnecter » vient de « Mon compte » (Arthur, 13 octobre 2026) :
        c'est ici qu'on range ce qu'on fait une fois de temps en temps. */}
    <form method="POST" action="/deconnexion" class="deconnexion">
      <button class="btn btn-contour btn-plein" type="submit">
        <Icone nom="sortie" taille={19} />
        Me déconnecter
      </button>
    </form>

    <div class="espace"></div>
  </main>
</Base>

<style>
  .section-titre {
    margin-top: var(--e5);
    margin-bottom: var(--e2);
    font-size: 14.5px;
    font-weight: 700;
    color: var(--texte-3);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .liste {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    background: var(--surface);
    overflow: hidden;
  }

  .ligne {
    display: flex;
    align-items: center;
    gap: var(--e3);
    padding: var(--e3) var(--e4);
    border-bottom: 1px solid var(--bordure);
  }

  .ligne:last-child {
    border-bottom: none;
  }

  .ligne:active {
    background: var(--surface-douce);
  }

  .ligne-rond {
    display: grid;
    place-items: center;
    flex: none;
    color: var(--rose);
  }

  .ligne-mot {
    flex: 1;
    font-size: 15.5px;
    font-weight: 600;
  }

  .ligne :global(.ligne-fleche) {
    flex: none;
    color: var(--texte-3);
  }

  .ligne-morte .ligne-rond,
  .ligne-morte .ligne-mot {
    opacity: 0.55;
  }

  .deconnexion {
    margin-top: var(--e6);
  }

  .ligne-bientot {
    flex: none;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--surface-douce);
    color: var(--texte-3);
    font-size: 13px;
    font-weight: 600;
  }
</style>

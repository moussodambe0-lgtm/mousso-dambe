---
/**
 * L'anneau du cycle.
 *
 * Tout est calculé côté serveur : l'anneau s'affiche même sans JavaScript, et
 * il n'y a rien à charger.
 *
 * Il dit quatre choses à la fois :
 *   - le rose plein, les jours de règles ;
 *   - le violet, la période fertile ;
 *   - le point sombre, aujourd'hui ;
 *   - les petits points à l'intérieur, les journées QU'ELLE A NOTÉES.
 *
 * Ce dernier point est ce qui transforme un calcul en son propre carnet.
 * Arthur, le 12 octobre 2026 : « jour 1 sur 28, c'est trop basique, je veux
 * vraiment une amélioration, que ce soit plus original ».
 *
 * Deux couleurs qu'il faut distinguer ne diffèrent jamais par la seule teinte :
 * le rose est plein et commence en haut, le violet est au milieu de l'anneau,
 * et le point d'aujourd'hui a une forme à lui.
 */
import { anneauDuCycle } from '../lib/cycle';

interface Props {
  jour: number;
  dureeRegles: number;
  cycle: number;
  phase: string;
  /** Les jours du cycle qu'elle a notés, et si elle y a déclaré du sang. */
  notes?: { jour: number; saigne: boolean }[];
  anime?: boolean;
}

const { jour, dureeRegles, cycle, phase, notes = [], anime = true } = Astro.props;
const a = anneauDuCycle(jour, dureeRegles, cycle);
const trace = `${a.parcouru.toFixed(1)} ${a.circonference.toFixed(1)}`;

// Les journées notées, posées sur un cercle intérieur. Deux notes le même jour
// n'existent pas (la base a une ligne par jour), donc pas de doublon à gérer.
const RAYON_NOTES = 66;
const points = notes
  .filter((n) => n.jour >= 1 && n.jour <= cycle)
  .map((n) => {
    const angle = ((n.jour - 0.5) / cycle) * 2 * Math.PI - Math.PI / 2;
    return {
      x: Number((100 + RAYON_NOTES * Math.cos(angle)).toFixed(2)),
      y: Number((100 + RAYON_NOTES * Math.sin(angle)).toFixed(2)),
      saigne: n.saigne,
    };
  });

const libelleNotes =
  points.length === 0
    ? ''
    : `, ${points.length} ${points.length === 1 ? 'journée notée' : 'journées notées'}`;
---

<div class="anneau">
  <svg
    width="208"
    height="208"
    viewBox="0 0 200 200"
    role="img"
    aria-label={`Jour ${jour} sur ${cycle} de ton cycle, ${phase}${libelleNotes}`}
  >
    <g transform="rotate(-90 100 100)">
      <!-- Le cycle entier, en fond -->
      <circle cx="100" cy="100" r="88" fill="none" stroke="var(--surface-douce)" stroke-width="14"></circle>
      <!-- Les jours de règles -->
      <circle
        cx="100"
        cy="100"
        r="88"
        fill="none"
        stroke="var(--rose)"
        stroke-width="14"
        stroke-linecap="round"
        stroke-dasharray={a.regles}
      ></circle>
      <!-- La période fertile -->
      <circle
        cx="100"
        cy="100"
        r="88"
        fill="none"
        stroke="var(--violet)"
        stroke-width="14"
        stroke-linecap="round"
        stroke-dasharray={a.fertile}
      ></circle>
      <!-- Le chemin parcouru, qui se dessine à l'arrivée.
           Le point de départ du tracé est posé en ATTRIBUT SVG, pas en style
           en ligne : la politique de sécurité du contenu refuse les seconds.
           L'animation n'a donc qu'une étape d'arrivée (« to »), et le
           navigateur part tout seul de la valeur de l'attribut. -->
      <circle
        cx="100"
        cy="100"
        r="88"
        fill="none"
        stroke="var(--encre)"
        stroke-width="3"
        stroke-linecap="round"
        stroke-dasharray={trace}
        stroke-dashoffset={a.parcouru.toFixed(1)}
        class={anime ? 'anneau-trace' : ''}
      ></circle>
    </g>

    <!-- Ses journées notées -->
    {
      points.map((p) => (
        <circle
          cx={p.x}
          cy={p.y}
          r={p.saigne ? 3.6 : 2.6}
          fill={p.saigne ? 'var(--rose)' : 'var(--texte-3)'}
          class={anime ? 'pose' : ''}
        />
      ))
    }

    <!-- Aujourd'hui : le seul élément qui respire, très lentement -->
    <circle cx={a.marqueur.x} cy={a.marqueur.y} r="9.5" fill="var(--fond)"></circle>
    <circle
      cx={a.marqueur.x}
      cy={a.marqueur.y}
      r="5.5"
      fill="var(--encre)"
      class={anime ? 'respire' : ''}
    ></circle>
  </svg>
  <div class="anneau-centre">
    <slot />
  </div>
</div>

<style>
  .anneau {
    position: relative;
    width: 208px;
    height: 208px;
  }

  .anneau-centre {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    text-align: center;
    /* Le centre ne doit pas intercepter le toucher destiné à l'anneau. */
    pointer-events: none;
  }
</style>

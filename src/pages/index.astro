---
/**
 * L'ACCUEIL.
 *
 * Deux états : la visiteuse qui découvre, et celle qui a son cycle.
 *
 * Le haut de l'écran reprend le code de référence d'Arthur du 12 octobre
 * 2026 : en-tête avec son avatar, carte vedette dont la couleur suit la phase
 * du cycle avec des objets qui flottent, puis la bande des jours en capsules.
 * Sous la bande viennent les sections de la section 10 du prompt : conseils
 * de la phase, et produits.
 *
 * Tout est construit sur le serveur. Le seul script envoyé fait avancer le
 * carrousel tout seul, et il n'est pas nécessaire pour lire la page.
 */
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Avatar from '../components/Avatar.astro';
import ObjetsCarte from '../components/ObjetsCarte.astro';
import Mascotte from '../components/Mascotte.astro';
import DefsCycle from '../components/DefsCycle.astro';
import GoutteJour from '../components/GoutteJour.astro';
import BebeJour from '../components/BebeJour.astro';
import CarteProduit from '../components/CarteProduit.astro';
import Alerte from '../components/Alerte.astro';
import '../styles/accueil.css';
import { existsSync as fsExiste } from 'node:fs';
import { clientPublic, clientSession, baseConfiguree } from '../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../lib/session';
import { PHASES } from '../lib/cycle';
import {
  infoDuJour,
  jourOvulation,
  prochainesRegles,
  moyenneCycles,
  ecartEnJours,
  plusDeJours,
  type ReglagesCycle,
  type TypeJour,
} from '../lib/cycle-calcul';
import { aujourdhui, dateLongue, dateDe } from '../lib/format';

const installee = baseConfiguree();
const moi = installee ? await visiteuse(Astro) : null;

if (moi && !moi.questionnaireFini) {
  return Astro.redirect('/bienvenue', 302);
}

// Celle qui arrive sans session voit d'abord l'écran d'ouverture (section 1
// du cahier d'Arthur). Il ne s'affiche donc qu'une fois : dès qu'elle a
// touché « Commencer », elle a une session et ne repasse plus par là.
if (installee && !moi) {
  return Astro.redirect('/ouverture', 302);
}

const hui = aujourdhui();
const panier = comptePanier(lirePanier(Astro));

// --- Le catalogue ----------------------------------------------------------
let produits: any[] = [];
if (installee) {
  const { data } = await clientPublic(Astro)
    .from('produits')
    .select('slug, nom, prix_cfa, rayon, image, etiquette, stock')
    .eq('publie', true)
    .order('ordre')
    .limit(4);
  produits = data ?? [];
}

// --- Son cycle -------------------------------------------------------------
let reglages: ReglagesCycle | null = null;
let aDesDonnees = false;
let infoAujourdhui: ReturnType<typeof infoDuJour> | null = null;
let prochaines: string | null = null;
let confirmes = new Set<string>();
let noteDuJour = false;

if (moi) {
  const client = clientSession(Astro)!;
  const { data: cyclesBase } = await client
    .from('cycles')
    .select('debut, fin')
    .order('debut', { ascending: false })
    .limit(12);

  const debuts = (cyclesBase ?? []).map((c: { debut: string }) => c.debut);
  aDesDonnees = debuts.length > 0;

  if (aDesDonnees) {
    reglages = {
      debuts,
      dureeRegles: moi.dureeRegles,
      dureeCycle: moyenneCycles(debuts) ?? moi.cycleMoyen,
    };

    for (const c of cyclesBase ?? []) {
      const fin = (c as { fin: string | null }).fin ?? c.debut;
      for (let d = c.debut; d <= fin; d = plusDeJours(d, 1)) confirmes.add(d);
    }

    const { data: notes } = await client
      .from('journal')
      .select('jour, flux')
      .gte('jour', plusDeJours(hui, -21))
      .lte('jour', hui);
    // A-t-elle déjà noté aujourd'hui ? Le bouton de la carte le dit, pour ne
    // pas lui demander de refaire ce qu'elle vient de faire.
    noteDuJour = (notes ?? []).some((n: { jour: string }) => n.jour === hui);
    for (const n of (notes ?? []) as { jour: string; flux: string }[]) {
      if (n.flux !== 'rien') confirmes.add(n.jour);
    }

    infoAujourdhui = infoDuJour(hui, reglages, confirmes, hui);
    prochaines = prochainesRegles(reglages, hui);
  }
}

// --- La bande des jours : quatorze jours à partir du lundi de cette semaine -
const lundi = plusDeJours(hui, -(((dateDe(hui).getDay() + 6) % 7)));
const JOURS_COURTS = ['Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam', 'Dim'];

const semaine = Array.from({ length: 14 }, (_, i) => {
  const iso = plusDeJours(lundi, i);
  const info = reglages ? infoDuJour(iso, reglages, confirmes, hui) : null;
  const d = dateDe(iso);
  return {
    iso,
    nom: JOURS_COURTS[(d.getDay() + 6) % 7],
    numero: d.getDate(),
    type: (info?.type ?? 'faible') as TypeJour,
    jourDuCycle: info?.jourDuCycle ?? 0,
    aujourdhui: iso === hui,
  };
});

const demande = Astro.url.searchParams.get('jour') ?? '';
const choisi = semaine.find((j) => j.iso === demande) ?? semaine.find((j) => j.aujourdhui) ?? semaine[0];

const DIT: Record<TypeJour, { quoi: string; sous: string; marque: string }> = {
  regles: { quoi: 'Jour de règles', sous: 'Risque de grossesse faible', marque: 'marque-regles' },
  fertile: { quoi: 'Jour fertile', sous: 'Risque de grossesse élevé', marque: 'marque-fertile' },
  ovulation: { quoi: 'Ovulation estimée', sous: 'Risque de grossesse très élevé', marque: 'marque-fertile' },
  faible: { quoi: 'Risque plus faible', sous: `Jour ${choisi?.jourDuCycle ?? 0} du cycle`, marque: 'marque-faible' },
};

// --- La carte vedette, dont la couleur suit la phase ------------------------
// La phase se dit avec les mots de `cycle.ts`. Un jour « faible » est soit
// l'élan d'avant l'ovulation, soit le ralenti d'après : c'est la place du jour
// dans le cycle qui tranche, pas son type.
let nomPhase: keyof typeof PHASES | null = null;
if (infoAujourdhui) {
  if (infoAujourdhui.type === 'regles') nomPhase = 'regles';
  else if (infoAujourdhui.type === 'fertile' || infoAujourdhui.type === 'ovulation') nomPhase = 'fertile';
  else nomPhase = infoAujourdhui.jourDuCycle > jourOvulation(reglages!.dureeCycle) ? 'lune' : 'elan';
}
const phase = nomPhase ? PHASES[nomPhase] : null;
const joursAvant = prochaines ? ecartEnJours(prochaines, hui) : 0;

let carteClasse = 'carte-elan';
let carteTitre = '';
let carteSous = '';

if (infoAujourdhui) {
  if (infoAujourdhui.type === 'regles') {
    carteClasse = 'carte-regles';
    carteTitre = `Jour ${infoAujourdhui.jourDuCycle}\nde tes règles`;
    carteSous = "Repose-toi, bois beaucoup d'eau";
  } else if (infoAujourdhui.type === 'ovulation') {
    carteClasse = 'carte-fertile';
    carteTitre = "Ovulation\naujourd'hui";
    carteSous = 'Risque de grossesse très élevé';
  } else if (infoAujourdhui.type === 'fertile') {
    carteClasse = 'carte-fertile';
    carteTitre = 'Période\nfertile';
    carteSous = 'Risque de grossesse élevé ces jours-ci';
  } else {
    carteClasse = nomPhase === 'lune' ? 'carte-lune' : 'carte-elan';
    carteTitre = joursAvant === 1 ? 'Tes règles\ndemain' : `Tes règles\ndans ${joursAvant} jours`;
    carteSous =
      joursAvant <= 5
        ? 'Pense à commander tes serviettes maintenant'
        : `Jour ${infoAujourdhui.jourDuCycle} de ton cycle`;
  }
}

const PROMESSES = [
  'Livraison discrète',
  'Paiement à la livraison',
  'Colis neutre',
  'Conseils vérifiés',
  'Ouagadougou et environs',
];

/** Trois conseils par phase, dits comme une grande sœur les dirait. Le
 * premier vient de `cycle.ts` pour ne pas répéter deux vérités différentes. */
const CONSEILS: Record<string, { icone: string; titre: string; texte: string }[]> = {
  regles: [
    { icone: 'goutte', titre: 'Change souvent', texte: 'Toutes les 4 à 6 heures, même si le flux est léger.' },
    { icone: 'soleil', titre: 'Chaleur sur le ventre', texte: "Une bouteille d'eau chaude enveloppée dans un pagne calme les crampes." },
    { icone: 'coeur', titre: 'Mange du fer', texte: 'Haricots, foie, feuilles vertes : tu en perds un peu ces jours-ci.' },
  ],
  elan: [
    { icone: 'pousse', titre: "C'est ta bonne semaine", texte: 'Place ici ce qui demande de la force : examens, sport, grosses journées.' },
    { icone: 'soleil', titre: 'Bois beaucoup', texte: "Avec la chaleur de Ouaga, deux litres d'eau ne sont pas de trop." },
    { icone: 'paquet', titre: 'Fais ton stock', texte: 'Commande tes protections maintenant, pas la veille.' },
  ],
  fertile: [
    { icone: 'info', titre: 'Risque élevé', texte: "C'est la semaine où une grossesse est possible." },
    { icone: 'bouclier', titre: 'Contraception', texte: "Si tu n'en veux pas maintenant, c'est là qu'il faut être la plus attentive." },
    { icone: 'goutte', titre: 'Pertes plus claires', texte: "Plus liquides et élastiques : c'est le signe, et c'est normal." },
  ],
  lune: [
    { icone: 'lune', titre: 'Dors un peu plus', texte: 'Ton corps travaille plus pour le même effort.' },
    { icone: 'coeur', titre: "L'humeur bouge", texte: 'Seins sensibles, envie de sucré : ça vient des hormones, et ça passe.' },
    { icone: 'camion', titre: 'Tes règles arrivent', texte: 'Garde une protection dans ton sac dès maintenant.' },
  ],
};

const conseilsPhase = nomPhase ? CONSEILS[nomPhase] : [];

// --- La bannière du médecin -------------------------------------------------
// Trois messages, une seule personne. Aucun ne promet un délai de réponse,
// aucun ne dit « docteur X » : Arthur n'a pas encore son médecin, et écrire un
// nom ou un « réponse en 24 h » qui n'existe pas, sur une application de
// santé, c'est exactement ce qu'il ne faut pas faire.
const BANNIERES = [
  {
    titre: 'Parle à un médecin',
    sous: "Une douleur, un retard, une question que tu n'oses poser à personne. Écris, c'est lu.",
    bouton: 'Écrire au médecin',
    ton: 'banniere-rose',
    pose: 0,
  },
  {
    titre: 'Pas sûre que ce soit normal ?',
    sous: 'Demande avant de t’inquiéter toute seule, ou avant de faire la route jusqu’au centre de santé.',
    bouton: 'Poser ma question',
    ton: 'banniere-encre',
    pose: 1,
  },
  {
    titre: 'Ce que tu écris reste entre vous',
    sous: 'Le médecin voit ta question et ton prénom. Jamais ton calendrier, jamais ton journal.',
    bouton: 'Commencer',
    ton: 'banniere-lilas',
    pose: 2,
  },
];

// Les photos du médecin. Une par message, et la même femme sur toutes :
// Arthur veut plusieurs images qui défilent, pas une seule répétée.
//
// On regarde si le fichier existe vraiment, au lieu d'écrire son adresse en
// dur : une image manquante laisserait une icône cassée en plein milieu de
// l'accueil, et c'est l'application qui aurait l'air abîmée. Tant qu'une pose
// n'est pas livrée, son message reprend la photo précédente, et la bannière
// reste entière.
const POSES = ['medecin-detoure', 'medecin-pose2-detoure', 'medecin-pose3-detoure'];
const dossierPublic = new URL('../../public', import.meta.url);
const existe = (chemin: string) => fsExiste(new URL(`.${chemin}`, `${dossierPublic}/`));

const photos = POSES.map((nom) => {
  const petite = `/accueil/${nom}-600.webp`;
  const grande = `/accueil/${nom}-1200.webp`;
  if (!existe(petite)) return null;
  return { src: petite, jeu: existe(grande) ? `${petite} 600w, ${grande} 1200w` : undefined };
}).filter((p): p is { src: string; jeu: string | undefined } => p !== null);

/** La photo du message numéro `i`, ou la dernière livrée si celle-là manque. */
const photoDe = (i: number) => photos[i] ?? photos[photos.length - 1] ?? null;
const photoMedecin = photos.length > 0;

const MOIS_COURTS = ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'];
const dateDuJour = `${dateDe(hui).getDate()} ${MOIS_COURTS[dateDe(hui).getMonth()]}`;
---

<Base titre="Mousso Dambé" nav={moi ? 'accueil' : null} panier={panier} pleinEcran={!moi} prenom={moi?.prenom ?? ''}>
  <DefsCycle />

  {
    !installee && (
      <main class="page">
        <div class="espace" />
        <Alerte
          type="attention"
          texte="L'application n'est pas encore branchée à sa base de données. Les deux clés Supabase manquent dans le fichier .env."
        />
      </main>
    )
  }


  {
    moi && (
      <main class="accueil">
        {/* --- L'en-tête --- */}
        <header class="acc-entete acc-marges">
          <a class="acc-avatar-bouton" href="/compte" aria-label="Mon compte">
            <Avatar
              graine={moi.avatarGraine}
              prenom={moi.prenom}
              identifiant={moi.id}
              taille={48}
              morph
            />
          </a>
          <div class="acc-bonjour">
            <b>Bonjour, {moi.prenom || 'toi'}</b>
            <span>Aujourd'hui, {dateDuJour}</span>
          </div>
          <a class="acc-rond" href="/boutique" aria-label="Chercher un produit">
            <Icone nom="recherche" taille={22} epaisseur={2} />
          </a>
        </header>

        {/* --- La carte du cycle : elle ne défile pas.
             C'est l'information pour laquelle elle a ouvert l'application.
             Une information qui part toute seule au bout de quatre secondes
             n'est plus une information, c'est une publicité. --- */}
        <section class="acc-vedettes acc-vedette-seule" aria-label="À retenir aujourd'hui">
          {
            aDesDonnees ? (
              <article class:list={['acc-carte', carteClasse]}>
                <ObjetsCarte nom="cycle" />
                <div class="acc-carte-texte">
                  <h2 class="acc-carte-titre">{carteTitre}</h2>
                  <p class="acc-carte-sous">{carteSous}</p>
                </div>
                {/* Le cahier d'Arthur proposait ici « +120 femmes de la
                    communauté sont dans la même phase que toi », OU un petit
                    bouton d'action. On prend la seconde option, et voici
                    pourquoi : ce chiffre n'existe pas. L'application n'a pas
                    120 utilisatrices et ne compte la phase de personne.
                    L'écrire serait afficher un faux sur une application de
                    santé, là où la confiance est tout ce qu'on a. Le jour où
                    il y aura du monde, ce compte sera vrai, et il reviendra. */}
                <div class="acc-carte-pied">
                  <a class="acc-bouton-pilule" href="/journal">
                    {noteDuJour ? 'Modifier ma journée' : 'Noter ma journée'}
                    <Icone nom="avant" taille={16} epaisseur={2.4} />
                  </a>
                </div>
              </article>
            ) : (
              <article class="acc-carte carte-elan">
                <ObjetsCarte nom="cycle" />
                <div class="acc-carte-texte">
                  <h2 class="acc-carte-titre">On ne connaît pas encore ton cycle</h2>
                  <p class="acc-carte-sous">Dis-moi quand tes dernières règles ont commencé.</p>
                </div>
                <div class="acc-carte-pied">
                  <a class="acc-bouton-pilule" href="/cycle">
                    Déclarer mes règles
                    <Icone nom="avant" taille={16} epaisseur={2.4} />
                  </a>
                </div>
              </article>
            )
          }

        </section>

        {/* --- LA BANNIÈRE DU MÉDECIN.
             Demande d'Arthur du 12 octobre 2026 au soir : les images qui
             défilent doivent montrer qu'on peut contacter directement un
             médecin pour avoir un conseil. Un seul médecin, donc la MÊME
             personne sur les trois messages.

             La photo est illustrative, et elle est traitée comme telle :
             aucun nom, aucune spécialité, aucun hôpital ne lui est attribué.
             Tant qu'Arthur n'a pas son médecin, l'écran dit ce qui est vrai
             (on peut écrire, et quelqu'un lira) et rien de plus. --- */}
        <section class="acc-bannieres" id="vedettes" aria-label="Parler à un médecin">
          {
            BANNIERES.map((b) => (
              <article class:list={['banniere', b.ton]}>
                <div class="banniere-mots">
                  <h2>{b.titre}</h2>
                  <p>{b.sous}</p>
                  <a class="banniere-bouton" href="/discussions/medecin">
                    {b.bouton}
                    <Icone nom="avant" taille={15} epaisseur={2.6} />
                  </a>
                </div>

                <div class="banniere-visage">
                  {
                    photoDe(b.pose) ? (
                      <img
                        src={photoDe(b.pose)!.src}
                        srcset={photoDe(b.pose)!.jeu}
                        sizes="180px"
                        alt=""
                        width="180"
                        height="200"
                        loading={b.pose === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                      />
                    ) : (
                      // Tant qu'aucune photo n'est déposée, on ne laisse pas
                      // un trou : la mascotte tient la place, et l'écran reste
                      // entier.
                      <Mascotte etat="ecoute" taille={160} titre={null} />
                    )
                  }
                </div>
              </article>
            ))
          }
        </section>

        <div class="acc-points" id="points" aria-hidden="true">
          <i class="actif"></i><i></i><i></i>
        </div>

        {
          photoMedecin && (
            // La licence Pexels interdit de laisser croire que la personne
            // photographiée recommande le produit. Cette ligne est donc
            // obligatoire, pas décorative : elle dit que c'est une photo
            // d'illustration, et non le médecin qui répondra.
            <p class="acc-mention-photo">Photo d'illustration</p>
          )
        }

        {/* --- La bande des jours --- */}
        <section class="acc-semaine" aria-label="Les jours à venir">
          {
            semaine.slice(0, 7).map((j) => (
              <a
                class:list={['acc-capsule', j.aujourdhui && 'aujourdhui', !j.aujourdhui && j.iso === choisi?.iso && 'choisie']}
                href={`/?jour=${j.iso}`}
                aria-label={`${dateLongue(j.iso)}, ${DIT[j.type].quoi}`}
              >
                <span class="acc-capsule-marque">
                  {
                    j.type === 'regles' ? (
                      <GoutteJour largeur={9} hauteur={11} />
                    ) : j.type === 'ovulation' ? (
                      <BebeJour taille={13} ovulation />
                    ) : j.type === 'fertile' ? (
                      <BebeJour taille={13} />
                    ) : (
                      <span class="acc-capsule-point"></span>
                    )
                  }
                </span>
                <span class="acc-capsule-nom">{j.nom}</span>
                <span class="acc-capsule-num">{j.numero}</span>
              </a>
            ))
          }
        </section>

        {
          choisi && aDesDonnees && (
            <div class="acc-jour-dit">
              <span class:list={['acc-jour-marque', DIT[choisi.type].marque]}>
                {
                  choisi.type === 'regles' ? (
                    <GoutteJour largeur={18} hauteur={22} />
                  ) : choisi.type === 'faible' ? (
                    <span class="acc-capsule-point"></span>
                  ) : (
                    <BebeJour taille={26} ovulation={choisi.type === 'ovulation'} />
                  )
                }
              </span>
              <span>
                <b>{choisi.aujourdhui ? "Aujourd'hui" : dateLongue(choisi.iso)}</b> · {DIT[choisi.type].quoi}
                <br />
                <span class="acc-jour-gris">{DIT[choisi.type].sous}</span>
              </span>
            </div>
          )
        }

        {/* --- La bande défilante des promesses --- */}
        <div class="acc-ruban" aria-hidden="true">
          <div class="acc-ruban-piste">
            {[0, 1].map(() => (
              <span class="acc-ruban-lot">
                {PROMESSES.map((t) => (
                  <>
                    <b>{t}</b>
                    <i>•</i>
                  </>
                ))}
              </span>
            ))}
          </div>
        </div>
        <p class="lecture-seule">Livraison discrète à Ouagadougou, paiement à la livraison, conseils vérifiés.</p>

        {/* --- Sous la bande : les sections de la section 10 --- */}
        <div class="page suite-accueil">
          <div class="deux-boutons">
            <a class="btn btn-rose sans-retour" href="/journal">Noter aujourd'hui</a>
            <a class="btn btn-contour" href="/cycle/calendrier">Mon calendrier</a>
          </div>

          {
            phase && (
              <section class="phase-bloc" aria-label="Conseils pour ta phase">
                <div class="section-titre">
                  <h2>Conseils pour ta phase</h2>
                  <span class="etiquette-phase">{phase.nom}</span>
                </div>
                <div class="rail-conseils">
                  {conseilsPhase.map((c, i) => (
                    <article class:list={['conseil-carte', `conseil-${i % 3}`]}>
                      <span class="conseil-icone"><Icone nom={c.icone} taille={20} /></span>
                      <h3>{c.titre}</h3>
                      <p>{c.texte}</p>
                    </article>
                  ))}
                </div>
              </section>
            )
          }

          {produits.length > 0 && (
            <section>
              <div class="section-titre">
                <h2>Pour tes règles</h2>
                <a href="/boutique">Tout voir</a>
              </div>
              <div class="grille-produits">
                {produits.map((p, i) => (
                  <div data-revele class:list={['monte', `retard-${i % 4}`]}>
                    <CarteProduit
                      slug={p.slug}
                      nom={p.nom}
                      prixCfa={p.prix_cfa}
                      rayon={p.rayon}
                      image={p.image}
                      etiquette={p.etiquette}
                      stock={p.stock}
                    />
                  </div>
                ))}
              </div>
            </section>
          )}

          <div class="espace"></div>
        </div>
      </main>
    )
  }
</Base>

<script>
  import '../scripts/accueil';
</script>

<style>
  /* --- Sous la bande des jours --- */
  .suite-accueil {
    padding-top: var(--e5);
  }

  .deux-boutons {
    display: flex;
    gap: var(--e2);
    margin-bottom: var(--e4);
  }

  .deux-boutons > * {
    flex: 1;
  }

  .sans-retour {
    flex: 1.25;
    white-space: nowrap;
    padding: 0 var(--e2);
  }


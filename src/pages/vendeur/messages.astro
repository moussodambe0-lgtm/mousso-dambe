---
/**
 * LA BOÎTE DE RÉCEPTION, VUE DE L'ESPACE VENDEUR.
 *
 * Copie de `src/pages/vendeur/messages.astro` de Jia, le 5 novembre 2026.
 * Arthur, le même jour : « tu copies tout, tu copies absolument tout, même les
 * couleurs ».
 *
 * CE QUI EST REPRIS TEL QUEL : le gabarit vendeur avec son onglet « Messages »,
 * le sous-titre qui compte les non-lus à côté du titre de la page, l'état vide
 * avec son icône de bulle en gris tertiaire, et la liste de la messagerie de
 * Jia (fond blanc d'un bord à l'autre, lignes séparées par `--filet-liste`,
 * une `LigneConversation` par fil). Le commentaire d'ouverture de Jia disait
 * l'essentiel et reste vrai ici : « répondre vite compte : un acheteur qui
 * attend une réponse achète souvent ailleurs dans l'heure ».
 *
 * CETTE PAGE AVAIT DISPARU, et la voici revenue. Elle ne contenait plus qu'une
 * redirection 301 vers `/admin`, posée le 5 novembre 2026 au motif qu'il n'y a
 * pas de vendeur tiers ici et donc pas deux boîtes à tenir. Le motif était bon
 * mais la conclusion mauvaise : ce ne sont pas deux boîtes, c'est UNE boîte et
 * DEUX métiers. Le vendeur ouvre cette page pour répondre à ses clientes ;
 * l'administration ouvre `/admin/conversations` pour chercher dans tout ce qui
 * s'est dit. Chez Jia les deux existent, et c'est ce que nous copions.
 *
 * ELLE MONTRE LES DEUX SUJETS, boutique et médecin, sans filtre. Le compteur de
 * la barre basse (`NavVendeur`, nourri par le gabarit) additionne les deux : si
 * cette page en cachait la moitié, la pastille annoncerait des messages
 * introuvables. Le tri par sujet est sur la page de l'administration, qui est
 * celle où l'on cherche.
 *
 * CE QUE JIA A ET QUE NOUS N'AVONS PAS : le bouton « tout marquer comme lu ».
 * Jia a `tout_marquer_lu(p_cote)` en base ; ici `marquer_lu` prend un fil et un
 * seul. Le bouton existerait sans rien faire.
 *
 * La porte est `exigerGestion()`, qui ne laisse entrer qu'une ligne de la table
 * `administrateurs`. Aucun écran de gestion ne lit le cycle d'une cliente, ni
 * son journal, ni ses questions à IA Dambé : règle du 12 octobre 2026, tenue
 * par la base elle-même, pas seulement par cette page.
 */
import Vendeur from '../../layouts/Vendeur.astro';
import Icone from '../../components/IconeJia.astro';
import LigneConversation, { type LigneFil } from '../../components/LigneConversation.astro';
import { exigerGestion } from '../../lib/gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

const { data: boite, error } = await sb.rpc('boite_de_reception', {
  p_recherche: null,
  p_sujet: null,
});
if (error) console.error('boite_de_reception', error.message);

const fils = ((boite as any)?.fils ?? []) as LigneFil[];
const nonLus = Number((boite as any)?.non_lus ?? 0);
---

<Vendeur
  titre="Messages clientes"
  onglet="messages"
  sb={sb}
  sousTitre={nonLus > 0 ? `${nonLus} non lu${nonLus > 1 ? 's' : ''}` : undefined}
>
  {
    fils.length === 0 ? (
      <div class="etat-vide">
        <Icone name="message" size={34} class="icone-vide" />
        <div class="titre">Aucun message pour l'instant</div>
        <p class="texte">
          Les questions des clientes sur tes produits arrivent ici. Réponds vite : ça compte dans tes ventes.
        </p>
      </div>
    ) : (
      <ul class="liste-conversations">
        {fils.map((f) => (
          <li>
            <LigneConversation fil={f} />
          </li>
        ))}
      </ul>
    )
  }
</Vendeur>

<style>
  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }

  /* La liste de la messagerie de Jia : pas de carte, pas de rayon, le blanc va
     d'un bord a l'autre et un filet separe deux conversations. C'est ce qui
     permet de la parcourir au pouce sans compter les cartes. */
  .liste-conversations { list-style: none; margin: 8px 0 0; padding: 0; background: var(--surface); }
  .liste-conversations li + li { border-top: 1px solid var(--filet-liste); }
</style>

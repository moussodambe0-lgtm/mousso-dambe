---
/**
 * Le gabarit de l'espace vendeur, copié de `layouts/Vendeur.astro` de Jia.
 *
 * Arthur, le 5 novembre 2026 : « va, tu pars dans Jia, la manière que l'espace
 * vendeur, la présentation de l'espace vendeur, tu copies la même chose, tout,
 * tout ce que tu vas voir là-bas, tu copies, tu viens mettre [...] même les
 * couleurs ».
 *
 * CE QUI EST REPRIS TEL QUEL : l'en-tête collant avec sa pastille à gauche et
 * le titre de la page, la barre basse avec sa bulle qui glisse, et toute la
 * feuille de style de Jia (orange, noir, blanc, rouge ; Outfit pour les
 * titres, Karla pour le texte). Les onglets portent les mêmes mots, dans le
 * même ordre : Résumé, Commandes, Produits, Messages.
 *
 * LES TROIS SEULES CHOSES QUE JE N'AI PAS COPIÉES, et pourquoi :
 *
 *   1. La pastille en haut à gauche dit « Administration » et non « Quitter ».
 *      Chez Jia, « Quitter » ramène le vendeur sur son compte d'acheteur, dans
 *      la même application. Ici les deux mondes sont sur deux adresses
 *      différentes, et Arthur avait justement demandé qu'on retire ce lien le
 *      5 novembre 2026 : « quand je suis dans admin je vois en haut à gauche
 *      Quitter, non enlève ça », après s'être perdu (« j'ai cru que c'était
 *      2 pages différentes »). La pastille garde sa place, sa forme et son
 *      chevron ; seuls le mot et la destination changent.
 *
 *   2. Les bandeaux « boutique en vérification », « boutique suspendue » et
 *      « vue administrateur » ne sont pas repris. Ils annoncent qu'un tiers
 *      juge la boutique ou qu'on regarde celle de quelqu'un d'autre. Mousso
 *      Dambé est la seule boutique et personne ne la juge : ces bandeaux ne
 *      pourraient jamais s'allumer.
 *
 *   3. L'onglet « Ma boutique » et le bandeau rouge qui y menait. Arthur, le
 *      5 novembre 2026, après avoir vu la copie : « laisse tomber le menu Ma
 *      boutique dans espace vendeur ». Le bandeau annonçait ce qui manquait à
 *      la vitrine et menait à cette page ; sans page, il n'avait plus de
 *      destination. `src/lib/vitrine.ts` et les fonctions `boutique_vitrine()`
 *      et `enregistrer_vitrine()` restent en place, prêtes, et rien ne les
 *      affiche pour l'instant.
 */
import type { SupabaseClient } from '@supabase/supabase-js';
import BaseGestion from './BaseGestion.astro';
import Icone from '../components/IconeJia.astro';
import NavVendeur, { type OngletVendeur } from '../components/NavVendeur.astro';

interface Props {
  titre: string;
  onglet: OngletVendeur;
  sb: SupabaseClient;
  /** Sous-titre sous le nom de la page. */
  sousTitre?: string;
  /** Réserve la place d'une barre d'action collante au-dessus de la navigation. */
  avecBarreAction?: boolean;
}

const { titre, onglet, sb, sousTitre, avecBarreAction = false } = Astro.props;

// Les compteurs de la navigation, visibles depuis toutes les pages. Chez Jia
// ce sont deux requêtes ; ici deux fonctions, pour la même raison : la barre
// doit dire la vérité sur chaque écran, pas seulement sur celui qui l'a
// calculée.
const [tableau, boite] = await Promise.all([
  sb.rpc('tableau_de_bord_vendeur'),
  sb.rpc('boite_de_reception', { p_recherche: null, p_sujet: null }),
]);
const aExpedier = Number((tableau.data as any)?.a_expedier ?? 0);
const messagesNonLus = Number((boite.data as any)?.non_lus ?? 0);
---

<BaseGestion
  titre={`${titre} · Espace vendeur`}
  description="Espace vendeur de Mousso Dambé."
  avecBarreAction={avecBarreAction}
>
  {/* En-tête compact, celui de Jia : la sortie et le titre de la page, rien de
      plus. Le nom de la boutique n'y figure pas, on le connaît. */}
  <header class="entete-vendeur">
    <a href="/admin" class="sortie reagit">
      <Icone name="chevron-left" size={19} stroke={2} />
      <span>Administration</span>
    </a>
    <div class="titres">
      <h1>{titre}</h1>
      {sousTitre && <div class="sous">{sousTitre}</div>}
    </div>
  </header>

  <slot />

  <NavVendeur actif={onglet} aExpedier={aExpedier} messages={messagesNonLus} />
</BaseGestion>

<style>
  .entete-vendeur {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
    border-bottom: 1px solid var(--bordure);
    padding: 11px var(--gouttiere);
  }
  .sortie {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    flex: 0 0 auto;
    padding: 6px 11px 6px 7px;
    border: 1px solid var(--bordure);
    border-radius: var(--r-pilule);
    background: var(--surface-douce);
    color: var(--texte-secondaire);
    font-size: 14px;
    font-weight: 700;
  }
  .sortie:hover { color: var(--encre); border-color: var(--texte-tertiaire); }

  .titres { flex: 1; min-width: 0; }
  .titres h1 { font-size: 17px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sous { font-size: 13px; color: var(--texte-secondaire); margin-top: 2px; }
</style>

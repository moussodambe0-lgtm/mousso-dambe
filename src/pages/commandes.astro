---
/**
 * Mes commandes : un aiguillage, plus une liste.
 *
 * Arthur, le 26 octobre 2026 : « chacune de ces étapes doit mener sur une page
 * précise distincte des autres ». Les commandes vivent donc dans quatre pages
 * (`/commandes/en-preparation`, `en-livraison`, `livrees`, `annulees`), et
 * cette adresse-ci n'affiche plus rien d'elle-même.
 *
 * Elle reste, parce que des liens pointent dessus (l'écran de confirmation, la
 * barre de navigation, et tout ce qu'une femme a pu mettre en favori). Elle
 * envoie vers l'onglet le plus utile : celui où se trouve quelque chose à
 * suivre, en commençant par les colis en route, puis ce qui se prépare. Faute
 * de quoi, le premier onglet.
 *
 * La page précédente faisait 230 lignes avec sa propre liste et son propre
 * style ; tout cela vit maintenant dans `[etat].astro`, en un seul endroit.
 */
import { clientSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { ETATS_CLIENTE } from '../lib/etats-commande';
import { sansCompte } from '../lib/porte';

export const prerender = false;

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return sansCompte(Astro);

const client = clientSession(Astro)!;
const { data: brutes } = await client.rpc('mes_commandes');
const commandes = (brutes ?? []) as { etat: string }[];

const aQuelqueChose = (cles: string[]) => commandes.some((c) => cles.includes(c.etat));

// L'ordre de priorité : ce qui est en route d'abord, c'est ce qu'on vient
// regarder ; puis ce qui se prépare ; puis l'historique.
const ORDRE = ['en-livraison', 'en-preparation', 'livrees', 'annulees'];
const premierUtile =
  ORDRE.map((cle) => ETATS_CLIENTE.find((e) => e.cle === cle))
    .find((e) => e && aQuelqueChose(e.etats))?.cle ?? ETATS_CLIENTE[0].cle;

return Astro.redirect(`/commandes/${premierUtile}`, 302);
---

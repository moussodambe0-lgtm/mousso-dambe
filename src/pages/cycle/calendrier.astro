---
/**
 * LE CALENDRIER.
 *
 * Reprise du code de référence d'Arthur du 12 octobre 2026 : mêmes couleurs,
 * mêmes icônes, même logique. Trois différences de fond, et leur raison :
 *
 *   1. Le mois est construit SUR LE SERVEUR. Le calendrier s'affiche donc
 *      même sans JavaScript, et changer de mois est un simple lien. Sur une
 *      3G de Ouagadougou, une page qui arrive vaut mieux qu'un calendrier qui
 *      attend un script.
 *   2. La fiche d'un jour s'ouvre par un lien `?jour=…`, et un petit script
 *      l'ouvre sans recharger quand JavaScript est là. Les deux chemins
 *      donnent le même écran.
 *   3. Les règles réellement déclarées priment sur la projection : un mois
 *      passé montre ce qui a été vécu, pas ce qu'un modulo aurait prédit.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import DefsCycle from '../../components/DefsCycle.astro';
import GoutteJour from '../../components/GoutteJour.astro';
import BebeJour from '../../components/BebeJour.astro';
import VuesCycle from '../../components/VuesCycle.astro';
import Alerte from '../../components/Alerte.astro';
import '../../styles/calendrier.css';
import { clientSession, baseConfiguree } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import {
  infoDuJour,
  prochainesRegles,
  prochaineOvulation,
  ecartEnJours,
  plusDeJours,
  type ReglagesCycle,
  type TypeJour,
} from '../../lib/cycle-calcul';
import { aujourdhui, dateLongue, dateCourte, moisEtAnnee, dateDe, enIso, messageErreur, enJours } from '../../lib/format';
import { sansCompte } from '../../lib/porte';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return sansCompte(Astro);

const client = clientSession(Astro)!;
let erreur = '';
let message = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const geste = String(f.get('geste') ?? '');
  const jour = String(f.get('jour') ?? '');

  if (geste === 'declarer') {
    const { data, error } = await client.rpc('declarer_regles', { p_debut: jour });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur);
    else return Astro.redirect('/cycle/calendrier?ok=declare', 303);
  } else if (geste === 'retirer') {
    const { data, error } = await client.rpc('retirer_regles', { p_debut: jour });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur);
    else return Astro.redirect('/cycle/calendrier?ok=retire', 303);
  }
}

if (Astro.url.searchParams.get('ok') === 'declare') {
  message = 'Tes règles sont notées, tes dates sont recalculées.';
}
if (Astro.url.searchParams.get('ok') === 'retire') {
  message = "C'est retiré de ton calendrier.";
}

const hui = aujourdhui();

// --- Ce qu'on sait d'elle --------------------------------------------------
const { data: cyclesBase } = await client
  .from('cycles')
  .select('debut, fin')
  .order('debut', { ascending: false })
  .limit(24);

const debuts = (cyclesBase ?? []).map((c: { debut: string }) => c.debut);
// La durée du cycle est celle du profil ; la moyenne observée n'est plus imposée.

const reglages: ReglagesCycle = {
  debuts,
  dureeRegles: moi.dureeRegles,
  dureeCycle: moi.cycleMoyen,
};

// --- Le mois affiché -------------------------------------------------------
const param = Astro.url.searchParams.get('mois') ?? '';
const base = /^\d{4}-\d{2}$/.test(param) ? dateDe(`${param}-01`) : dateDe(hui);
const premier = new Date(base.getFullYear(), base.getMonth(), 1);
const dernier = new Date(base.getFullYear(), base.getMonth() + 1, 0);
const clefMois = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
const moisAvant = clefMois(new Date(premier.getFullYear(), premier.getMonth() - 1, 1));
const moisApres = clefMois(new Date(premier.getFullYear(), premier.getMonth() + 1, 1));

// Les jours où elle a elle-même déclaré du sang, sur une fenêtre large pour
// couvrir aussi les cases des mois voisins affichées en bordure.
const { data: notes } = await client
  .from('journal')
  .select('jour, flux')
  .gte('jour', plusDeJours(enIso(premier), -7))
  .lte('jour', plusDeJours(enIso(dernier), 7));

const confirmes = new Set<string>();
for (const c of cyclesBase ?? []) {
  const fin = (c as { fin: string | null }).fin ?? c.debut;
  for (let d = c.debut; d <= fin; d = plusDeJours(d, 1)) confirmes.add(d);
}
for (const n of (notes ?? []) as { jour: string; flux: string }[]) {
  if (n.flux !== 'rien') confirmes.add(n.jour);
}

// --- La grille -------------------------------------------------------------
interface Case {
  iso: string;
  numero: number;
  type: TypeJour;
  prevu: boolean;
  jourDuCycle: number;
  risque: string;
  aujourdhui: boolean;
  passe: boolean;
  bande: string;
}

const decalage = (premier.getDay() + 6) % 7;
const cases: (Case | null)[] = Array.from({ length: decalage }, () => null);

for (let j = 1; j <= dernier.getDate(); j += 1) {
  const iso = enIso(new Date(premier.getFullYear(), premier.getMonth(), j));
  const info = infoDuJour(iso, reglages, confirmes, hui);
  cases.push({
    iso,
    numero: j,
    type: info.type,
    prevu: info.prevu,
    jourDuCycle: info.jourDuCycle,
    risque: info.risque,
    aujourdhui: iso === hui,
    passe: iso < hui,
    bande: '',
  });
}
while (cases.length % 7 !== 0) cases.push(null);

// La bande ROSE CLAIR relie les jours fertiles qui se suivent DANS LA MÊME
// RANGÉE : une bande qui sauterait d'une ligne à l'autre ne voudrait rien dire.
//
// Demande d'Arthur du 13 octobre 2026 : la couleur seulement sur la période
// fertile, le bébé seulement le jour de l'ovulation, le reste des dates
// ordinaire, sans rien de distinctif. Il avait dit « vert » ; le vert veut dire
// « risque plus faible » partout ailleurs dans l'application, le mettre sur les
// jours les plus risqués aurait inversé son sens. Il a choisi le lilas, puis
// demandé du rose clair à la place du violet : c'est la couleur de la
// fertilité, ici comme sur l'anneau de Mon cycle (`--fertile` dans tokens.css).
const fertileOuOvulation = (c: Case | null | undefined) =>
  !!c && (c.type === 'fertile' || c.type === 'ovulation');
for (let i = 0; i < cases.length; i += 1) {
  const c = cases[i];
  if (!c || !fertileOuOvulation(c)) continue;
  const colonne = i % 7;
  const gauche = colonne > 0 && fertileOuOvulation(cases[i - 1]);
  const droite = colonne < 6 && fertileOuOvulation(cases[i + 1]);
  c.bande = gauche && droite ? '' : gauche ? 'bande-fin' : droite ? 'bande-debut' : 'bande-seule';
}

// --- Le résumé -------------------------------------------------------------
const aDesDonnees = debuts.length > 0;
const prochaines = aDesDonnees ? prochainesRegles(reglages, hui) : null;
const ovulation = aDesDonnees ? prochaineOvulation(reglages, hui) : null;

// --- La fiche d'un jour ----------------------------------------------------
const jourDemande = Astro.url.searchParams.get('jour') ?? '';
const fiche =
  /^\d{4}-\d{2}-\d{2}$/.test(jourDemande) && aDesDonnees
    ? { iso: jourDemande, ...infoDuJour(jourDemande, reglages, confirmes, hui) }
    : null;

const TEXTES: Record<TypeJour, { nom: string; fond: string; texte: string; classe: string }> = {
  regles: {
    nom: 'Jour de règles',
    fond: 'fond-regles',
    classe: 'texte-regles',
    texte:
      "Ton corps élimine la muqueuse de l'utérus. Repose-toi, bois beaucoup d'eau, et mange des aliments riches en fer : feuilles de baobab, haricots, foie.",
  },
  fertile: {
    nom: 'Jour fertile',
    fond: 'fond-fertile',
    classe: 'texte-fertile',
    texte: "Tu es dans ta fenêtre fertile : un rapport sans protection peut entraîner une grossesse.",
  },
  ovulation: {
    nom: "Jour d'ovulation, estimé",
    fond: 'fond-fertile',
    classe: 'texte-fertile',
    texte:
      "C'est le jour où le risque de grossesse est le plus élevé. Tu peux sentir une légère douleur d'un côté du ventre.",
  },
  faible: {
    nom: 'Faible fertilité',
    fond: 'fond-faible',
    classe: 'texte-faible',
    texte:
      "Le risque de grossesse est plus faible ce jour-là, mais il n'est jamais nul. Ce calendrier n'est pas une contraception.",
  },
};

const panier = comptePanier(lirePanier(Astro));

function libelle(c: Case): string {
  const bouts = [dateLongue(c.iso)];
  if (c.type === 'regles') bouts.push(c.prevu ? 'règles prévues' : 'règles');
  else if (c.type === 'ovulation') bouts.push('ovulation probable');
  else if (c.type === 'fertile') bouts.push('jour fertile');
  if (c.aujourdhui) bouts.push("aujourd'hui");
  return bouts.join(', ');
}
---

<Base titre="Mon calendrier" nav="cycle" panier={panier} prenom={moi.prenom}>
  <DefsCycle />

  <main class="ecran-calendrier">
    <div class="page">
      {/* Les deux vues de « Mon cycle », les mêmes que sur le tableau de bord.
          Elles n'existaient pas ici : on arrivait sur le calendrier sans
          pouvoir revenir au tableau de bord (retour d'Arthur, 13 octobre
          2026). Le titre reste dans la page pour les lecteurs d'écran. */}
      <h1 class="lecture-seule">Mon calendrier</h1>
      <VuesCycle actif="calendrier" />

      {message && <div class="marge-bas"><Alerte type="reussite" texte={message} /></div>}
      {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

      {
        aDesDonnees && (
          <section class="cal-resume">
            <div class="cal-resume-carte">
              <GoutteJour doux largeur={26} hauteur={31} />
              <div>
                <div class="cal-resume-quoi">Prochaines règles</div>
                <div class="cal-resume-valeur">{dateCourte(prochaines!)}</div>
                <div class="cal-resume-quand rouge">{enJours(ecartEnJours(prochaines!, hui))}</div>
              </div>
            </div>
            <div class="cal-resume-carte">
              <BebeJour plat ovulation taille={34} />
              <div>
                <div class="cal-resume-quoi">Ovulation</div>
                <div class="cal-resume-valeur">{dateCourte(ovulation!)}</div>
                <div class="cal-resume-quand lilas">{enJours(ecartEnJours(ovulation!, hui))}</div>
              </div>
            </div>
          </section>
        )
      }

      <section class="cal-carte">
        <nav class="cal-mois" aria-label="Changer de mois">
          <a class="cal-fleche" href={`/cycle/calendrier?mois=${moisAvant}`} aria-label="Mois précédent">
            <Icone nom="retour" taille={20} epaisseur={2.6} />
          </a>
          <div class="cal-mois-titre">{moisEtAnnee(premier)}</div>
          <a class="cal-fleche" href={`/cycle/calendrier?mois=${moisApres}`} aria-label="Mois suivant">
            <Icone nom="avant" taille={20} epaisseur={2.6} />
          </a>
        </nav>

        <div class="cal-jours-noms" aria-hidden="true">
          <span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span>
        </div>

        <div class="cal-grille" id="grille" data-mois={clefMois(premier)}>
          {
            cases.map((c) =>
              !c ? (
                <span class="cal-vide"></span>
              ) : (
                <a
                  class:list={[
                    'cal-case',
                    `jour-${c.type === 'ovulation' ? 'fertile' : c.type}`,
                    c.aujourdhui && 'aujourdhui',
                    c.passe && 'passe',
                  ]}
                  href={`/cycle/calendrier?mois=${clefMois(premier)}&jour=${c.iso}`}
                  aria-label={libelle(c)}
                >
                  {
                    c.type === 'regles' ? (
                      <span class="cal-icone">
                        <GoutteJour doux numero={c.numero} prevue={c.prevu} />
                      </span>
                    ) : c.type === 'fertile' || c.type === 'ovulation' ? (
                      <>
                        <span class:list={['bande', 'bande-fertile', c.bande]}></span>
                        {c.type === 'ovulation' ? (
                          <span class="cal-icone">
                            <BebeJour plat ovulation />
                            <span class="cal-badge">{c.numero}</span>
                          </span>
                        ) : (
                          <span class="cal-num">{c.numero}</span>
                        )}
                      </>
                    ) : (
                      <>
                        {c.aujourdhui && <span class="cal-rond-plein"></span>}
                        <span class="cal-num">{c.numero}</span>
                      </>
                    )
                  }
                </a>
              )
            )
          }
        </div>

        <div class="cal-legende">
          <div><GoutteJour doux largeur={18} hauteur={22} /> Règles</div>
          <div><GoutteJour doux largeur={18} hauteur={22} prevue /> Règles prévues</div>
          <div><span class="cal-legende-bande"></span> Période fertile</div>
          <div><BebeJour plat taille={24} ovulation /> Ovulation</div>
        </div>
      </section>

      {/* La mention d'estimation (posée le 13 octobre 2026 d'après le prompt
          d'Arthur) a été retirée le même jour, à sa demande : « en bas du
          calendrier il y a ça, supprime ». */}

      {
        !aDesDonnees && (
          <section class="carte bloc marge-haut">
            <h2>On ne connaît pas encore ton cycle</h2>
            <p class="doux">
              Touche le jour où tes dernières règles ont commencé, et je te donne tes prochaines dates.
            </p>
          </section>
        )
      }

      <div class="espace"></div>
    </div>

    {
      fiche && (
        <>
          <a class="cal-voile" href={`/cycle/calendrier?mois=${clefMois(premier)}`} aria-label="Fermer"></a>
          <section class="cal-fiche" role="dialog" aria-modal="true" aria-label={dateLongue(fiche.iso)}>
            <div class="cal-poignee"></div>
            <div class="cal-fiche-haut">
              <div class:list={['cal-fiche-icone', TEXTES[fiche.type].fond]}>
                {
                  fiche.type === 'regles' ? (
                    <GoutteJour doux largeur={30} hauteur={36} prevue={fiche.prevu} />
                  ) : fiche.type === 'faible' ? (
                    <span class="pastille-neutre"></span>
                  ) : fiche.type === 'ovulation' ? (
                    <BebeJour plat ovulation taille={46} />
                  ) : (
                    <span class="pastille-fertile"></span>
                  )
                }
              </div>
              <div>
                <div class="cal-fiche-date">{dateLongue(fiche.iso)}</div>
                <div class:list={['cal-fiche-type', TEXTES[fiche.type].classe]}>
                  {TEXTES[fiche.type].nom}
                  {fiche.prevu ? ' · prévu' : ''} · jour {fiche.jourDuCycle} du cycle
                </div>
              </div>
            </div>

            {/* Le bloc « Risque de grossesse » (mot, jauge) et les phrases qui
                parlent du risque ont été retirés de la fiche le 13 octobre 2026,
                à la demande d'Arthur. Ne reste que ce qui n'est pas du risque : le
                conseil de soin d'un jour de règles. */}
            {fiche.type === 'regles' && <p class="cal-fiche-texte">{TEXTES[fiche.type].texte}</p>}

            {
              fiche.iso > hui ? (
                <button class="cal-bouton cal-bouton-pale" type="button" disabled>
                  On ne note pas un jour à venir
                </button>
              ) : confirmes.has(fiche.iso) ? (
                <form method="POST">
                  <input type="hidden" name="geste" value="retirer" />
                  <input type="hidden" name="jour" value={fiche.iso} />
                  <button class="cal-bouton cal-bouton-pale" type="submit">
                    Retirer mes règles de ce jour
                  </button>
                </form>
              ) : (
                <form method="POST">
                  <input type="hidden" name="geste" value="declarer" />
                  <input type="hidden" name="jour" value={fiche.iso} />
                  <button class="cal-bouton" type="submit">Mes règles ont commencé ce jour</button>
                </form>
              )
            }
          </section>
        </>
      )
    }
  </main>
</Base>

<style>
  .ecran-calendrier .page {
    padding-top: var(--e4);
  }

  .marge-bas {
    margin-bottom: var(--e3);
  }

  .marge-haut {
    margin-top: var(--e4);
  }

  .doux {
    margin-top: var(--e2);
    font-size: 15.5px;
    color: var(--texte-2);
    line-height: 1.5;
  }

  .pastille-neutre,
  .pastille-fertile {
    display: block;
    width: 26px;
    height: 26px;
    border-radius: 50%;
  }

  .pastille-neutre {
    background: #d9d1d6;
  }

  .pastille-fertile {
    background: var(--fertile);
  }
</style>

<script>
  import '../../scripts/calendrier';
</script>

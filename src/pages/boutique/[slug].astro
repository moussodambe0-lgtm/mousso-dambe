---
/**
 * La fiche d'un produit.
 *
 * Elle dit trois choses qu'une fille se demande vraiment avant d'acheter ici :
 * combien ça coûte livré, si le colis se voit, et combien de temps ça dure.
 * Le reste est du détail.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Alerte from '../../components/Alerte.astro';
import { clientPublic, clientSession, baseConfiguree, jetonDeSession } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import { enteteCatalogue } from '../../lib/cache';
import { prixLivraison } from '../../lib/boutique';
import { prix, dateLongue, messageErreur } from '../../lib/format';

const { slug } = Astro.params;

if (!baseConfiguree()) return Astro.redirect('/boutique', 302);

const { data: produit } = await clientPublic(Astro)
  .from('produits')
  .select('slug, nom, resume, description, prix_cfa, rayon, image, etiquette, stock, tailles, reutilisable')
  .eq('slug', slug ?? '')
  .eq('publie', true)
  .maybeSingle();

if (!produit) {
  return new Response(null, { status: 404 });
}

// Lu en base, par la seule valeur des réglages ouverte en lecture. Le reste
// de la table, dont l'empreinte de la clé du serveur, reste fermé.

// Relevé AVANT de lire la session : si le cookie était périmé, `visiteuse()`
// demande au navigateur de l'effacer, et une réponse qui pose un cookie ne doit
// jamais être gardée par un cache partagé.
const avaitUnCookie = !!jetonDeSession(Astro);
const moi = await visiteuse(Astro);
const panier = comptePanier(lirePanier(Astro));
const rupture = produit.stock <= 0;

// Le cœur : rouge si ce produit est déjà dans SES favoris. Lu avec sa session,
// donc seulement les siens (la base ferme la table aux autres).
let favori = false;
if (moi) {
  const client = clientSession(Astro);
  if (client) {
    const { data } = await client
      .from('favoris')
      .select('produit_slug')
      .eq('produit_slug', produit.slug)
      .maybeSingle();
    favori = !!data;
  }
}
const tailles: string[] = produit.tailles ?? [];
const erreur = Astro.url.searchParams.get('erreur');

// Retour de l'écran d'avis. Si une photo a été refusée, on le dit avec l'avis :
// il est bien enregistré, c'est seulement l'image qui n'est pas passée. Taire
// le refus la laisserait croire que sa photo est en ligne.
const avisDepose = Astro.url.searchParams.get('avis') === 'merci';
const photoRefusee = Astro.url.searchParams.get('photos');
const motAvis = !avisDepose
  ? ''
  : photoRefusee
    ? `Merci pour ton avis. ${messageErreur(photoRefusee)}`
    : 'Merci pour ton avis. Il est en ligne.';

// Le prix de la livraison, redemandé sur la fiche par Arthur le 26 octobre 2026
// (« si on clique sur un produit, je veux qu'on puisse mettre livraison 1000
// francs »). Il revient sur sa décision du 13 octobre, qui avait fait retirer
// trois encadrés d'un coup ; seule la livraison revient, pas les deux autres.
// La valeur est LUE, jamais écrite en dur : une fiche qui annonce 1 000 et une
// base qui en compte 1 500 au moment de payer, c'est un colis refusé à la porte.
const livraisonCfa = await prixLivraison(clientPublic(Astro));

// Les avis, et ce qu'ils valent ensemble. Ouverts à tout le monde, même sans
// compte : c'est ce qu'on vient lire avant d'acheter.
const { data: avisData } = await clientPublic(Astro).rpc('avis_du_produit', {
  p_slug: produit.slug,
  p_combien: 10,
});
const avis = {
  nombre: Number(avisData?.nombre ?? 0),
  moyenne: avisData?.moyenne == null ? null : Number(avisData.moyenne),
  liste: (avisData?.liste ?? []) as {
    id: string;
    note: number;
    texte: string | null;
    cree_le: string;
    photos: string[];
  }[],
};

const DESSINS: Record<string, string> = {
  serviettes: 'paquet',
  culottes: 'culotte',
  lavables: 'tissu',
  kits: 'trousse',
};

// Catalogue sans rien de personnel : le réseau peut le garder deux minutes.
// Le compteur du panier compte comme personnel : il est écrit dans la page, et
// un cache partagé le servirait à la visiteuse suivante (Cyber, 26 octobre
// 2026). La décision vit dans src/lib/cache.ts pour être testable.
Astro.response.headers.set(
  'Cache-Control',
  enteteCatalogue({ connectee: !!moi, avaitUnCookie, articlesAuPanier: panier })
);
---

<Base titre={produit.nom} description={produit.resume} nav="boutique" panier={panier}>
  <main>
    <div class:list={['visuel-haut', produit.rayon === 'culottes' && 'sombre', produit.rayon === 'lavables' && 'violet']}>
      {
        produit.image ? (
          <img
            src={produit.image}
            srcset={`${produit.image} 600w, ${produit.image.replace('-600.webp', '-1200.webp')} 1200w`}
            sizes="(max-width: 480px) 100vw, 480px"
            alt={produit.nom}
            width="600"
            height="600"
            fetchpriority="high"
          />
        ) : (
          <span class:list={['dessin', produit.rayon === 'culottes' && 'clair']}>
            <Icone nom={DESSINS[produit.rayon] ?? 'paquet'} taille={128} epaisseur={1.4} />
          </span>
        )
      }
      <div class="coins">
        <a class="rond" href="/boutique" aria-label="Retour à la boutique">
          <Icone nom="retour" taille={20} epaisseur={2} />
        </a>
        <a class="rond" href="/panier" aria-label={`Mon panier, ${panier} articles`}>
          <Icone nom="panier" taille={20} />
          {panier > 0 && <span class="nav-pastille">{panier}</span>}
        </a>
      </div>
    </div>

    <div class="page">
      <h1>{produit.nom}</h1>

      <div class="ligne-prix">
        <span class="chiffre grand-prix">{prix(produit.prix_cfa)}</span>
        <span class="unite">FCFA</span>
        <span class:list={['pastille', rupture ? 'pastille-neutre' : 'pastille-verte', 'pousse']}>
          {rupture ? 'Bientôt de retour' : 'En stock'}
        </span>
      </div>

      {/* La description longue a été retirée de la fiche le 13 octobre 2026, à
          la demande d'Arthur (« quand je clique pour commander un produit, je
          vois ce genre de texte, supprime »). Le texte reste en base. */}

      {erreur && <div class="marge"><Alerte type="erreur" texte={erreur === 'taille' ? 'Choisis ta taille avant de continuer.' : 'Ce produit ne peut pas être ajouté.'} /></div>}
      {motAvis && <div class="marge"><Alerte type="reussite" texte={motAvis} /></div>}

      <form method="POST" action="/panier">
        <input type="hidden" name="geste" value="ajouter" />
        <input type="hidden" name="slug" value={produit.slug} />

        {
          tailles.length > 0 && (
            <fieldset class="tailles">
              <legend class="libelle">Ta taille</legend>
              {tailles.map((t, i) => (
                <>
                  <input class="cache" type="radio" name="taille" id={`t-${t}`} value={t} checked={i === 1 || tailles.length === 1} required />
                  <label class="taille-label" for={`t-${t}`}>{t}</label>
                </>
              ))}
            </fieldset>
          )
        }

        {/* Les trois encadrés (livraison, emballage, réutilisable deux ans) ont
            été retirés le 13 octobre 2026. Seule la livraison revient, le
            26 octobre, et en une ligne plutôt qu'en encadré : c'est le chiffre
            qui manque pour savoir ce qu'on paiera vraiment, pas une réclame. */}
        <p class="livraison-mot">
          <Icone nom="camion" taille={17} />
          Livraison à Ouagadougou&nbsp;·&nbsp;<b class="chiffre">{prix(livraisonCfa)} FCFA</b>
        </p>

        <a class="aide-dambe" href="/dambe">
          <span class="rond-sombre"><Icone nom="dambe" taille={20} /></span>
          <span>Tu hésites ? <strong>Demande à IA Dambé</strong></span>
        </a>

        {/* Les avis (Arthur, 26 octobre 2026 : « mettre aussi des avis [...] à
            la fin, si quelqu'un a reçu son colis, qu'il puisse mettre des avis,
            avec peut-être des images même du produit »).

            ILS SONT ANONYMES. Ni prénom, ni quartier, ni photo de profil. Sur
            une boutique de protections périodiques, signer son avis revient à
            dire publiquement ce qu'on achète et quand on a ses règles. Ce qui
            donne sa valeur à l'avis, c'est qu'il vient d'une commande livrée,
            pas le nom de qui l'écrit : la base n'accepte un avis que d'une
            femme qui a reçu ce produit-là, et la mention le dit.

            LES VIDES. Aucun avis : on ne le cache pas et on n'invente pas
            d'étoiles, on dit qu'il n'y en a pas encore. Une note sans texte
            compte autant qu'une autre : beaucoup de femmes mettront quatre
            étoiles sans écrire un mot. */}
        <section class="avis" aria-labelledby="titre-avis">
          <h2 class="avis-titre" id="titre-avis">Ce qu'elles en disent</h2>

          {avis.nombre === 0 ? (
            <p class="avis-rien">
              Pas encore d'avis sur ce produit. Le premier sera celui d'une
              femme qui l'aura reçu.
            </p>
          ) : (
            <>
              <p class="avis-note">
                <span class="avis-etoiles" aria-hidden="true">
                  {[1, 2, 3, 4, 5].map((n) => (
                    <span class:list={['etoile', (avis.moyenne ?? 0) >= n - 0.5 && 'etoile-pleine']}>
                      <Icone nom="etoile" taille={17} />
                    </span>
                  ))}
                </span>
                <b class="chiffre">{String(avis.moyenne ?? 0).replace('.', ',')}</b>
                {/* « 5 sur 1 avis » se lisait comme une note sur 1. La note
                    d'abord, le nombre d'avis ensuite et à part : ce sont deux
                    choses différentes, elles ne tiennent pas dans une phrase. */}
                <span class="avis-combien">
                  sur 5 · {avis.nombre} avis
                </span>
              </p>

              <ul class="avis-liste">
                {avis.liste.map((a) => (
                  <li class="avis-un">
                    <p class="avis-haut">
                      <span class="avis-etoiles" aria-label={`${a.note} sur 5`}>
                        {[1, 2, 3, 4, 5].map((n) => (
                          <span class:list={['etoile', a.note >= n && 'etoile-pleine']} aria-hidden="true">
                            <Icone nom="etoile" taille={15} />
                          </span>
                        ))}
                      </span>
                      <span class="avis-verifie">
                        <Icone nom="coche" taille={13} />
                        Achat vérifié
                      </span>
                    </p>
                    {a.texte && <p class="avis-texte">{a.texte}</p>}
                    {a.photos.length > 0 && (
                      <ul class="avis-photos">
                        {a.photos.map((p) => (
                          <li>
                            <img
                              class="avis-photo"
                              src={`/photo-avis/${p}`}
                              alt="Photo envoyée avec cet avis"
                              width="76"
                              height="76"
                              loading="lazy"
                              decoding="async"
                            />
                          </li>
                        ))}
                      </ul>
                    )}
                    <p class="avis-quand">{dateLongue(a.cree_le)}</p>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>

        <div class="place-barre"></div>

        <div class="barre-action">
          {/* « Écrire à la boutique », JUSTE AU-DESSUS de « Commander » (demande
              d'Arthur, 13 octobre 2026). Avant, c'était un petit carré à côté
              du bouton, sans un mot : on ne savait pas ce qu'il faisait. Celle
              qui hésite sur une taille ou un quartier de livraison doit voir
              tout de suite qu'elle peut écrire. Le lien emporte le produit,
              qui sera attaché en haut de son message. */}
          <div class="rangee-ecrire">
            <a class="btn btn-contour ecrire-vendeur" href={`/discussions/boutique?produit=${produit.slug}`}>
              <Icone nom="bulles" taille={18} />
              Écrire à la boutique
            </a>
            {/* Le cœur des favoris (Arthur, 13 octobre 2026) : un petit carré, sur
                la même ligne. Touché, il devient rouge. `type="button"` : il ne
                doit pas envoyer le formulaire de commande. */}
            <button
              class:list={['favori', favori && 'favori-actif']}
              type="button"
              data-slug={produit.slug}
              aria-pressed={favori ? 'true' : 'false'}
              aria-label={favori ? 'Retirer des favoris' : 'Mettre en favori'}
            >
              <Icone nom="coeur" taille={22} epaisseur={2} />
            </button>
          </div>
          <button class="btn btn-rose btn-plein" type="submit" name="quantite" value="1" disabled={rupture}>
            {rupture ? 'Bientôt de retour' : `Commander · ${prix(produit.prix_cfa)} F`}
          </button>
        </div>
      </form>
    </div>
  </main>
</Base>

<script>
  import '../../scripts/favori';
</script>

<style>
  /* Les deux boutons d'action, l'un au-dessus de l'autre : « Écrire à la
     boutique », puis « Commander ». */
  .barre-action {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    margin-top: var(--e4);
  }

  .rangee-ecrire {
    display: flex;
    gap: var(--e2);
  }

  /* Plus petit qu'avant (« réduis un peu le rectangle ») : 44 px de haut, un
     texte de 14 px, et il laisse sa place au cœur sur la même ligne. */
  .ecrire-vendeur {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    height: 44px;
    padding: 0 14px;
    border-radius: 14px;
    font-size: 15.5px;
  }

  /* Le cœur : un carré de la même hauteur. Au repos, un contour ; touché, il se
     remplit de rouge. */
  .favori {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border: 1px solid var(--bordure);
    border-radius: 14px;
    background: var(--surface);
    color: var(--encre);
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .favori:active {
    transform: scale(0.9);
  }

  .favori :global(svg) {
    fill: none;
    transition: fill 0.15s, stroke 0.15s;
  }

  .favori-actif {
    border-color: #e11d48;
  }

  .favori-actif :global(svg) {
    fill: #e11d48;
    stroke: #e11d48;
  }

  @media (prefers-reduced-motion: reduce) {
    .favori,
    .favori :global(svg) {
      transition: none;
    }
  }

  .visuel-haut {
    position: relative;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-douce);
    color: var(--rose);
    overflow: hidden;
  }

  .visuel-haut img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sombre {
    background: var(--encre);
  }

  .violet {
    background: var(--violet-clair);
    color: var(--violet);
  }

  .clair {
    color: var(--rose-clair);
  }

  .coins {
    position: absolute;
    top: var(--e4);
    left: var(--e4);
    right: var(--e4);
    display: flex;
    justify-content: space-between;
  }

  h1 {
    margin-top: var(--e4);
    font-size: 24.5px;
  }

  .ligne-prix {
    display: flex;
    align-items: baseline;
    gap: var(--e2);
    margin-top: var(--e2);
  }

  .grand-prix {
    font-size: 31.5px;
    color: var(--rose);
  }

  .unite {
    font-size: 15.5px;
    font-weight: 600;
    color: var(--texte-2);
  }

  .tailles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e2);
    align-items: center;
    margin: var(--e5) 0 0;
    padding: 0;
    border: none;
  }

  .tailles legend {
    width: 100%;
  }

  .cache {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .taille-label {
    min-width: 56px;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--bordure);
    border-radius: var(--r-champ);
    background: var(--surface);
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--vite) ease, border-color var(--vite) ease;
  }

  .cache:checked + .taille-label {
    background: var(--encre);
    border-color: var(--encre);
    color: #fff;
  }

  .cache:focus-visible + .taille-label {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
  }

  /* L'aide d'IA Dambé garde son espace au-dessus (les encadrés de livraison
     qui le précédaient ont été retirés). */
  .aide-dambe {
    display: flex;
    align-items: center;
    gap: var(--e3);
    margin-top: var(--e4);
    font-size: 15px;
    color: var(--encre);
  }

  .aide-dambe strong {
    color: var(--rose);
  }

  .rond-sombre {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 12px;
    background: var(--encre);
    color: var(--rose-clair);
  }

  /* La barre d'action flotte au-dessus du contenu : on lui réserve sa hauteur
     entière, sinon la dernière ligne du texte finit cachée derrière. */
  .place-barre {
    height: 8px;
  }

  /* --- Le prix de la livraison, en une ligne --------------------------- */
  .livraison-mot {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: var(--e3) 0 0;
    font-size: 14.5px;
    color: var(--texte-2);
  }

  /* --- Les avis -------------------------------------------------------- */
  .avis {
    margin-top: var(--e5);
    padding-top: var(--e4);
    border-top: 1px solid var(--bordure);
  }

  .avis-titre {
    margin: 0 0 var(--e3);
    font-size: 18px;
    font-weight: 700;
  }

  .avis-rien {
    margin: 0;
    font-size: 14.5px;
    color: var(--texte-2);
  }

  .avis-note {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0 0 var(--e3);
    font-size: 15px;
  }

  .avis-combien {
    color: var(--texte-2);
  }

  .avis-etoiles {
    display: inline-flex;
    gap: 1px;
  }

  /* Une etoile vide reste dessinee, en gris : cinq formes alignees se
     comparent d'un coup d'oeil, trois formes isolees ne se comparent pas. */
  .etoile {
    display: inline-grid;
    place-items: center;
    color: var(--bordure);
  }

  /* REMPLIE, et pas seulement d une autre couleur : les icones du site sont
     dessinees au trait, et deux teintes d orange se confondent dans un rond de
     15 px. Le plein contre le vide se lit meme de loin, meme en plein soleil. */
  .etoile-pleine {
    color: #e8a33d;
  }

  .etoile-pleine :global(svg) {
    fill: currentColor;
  }

  .avis-liste {
    display: grid;
    gap: var(--e3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .avis-un {
    padding: var(--e3);
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    background: var(--surface);
  }

  .avis-haut {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e2);
    margin: 0;
  }

  /* « Achat verifie » est ce qui tient lieu de signature : l'avis est anonyme,
     mais il vient d'une commande livree, et c'est cela qui compte. */
  .avis-verifie {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 12px;
    font-weight: 600;
    color: var(--texte-2);
  }

  .avis-texte {
    margin: var(--e2) 0 0;
    font-size: 15px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .avis-photos {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: var(--e2) 0 0;
    padding: 0;
    list-style: none;
  }

  .avis-photo {
    display: block;
    width: 76px;
    height: 76px;
    border-radius: var(--r-champ);
    object-fit: cover;
    background: var(--surface-douce);
  }

  .avis-quand {
    margin: var(--e2) 0 0;
    font-size: 12.5px;
    color: var(--texte-3);
  }
</style>

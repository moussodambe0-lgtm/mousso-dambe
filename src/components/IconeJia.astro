  {name === 'box' && (<><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a4 4 0 0 1 8 0v2" /></>)}
  {name === 'trend-up' && (<path d="M5 15l7-7 7 7" />)}
  {name === 'card' && (<><rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3 10h18" /></>)}

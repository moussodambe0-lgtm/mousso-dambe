---
/**
 * MONDE : tout ce qui se passe sur la plateforme.
 *
 * Arthur, le 5 novembre 2026 : « au niveau de Monde, il faudra mettre le nombre
 * de personnes qui se sont connectées. Je dois pouvoir voir les comptes qui
 * sont connectés, le nombre de personnes qui sont venues sur la plateforme, qui
 * ont visité la plateforme. Toutes les informations possibles. »
 *
 * L'écran est donc rangé du plus large au plus étroit, et c'est l'ordre dans
 * lequel on cherche quand on ouvre une page de chiffres : combien sont venues,
 * combien ont un compte, combien de ces comptes vivent encore, combien
 * achètent.
 *
 * CE QUI N'APPARAÎT PAS, et ce n'est pas un oubli. Aucun prénom, aucun numéro,
 * aucune page visitée par quelqu'un en particulier. `monde()` ne lit ni les
 * cycles, ni le journal, ni les questions posées à Dambé, et la table des
 * visites ne contient que trois nombres par date : il n'y a rien à montrer de
 * plus, parce qu'il n'y a rien d'enregistré de plus. Le détail du choix est en
 * tête de `20261105190000_ce_qui_se_passe_sur_la_plateforme.sql`.
 */
import Admin from '../../layouts/Admin.astro';
import Icone from '../../components/IconeJia.astro';
import { exigerGestion } from '../../lib/gestion';
import { entier, dateCourte } from '../../lib/format-gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

const { data, error } = await sb.rpc('monde');
const pasEncore = !!error || data?.ok !== true;
const d: any = pasEncore ? {} : data;

type Jour = { jour: string; inscriptions: number; commandes: number; visites: number; pages: number };
const jours = (d.jours ?? []) as Jour[];

const v = (d.visites ?? {}) as Record<string, any>;

const comptes = Number(d.comptes ?? 0);
const ontCommande = Number(d.ont_commande ?? 0);
const partAcheteuses = comptes > 0 ? Math.round((ontCommande / comptes) * 100) : null;
const questionnaire = Number(d.questionnaire_fait ?? 0);
const partQuestionnaire = comptes > 0 ? Math.round((questionnaire / comptes) * 100) : null;
const jamaisRevenues = Number(d.jamais_revenues ?? 0);
const partRevenues = comptes > 0 ? Math.round(((comptes - jamaisRevenues) / comptes) * 100) : null;

// La courbe porte trois séries, et les visites écrasent les deux autres : il y
// a toujours beaucoup plus de passages que d'inscriptions. Chaque série est
// donc mise à l'échelle de SON propre maximum. On ne compare pas leurs
// hauteurs entre elles, on regarde la forme de chacune dans le temps.
const maxVisites = Math.max(1, ...jours.map((j) => Number(j.visites ?? 0)));
const maxActes = Math.max(1, ...jours.map((j) => Math.max(j.inscriptions, j.commandes)));

const record = d.visites?.record ?? null;

/** Les lignes d'un bloc de chiffres, à plat : libellé, valeur, précision. */
type Ligne = { mot: string; valeur: string; apres?: string | null };

const frequentation: Ligne[] = [
  { mot: 'Visiteuses aujourd’hui', valeur: entier(Number(v.jour ?? 0)), apres: `${entier(Number(v.pages_jour ?? 0))} pages` },
  { mot: 'Sur 7 jours', valeur: entier(Number(v.semaine ?? 0)), apres: `${entier(Number(v.pages_semaine ?? 0))} pages` },
  { mot: 'Sur 30 jours', valeur: entier(Number(v.mois ?? 0)), apres: `${entier(Number(v.pages_mois ?? 0))} pages` },
  {
    mot: 'Pages ouvertes par quelqu’un de connecté',
    valeur: v.part_connectee === null || v.part_connectee === undefined ? '—' : `${v.part_connectee} %`,
    apres: null,
  },
];

const presence: Ligne[] = [
  { mot: 'En ce moment', valeur: entier(Number(d.connectees_maintenant ?? 0)), apres: 'dernier quart d’heure' },
  { mot: 'Aujourd’hui', valeur: entier(Number(d.connectees_jour ?? 0)), apres: null },
  { mot: 'Cette semaine', valeur: entier(Number(d.connectees_7j ?? 0)), apres: null },
  { mot: 'Ce mois', valeur: entier(Number(d.connectees_30j ?? 0)), apres: null },
];

const fidelite: Ligne[] = [
  {
    mot: 'Comptes revenus au moins une fois',
    valeur: entier(comptes - jamaisRevenues),
    apres: partRevenues === null ? null : `${partRevenues} %`,
  },
  { mot: 'Jamais revenues après l’inscription', valeur: entier(jamaisRevenues), apres: null },
  {
    mot: 'Questionnaire d’ouverture fini',
    valeur: entier(questionnaire),
    apres: partQuestionnaire === null ? null : `${partQuestionnaire} %`,
  },
  { mot: 'Ont recommandé', valeur: entier(Number(d.ont_recommande ?? 0)), apres: null },
];
---

<Admin titre="Monde" onglet="monde">
  {
    pasEncore ? (
      <div class="etat-vide">
        <Icone name="user" size={34} class="icone-vide" />
        <div class="titre">Rien à compter pour l'instant</div>
        <div class="texte">
          Cet écran attend les migrations du 5 novembre 2026. Tant qu'elles ne sont pas appliquées sur cette base,
          aucun nombre affiché ici ne voudrait dire quelque chose.
        </div>
      </div>
    ) : (
      <>
        <section class="section-serree chiffres">
          <div><strong class="chiffre">{entier(Number(v.jour ?? 0))}</strong><span>visiteuses aujourd’hui</span></div>
          <div>
            <strong class="chiffre">{entier(Number(d.connectees_maintenant ?? 0))}</strong>
            <span>connectées là</span>
          </div>
          <div><strong class="chiffre">{entier(comptes)}</strong><span>comptes en tout</span></div>
          <div>
            <strong class="chiffre">
              {entier(ontCommande)}
              {partAcheteuses !== null && <small>{partAcheteuses} %</small>}
            </strong>
            <span>ont commandé</span>
          </div>
        </section>

        <section class="section">
          <h2 class="titre-section">Les trente derniers jours</h2>
          <div class="bloc-courbe">
            <div class="courbe" role="img" aria-label="Visites, inscriptions et commandes des trente derniers jours">
              {jours.map((j) => (
                <span
                  class="jour"
                  title={`${j.jour} : ${j.visites ?? 0} visiteuse(s), ${j.inscriptions} inscription(s), ${j.commandes} commande(s)`}
                >
                  <span class="barre barre-visite" style={`height:${(Number(j.visites ?? 0) / maxVisites) * 100}%`} />
                  <span class="barre barre-inscription" style={`height:${(j.inscriptions / maxActes) * 100}%`} />
                  <span class="barre barre-commande" style={`height:${(j.commandes / maxActes) * 100}%`} />
                </span>
              ))}
            </div>
            <div class="legende">
              <span><i class="puce puce-visite" />Visites</span>
              <span><i class="puce puce-inscription" />Inscriptions</span>
              <span><i class="puce puce-commande" />Commandes</span>
            </div>
          </div>
          {record && Number(record.visiteuses) > 0 && (
            <p class="record">
              Meilleur jour : <strong>{dateCourte(record.jour)}</strong>, {entier(Number(record.visiteuses))} visiteuse
              {Number(record.visiteuses) > 1 ? 's' : ''}.
            </p>
          )}
        </section>

        <section class="section">
          <h2 class="titre-section">La fréquentation</h2>
          <div class="carte">
            {frequentation.map((l) => (
              <div class="ligne-mention">
                <span>{l.mot}</span>
                <strong>
                  {l.valeur}
                  {l.apres && <span class="part"> · {l.apres}</span>}
                </strong>
              </div>
            ))}
          </div>
        </section>

        <section class="section">
          <h2 class="titre-section">Les comptes qui se connectent</h2>
          <div class="carte">
            {presence.map((l) => (
              <div class="ligne-mention">
                <span>{l.mot}</span>
                <strong>
                  {l.valeur}
                  {l.apres && <span class="part"> · {l.apres}</span>}
                </strong>
              </div>
            ))}
          </div>
        </section>

        <section class="section">
          <h2 class="titre-section">Est-ce qu’elles restent</h2>
          <div class="carte">
            {fidelite.map((l) => (
              <div class="ligne-mention">
                <span>{l.mot}</span>
                <strong>
                  {l.valeur}
                  {l.apres && <span class="part"> · {l.apres}</span>}
                </strong>
              </div>
            ))}
          </div>
        </section>

        <section class="section">
          <h2 class="titre-section">Ce qui se vend</h2>
          <div class="carte">
            <div class="ligne-mention">
              <span>Commandes aujourd’hui</span>
              <strong>{entier(Number(d.commandes_jour ?? 0))}</strong>
            </div>
            <div class="ligne-mention">
              <span>Commandes sur 7 jours</span>
              <strong>{entier(Number(d.commandes_7j ?? 0))}</strong>
            </div>
            <div class="ligne-mention">
              <span>Nouveaux comptes sur 7 jours</span>
              <strong>{entier(Number(d.comptes_7j ?? 0))}</strong>
            </div>
            <div class="ligne-mention">
              <span>Nouveaux comptes sur 30 jours</span>
              <strong>{entier(Number(d.comptes_30j ?? 0))}</strong>
            </div>
          </div>
        </section>
      </>
    )
  }
</Admin>

<style>
  .chiffres { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 6px; background: var(--surface); border-bottom: 1px solid var(--bordure); }
  .chiffres div { text-align: center; }
  .chiffres strong { display: block; font-size: 19px; }
  .chiffres strong small { font-size: 11.5px; font-weight: 700; color: var(--texte-tertiaire); margin-left: 3px; }
  .chiffres span { display: block; font-size: 11.5px; color: var(--texte-secondaire); margin-top: 1px; }

  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }

  .titre-section { font-size: 16px; margin: 20px 0 12px; }

  /* Une courbe sans bibliothèque : trente colonnes, trois barres par jour.
     Rien à télécharger, et ça se lit sur un téléphone. */
  .bloc-courbe { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 14px; }
  .courbe { display: flex; align-items: flex-end; gap: 3px; height: 120px; }
  .jour { display: flex; align-items: flex-end; gap: 1px; flex: 1; height: 100%; }
  .barre { flex: 1; min-height: 2px; border-radius: 2px 2px 0 0; }
  /* Les visites en pâle et derrière, les deux gestes en plein devant : il y a
     cent fois plus de passages que d'inscriptions, et la barre pâle est le
     décor sur lequel les autres se lisent. */
  .barre-visite { background: var(--action-bordure); }
  .barre-inscription { background: var(--action); }
  .barre-commande { background: var(--encre); }

  .legende { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 11px; font-size: 12.5px; color: var(--texte-secondaire); }
  .puce { display: inline-block; width: 10px; height: 10px; margin-right: 6px; border-radius: 3px; }
  .puce-visite { background: var(--action-bordure); }
  .puce-inscription { background: var(--action); }
  .puce-commande { background: var(--encre); }

  .record { margin: 10px 0 0; font-size: 13px; color: var(--texte-secondaire); }

  .carte { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 4px 14px; }
  .ligne-mention { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 10px 0; font-size: 14px; }
  .ligne-mention + .ligne-mention { border-top: 1px solid var(--bordure); }
  .ligne-mention > span:first-child { color: var(--texte-secondaire); }
  .ligne-mention strong { white-space: nowrap; }
  .part { color: var(--texte-tertiaire); font-weight: 700; }
</style>

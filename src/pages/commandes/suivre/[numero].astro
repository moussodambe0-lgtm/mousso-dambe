---
/**
 * Suivre une commande.
 *
 * REFAITE LE 8 NOVEMBRE 2026, sur les captures de l'autre application d'Arthur,
 * et sur sa phrase : « AU NIVEAU DE SUIVRE MA COMMANDE JE VEUX QUE SA SOIT
 * COMME SA. AVEC UNE VRAI MAPS », puis « les icônes avec en livraison, en
 * préparation, et j'en passe. Si quelqu'un appuie sur ça, ça doit s'afficher
 * comme ça. »
 *
 * CE QUI CHANGE, ET CE QUE ÇA ANNULE. Le 27 octobre 2026, entre trois
 * propositions, il avait choisi de garder un simple bouton qui ouvre
 * l'application de cartes du téléphone, et le commentaire d'alors disait : « ne
 * pas la rouvrir sans qu'il la rouvre ». Il l'a rouverte, en montrant à quoi la
 * page doit ressembler. La carte est donc dessinée ici.
 *
 * L'ORDRE DE L'ÉCRAN, ET POURQUOI. Il suit les captures, et chaque bloc répond
 * à une question qu'on se pose dans cet ordre quand on attend un colis :
 *   1. où ça en est             -> le bandeau d'état, en grand, lisible de loin
 *   2. qu'est-ce que je fais    -> confirmer la réception, quand c'est le moment
 *   3. où est mon colis         -> la carte
 *   4. quel chemin il a fait    -> la frise des quatre étapes, puis leurs heures
 *   5. qu'est-ce que j'ai pris  -> l'article et le total
 *   6. qui vient, et où         -> la livraison
 *   7. et si ça se passe mal    -> les recours, en dernier, jamais en premier
 *
 * UNE SEULE LECTURE EN BASE. La page appelait `mes_commandes()` puis cherchait
 * la bonne avec un `.find()` : elle chargeait les vingt dernières commandes,
 * avec toutes leurs lignes, pour en afficher une. `suivi_de_ma_commande()` rend
 * exactement cette commande-là, et les champs qu'il faut à cet écran.
 *
 * PAS DE NUMÉRO DE COMMANDE À L'ÉCRAN (Arthur, le 7 novembre 2026 : « JE VEUX
 * PAS DE NUMERO DE COMMANDE »). Il reste dans l'adresse, parce que c'est la clé
 * de la page, et dans les champs cachés des formulaires. Nulle part sous ses
 * yeux.
 */
import Base from '../../../layouts/Base.astro';
import Entete from '../../../components/Entete.astro';
import Icone from '../../../components/Icone.astro';
import Alerte from '../../../components/Alerte.astro';
import CarteSuivi from '../../../components/CarteSuivi.astro';
import { clientSession, baseConfiguree } from '../../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../../lib/session';
import { prix, dateEtHeure, messageErreur } from '../../../lib/format';
import { pageDeLEtat, ETATS_CLIENTE } from '../../../lib/etats-commande';

export const prerender = false;

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);

const client = clientSession(Astro)!;
let erreur = '';
let message = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const numero = String(f.get('numero') ?? '');
  const geste = String(f.get('geste') ?? '');

  if (geste === 'position') {
    const lat = Number(f.get('lat'));
    const lng = Number(f.get('lng'));
    if (!Number.isFinite(lat) || !Number.isFinite(lng) || (lat === 0 && lng === 0)) {
      // Le bouton « Partager ma position » n'a pas été appuyé, ou le navigateur
      // a refusé. Dire quoi faire vaut mieux qu'un « position hors zone » venu
      // de la base, qui serait vrai mais incompréhensible.
      erreur = "Appuie d'abord sur « Partager ma position », puis envoie.";
    } else {
      const { data, error } = await client.rpc('preciser_ma_position', {
        p_numero: numero,
        p_lat: lat,
        p_lng: lng,
      });
      if (error || !data?.ok) erreur = messageErreur(data?.erreur ?? error?.message);
      else return Astro.redirect(`/commandes/suivre/${encodeURIComponent(numero)}?ok=position`, 303);
    }
  } else if (geste === 'recue') {
    const { data, error } = await client.rpc('confirmer_reception', { p_numero: numero });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur ?? error?.message);
    else return Astro.redirect(`/commandes/suivre/${encodeURIComponent(numero)}?ok=recue`, 303);
  } else if (geste === 'pas-recue') {
    const { data, error } = await client.rpc('signaler_non_reception', { p_numero: numero });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur ?? error?.message);
    else return Astro.redirect(`/commandes/suivre/${encodeURIComponent(numero)}?ok=signale`, 303);
  } else {
    const { data, error } = await client.rpc('annuler_ma_commande', { p_numero: numero });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur);
    else return Astro.redirect('/commandes/annulees?ok=annule', 303);
  }
}

const quoi = Astro.url.searchParams.get('ok');
if (quoi === 'position') message = 'Ta position est enregistrée. Le livreur la verra.';
if (quoi === 'recue') message = 'Merci. Ta commande est clôturée.';
if (quoi === 'signale') {
  message = "C'est signalé. Écris à la boutique pour expliquer ce qui s'est passé.";
}

const { data: brut } = await client.rpc('suivi_de_ma_commande', {
  p_numero: String(Astro.params.numero ?? ''),
});

// Un numéro qui n'est pas le sien, ou qui n'existe pas : on ne le dit pas
// autrement qu'en la ramenant à sa liste. Répondre « cette commande n'existe
// pas » renseignerait quelqu'un qui essaie des numéros au hasard.
if (!brut?.ok) return Astro.redirect(`/commandes/${ETATS_CLIENTE[0].cle}`, 302);

const c = brut as {
  numero: string;
  etat: string;
  nom: string;
  telephone: string;
  quartier: string;
  repere: string;
  articles_cfa: number;
  livraison_cfa: number;
  total: number;
  cree_le: string;
  preparee_le: string | null;
  envoyee_le: string | null;
  livree_le: string | null;
  lat: number | null;
  lng: number | null;
  livreur_nom: string | null;
  livreur_telephone: string | null;
  livreur_lat: number | null;
  livreur_lng: number | null;
  livreur_position_le: string | null;
  recue_confirmee_le: string | null;
  probleme_signale_le: string | null;
  articles: { nom: string; taille: string | null; quantite: number; total: number; image: string | null; slug: string | null }[];
};

/**
 * Le chemin normal d'un colis, et les quatre pastilles de la frise.
 *
 * L'annulation n'en fait pas partie : c'est une sortie de route, pas une
 * étape, et l'afficher dans la file donnerait à croire que toute commande
 * finit par être annulée. Une commande annulée n'affiche pas de frise du tout.
 */
const CHEMIN = [
  { etat: 'nouvelle', mot: 'Commandée', quand: c.cree_le, journal: 'Commande passée' },
  { etat: 'preparee', mot: 'En préparation', quand: c.preparee_le, journal: 'Colis préparé' },
  { etat: 'envoyee', mot: 'En route', quand: c.envoyee_le, journal: 'Colis remis au livreur' },
  { etat: 'livree', mot: 'Livrée', quand: c.livree_le, journal: 'Colis livré' },
];

const annulee = c.etat === 'annulee';
const place = CHEMIN.findIndex((e) => e.etat === c.etat);

/**
 * Le bandeau du haut, celui qu'on lit de loin.
 *
 * Chaque état dit DEUX choses : où ça en est, et ce qu'elle a à faire. Le
 * second compte plus que le premier : « En cours de livraison » sans « vérifie
 * le produit avant de payer » laisse quelqu'un payer un carton fermé.
 */
const BANDEAUX: Record<string, { icone: string; mot: string; dit: string }> = {
  nouvelle: {
    icone: 'carton',
    mot: 'Commande reçue',
    dit: 'On prépare ton colis. Tu ne paies rien avant de le recevoir.',
  },
  preparee: {
    icone: 'colis',
    mot: 'Colis préparé',
    dit: "Emballage neutre, rien n'est écrit dessus. Il part bientôt.",
  },
  envoyee: {
    icone: 'scooter',
    mot: 'En cours de livraison',
    dit: 'Vérifie le produit à la réception, puis paie.',
  },
  livree: {
    icone: 'coche',
    mot: 'Commande livrée',
    dit: 'Tu as payé à la remise. Merci.',
  },
  annulee: {
    icone: 'croix-cercle',
    mot: 'Commande annulée',
    dit: "Elle n'a pas été livrée, et tu n'as rien payé.",
  },
};
const bandeau = BANDEAUX[c.etat] ?? BANDEAUX.nouvelle;

// La barre de progression du bandeau : la part du chemin parcourue.
const avancee = annulee ? 100 : Math.round(((place + 1) / CHEMIN.length) * 100);

// Les étapes déjà franchies, de la plus récente à la plus ancienne, comme dans
// un journal. Une étape sans heure enregistrée s'affiche quand même : les
// commandes parties avant le 8 novembre 2026 n'ont pas toutes leur horodatage,
// et une étape sans heure vaut mieux qu'une heure inventée.
const journal = CHEMIN.slice(0, place + 1)
  .map((e) => ({ mot: e.journal, quand: dateEtHeure(e.quand) }))
  .reverse();

const elle = c.lat != null && c.lng != null ? { lat: c.lat, lng: c.lng } : null;
const leLivreur =
  c.livreur_lat != null && c.livreur_lng != null ? { lat: c.livreur_lat, lng: c.livreur_lng } : null;
/*
 * QUAND LA CARTE S'AFFICHE (élargi le 8 novembre 2026).
 *
 * Elle ne se montrait que pendant la livraison. Arthur, le soir même : « ET LA
 * MAP ? JE LA VOIS PAS ». Mesuré plutôt que supposé : sa base n'avait aucune
 * commande à l'état « envoyee », donc la carte n'avait jamais l'occasion
 * d'exister. La condition était juste, et inutilement étroite.
 *
 * ELLE S'AFFICHE MAINTENANT DÈS QUE LA COMMANDE EST EN COURS, et ce n'est pas
 * une complaisance : avant que le colis parte, la carte sert à VÉRIFIER. Elle a
 * appuyé sur « Partager ma position » sans jamais voir où le point tombait ;
 * elle peut maintenant regarder, et le corriger pendant qu'il en est encore
 * temps. Un point faux corrigé avant le départ vaut mieux qu'un livreur perdu.
 *
 * ELLE DISPARAÎT UNE FOIS LIVRÉE : le colis est arrivé, il n'y a plus rien à
 * suivre, et une carte de plus sur un forfait compté ne sert personne.
 *
 * ET TOUJOURS PAS DE CARTE VIDE : sans aucun point, il n'y a rien à montrer.
 */
const EN_COURS = ['nouvelle', 'preparee', 'envoyee'];
const carteUtile = EN_COURS.includes(c.etat) && (elle || leLivreur);

const page = pageDeLEtat(c.etat);
const panier = comptePanier(lirePanier(Astro));
const paye = c.etat === 'livree';
---

<Base titre="Suivi de commande" nav="compte" panier={panier}>
  <main class="page">
    <Entete titre="Suivi de commande" retour={`/commandes/${page?.cle ?? ETATS_CLIENTE[0].cle}`} />

    {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}
    {message && <div class="marge-bas"><Alerte type="reussite" texte={message} /></div>}

    {/* 1. OÙ ÇA EN EST ----------------------------------------------------- */}
    <section class:list={['bandeau', annulee && 'bandeau-eteint']}>
      <div class="bandeau-haut">
        <span class="bandeau-icone"><Icone nom={bandeau.icone} taille={22} /></span>
        <div>
          <h2 class="bandeau-mot">{bandeau.mot}</h2>
          <p class="bandeau-dit">{bandeau.dit}</p>
        </div>
      </div>
      <div class="jauge" role="presentation">
        <i class="jauge-faite" data-avancee={avancee}></i>
      </div>
    </section>

    {/* 2. CE QU'ELLE A À FAIRE --------------------------------------------- */}
    {
      c.etat === 'envoyee' && (
        <section class="action">
          <h2 class="action-titre">
            <Icone nom="colis" taille={18} />
            Confirme la réception
          </h2>
          <p class="action-dit">
            Confirme avoir reçu ta commande pour la clôturer. Tu pourras ensuite
            noter ton achat.
          </p>
          <form method="POST">
            <input type="hidden" name="geste" value="recue" />
            <input type="hidden" name="numero" value={c.numero} />
            <button class="btn btn-rose btn-plein" type="submit">
              J'ai reçu ma commande
            </button>
          </form>
          {c.probleme_signale_le ? (
            <p class="action-signale">
              <Icone nom="alerte" taille={15} />
              Tu as signalé ne pas l'avoir reçue. Écris à la boutique pour
              expliquer.
            </p>
          ) : (
            <form method="POST">
              <input type="hidden" name="geste" value="pas-recue" />
              <input type="hidden" name="numero" value={c.numero} />
              <button class="pas-recue" type="submit">
                <Icone nom="alerte" taille={15} />
                Je n'ai pas reçu ma commande
              </button>
            </form>
          )}
        </section>
      )
    }

    {/* 3. OÙ EST LE COLIS --------------------------------------------------- */}
    {
      carteUtile && (
        <CarteSuivi
          elle={elle}
          livreur={leLivreur}
          livreurQuand={dateEtHeure(c.livreur_position_le)}
          livreurNom={c.livreur_nom ?? ''}
        />
      )
    }

    {/* 4. LE CHEMIN PARCOURU ------------------------------------------------ */}
    {
      !annulee && (
        <section class="frise-carte">
          <div class="frise-haut">
            <div>
              <p class="frise-de">Commande de</p>
              <p class="frise-qui">Mousso Dambé</p>
            </div>
            <span class="frise-badge">{page?.mot ?? bandeau.mot}</span>
          </div>

          <ol class="frise" aria-label="Avancement de la commande">
            {CHEMIN.map((e, i) => {
              const faite = i < place;
              const courante = i === place;
              return (
                <li class:list={['etape', (faite || courante) && 'etape-faite', courante && 'etape-ici']}>
                  <span class="etape-trait" aria-hidden="true"></span>
                  <span class="etape-puce">
                    {faite ? (
                      <Icone nom="coche" taille={13} />
                    ) : courante ? (
                      <Icone nom="moins" taille={13} />
                    ) : (
                      <i class="etape-creux"></i>
                    )}
                  </span>
                  <span class="etape-mot">{e.mot}</span>
                </li>
              );
            })}
          </ol>

          <p class="frise-legende">
            <i class="trait-plein" aria-hidden="true"></i> parcours confirmé
            <i class="trait-creux" aria-hidden="true"></i> reste à parcourir
          </p>
        </section>
      )
    }

    {
      !annulee && (
        <section class="bloc">
          <h2 class="bloc-titre-grand">Étapes de la commande</h2>
          <ol class="journal">
            {journal.map((e) => (
              <li class="jour">
                <span class="jour-puce" aria-hidden="true"></span>
                <span class="jour-corps">
                  <b>{e.mot}</b>
                  {e.quand && <small>{e.quand}</small>}
                </span>
              </li>
            ))}
          </ol>

          {c.etat === 'envoyee' &&
            (elle ? (
              <p class="partage">
                <Icone nom="coche" taille={15} />
                Ta position est partagée avec le livreur.
              </p>
            ) : (
              <p class="partage partage-sans">
                <Icone nom="info" taille={15} />
                Tu n'as pas partagé ta position. Le livreur a ton quartier et ton
                numéro.
              </p>
            ))}
        </section>
      )
    }

    {/* 5. CE QU'ELLE A PRIS -------------------------------------------------- */}
    <section class="bloc">
      <h2 class="bloc-titre-grand">{c.articles.length > 1 ? 'Articles' : 'Article'}</h2>
      <ul class="articles">
        {c.articles.map((a) => (
          <li class="article">
            {a.image ? (
              <img class="article-photo" src={a.image} alt="" width="56" height="56" loading="lazy" />
            ) : (
              <span class="article-photo article-sans"><Icone nom="colis" taille={20} /></span>
            )}
            <span class="article-corps">
              <b>{a.nom}</b>
              <small>
                Mousso Dambé
                {a.taille ? ` · ${a.taille}` : ''}
                {` · Quantité ${a.quantite}`}
              </small>
            </span>
            <span class="article-prix chiffre">{prix(a.total)} FCFA</span>
          </li>
        ))}
      </ul>

      <dl class="compte">
        <div><dt>Sous-total</dt><dd class="chiffre">{prix(c.articles_cfa)} FCFA</dd></div>
        <div><dt>Livraison</dt><dd class="chiffre">{prix(c.livraison_cfa)} FCFA</dd></div>
        <div class="compte-total">
          <dt>{paye ? 'Payé à la livraison' : 'À payer à la livraison'}</dt>
          <dd class="chiffre">{prix(c.total)} FCFA</dd>
        </div>
      </dl>
    </section>

    {/* 6. QUI VIENT, ET OÙ --------------------------------------------------- */}
    <section class="bloc">
      <h2 class="bloc-titre-grand">Livraison</h2>
      <p class="livr-qui">{c.nom}</p>
      <p class="livr-ligne">{c.telephone}</p>
      <p class="livr-ligne">{c.quartier}, Ouagadougou</p>
      {c.repere && <p class="livr-repere">{c.repere}</p>}

      {
        c.etat === 'envoyee' && c.livreur_nom && (
          <div class="livreur">
            <p class="livreur-qui">
              <b>{c.livreur_nom}</b> apporte ton colis.
            </p>
            {c.livreur_telephone && (
              <a class="btn btn-contour btn-plein" href={`tel:${c.livreur_telephone}`}>
                <Icone nom="telephone" taille={18} />
                Appeler {c.livreur_nom}
              </a>
            )}
          </div>
        )
      }

      {/* Repréciser sa position pendant que le colis roule. Arthur : « la
          personne peut toujours envoyer sa localisation ». Le cas est réel :
          elle commande depuis le marché, et c'est chez elle qu'il faut livrer.
          Le bloc est caché tant que le script n'a pas tourné : sans
          JavaScript, aucun navigateur ne sait donner une position, et un
          bouton qui ne peut rien faire vaut moins que pas de bouton. */}
      {
        (c.etat === 'nouvelle' || c.etat === 'preparee' || c.etat === 'envoyee') && (
          <form class="repointer" method="POST" data-position>
            <input type="hidden" name="geste" value="position" />
            <input type="hidden" name="numero" value={c.numero} />
            <input type="hidden" class="position-lat" name="lat" />
            <input type="hidden" class="position-lng" name="lng" />
            <button class="btn btn-contour btn-plein position-bouton" type="button" hidden>
              <Icone nom="lieu" taille={18} />
              <span class="position-mot">{elle ? 'Corriger ma position' : 'Partager ma position'}</span>
            </button>
            <p class="position-dit" hidden></p>
            <button class="btn btn-rose btn-plein repointer-envoi" type="submit">Envoyer au livreur</button>
          </form>
        )
      }
    </section>

    {/* 7. ET SI ÇA SE PASSE MAL ---------------------------------------------- */}
    <section class="bloc">
      <h2 class="bloc-titre-grand">Un problème avec cette commande ?</h2>
      <div class="recours">
        <a class="btn btn-contour btn-plein" href="/discussions/boutique">
          <Icone nom="bulles" taille={18} />
          Écrire à la boutique
        </a>

        {
          (c.etat === 'nouvelle' || c.etat === 'preparee') && (
            <form method="POST">
              <input type="hidden" name="geste" value="annuler" />
              <input type="hidden" name="numero" value={c.numero} />
              <button class="btn btn-texte btn-plein" type="submit">Annuler cette commande</button>
            </form>
          )
        }

        {/*
          LE REMBOURSEMENT N'A DE SENS QU'APRÈS AVOIR PAYÉ, et ici on paie à la
          remise du colis. Avant la livraison, il n'y a rien à rembourser :
          c'est « Annuler » qu'il faut, et il est juste au-dessus. Ce lien
          ouvre donc la discussion avec la boutique, parce que c'est ce qui se
          passe réellement : Arthur regarde, et il rend l'argent ou non. Un
          bouton qui déclencherait un remboursement tout seul mentirait sur ce
          que fait l'application.
        */}
        {
          c.etat === 'livree' && (
            <a class="btn btn-contour btn-plein" href="/discussions/boutique">
              <Icone nom="carton" taille={18} />
              Demander un remboursement
            </a>
          )
        }
      </div>
      <p class="depuis">Commande passée le {dateEtHeure(c.cree_le)}.</p>
    </section>
  </main>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--e3);
  }

  /* --- 1. Le bandeau d'état ---------------------------------------------- */
  .bandeau {
    display: grid;
    gap: var(--e3);
    padding: var(--e4);
    border-radius: var(--r-carte);
    background: var(--rose);
    color: #fff;
  }

  /* Une commande annulée ne crie pas en rose vif : ce n'est pas une étape
     heureuse, et l'écran n'a pas à la célébrer. */
  .bandeau-eteint {
    background: var(--encre);
  }

  .bandeau-haut {
    display: flex;
    gap: var(--e3);
    align-items: flex-start;
  }

  .bandeau-icone {
    display: grid;
    place-items: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: rgb(255 255 255 / 0.18);
  }

  .bandeau-mot {
    margin: 0;
    font-family: var(--titre);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.2;
  }

  .bandeau-dit {
    margin: 4px 0 0;
    font-size: 14px;
    line-height: 1.45;
    color: rgb(255 255 255 / 0.9);
  }

  .jauge {
    height: 5px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.3);
    overflow: hidden;
  }

  /* La largeur vient d'un attribut, pas d'un style en ligne : la politique de
     sécurité du site interdit style= dans les pages, et une carte est la seule
     exception, pour ses tuiles. On déclare donc les paliers ici. */
  .jauge-faite {
    display: block;
    height: 100%;
    border-radius: 999px;
    background: #fff;
    width: 25%;
  }

  .jauge-faite[data-avancee='50'] { width: 50%; }
  .jauge-faite[data-avancee='75'] { width: 75%; }
  .jauge-faite[data-avancee='100'] { width: 100%; }

  /* --- 2. Confirmer la réception ------------------------------------------ */
  .action {
    display: grid;
    gap: var(--e2);
    padding: var(--e4);
    border: 1px solid var(--bordure-forte);
    border-radius: var(--r-carte);
    background: var(--surface-douce);
  }

  .action-titre {

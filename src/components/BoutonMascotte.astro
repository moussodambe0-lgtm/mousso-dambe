---
/**
 * LA BULLE FLOTTANTE DE MOUSSO.
 *
 * Section 6 du cahier : la mascotte est présente sur toutes les pages, en bas
 * à droite au-dessus de la barre de navigation, et ouvre la conversation avec
 * IA Dambé au toucher. Pas dans la conversation elle-même, ni pendant le
 * questionnaire : à ces deux endroits elle serait un bouton qui mène là où on
 * est déjà, ou une distraction au milieu d'une question.
 *
 * C'est un lien, pas un bouton : elle mène à une page. Le navigateur sait
 * donc l'ouvrir dans un nouvel onglet, et le lecteur d'écran l'annonce comme
 * ce qu'elle est.
 *
 * La petite phrase (« Une question, Awa ? ») apparaît une fois, dix secondes
 * après l'arrivée, et s'en va au bout de six. Elle n'attend aucun clic et ne
 * recouvre pas la barre. Si on la touche, c'est la conversation qui s'ouvre.
 */
import Mascotte from './Mascotte.astro';

interface Props {
  prenom?: string;
}

const { prenom = '' } = Astro.props;
const phrase = prenom ? `Une question, ${prenom} ?` : 'Une question ?';
---

<a class="flottante" href="/dambe" aria-label="Ouvrir la conversation avec IA Dambé">
  <span class="flottante-mot" aria-hidden="true">{phrase}</span>
  <span class="flottante-rond">
    <Mascotte etat="visage" taille={44} titre={null} />
  </span>
</a>

<style>
  .flottante {
    position: fixed;
    right: 14px;
    /* Au-dessus du cercle de la barre basse, qui dépasse de 32 px : plus bas,
       la bulle lui rentrerait dedans. */
    bottom: calc(118px + env(safe-area-inset-bottom, 0px));
    z-index: 19;
    display: flex;
    align-items: center;
    gap: 8px;
    animation: flottante-arrive 0.5s 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .flottante-rond {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--rose-clair);
    box-shadow: 0 6px 18px rgba(27, 17, 22, 0.22);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .flottante:active .flottante-rond {
    transform: scale(0.9);
  }

  /* La phrase : repliée à zéro, elle se déplie une fois puis se replie. La
     largeur est animée par `max-width`, qui ne déclenche aucune mise en page
     sur le reste de l'écran parce que le bloc est en position fixe. */
  .flottante-mot {
    max-width: 0;
    padding: 0;
    overflow: hidden;
    white-space: nowrap;
    border-radius: var(--r-ronde);
    background: var(--surface);
    box-shadow: 0 4px 14px rgba(27, 17, 22, 0.14);
    font-size: 14.5px;
    font-weight: 600;
    line-height: 34px;
    opacity: 0;
    animation: flottante-dit 16s 10s ease both;
  }

  @keyframes flottante-arrive {
    from {
      opacity: 0;
      transform: translateY(26px) scale(0.6);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes flottante-dit {
    0% {
      max-width: 0;
      padding: 0;
      opacity: 0;
    }
    8%,
    40% {
      max-width: 200px;
      padding: 0 14px;
      opacity: 1;
    }
    48%,
    100% {
      max-width: 0;
      padding: 0;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flottante {
      animation: none;
    }

    .flottante-mot {
      animation: none;
    }
  }
</style>

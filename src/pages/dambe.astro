---
/**
 * Dambé, l'assistante.
 *
 * Le formulaire est un POST ordinaire : la page revient avec la réponse déjà
 * écrite. C'est plus lent à l'écran qu'une discussion qui se remplit toute
 * seule, mais ça marche sans JavaScript, sur un téléphone d'entrée de gamme et
 * sur une connexion qui tombe.
 *
 * Deux choses se passent AVANT le modèle :
 *   - la question est enregistrée par la base, qui vérifie les quotas ;
 *   - les mots qui disent une urgence déclenchent une réponse écrite par nous,
 *     sans aucun appel au modèle. Une orientation vers un soignant ne dépend
 *     pas de la disponibilité d'un service extérieur.
 */
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Mascotte from '../components/Mascotte.astro';
import Alerte from '../components/Alerte.astro';
import { clientSession, baseConfiguree } from '../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../lib/session';
import { ollamaConfigure, demanderOllama, ErreurOllama } from '../lib/ollama';
import { alerte, messagesPour, nettoyer, SUGGESTIONS, type ContexteAssistante } from '../lib/assistante';
import { prix, messageErreur } from '../lib/format';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);
// UN VRAI COMPTE, PAS SEULEMENT UNE SESSION (Arthur, le 27 octobre 2026).
//
// « Pour accéder à la messagerie et au niveau de compte, la personne va devoir
// se connecter. » Celle qui est entrée par « Commencer » a bien une session,
// et tout le reste de l'application lui est ouvert : son cycle, son journal,
// la boutique, ses commandes. Mais ici il faut un email : sans lui, personne
// ne peut lui répondre, et elle ne retrouverait rien en changeant de
// téléphone. L'écran de connexion explique pourquoi grâce à `pour`.
if (!moi.compteReel) return Astro.redirect('/connexion?pour=messagerie', 302);

const client = clientSession(Astro)!;
let erreur = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const question = String(f.get('question') ?? '').trim();

  if (question.length < 2) {
    erreur = 'Écris ta question.';
  } else {
    // 1. La base enregistre et compte. Si elle refuse, on s'arrête là : aucun
    //    appel au service extérieur n'est fait pour rien.
    const { data: pose, error: errPose } = await client.rpc('assistante_poser', { p_question: question });
    if (errPose || !pose?.ok) {
      erreur = messageErreur(pose?.erreur);
    } else {
      const { data: ctx } = await client.rpc('assistante_contexte');
      const contexte = (ctx ?? { catalogue: [], echanges: [] }) as ContexteAssistante;
      const signal = alerte(question);

      let texte = '';
      let produit: string | null = null;
      let entree = 0;
      let sortie = 0;

      if (signal.gravite === 'urgence') {
        // Rien ne part vers le modèle : cette réponse est écrite par nous.
        texte = signal.texte;
      } else if (!ollamaConfigure()) {
        erreur = "Dambé n'est pas encore branchée. Il manque son adresse et sa clé dans les réglages du site.";
      } else {
        try {
          const r = await demanderOllama(messagesPour(question, contexte));
          const propre = nettoyer(r.texte, (contexte.catalogue ?? []).map((p) => p.slug));
          texte = propre.texte;
          produit = propre.produit;
          entree = r.jetonsEntree;
          sortie = r.jetonsSortie;
          if (signal.gravite === 'soignant' && texte) {
            texte = `${texte}\n\n${signal.texte}`;
          }
          if (!texte) {
            erreur = "Dambé n'a pas réussi à répondre. Repose ta question autrement.";
          }
        } catch (e) {
          erreur =
            e instanceof ErreurOllama && e.statut === 429
              ? 'Dambé reçoit trop de questions en ce moment. Réessaie dans une minute.'
              : "Dambé n'a pas répondu à temps. Réessaie dans un moment.";
        }
      }

      if (texte) {
        await client.rpc('assistante_repondre', {
          p_id: pose.id,
          p_reponse: texte,
          p_produit: produit,
          p_entree: entree,
          p_sortie: sortie,
        });
        return Astro.redirect('/dambe#fin', 303);
      }
    }
  }
}

const { data: fil } = await client.rpc('mon_fil_assistante');
const messages = (fil ?? []) as {
  id: string;
  question: string;
  reponse: string | null;
  produit: string | null;
  cree_le: string;
}[];

// Les produits cités dans le fil, relus en base : le prix affiché est
// toujours celui du catalogue, jamais celui qu'un modèle a écrit.
const slugs = messages.map((m) => m.produit).filter((s): s is string => !!s);
let produits: Record<string, { nom: string; prix_cfa: number; rayon: string }> = {};
if (slugs.length > 0) {
  const { data } = await client.from('produits').select('slug, nom, prix_cfa, rayon').in('slug', slugs);
  for (const p of data ?? []) produits[p.slug] = p;
}

const panier = comptePanier(lirePanier(Astro));
const branchee = ollamaConfigure();
---

<Base titre="IA Dambé" nav="discussions" panier={panier}>
  <header class="barre">
    <div class="page barre-dedans">
      <a class="rond" href="/" aria-label="Retour à l'accueil">
        <Icone nom="retour" taille={20} epaisseur={2} />
      </a>
      {/* Le visage d'IA Dambé, pas le logo de l'application : c'est elle qui
          parle sur cet écran. Et le logo, dont le profil est noir, se perdrait
          sur ce fond sombre. */}
      <span class="portrait">
        <Mascotte etat="visage" taille={38} titre={null} />
      </span>
      <div>
        <h1>IA Dambé</h1>
        {/* « Prête à répondre » est supprimé (Arthur, 14 octobre 2026) : une
            assistante qui annonce qu'elle est prête dit ce qui se voit déjà.
            Quand elle n'est PAS branchée, en revanche, il faut le dire : sans
            ça, elle aurait juste l'air muette. */}
        {!branchee && (
          <div class="etat etat-off">
            <i></i>
            Pas encore branchée
          </div>
        )}
      </div>
      {/* La poubelle « Effacer toute la discussion » est retirée de cette
          barre (Arthur, 14 octobre 2026). La route `/dambe/effacer` reste en
          place, et effacer ses questions à Dambé reste possible depuis
          « Réinitialiser mon compte », sur la page Confidentialité : remettre le
          bouton ici tient en cinq lignes. */}
    </div>
  </header>

  <main class="page">
    {
      messages.length === 0 ? (
        <div class="accueil-dambe apparait">
          <Mascotte etat="salut" taille={120} titre="IA Dambé" />
          <h2>Pose ta question</h2>
          <p class="doux">
            Les douleurs, le retard, l'hygiène, les protections, ce qui est normal et ce qui ne l'est pas. Ce que tu
            n'oses pas demander ailleurs.
          </p>
        </div>
      ) : (
        <div class="fil">
          {messages.map((m) => (
            <>
              <div class="bulle-moi">{m.question}</div>
              {m.reponse ? (
                <div class="bulle-elle">{m.reponse}</div>
              ) : (
                /* Une question restée sans réponse (la page a été fermée
                   pendant que Dambé réfléchissait) : le même petit visage que
                   pendant l'attente, et non plus le grand dessin. */
                <div class="reflechit">
                  <Mascotte etat="visage" taille={24} titre={null} />
                  <span class="points" aria-label="Dambé réfléchit" role="img">
                    <i></i>
                    <i></i>
                    <i></i>
                  </span>
                </div>
              )}
              {m.produit && produits[m.produit] && (
                <a class="produit-propose" href={`/boutique/${m.produit}`}>
                  <span class="vignette">
                    <Icone nom={produits[m.produit].rayon === 'culottes' ? 'culotte' : produits[m.produit].rayon === 'lavables' ? 'tissu' : 'paquet'} taille={26} />
                  </span>
                  <span class="propose-texte">
                    <strong>{produits[m.produit].nom}</strong>
                    <span class="chiffre prix-propose">{prix(produits[m.produit].prix_cfa)} FCFA</span>
                  </span>
                  <Icone nom="avant" taille={18} />
                </a>
              )}
            </>
          ))}
        </div>
      )
    }

    <span id="fin"></span>

    {erreur && <div class="marge"><Alerte type="erreur" texte={erreur} /></div>}

    {
      !branchee && (
        <div class="marge">
          <Alerte
            type="attention"
            texte="Dambé répond dès qu'Arthur dépose l'adresse et la clé Ollama dans les réglages du site. Les réponses d'orientation vers un centre de santé, elles, marchent déjà."
          />
        </div>
      )
    }

    {
      messages.length === 0 && (
        <div class="suggestions">
          {SUGGESTIONS.map((s) => (
            <form method="POST">
              <input type="hidden" name="question" value={s} />
              <button class="puce" type="submit">{s}</button>
            </form>
          ))}
        </div>
      )
    }

    {/* La mention « Dambé n'est pas médecin et ne pose aucun diagnostic. Tes
        questions passent par un service d'IA extérieur. » a été retirée de
        sous la conversation le 14 octobre 2026, à la demande d'Arthur.
        `AVERTISSEMENT` reste dans `src/lib/assistante.ts` : la remettre tient
        en trois lignes. Ce qu'elle disait n'est pas perdu pour autant : la
        page `/confidentialite` garde sa section « Ce qui part vers Dambé »,
        qui dit que l'assistante tourne chez un prestataire extérieur. */}

    <div class="place-saisie"></div>
  </main>

  {/* --- La case où elle écrit, et le micro ---------------------------------
      Le micro ne pose pas un vocal : il écrit ses mots dans la case, qu'elle
      relit avant d'envoyer (décision d'Arthur du 13 octobre 2026). Dambé lit
      du texte et n'entend rien ; un vocal qui part sans être compris est une
      promesse en l'air.

      Il arrive CACHÉ. Le serveur ne sait pas si le navigateur sait écouter :
      c'est `dictee.ts` qui le montre, une fois sûr. Celle dont le téléphone
      ne sait pas écrit comme avant, sans voir un bouton mort.

      Le vrai vocal, celui qu'on enregistre et qu'on envoie, est dans la
      discussion avec le médecin : là-bas un humain écoute, donc le moré et le
      dioula passent, et aucun son ne sort vers un service extérieur. */}
  <form method="POST" class="saisie">
    <div class="page saisie-dedans">
      <label class="lecture-seule" for="question">Ta question</label>
      <input
        class="champ"
        id="question"
        name="question"
        type="text"
        placeholder="Écris ta question"
        maxlength="500"
        required
        autocomplete="off"
      />
      <button class="rond dictee" type="button" aria-pressed="false" aria-label="Dicter ma question" data-dictee data-cible="#question" data-dit=".dictee-dit" hidden>
        <Icone nom="micro" taille={21} />
      </button>
      <button class="rond rond-rose" type="submit" aria-label="Envoyer ma question">
        <Icone nom="envoyer" taille={21} />
      </button>
    </div>
    {/* Ce que le micro entend, dit à voix haute pour le lecteur d'écran :
        `aria-live` fait relire la ligne à chaque changement. */}
    <p class="page dictee-dit" aria-live="polite" hidden></p>
  </form>

  {/* Le modèle que `dambe-attente.ts` recopie quand elle envoie sa question
      (Arthur, 14 octobre 2026 : « ça doit partir, ensuite la tête de la
      mascotte apparaît comme si elle réfléchit, et enfin elle répond »).
      C'est un modèle plutôt qu'un morceau écrit dans le script : la bulle et
      le dessin sont ainsi EXACTEMENT ceux que le serveur rend lui-même, et le
      jour où ils changent, ils changent aux deux endroits à la fois. */}
  <template id="modele-attente">
    <div class="bulle-moi"></div>
    {/* Arthur, 14 octobre 2026 : « avant que l'IA réponde il y a de gros trucs
        qui apparaissent au milieu [...] enlève ça. À la place mets la mascotte
        en petit à gauche qui va apparaître avant la réponse. Elle sera en
        train de réfléchir. Et dès que la réponse arrive elle disparaît. »
        C'est donc son visage, petit, posé à gauche comme une bulle de
        réponse, avec trois points qui respirent. Le dessin plein écran
        `etat-reflechit` ne sert plus ici. */}
    <div class="reflechit">
      <Mascotte etat="visage" taille={24} titre={null} />
      <span class="points" aria-label="Dambé réfléchit" role="img">
        <i></i>
        <i></i>
        <i></i>
      </span>
    </div>
  </template>

  <script>
    import '../scripts/dictee';
    import '../scripts/dambe-attente';
  </script>
</Base>

<style>
  .barre {
    background: var(--surface);
    border-bottom: 1px solid var(--bordure);
  }

  .barre-dedans {
    display: flex;
    align-items: center;
    gap: var(--e3);
    padding: var(--e4) var(--e4);
  }

  .portrait {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    flex: none;
    overflow: hidden;
    border-radius: 13px;
    background: var(--rose-clair);
  }

  h1 {
    font-size: 19px;
  }

  .etat {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 13.5px;
    font-weight: 600;
  }

  .etat i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
  }

  .etat-ok {
    color: var(--vert);
  }

  .etat-ok i {
    background: var(--vert);
  }

  .etat-off {
    color: var(--ambre);
  }

  .etat-off i {
    background: var(--ambre);
  }

  .accueil-dambe {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e3);
    padding: var(--e7) 0 var(--e5);
    text-align: center;
  }

  .accueil-dambe h2 {
    font-size: 24.5px;
  }

  .doux {
    max-width: 320px;
    font-size: 16px;
    color: var(--texte-2);
    line-height: 1.5;
  }

  .fil {
    padding-top: var(--e4);
  }

  /* Le petit visage de Dambé, à gauche, avec trois points qui respirent
     (Arthur, 14 octobre 2026). Il prend la place d'une bulle de réponse, et
     disparaît dès que la vraie réponse le remplace. */
  /* Ni carré, ni bulle, ni fond (Arthur, 14 octobre 2026 : « supprime le carré
     dans lequel est la mascotte lorsqu'elle réfléchit »). Juste son visage, en
     petit, à gauche, et trois points qui respirent à côté. */
  .reflechit {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: 7px;
    padding: 2px 0;
  }

  .points {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .points i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--rose);
    opacity: 0.35;
    animation: dambe-point 1.3s ease-in-out infinite;
  }

  .points i:nth-child(2) {
    animation-delay: 0.18s;
  }

  .points i:nth-child(3) {
    animation-delay: 0.36s;
  }

  @keyframes dambe-point {
    0%, 60%, 100% {
      opacity: 0.3;
      transform: translateY(0);
    }
    30% {
      opacity: 1;
      transform: translateY(-3px);
    }
  }

  /* Elle respire doucement au lieu de sauter, pour qui a demandé moins de
     mouvement. Le point reste visible : il dit que quelque chose se passe. */
  @media (prefers-reduced-motion: reduce) {
    .points i {
      animation: none;
      opacity: 0.75;
    }
  }

  .produit-propose {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: var(--e3);
    max-width: 88%;
    padding: 10px;
    border: 1px solid var(--bordure);
    border-radius: 16px;
    background: var(--surface);
    color: inherit;
  }

  .vignette {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    flex: none;
    border-radius: 12px;
    background: var(--surface-douce);
    color: var(--rose);
  }

  .propose-texte {
    min-width: 0;
  }

  .propose-texte strong {
    display: block;
    font-size: 15px;
    line-height: 1.3;
  }

  .prix-propose {
    font-size: 17px;
    color: var(--rose);
  }

  .suggestions {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    margin-top: var(--e4);
  }

  .suggestions .puce {
    width: 100%;
    text-align: left;
  }


  .marge {
    margin-top: var(--e4);
  }

  /* La saisie est posée au-dessus de la barre basse. On réserve sa hauteur
     entière, sinon la dernière phrase finit cachée derrière (constaté sur la
     capture du 12 octobre : l'avertissement était coupé en deux). */
  .place-saisie {
    height: 170px;
  }

  .saisie {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(var(--nav-hauteur) + env(safe-area-inset-bottom, 0px));
    z-index: 19;
    background: var(--fond);
    border-top: 1px solid var(--bordure);
  }

  .saisie-dedans {
    display: flex;
    gap: var(--e2);
    align-items: center;
    padding: var(--e3) var(--e4);
  }

  /* Une écriture plus petite que dans le reste de l'application (Arthur, 14
     octobre 2026 : « quand j'écris un message sur la barre les écritures sont
     trop grosses »). On s'arrête à 16 px et pas moins : en dessous, Safari sur
     iPhone zoome tout seul sur la page dès qu'elle touche la case, et il faut
     ensuite pincer l'écran pour revenir. */
  .saisie-dedans .champ {
    font-size: 16px;
  }

  /* Plus de rose quand elle commence à taper (Arthur, 14 octobre 2026). La
     bordure se fonce quand même : sans aucun changement, on ne sait plus où
     on écrit, et c'est le genre de repère dont on ne mesure l'utilité qu'une
     fois perdu. Les autres champs de l'application gardent le rose. */
  .saisie-dedans .champ:focus {
    border-color: var(--bordure-forte);
  }

  /* --- Le micro ---
     Au repos il est discret : un rond blanc comme les autres. En train
     d'écouter il devient rose et respire, parce qu'un micro ouvert doit se
     voir de loin. On n'enregistre rien, mais elle doit quand même savoir à la
     seconde près quand le téléphone l'écoute. */
  .dictee[hidden] {
    display: none;
  }

  .dictee-ecoute {
    background: var(--rose);
    border-color: var(--rose);
    color: #fff;
    animation: dictee-respire 1.6s ease-in-out infinite;
  }

  .dictee-ecoute:hover {
    background: var(--rose-fonce);
  }

  @keyframes dictee-respire {
    0%, 100% { box-shadow: 0 0 0 0 rgba(208, 32, 106, 0.45); }
    60% { box-shadow: 0 0 0 9px rgba(208, 32, 106, 0); }
  }

  /* La ligne sous la case : ce que le micro entend, ou pourquoi il n'entend
     rien. Elle pousse la case vers le haut au lieu de passer par-dessus : un
     message qui recouvre ce qu'elle écrit n'aide personne. */
  .dictee-dit {
    padding: 0 var(--e4) var(--e3);
    margin-top: calc(var(--e3) * -1);
    font-size: 14.5px;
    line-height: 1.35;
    color: var(--texte-2);
  }

  .dictee-dit[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .dictee-ecoute {
      animation: none;
    }
  }
</style>

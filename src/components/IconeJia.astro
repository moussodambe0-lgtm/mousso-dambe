  {name === 'refund' && (<><path d="M4 12a8 8 0 1 1 2.6 5.9" /><path d="M4 17v-4h4" /></>)}
  {name === 'message-star' && (<><path d="M4 4h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9l-5 4V5a1 1 0 0 1 1-1z" /><path d="M12 7l1 2 2 .3-1.5 1.4.4 2-1.9-1-1.9 1 .4-2L9 9.3 11 9l1-2z" fill="currentColor" stroke="none" /></>)}
  {name === 'cancel' && (<><circle cx="12" cy="12" r="9" /><path d="M9 9l6 6M15 9l-6 6" /></>)}

  {name === 'check' && (<path d="M6 12l4 4 8-9" />)}

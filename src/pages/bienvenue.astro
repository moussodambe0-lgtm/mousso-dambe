---
/**
 * LE QUESTIONNAIRE D'ACCUEIL, HUIT QUESTIONS.
 *
 * Section 3 du cahier d'Arthur du 12 octobre 2026. Une question par écran,
 * en plein écran, chacune avec sa grande illustration. Jamais un écran blanc
 * avec juste une question : ces questions sont intimes, et un formulaire nu
 * sur ce sujet fait fermer l'application.
 *
 * Il marche SANS JavaScript : chaque étape est un POST qui renvoie la
 * suivante, et les réponses déjà données voyagent dans des champs cachés.
 * Rien n'est écrit en base avant le dernier écran, pour qu'une fille qui
 * abandonne en route n'ait rien laissé derrière elle.
 *
 * Trois choses apprises en se servant de l'application, et gardées ici :
 *   - la valeur visible doit l'emporter sur la valeur cachée du même nom,
 *     sinon la réponse qu'on vient de donner est jetée (c'est ce qui
 *     bloquait l'écran de la date) ;
 *   - une saisie libre existe partout où on demande un nombre, parce que
 *     « 27 jours » n'était dans aucune liste ;
 *   - « Je ne sais pas » est une vraie réponse, avec une valeur par défaut
 *     raisonnable derrière, pas une impasse.
 */
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import Anim from '../components/Anim.astro';
import Mascotte from '../components/Mascotte.astro';
import MascotteEntiere from '../components/MascotteEntiere.astro';
import Alerte from '../components/Alerte.astro';
// Les huit illustrations de Motion (12 octobre 2026) et leurs animations.
import '../styles/questions-huit.css';
import { clientSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { messageErreur, aujourdhui, dateDe, enIso, dateLongue, dateCourte } from '../lib/format';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);

const TOTAL = 5;
let etape = Number(Astro.url.searchParams.get('etape') ?? '1');
let erreur = '';

// L'écran de fin, après l'enregistrement.
const fini = Astro.url.searchParams.get('fini') === '1';

let reponses = {
  prenom: moi.prenom,
  dernieres: '',
  sait: 'oui',
  duree: '5',
  cycle: '28',
  regularite: '',
  ressentis: [] as string[],
  objectif: '',
  protection: '',
};

/**
 * La dernière réponse non vide portant ce nom.
 *
 * Chaque champ existe deux fois dans le formulaire : une fois caché, qui
 * transporte la réponse des étapes précédentes, et une fois visible pour la
 * question en cours. Le champ caché vient en premier dans la page, donc
 * `formData.get()` renvoyait toujours LUI, et la réponse qu'elle venait de
 * donner était jetée. Sur l'écran de la date, cela bloquait le questionnaire :
 * quelle que soit la date choisie, l'écran redemandait la même chose.
 * Défaut trouvé par Arthur le 12 octobre 2026, en se servant de l'application.
 */
function derniereReponse(f: FormData, nom: string, defaut: string): string {
  const valeurs = f
    .getAll(nom)
    .map((v) => String(v).trim())
    .filter((v) => v !== '');
  return valeurs.length > 0 ? valeurs[valeurs.length - 1] : defaut;
}

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  reponses = {
    prenom: derniereReponse(f, 'prenom', moi.prenom),
    dernieres: derniereReponse(f, 'dernieres', ''),
    sait: derniereReponse(f, 'sait', 'oui'),
    duree: derniereReponse(f, 'duree', '5'),
    cycle: derniereReponse(f, 'cycle', '28'),
    regularite: derniereReponse(f, 'regularite', ''),
    // Un choix multiple : on garde TOUTES les valeurs, pas la dernière.
    ressentis: f
      .getAll('ressentis')
      .map((v) => String(v))
      .filter(Boolean),
    objectif: derniereReponse(f, 'objectif', ''),
    protection: derniereReponse(f, 'protection', ''),
  };
  const venantDe = Number(f.get('etape') ?? '1');

  if (venantDe === 1) {
    if (reponses.prenom.trim().length < 1) {
      erreur = 'Dis-moi comment on t’appelle, même un surnom.';
      etape = 1;
    } else {
      etape = 2;
    }
  } else if (venantDe === 2 && reponses.sait === 'oui') {
    const d = reponses.dernieres;
    if (!/^\d{4}-\d{2}-\d{2}$/.test(d)) {
      erreur = "Choisis la date du premier jour de tes dernières règles, ou dis que tu ne t'en souviens pas.";
      etape = 2;
    } else if (d > aujourdhui()) {
      erreur = 'Cette date est dans le futur.';
      etape = 2;
    } else if (dateDe(d) < new Date(Date.now() - 120 * 86400000)) {
      erreur = 'Cette date est trop ancienne pour servir de point de départ.';
      etape = 2;
    } else {
      etape = 3;
    }
  } else if (venantDe === 3) {
    const n = Number(reponses.duree);
    if (!Number.isInteger(n) || n < 1 || n > 10) {
      erreur = 'Donne un nombre de jours entre 1 et 10, ou dis que tu ne sais pas.';
      etape = 3;
    } else {
      etape = 4;
    }
  } else if (venantDe === 4) {
    const n = Number(reponses.cycle);
    if (!Number.isInteger(n) || n < 20 || n > 45) {
      erreur = 'Donne un nombre de jours entre 20 et 45, ou dis que tu ne sais pas.';
      etape = 4;
    } else {
      etape = 5;
    }
  } else if (venantDe === TOTAL) {
    // Dernier écran : on écrit, une seule fois, par la fonction de la base.
    const client = clientSession(Astro);
    const { data, error } = await client!.rpc('enregistrer_questionnaire', {
      p_prenom: reponses.prenom,
      p_cycle: Number(reponses.cycle),
      p_duree: Number(reponses.duree),
      p_dernieres_regles: reponses.sait === 'oui' && reponses.dernieres ? reponses.dernieres : null,
      p_regularite: reponses.regularite || 'inconnue',
      p_ressentis: reponses.ressentis,
      p_objectif: reponses.objectif || 'suivre',
      p_protection: reponses.protection || 'jetables',
    });
    if (error || !data?.ok) {
      erreur = messageErreur(data?.erreur ?? null);
      etape = TOTAL;
    } else {
      return Astro.redirect(`/bienvenue?fini=1&prenom=${encodeURIComponent(reponses.prenom)}`, 303);
    }
  } else {
    etape = Math.min(venantDe + 1, TOTAL);
  }
}

etape = Math.min(Math.max(etape, 1), TOTAL);

// Les dix derniers jours proposés en un geste : taper une date au clavier sur
// un téléphone d'entrée de gamme est pénible, et la bonne réponse est presque
// toujours récente.
const joursRecents = Array.from({ length: 10 }, (_, i) => {
  const d = new Date();
  d.setDate(d.getDate() - i);
  return { iso: enIso(d), libelle: i === 0 ? "Aujourd'hui" : i === 1 ? 'Hier' : dateLongue(enIso(d)) };
});

// Ce qu'elle a déjà répondu, rappelé sous la barre d'avancement. Sans ça, deux
// écrans qui posent tous les deux une question en jours se ressemblent assez
// pour qu'on croie que rien ne s'est passé.
const dejaDit: string[] = [];
if (etape >= 2 && reponses.prenom) dejaDit.push(reponses.prenom);
if (etape >= 3) {
  dejaDit.push(reponses.sait === 'oui' && reponses.dernieres ? dateCourte(reponses.dernieres) : 'date inconnue');
}
if (etape >= 4) dejaDit.push(`règles ${reponses.duree} j`);
if (etape >= 5) dejaDit.push(`cycle ${reponses.cycle} j`);

const TITRES: Record<number, string> = {
  1: 'Comment tu t’appelles ?',
  2: 'Quand ont commencé tes dernières règles ?',
  3: 'Combien de jours durent tes règles, d’habitude ?',
  4: 'Durée du cycle : combien de jours entre chaque règles ?',
  5: 'Tes règles sont-elles régulières ?',
};

const AIDES: Record<number, string> = {
  1: 'Ton prénom suffit, ou un surnom. Il ne sert qu’à te parler, et à personne d’autre.',
  2: 'Le premier jour de saignement, pas le dernier. C’est la seule date dont j’ai besoin pour calculer la suite.',
  3: 'Du premier jour de saignement au dernier. Si ça change d’un mois à l’autre, donne une moyenne.',
  4: 'Du premier jour de tes règles au premier jour des suivantes. Chez beaucoup de femmes c’est entre 25 et 32 jours.',
  5: 'Il n’y a pas de bonne réponse. Si tes cycles bougent, l’application te le dira autrement, c’est tout.',
};

const REGULARITES = [
  { id: 'oui', libelle: 'Oui, c’est régulier', sous: 'À deux ou trois jours près', icone: 'coche' },
  { id: 'parfois', libelle: 'Pas toujours', sous: 'Ça bouge d’un mois à l’autre', icone: 'tissu' },
  { id: 'non', libelle: 'Non, jamais pareil', sous: 'Impossible de prévoir', icone: 'horloge' },
  { id: 'inconnue', libelle: 'Je ne sais pas', sous: 'Je n’ai jamais compté', icone: 'info' },
];

// Le questionnaire s'arrête à la régularité (13 octobre 2026, trois demandes
// successives d'Arthur : « supprime cette page » pour les ressentis, ce
// qu'elle cherche, et la protection utilisée). Ces trois questions ne sont
// plus posées ; la base garde leurs colonnes avec leurs valeurs par défaut
// ('suivre', 'jetables', aucun ressenti), pour le jour où elles reviendraient.

const DUREES_REGLES = [3, 4, 5, 6, 7];
const DUREES_CYCLE = [26, 28, 30, 32];

const prenomFini = Astro.url.searchParams.get('prenom') ?? moi.prenom;
---

{
  fini ? (
    <Base titre="C'est prêt" pleinEcran>
      <main class="fin">
        <Mascotte etat="bravo" taille={200} titre={null} />
        <h1>Merci {prenomFini} !</h1>
        <p>Je prépare ton calendrier…</p>
        <a class="btn btn-rose" href="/">Entrer</a>
      </main>
    </Base>
  ) : (
    <Base titre="Bienvenue" pleinEcran>
      <main class="questionnaire">
        <header class="haut">
          <a class="rond" href={etape === 1 ? '/' : `/bienvenue?etape=${etape - 1}`} aria-label="Question précédente">
            <Icone nom="retour" taille={20} epaisseur={2} />
          </a>
          <div class="progression">
            <div class="ligne-haute">
              <span>
                {etape} / {TOTAL}
              </span>
              <span>{etape < 4 ? '1 minute' : etape < 7 ? '30 secondes' : 'presque fini'}</span>
            </div>
            <div class="rail">
              <div class:list={['jauge', `part-${etape}`]} />
            </div>
          </div>
        </header>

        {/* --- La moitié haute : l'illustration --- */}
        <div class:list={['tableau', etape === 1 && 'tableau-mascotte']}>
          {/* La toute première image, quand on touche « Commencer » : la
              mascotte EN ENTIER, qui enchaîne des mouvements différents (Arthur,
              13 octobre 2026). Les sept autres écrans gardent leur dessin. */}
          {etape === 1 && <MascotteEntiere hauteur="grande" />}
          {etape === 2 && <Anim nom="q2-date" repli="phase-regles" classe="dessin" />}
          {etape === 3 && <Anim nom="q3-duree-regles" repli="phase-regles" classe="dessin" />}
          {etape === 4 && <Anim nom="q4-duree-cycle" repli="q-cycle" classe="dessin" />}
          {etape === 5 && <Anim nom="q5-regularite" repli="phase-lune" classe="dessin" />}
        </div>

        {/* --- La moitié basse : la question --- */}
        <form class="bas" method="POST">
          {/* Les réponses déjà données voyagent cachées d'une étape à l'autre.
              Celle que l'écran en cours demande n'est PAS reportée ici : sinon
              le champ caché et le champ visible portent le même nom, et la
              vieille valeur masque la nouvelle. */}
          <input type="hidden" name="etape" value={etape} />
          {etape !== 1 && <input type="hidden" name="prenom" value={reponses.prenom} />}
          {etape !== 2 && <input type="hidden" name="dernieres" value={reponses.dernieres} />}
          {etape !== 2 && <input type="hidden" name="sait" value={reponses.sait} />}
          {etape !== 3 && <input type="hidden" name="duree" value={reponses.duree} />}
          {etape !== 4 && <input type="hidden" name="cycle" value={reponses.cycle} />}

          {dejaDit.length > 0 && (
            <div class="deja" aria-label="Ce que tu as déjà répondu">
              {dejaDit.map((bout) => (
                <span class="bout">
                  <Icone nom="coche" taille={12} epaisseur={2.5} />
                  {bout}
                </span>
              ))}
            </div>
          )}

          <h1>{TITRES[etape]}</h1>
          <p class="aide">{AIDES[etape]}</p>

          {erreur && (
            <div class="marge">
              <Alerte type="erreur" texte={erreur} />
            </div>
          )}

          {/* --- 1. Le prénom --- */}
          {etape === 1 && (
            <div class="corps">
              <label class="lecture-seule" for="p">
                Ton prénom
              </label>
              <input
                class="champ"
                id="p"
                name="prenom"
                type="text"
                required
                maxlength="40"
                value={reponses.prenom}
                autocomplete="given-name"
                placeholder="Awa"
              />
              <button class="btn btn-rose btn-plein marge" type="submit">
                Continuer
              </button>
            </div>
          )}

          {/* --- 2. La date --- */}
          {etape === 2 && (
            <div class="corps">
              <div class="jours">
                {joursRecents.map((j) => (
                  <button
                    class="puce"
                    type="submit"
                    name="dernieres"
                    value={j.iso}
                    aria-pressed={reponses.dernieres === j.iso}
                  >
                    {j.libelle}
                  </button>
                ))}
              </div>
              <label class="libelle marge" for="d">
                Ou une autre date
              </label>
              <input class="champ" id="d" name="dernieres" type="date" max={aujourdhui()} value={reponses.dernieres} />
              <button class="btn btn-rose btn-plein marge" type="submit">
                Continuer
              </button>
              <button class="btn btn-texte btn-plein" type="submit" name="sait" value="non">
                Je ne m'en souviens pas
              </button>
            </div>
          )}

          {/* --- 3. La durée des règles --- */}
          {etape === 3 && (
            <div class="corps">
              {/* La saisie libre vient AVANT les propositions : quand elle
                  touche une proposition, c'est la valeur la plus récente dans
                  la page qui compte, et une saisie restée vide ne doit pas
                  l'emporter sur le bouton qu'elle vient de toucher. */}
              <label class="libelle-petit" for="duree-libre">
                Un autre nombre de jours
              </label>
              <div class="ligne-saisie">
                <input
                  class="champ champ-nombre"
                  id="duree-libre"
                  name="duree"
                  type="number"
                  inputmode="numeric"
                  min="2"
                  max="10"
                  placeholder="5"
                />
                <button class="btn btn-contour" type="submit">
                  Valider
                </button>
              </div>

              <div class="gouttes">
                {DUREES_REGLES.map((n) => (
                  <button class="goutte-choix" type="submit" name="duree" value={String(n)}>
                    <span class="goutte-pile" aria-hidden="true">
                      {Array.from({ length: Math.min(n, 4) }).map(() => (
                        <Icone nom="goutte" taille={12} />
                      ))}
                    </span>
                    <span class="goutte-n">{n}</span>
                    <span class="goutte-mot">jours</span>
                  </button>
                ))}
              </div>

              {/* Un petit rectangle, bien visible (Arthur, 13 octobre 2026) : c'était
                  une ligne de texte grise qu'on ne reconnaissait pas comme un
                  bouton. */}
              <button class="je-sais-pas" type="submit" name="duree" value="5">
                <b>Je ne sais pas</b>
                <span>on partira sur 5 jours</span>
              </button>
            </div>
          )}

          {/* --- 4. La durée du cycle --- */}
          {etape === 4 && (
            <div class="corps">
              <label class="libelle-petit" for="cycle-libre">
                Un autre nombre de jours
              </label>
              <div class="ligne-saisie">
                <input
                  class="champ champ-nombre"
                  id="cycle-libre"
                  name="cycle"
                  type="number"
                  inputmode="numeric"
                  min="21"
                  max="45"
                  placeholder="28"
                />
                <button class="btn btn-contour" type="submit">
                  Valider
                </button>
              </div>

              <div class="cartes-courtes">
                {DUREES_CYCLE.map((n) => (
                  <button class="carte-courte" type="submit" name="cycle" value={String(n)}>
                    <span class="carte-courte-n">{n}</span>
                    <span class="carte-courte-mot">jours</span>
                  </button>
                ))}
              </div>

              <button class="je-sais-pas" type="submit" name="cycle" value="28">
                <b>Je ne sais pas</b>
                <span>on partira sur 28 jours</span>
              </button>
            </div>
          )}

          {/* --- 5. La régularité --- */}
          {etape === 5 && (
            <div class="corps">
              <div class="cartes">
                {REGULARITES.map((r) => (
                  <button class="carte-choix" type="submit" name="regularite" value={r.id}>
                    <span class="carte-icone">
                      <Icone nom={r.icone} taille={20} />
                    </span>
                    <span class="carte-texte">
                      <b>{r.libelle}</b>
                      <span>{r.sous}</span>
                    </span>
                    <Icone nom="avant" taille={17} classe="carte-fleche" />
                  </button>
                ))}
              </div>
            </div>
          )}

          {/* Le questionnaire s'arrête ici : les trois pages qui suivaient
              (ressentis, objectif, protection) ont été retirées le 13 octobre
              2026, à la demande d'Arthur. Toucher une carte ci-dessus envoie
              directement le formulaire, qui l'enregistre et termine. */}
        </form>
      </main>
    </Base>
  )
}

<style>
  .questionnaire {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    max-width: 480px;
    margin: 0 auto;
    /* Le glissement d'arrivée part de la droite : sans ça, l'écran se laisse
       tirer de côté pendant une demi-seconde. `clip` plutôt que `hidden`, qui
       créerait une zone de défilement. Défaut d'avant l'agrandissement des
       écritures du 13 octobre 2026, trouvé en le vérifiant. */
    overflow-x: clip;
  }

  /* --- La barre d'avancement --- */
  .haut {
    display: flex;
    align-items: center;
    gap: var(--e3);
    padding: var(--e4) var(--e4) var(--e2);
  }

  .rond {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border: 1px solid var(--bordure);
    border-radius: 50%;
    background: var(--surface);
    color: var(--encre);
  }

  .progression {
    flex: 1;
  }

  .ligne-haute {
    display: flex;
    justify-content: space-between;
    margin-bottom: 5px;
    font-size: 13.5px;
    color: var(--texte-3);
  }

  .rail {
    height: 5px;
    border-radius: var(--r-ronde);
    background: var(--surface-douce);
    overflow: hidden;
  }

  .jauge {
    height: 100%;
    border-radius: var(--r-ronde);
    background: var(--rose);
  }

  .part-1 { width: 20%; }
  .part-2 { width: 40%; }
  .part-3 { width: 60%; }
  .part-4 { width: 80%; }
  .part-5 { width: 100%; }

  /* --- La moitié haute : l'illustration --- */
  .tableau {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    max-height: 34dvh;
    padding: var(--e3) var(--e4);
    overflow: hidden;
    /* Le glissement horizontal d'une question à l'autre, demandé dans le
       cahier. Il se joue à l'arrivée de la page, donc sans script. */
    animation: glisse-dessin 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  /* La première étape : la mascotte entière a besoin de plus de place que les
     dessins carrés des autres, et elle ne doit pas être rognée. */
  .tableau-mascotte {
    min-height: 40dvh;
    max-height: none;
    overflow: visible;
    align-items: flex-end;
    padding-top: var(--e4);
    padding-bottom: var(--e3);
  }

  .tableau :global(.dessin) {
    width: 100%;
    max-width: 310px;
  }

  .tableau :global(.dessin svg) {
    width: 100%;
    height: auto;
    max-height: 30dvh;
  }

  /* --- La moitié basse --- */
  .bas {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--e4) var(--e4) var(--e6);
    border-radius: var(--r-feuille) var(--r-feuille) 0 0;
    background: var(--surface);
    animation: glisse-bas 0.5s 0.06s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .bas h1 {
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
  }

  .aide {
    margin-top: 6px;
    font-size: 15px;
    color: var(--texte-2);
    line-height: 1.45;
  }

  .corps {
    margin-top: var(--e4);
  }

  .deja {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin-bottom: var(--e3);
  }

  .bout {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 9px;
    border-radius: var(--r-ronde);
    background: var(--surface-douce);
    color: var(--texte-2);
    font-size: 13px;
    font-weight: 600;
  }

  .marge {
    margin-top: var(--e3);
  }

  .libelle,
  .libelle-petit {
    display: block;
    margin-bottom: 5px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--texte-2);
  }

  .libelle-petit {
    font-size: 13.5px;
  }

  .champ {
    width: 100%;
    min-height: 50px;
    padding: 0 var(--e3);
    border: 1px solid var(--bordure);
    border-radius: var(--r-champ);
    background: var(--surface);
    font-family: var(--texte);
    font-size: 18px;
  }

  .ligne-saisie {
    display: flex;
    gap: var(--e2);
    margin-bottom: var(--e4);
  }

  .champ-nombre {
    flex: 1;
    min-width: 0;
  }

  /* --- Les dates proposées --- */
  .jours {
    display: flex;
    flex-wrap: wrap;

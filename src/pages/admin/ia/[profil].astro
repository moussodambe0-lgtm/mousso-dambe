---
/**
 * UN ÉCHANGE AVEC IA DAMBÉ, lu par l'administration.
 *
 * Arthur, le 5 novembre 2026 : « je veux voir seulement les conversations que
 * les gens ont avec l'IA ». Cette page est l'ouverture d'une ligne de
 * `/admin/conversations`.
 *
 * ELLE NE RÉPOND PAS, et il n'y a pas de zone d'écriture. C'est voulu, et ce
 * n'est pas une étape qui manque : Dambé répond toute seule, et une réponse
 * écrite à la main arriverait dans le fil sous son nom à elle. La fille
 * croirait que la machine lui a répondu alors que c'est un humain. Si un jour
 * il faut pouvoir répondre, il faudra d'abord décider comment le lui dire.
 *
 * Elle ne lit ni le cycle, ni le journal : `fil_ia()` ne touche pas à ces
 * tables. Et comme l'écran de la liste, elle attend que la politique de
 * confidentialité dise qu'un humain peut relire ces échanges.
 *
 * Pas d'en-tête d'administration ni d'onglets : une conversation ouverte est un
 * endroit où l'on est entré, on en sort par la flèche. Même raison que pour
 * `/admin/[fil]`, demandée par Arthur le même jour.
 */
import BaseGestion from '../../../layouts/BaseGestion.astro';
import Icone from '../../../components/IconeJia.astro';
import Avatar from '../../../components/Avatar.astro';
import { exigerGestion } from '../../../lib/gestion';
import { heure, dateCourte } from '../../../lib/format-gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

const { profil } = Astro.params;

// Un profil est un UUID, et rien d'autre : cette route ne doit pas se laisser
// appeler avec n'importe quoi et répondre « Conversation ».
const EST_UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!profil || !EST_UUID.test(profil)) return Astro.rewrite('/404');

const { data, error } = await sb.rpc('fil_ia', { p_profil: profil });
if (error) console.error('fil_ia', error.message);

const ouvert = data?.ok === true;
// Le fil existe, mais elle n'a pas accepté qu'on le relise. Ce n'est pas la
// même chose qu'un fil introuvable, et l'écran ne doit pas dire la même chose.
const sansAccord = data?.erreur === 'sans_accord';
const tete = ouvert ? data.tete : null;

type MessageIA = {
  id: string;
  question: string | null;
  reponse: string | null;
  produit: string | null;
  ouvert_par: 'elle' | 'dambe';
  cree_le: string;
  repondu_le: string | null;
};
const messages = (ouvert ? (data.messages ?? []) : []) as MessageIA[];

// Le trait de date entre deux journées, posé une seule fois par jour. Calculé
// ici plutôt que dans le balisage : une comparaison de dates au milieu d'une
// boucle d'affichage se relit mal.
let jourPrecedent = '';
const lignes = messages.map((m) => {
  const jour = new Date(m.cree_le).toDateString();
  const nouveauJour = jour !== jourPrecedent;
  jourPrecedent = jour;
  return { ...m, nouveauJour };
});
---

<BaseGestion
  titre={ouvert && tete ? tete.prenom : 'Échange'}
  description="Échange avec IA Dambé."
  sansNav
>
  {!ouvert && (
    <div class="etat-vide">
      <Icone name="lock" size={32} class="icone-vide" />
      <div class="titre">
        {sansAccord ? "Elle n'a pas donné son accord" : "Cet échange ne s'ouvre pas"}
      </div>
      {/* La raison, et une seule ligne. Un refus muet se prend pour un défaut
          de la page, et on finit par chercher un bogue là où la loi travaille.
          Article 26 de la loi n°037-2026/ALP : sans accord exprès, lire est
          l'acte interdit. */}
      {sansAccord && <div class="texte">Tant qu'elle n'accepte pas, ce fil ne se lit pas.</div>}
      <a class="btn btn-contour espace" href="/admin/conversations">Retour aux conversations</a>
    </div>
  )}

  {ouvert && tete && (
    <>
      <header class="entete-page barre-fil">
        <a class="retour" href="/admin/conversations" aria-label="Retour aux conversations">
          <Icone name="chevron-left" size={20} stroke={2} />
        </a>
        <Avatar fichier={tete.avatar_fichier} prenom={tete.prenom} taille={38} contour={false} />
        <span class="qui">
          <strong>{tete.prenom}</strong>
          <span class="sous-qui">
            IA Dambé · {tete.messages} message{tete.messages > 1 ? 's' : ''}
          </span>
        </span>
      </header>

      <div class="fil fil-messages">
        {lignes.length === 0 && <p class="debut">Rien dans cet échange.</p>}
        {lignes.map((m) => (
          <>
            {m.nouveauJour && <div class="jour">{dateCourte(m.cree_le)}</div>}

            {/* Ce qu'elle a écrit. Quand c'est Dambé qui a ouvert la
                conversation d'elle-même, il n'y a pas de question : on ne
                dessine pas une bulle vide. */}
            {m.question && (
              <div class="bulle bulle-lui">
                <div class="corps">
                  <span class="texte-message">{m.question}</span>
                </div>
                <div class="heure">{heure(m.cree_le)}</div>
              </div>
            )}

            {/* Ce que Dambé a répondu. Sans réponse, l'assistante a échoué :
                on le dit, plutôt que de laisser un trou qu'on prendrait pour
                un défaut de cette page. */}
            {m.reponse ? (
              <div class="bulle bulle-moi">
                <div class="corps">
                  <span class="texte-message">{m.reponse}</span>
                </div>
                <div class="heure">
                  {m.repondu_le ? heure(m.repondu_le) : heure(m.cree_le)}
                  {m.ouvert_par === 'dambe' && ' · Dambé a ouvert'}
                </div>
              </div>
            ) : (
              <div class="bulle bulle-moi">
                <div class="corps">
                  <span class="sans-reponse">Pas de réponse</span>
                </div>
              </div>
            )}
          </>
        ))}
      </div>
    </>
  )}
</BaseGestion>

{/* LE BLOC DE CORRESPONDANCE. `Avatar` est écrit avec les variables de la
    feuille des clientes, que ce socle ne charge pas : sans ces lignes, le rond
    qui porte l'initiale serait sans couleur. Chacune tombe sur son équivalent
    chez Jia. `is:global` parce qu'une variable posée dans un style scopé
    n'atteindrait pas l'intérieur d'un composant. Même bloc que dans
    `/admin/[fil]`, pour la même raison. */}
<style is:global>
  :root {
    --rose: var(--action);
    --texte-2: var(--texte-corps);
    --texte-3: var(--texte-tertiaire);
    --texte: 'Karla', system-ui, -apple-system, sans-serif;
    --e2: 8px;
  }
</style>

<style>
  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }
  .espace { margin-top: 16px; }

  .barre-fil { gap: 10px; }
  .qui { flex: 1; min-width: 0; }
  .qui strong {
    display: block;
    font-family: 'Outfit', sans-serif;
    font-size: 16.5px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sous-qui {
    display: block;
    margin-top: 1px;
    font-size: 12.5px;
    color: var(--texte-secondaire);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---------- Le fil ----------
     Mêmes valeurs que `/admin/[fil]` : `.fil` de Jia ne donne que la colonne,
     l'écartement et les marges se posent ici. Sans elles, les bulles touchent
     les deux bords de l'écran. */
  .fil-messages {
    gap: 9px;
    padding: 16px var(--gouttiere) 40px;
    min-height: 50vh;
  }

  /* La pilule du changement de jour, celle de Jia. */
  .jour {
    align-self: center;
    margin: 6px 0;
    padding: 3px 10px;
    border: 1px solid var(--bordure);
    border-radius: var(--r-pilule);
    background: var(--surface);
    font-size: 12px;
    font-weight: 700;
    color: var(--texte-tertiaire);
  }

  .debut { text-align: center; font-size: 13px; color: var(--texte-tertiaire); padding: 28px 0; }
  .texte-message { white-space: pre-wrap; }
  /* L'absence de réponse n'est pas un message : elle est écrite en creux, en
     italique et en gris, pour ne pas se lire comme une phrase de Dambé. */
  .sans-reponse { font-style: italic; opacity: 0.75; }
</style>

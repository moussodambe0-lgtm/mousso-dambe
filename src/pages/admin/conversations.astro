---
/**
 * LES ÉCHANGES AVEC IA DAMBÉ.
 *
 * Arthur, le 5 novembre 2026 : « au niveau de conversation, je veux voir
 * seulement les conversations que les gens ont avec l'IA ». Cet onglet montrait
 * les messages écrits à la boutique et au médecin ; il ne montre plus que ça.
 *
 * OÙ SONT PASSÉS LES AUTRES MESSAGES. Ils n'ont pas disparu : ils sont dans
 * l'espace vendeur, onglet Messages, qui est l'endroit où on y RÉPOND. C'est
 * d'ailleurs plus juste qu'avant, où les mêmes fils s'ouvraient à deux
 * adresses : répondre à une cliente est un geste de vendeur, pas un geste
 * d'administration.
 *
 * CE QU'IL FAUT SAVOIR AVANT LA MISE EN LIGNE, et ce n'est pas une formalité :
 * une fille qui écrit à Dambé croit parler à une machine. Elle ne sait pas
 * qu'un humain la relit. Tant que la politique de confidentialité ne le dit
 * pas, et tant que l'application ne le dit pas à l'endroit où elle écrit, cet
 * écran ne doit servir qu'en local. Le détail est en tête de la migration
 * `20261105180000_les_echanges_avec_dambe.sql`.
 *
 * Le cycle et le journal restent fermés : `conversations_ia()` et `fil_ia()`
 * ne touchent ni `cycles` ni `journal`.
 */
import Admin from '../../layouts/Admin.astro';
import Icone from '../../components/IconeJia.astro';
import LigneConversation, { type LigneFil } from '../../components/LigneConversation.astro';
import { exigerGestion } from '../../lib/gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

const recherche = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 60);

const { data, error } = await sb.rpc('conversations_ia', { p_recherche: recherche || null });
if (error) console.error('conversations_ia', error.message);

const pasEncore = !data?.ok;

type FilIA = {
  profil: string;
  prenom: string;
  avatar_fichier: string | null;
  messages: number;
  apercu: string;
  quand: string | null;
  sans_reponse: number;
};
const fils = (data?.fils ?? []) as FilIA[];
const totalFils = Number(data?.total_fils ?? 0);
const totalMessages = Number(data?.total_messages ?? 0);
---

<Admin titre="Conversations" onglet="conversations">
  <section class="section-serree chiffres">
    <div><strong class="chiffre">{totalFils}</strong><span>ont parlé à Dambé</span></div>
    <div><strong class="chiffre">{totalMessages}</strong><span>questions posées</span></div>
  </section>

  <section class="section">
    <form method="get" class="barre-recherche sur-fond recherche">
      <Icone name="search" size={15} stroke={2} />
      <label class="lecteur-ecran-seul" for="q">Chercher un prénom ou un mot</label>
      <input id="q" type="search" name="q" value={recherche} placeholder="Prénom ou mot de la question" />
    </form>

    {pasEncore ? (
      <div class="etat-vide">
        <Icone name="warning" size={32} class="icone-vide" />
        <div class="titre">La migration n'est pas appliquée</div>
      </div>
    ) : fils.length === 0 ? (
      <div class="etat-vide">
        <Icone name={recherche ? 'search' : 'bot'} size={32} class="icone-vide" />
        <div class="titre">{recherche ? 'Rien trouvé' : 'Aucun échange'}</div>
        {recherche && <a class="btn btn-contour espace" href="/admin/conversations">Voir tout</a>}
      </div>
    ) : (
      <ul class="liste-conversations">
        {fils.map((f) => {
          const ligne: LigneFil = {
            fil: f.profil,
            prenom: f.prenom,
            avatar_fichier: f.avatar_fichier,
            apercu: f.apercu,
            quand: f.quand,
          };
          const etiquettes = [`${f.messages} message${f.messages > 1 ? 's' : ''}`];
          // Une question restée sans réponse veut dire que l'assistante a
          // échoué, pas qu'on a oublié de répondre : personne ne répond à la
          // main ici. C'est donc une panne à voir, et elle se signale.
          if (f.sans_reponse > 0) etiquettes.push(`${f.sans_reponse} sans réponse`);
          return (
            <li>
              <LigneConversation
                fil={ligne}
                href={`/admin/ia/${f.profil}`}
                second="Échange avec IA Dambé"
                etiquettes={etiquettes}
              />
            </li>
          );
        })}
      </ul>
    )}
  </section>
</Admin>

<style>
  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }
  .espace { margin-top: 16px; }

  /* La rangée de chiffres de Jia. Deux colonnes et non quatre : il n'y a que
     deux nombres à dire ici, et quatre colonnes en auraient laissé la moitié
     vide. Le reste est identique aux autres écrans de l'administration. */
  .chiffres {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    background: var(--surface);
    border-bottom: 1px solid var(--bordure);
  }
  .chiffres div { text-align: center; }
  .chiffres strong { display: block; font-size: 19px; }
  .chiffres span { display: block; font-size: 11.5px; color: var(--texte-secondaire); margin-top: 1px; }

  .recherche { margin-bottom: 14px; }

  /* La liste occupe toute la largeur, d'un bord à l'autre, comme la messagerie
     de Jia : les lignes sont séparées par un filet, pas par des cartes. */
  .liste-conversations {
    list-style: none;
    margin: 0 calc(-1 * var(--gouttiere));
    padding: 0;
    border-top: 1px solid var(--filet-liste);
  }
  .liste-conversations li { border-bottom: 1px solid var(--filet-liste); }
</style>

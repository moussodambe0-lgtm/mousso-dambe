---
/**
 * Le gabarit de toutes les pages.
 *
 * Il n'y a aucun `style=` en ligne et aucun `<script is:inline>` dans le site :
 * la politique de sécurité du contenu les refuse, et c'est ce qui empêche un
 * texte venu d'ailleurs de s'exécuter dans la page.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/composants.css';
import '../styles/animations.css';
// Les animations dessinées par Motion (logo, phases, questionnaire, états).
import '../styles/motion.css';
import NavBasse from '../components/NavBasse.astro';
import BoutonMascotte from '../components/BoutonMascotte.astro';
import InviteInstaller from '../components/InviteInstaller.astro';

interface Props {
  titre: string;
  description?: string;
  nav?: 'accueil' | 'cycle' | 'discussions' | 'boutique' | 'compte' | null;
  panier?: number;
  /** Messages de la boutique non lus, pour la pastille de l'onglet. */
  messages?: number;
  /** Une page qui tient tout l'écran (connexion, questionnaire) : pas de
   * barre basse, et pas de place réservée en bas. */
  pleinEcran?: boolean;
  /** Le prénom, pour la petite phrase de la mascotte flottante. */
  prenom?: string;
}

const {
  titre,
  description = 'Suis tes règles, trouve tes protections, pose tes questions. Mousso Dambé, pour les femmes du Burkina.',
  nav = null,
  panier = 0,
  messages = 0,
  pleinEcran = false,
  prenom = '',
} = Astro.props;

const titreComplet = titre === 'Mousso Dambé' ? titre : `${titre} · Mousso Dambé`;

// La mascotte flottante est partout où il y a la barre basse, sauf là où elle
// mènerait à la page qu'on regarde déjà (la conversation avec IA Dambé) ou
// couvrirait la zone d'écriture (les autres conversations).
const chemin = Astro.url.pathname;
const mascotteFlottante =
  nav !== null && !chemin.startsWith('/dambe') && !chemin.startsWith('/discussions/') && !chemin.startsWith('/admin');
const canonique = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4322').href;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />

    <!-- Le rose de la barre du navigateur, pour que l'application ne se voie
         pas comme une page web ouverte dans un onglet. -->
    <meta name="theme-color" content="#fff6f9" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icone-192.png" />

    <!-- Les deux polices sont servies depuis ce site : sur 3G, Google Fonts
         coûtait 2 à 4 secondes avant le premier texte lisible. -->
    <link rel="preload" href="/fonts/figtree.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Rien de tout ça ne doit sortir d'ici : une page de cycle n'a aucune
         raison d'être indexée ni partagée. Seule la boutique l'est.
         L'ACCUEIL EN A ÉTÉ RETIRÉ le 26 octobre 2026 (audit de Cyber) : « / »
         se déclarait « index,follow » alors que, connectée, il affiche son jour
         de cycle, sa phase et la date de ses prochaines règles. C'était
         justement la faille la plus grave de l'audit du 12 octobre, et la
         phrase juste au-dessus disait déjà le contraire de la ligne.
         Rien ne fuyait, parce que « / » sans session redirige vers
         « /ouverture » et qu'un robot n'a donc jamais de page à lire ; mais
         c'était une invitation à suivre les liens vers /cycle et /journal, et
         un en-tête qui contredit son propre commentaire finit par être cru. -->
    <meta
      name="robots"
      content={Astro.url.pathname.startsWith('/boutique') ? 'index,follow' : 'noindex,nofollow'}
    />

    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
  </head>
  <body class={pleinEcran ? 'sans-nav' : undefined}>
    <slot />
    {/* Proposer de poser l'application sur l'écran d'accueil (Arthur, le 27
        octobre 2026). Invisible tant que le navigateur n'a pas dit que
        l'installation est possible, et jamais sur l'adresse de la gestion :
        un vendeur n'installe pas l'application des clientes. */}
    {nav && <InviteInstaller />}
    {mascotteFlottante && <BoutonMascotte prenom={prenom} />}
    {nav && <NavBasse actif={nav} panier={panier} messages={messages} />}
    <script>
      import '../scripts/installer';
      import '../scripts/toucher';
    </script>
  </body>
</html>

---
/**
 * LE LOGO DE MOUSSO DAMBÉ.
 *
 * Le vrai, celui d'Arthur, livré en PDF vectoriel le 12 octobre 2026 : une
 * fleur dont un pétale dessine le profil d'une femme. Il remplace le symbole
 * provisoire (un anneau et une goutte) que j'avais dessiné en attendant.
 *
 * Deux formes, et quand prendre laquelle :
 *   - `fleur` (par défaut) : le dessin seul. C'est la forme qui tient dans une
 *     barre, un rond, une icône, à côté d'un titre.
 *   - `nom` : la fleur AVEC « MOUSSO DAMBÉ » dessous. Pour les écrans où
 *     l'application se présente, et seulement là : écrire le nom deux fois sur
 *     le même écran ne le rend pas plus clair.
 *
 * Le dessin est posé dans la page, pas chargé en image : à 4 Ko pour la fleur,
 * c'est moins cher qu'une requête de plus sur une 3G, et le CSS peut
 * l'atteindre.
 *
 * Les couleurs sont celles du logo, et elles ne se changent plus depuis
 * l'extérieur : un logo dont on change la couleur n'est plus un logo. Sur un
 * fond sombre, on le pose donc sur un rond clair.
 *
 * `outils/logo-depuis-pdf.mjs` refabrique ces fichiers depuis le PDF d'origine
 * le jour où Arthur en livre une nouvelle version.
 */
import fleur from '../assets/logo/logo-fleur.svg?raw';
import avecNom from '../assets/logo/logo-avec-nom.svg?raw';

interface Props {
  /** Une LARGEUR, pas un carré : le logo est plus large que haut. */
  taille?: number;
  /** `nom` ajoute « MOUSSO DAMBÉ » sous la fleur. */
  forme?: 'fleur' | 'nom';
  classe?: string;
  titre?: string;
  anime?: boolean;
}

const { taille = 32, forme = 'fleur', classe = '', titre, anime = false } = Astro.props;

// Les largeurs servies. La politique de sécurité du contenu interdit un
// `style=` en ligne, donc la taille passe par une classe, et une classe ne
// peut exister que pour une valeur prévue.
//
// On RAMÈNE la taille demandée à la plus proche de cette liste, au lieu de la
// laisser tomber dans le vide. Sans ça, demander 150 donnait silencieusement
// 32 px : le logo de l'écran d'ouverture est resté minuscule jusqu'à ce que je
// regarde la capture, le 12 octobre 2026.
const LARGEURS = [24, 28, 30, 32, 38, 44, 54, 64, 88, 120, 140, 150, 160, 180, 200, 240];
const largeur = LARGEURS.reduce((a, b) => (Math.abs(b - taille) < Math.abs(a - taille) ? b : a));

const dessin = forme === 'nom' ? avecNom : fleur;
const marque = titre
  ? `<svg role="img" aria-label="${titre.replace(/"/g, '&quot;')}" `
  : '<svg role="presentation" aria-hidden="true" ';
const pose = dessin.replace('<svg ', marque);
---

<span class:list={['symbole', anime && 'symbole-anime', classe]} data-taille={largeur} set:html={pose} />

<style>
  .symbole {
    display: block;
    width: var(--symbole, 32px);
    flex: none;
    line-height: 0;
  }

  .symbole :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* L'entrée : la fleur se pose. Une seule fois, en moins d'une seconde. */
  .symbole-anime :global(svg) {
    animation: symbole-pose 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes symbole-pose {
    from {
      opacity: 0;
      transform: scale(0.82) translateY(8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .symbole-anime :global(svg) {
      animation: none;
    }
  }

  /* Les largeurs servies. Toute valeur demandée est ramenée à la plus proche
     d'entre elles (voir plus haut) : aucune ne peut passer au travers. */
  .symbole[data-taille='24'] { --symbole: 24px; }
  .symbole[data-taille='28'] { --symbole: 28px; }
  .symbole[data-taille='30'] { --symbole: 30px; }
  .symbole[data-taille='32'] { --symbole: 32px; }
  .symbole[data-taille='38'] { --symbole: 38px; }
  .symbole[data-taille='44'] { --symbole: 44px; }
  .symbole[data-taille='54'] { --symbole: 54px; }
  .symbole[data-taille='64'] { --symbole: 64px; }
  .symbole[data-taille='88'] { --symbole: 88px; }
  .symbole[data-taille='120'] { --symbole: 120px; }
  .symbole[data-taille='140'] { --symbole: 140px; }
  .symbole[data-taille='150'] { --symbole: 150px; }
  .symbole[data-taille='160'] { --symbole: 160px; }
  .symbole[data-taille='180'] { --symbole: 180px; }
  .symbole[data-taille='200'] { --symbole: 200px; }
  .symbole[data-taille='240'] { --symbole: 240px; }
</style>

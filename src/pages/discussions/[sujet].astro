---
/**
 * UNE CONVERSATION : LA BOUTIQUE, OU LE MÉDECIN.
 *
 * Sections 7 et 8 du cahier d'Arthur, plus sa demande du 12 octobre 2026 au
 * soir : « on peut contacter directement un médecin sur la plateforme pour
 * prendre conseil ». Un seul médecin, comme il n'y a qu'un seul vendeur.
 *
 * Un formulaire qui se poste, comme pour IA Dambé : la page revient avec le
 * message déjà en place. C'est moins joli qu'une messagerie qui se remplit
 * toute seule, et c'est le seul moyen que ça marche quand la connexion tombe
 * entre deux messages.
 *
 * Trois façons d'arriver ici :
 *   - par l'onglet Discussions, pour écrire ;
 *   - depuis une fiche produit, avec `?produit=slug`, et alors la carte du
 *     produit est attachée en haut et le message est pré-rempli (modifiable) ;
 *   - depuis la bannière du médecin, sur l'accueil.
 *
 * CE QUI CHANGE DANS LE FIL DU MÉDECIN, et pourquoi :
 *
 *   - les mots qui disent une urgence déclenchent tout de suite l'orientation
 *     vers un centre de santé, sans attendre une réponse humaine. Un médecin
 *     répond quand il peut ; une urgence, non. C'est le même repérage que
 *     celui d'IA Dambé, et il est écrit par nous ;
 *   - aucune carte produit ne s'y attache : on ne vend pas dans une
 *     conversation de santé ;
 *   - l'écran ne promet aucun délai de réponse, et n'écrit le nom d'aucun
 *     médecin tant qu'Arthur n'a pas le sien.
 *
 * Le rafraîchissement régulier demandé dans le cahier est fait par une seule
 * ligne de script : la page se recharge toutes les vingt secondes tant
 * qu'elle est ouverte, visible, et qu'elle n'est pas en train d'écrire.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Symbole from '../../components/Symbole.astro';
import VocalSaisie from '../../components/VocalSaisie.astro';
import Alerte from '../../components/Alerte.astro';
import { clientSession, baseConfiguree } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import { prixComplet, heureCourte, dateLongue, messageErreur } from '../../lib/format';
import { alerte } from '../../lib/assistante';
import { MEDECIN_DISPONIBLE, MEDECIN_BIENTOT } from '../../lib/medecin';
import { PHOTOS_MEDECIN } from '../../lib/photos-medecin';
import { sansCompte } from '../../lib/porte';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return sansCompte(Astro);
// UN VRAI COMPTE, PAS SEULEMENT UNE SESSION (Arthur, le 27 octobre 2026).
//
// « Pour accéder à la messagerie et au niveau de compte, la personne va devoir
// se connecter. » Celle qui est entrée par « Commencer » a bien une session,
// et tout le reste de l'application lui est ouvert : son cycle, son journal,
// la boutique, ses commandes. Mais ici il faut un email : sans lui, personne
// ne peut lui répondre, et elle ne retrouverait rien en changeant de
// téléphone. L'écran de connexion explique pourquoi grâce à `pour`.
if (!moi.compteReel) return sansCompte(Astro);

// Deux conversations, pas une de plus. Une adresse inventée mène à la
// boutique plutôt qu'à une page introuvable.
const sujet: 'boutique' | 'medecin' = Astro.params.sujet === 'medecin' ? 'medecin' : 'boutique';
if (Astro.params.sujet !== sujet) return Astro.redirect(`/discussions/${sujet}`, 302);
const estMedecin = sujet === 'medecin';

// LE FIL DU MÉDECIN N'EST PAS ENCORE OUVERT.
//
// Première version (Cyber, 26 octobre 2026) : cette page renvoyait à la liste
// des discussions. Elle s'ouvrait en entier à qui tapait l'adresse ou gardait
// un signet, avec champ de saisie et bouton d'enregistrement vocal : une femme
// pouvait enregistrer quatre-vingt-dix secondes sur une question intime avant
// d'apprendre que personne n'écoute. La base refuse maintenant le texte ET la
// voix (migrations 20261026130000 et 20261026150000), mais elle les refuse
// APRÈS l'enregistrement, et il ne faut pas la faire parler pour rien.
//
// Deuxième version, et c'est celle-ci. Arthur, le 26 octobre 2026 : « quand on
// clique là-bas, ça doit nous envoyer sur la page médecin, on doit pouvoir
// entrer dans la discussion médecin, et dans la discussion médecin on ne
// pourra pas écrire le message parce qu'on va juste écrire bientôt
// disponible ». Renvoyer à la liste avait un effet qu'il a vu tout de suite et
// que je n'avais pas vu : on atterrissait sur l'écran où Dambé est en haut,
// avec son visage, et on croyait que le médecin ÉTAIT Dambé.
//
// La page s'ouvre donc, et c'est l'écriture qui est retirée, pas la page.
const ferme = estMedecin && !MEDECIN_DISPONIBLE;

const client = clientSession(Astro)!;
const panier = comptePanier(lirePanier(Astro));

let erreur = '';
// Ce que l'application dit elle-même, sans attendre personne, quand les mots
// disent une urgence.
let orientation = '';

if (Astro.request.method === 'POST' && !ferme) {
  const f = await Astro.request.formData();
  const texte = String(f.get('texte') ?? '').trim();
  const slug = String(f.get('produit') ?? '').trim() || null;
  const tel = String(f.get('telephone') ?? '').trim();

  // Le téléphone, demandé une seule fois et facultatif : il sert à rappeler.
  if (tel && !moi.telephone) {
    await client.rpc('changer_telephone', { p_telephone: tel });
  }

  if (texte.length < 1) {
    erreur = 'Écris ton message.';
  } else {
    const { data, error } = await client.rpc('ecrire_a', {
      p_sujet: sujet,
      p_texte: texte,
      p_produit_slug: estMedecin ? null : slug,
    });
    if (error || !data?.ok) {
      erreur = messageErreur(data?.erreur);
    } else {
      // Le message est parti, et le médecin le lira. Mais si les mots disent
      // une urgence, elle ne doit pas attendre : on le lui dit tout de suite,
      // et ça ne dépend d'aucun service extérieur.
      const grave = estMedecin && alerte(texte).gravite !== 'aucune';
      return Astro.redirect(`/discussions/${sujet}${grave ? '?urgent=1' : ''}`, 303);
    }
  }
}

if (estMedecin && Astro.url.searchParams.get('urgent') === '1') {
  orientation =
    'Ton message est parti, et il sera lu. Mais ce que tu décris ne devrait pas attendre une réponse : ' +
    'va au centre de santé le plus proche, même sans rendez-vous. Si tu es en danger maintenant, va vers ' +
    "quelqu'un en qui tu as confiance.";
}

// Le produit attaché, s'il y en a un, et seulement s'il est en vente. Jamais
// dans le fil du médecin : on ne vend pas dans une conversation de santé.
const slugDemande = estMedecin ? '' : (Astro.url.searchParams.get('produit') ?? '');
let produit: { slug: string; nom: string; prix_cfa: number; image: string | null } | null = null;
if (slugDemande) {
  const { data } = await client
    .from('produits')
    .select('slug, nom, prix_cfa, image')
    .eq('slug', slugDemande)
    .eq('publie', true)
    .maybeSingle();
  produit = data ?? null;
}

const { data: fil } = await client.rpc('mon_fil_de', { p_sujet: sujet });
const messages = (fil?.messages ?? []) as {
  id: string;
  de: 'elle' | 'boutique';
  texte: string;
  quand: string;
  lu: boolean;
  vocal_secondes: number | null;
  produit: { slug: string; nom: string; prix_cfa: number; image: string | null } | null;
}[];

// Ouvrir la conversation, c'est l'avoir lue.
if (fil?.fil) await client.rpc('marquer_lu', { p_fil: fil.fil });

// Les jours servent de séparateurs dans le fil.
let jourPrecedent = '';
const lignes = messages.map((m) => {
  const jour = (m.quand ?? '').slice(0, 10);
  const nouveauJour = jour !== jourPrecedent;
  jourPrecedent = jour;
  return { ...m, jour, nouveauJour };
});

const brouillon = produit ? 'Bonjour, je suis intéressée par ce produit.' : '';

// Ce que l'écran dit, selon à qui elle parle. Pour le médecin, aucune
// promesse de délai et aucun nom : Arthur n'a pas encore son médecin, et
// inventer l'un ou l'autre sur une application de santé serait mentir.
const QUI = {
  boutique: {
    titre: 'Boutique Mousso Dambé',
    // Retiré le 13 octobre 2026 à la demande d'Arthur (« on répond nous-mêmes,
    // pas un robot »).
    sous: '',
    icone: 'boutique',
    videTitre: 'Écris-nous',
    videTexte:
      'Une taille, un délai, un quartier de livraison, un prix. On te répond en français ou en mooré, du lundi au samedi.',
    champ: 'Ton message...',
  },
  medecin: {
    titre: 'Le médecin',
    sous: 'Un conseil, pas un diagnostic',
    icone: 'coeur',
    videTitre: 'Pose ta question',
    videTexte:
      "Des douleurs, un retard, des pertes, une question que tu n'oses poser à personne. Écris-la ici : elle ne sort pas de cette conversation, et elle ne part jamais vers IA Dambé.",
    champ: 'Ta question...',
  },
} as const;
const dit = QUI[sujet];
---

<Base titre={dit.titre} nav="discussions" panier={panier}>
  <main class="conversation">
    <header class="barre">
      <a class="retour" href="/discussions" aria-label="Retour aux discussions">
        <Icone nom="retour" taille={22} />
      </a>
      {/* Chez le médecin, un VISAGE, et pas un cœur ni la mascotte : c'est un
          humain qui répond, et l'écran doit le dire avant la première ligne de
          texte. La fleur reste chez la boutique, où c'est bien Mousso Dambé qui
          parle. */}
      <span class:list={['visage', estMedecin ? 'visage-medecin' : 'visage-boutique']}>
        {
          estMedecin ? (
            PHOTOS_MEDECIN[0] ? (
              <img
                class="visage-photo"
                src={PHOTOS_MEDECIN[0].src}
                srcset={PHOTOS_MEDECIN[0].jeu}
                sizes="38px"
                alt="Illustration"
                width="38"
                height="38"
              />
            ) : (
              <Icone nom={dit.icone} taille={20} />
            )
          ) : (
            <Symbole forme="fleur" taille={38} titre="Mousso Dambé" />
          )
        }
      </span>
      <span class="qui">
        <b>{dit.titre}</b>
        {dit.sous && <span>{dit.sous}</span>}
      </span>
    </header>

    {
      orientation && (
        <div class="dans-la-page">
          <Alerte type="attention" texte={orientation} />
        </div>
      )
    }

    <div class="fil-messages">
      {
        // Chez la boutique, l'ancien texte d'accueil est retiré (Arthur, 13
        // octobre 2026). À la place, voir le logo qui flotte, juste dessous.
        estMedecin && lignes.length === 0 && (
          <div class="vide">
            <span class="vide-rond"><Icone nom={estMedecin ? 'coeur' : 'bulles'} taille={26} /></span>
            <h2>{dit.videTitre}</h2>
            <p>{dit.videTexte}</p>
          </div>
        )
      }

      {
        // La toute première fois qu'elle entre chez la boutique : le logo de
        // Mousso Dambé flotte au milieu de la conversation, et un petit mot
        // juste dessous (demande d'Arthur, 13 octobre 2026). Il disparaît
        // dès qu'il y a un message : une conversation en cours n'a pas besoin
        // de se présenter.
        !estMedecin && lignes.length === 0 && (
          <div class="logo-flotte">
            <span class="logo-flotte-rond">
              <Symbole forme="nom" taille={120} titre="Mousso Dambé" />
            </span>
            <p>Bienvenue chez Mousso Dambé. Écris-nous juste en dessous.</p>
          </div>
        )
      }

      {
        lignes.map((m) => (
          <>
            {m.nouveauJour && <p class="jour">{dateLongue(m.jour)}</p>}
            <div class:list={['ligne', m.de === 'elle' ? 'de-moi' : 'de-eux']}>
              <div class="bulle">
                {m.produit && (
                  <a class="carte-jointe" href={`/boutique/${m.produit.slug}`}>
                    {m.produit.image ? (
                      <img
                        src={m.produit.image}
                        alt=""
                        width="48"
                        height="48"
                        loading="lazy"
                      />
                    ) : (
                      <span class="carte-sans-image"><Icone nom="paquet" taille={20} /></span>
                    )}
                    <span>
                      <b>{m.produit.nom}</b>
                      <span class="carte-prix">{prixComplet(m.produit.prix_cfa)}</span>
                    </span>
                  </a>
                )}
                {m.vocal_secondes ? (
                  <div class="vocal-bulle">
                    <span class="vocal-etiquette">
                      <Icone nom="micro" taille={15} />
                      Message vocal · {Math.floor(m.vocal_secondes / 60)}:{String(m.vocal_secondes % 60).padStart(2, '0')}
                    </span>
                    {/* `preload="none"` : une conversation de dix vocaux ne
                        télécharge rien tant qu'on n'en écoute pas un. Le son
                        passe par /vocal/<id>, qui demande à la base si elle a
                        le droit de l'entendre. */}
                    <audio class="vocal-lecteur" controls preload="none" src={`/vocal/${m.id}`}></audio>
                  </div>
                ) : (
                  <p class="texte">{m.texte}</p>
                )}
                <span class="pied">
                  {heureCourte(m.quand)}
                  {m.de === 'elle' && (
                    <>
                      {/* Écrit en toutes lettres (Arthur, 13 octobre 2026) : « Lu »
                          quand celle qui l'a reçu l'a vu, « Non lu » sinon. Les
                          coches restent, mais on ne devine plus leur sens. */}
                      <span class={['statut-lu', m.lu && 'statut-lu-vu'].filter(Boolean).join(' ')}>
                        {m.lu ? 'Lu' : 'Non lu'}
                      </span>
                      <span class:list={['coches', m.lu && 'coches-lues']} aria-hidden="true">
                        <Icone nom="coche" taille={13} epaisseur={2.6} />
                        {m.lu && <Icone nom="coche" taille={13} epaisseur={2.6} />}
                      </span>
                    </>
                  )}
                </span>
              </div>
            </div>
          </>
        ))
      }
    </div>

    {erreur && <div class="dans-la-page"><Alerte type="erreur" texte={erreur} /></div>}

    {
      ferme ? (
        /* Pas de champ, pas de micro, pas de bouton d'envoi : rien à remplir
           tant que personne ne répond de l'autre côté. Ce qui prend leur place
           dit qui répondra, et que ce sera un humain. */
        <div class="attente">
          <div class="attente-visages">
            {PHOTOS_MEDECIN.map((photo, i) => (
              <img
                class="attente-visage"
                src={photo.src}
                srcset={photo.jeu}
                sizes="72px"
                alt={`Illustration, photo ${i + 1} sur ${PHOTOS_MEDECIN.length}`}
                width="72"
                height="72"
                loading="lazy"
                decoding="async"
              />
            ))}
          </div>
          <p class="attente-etiquette">{MEDECIN_BIENTOT}</p>
          <p class="attente-texte">
            Un vrai médecin répondra ici, une personne, pas une machine. Ce
            n'est pas encore ouvert : tu ne peux donc pas encore écrire, pour ne
            pas poser une question qui resterait sans réponse.
          </p>
          <p class="attente-texte attente-doux">
            En attendant, Dambé peut répondre à tes questions sur ton cycle.
            Elle, c'est une machine, et elle ne remplace pas un médecin.
          </p>
          <a class="btn btn-contour" href="/dambe">Parler à Dambé</a>
        </div>
      ) : (
      <form class="ecrire" method="post">
      {
        produit && (
          <div class="jointe-brouillon">
            {produit.image ? (
              <img src={produit.image} alt="" width="44" height="44" />
            ) : (
              <span class="carte-sans-image"><Icone nom="paquet" taille={18} /></span>
            )}
            <span>
              <b>{produit.nom}</b>
              <span class="carte-prix">{prixComplet(produit.prix_cfa)}</span>
            </span>
            <a class="enlever" href={`/discussions/${sujet}`} aria-label="Enlever le produit">
              <Icone nom="croix" taille={16} />
            </a>
            <input type="hidden" name="produit" value={produit.slug} />
          </div>
        )
      }

      {/* Le champ « Ton numéro, pour qu'on puisse te rappeler » a été retiré le
          13 octobre 2026, à la demande d'Arthur. */}

      <div class="zone-ecriture">
        <label class="lecture-seule" for="texte">Ton message</label>
        <textarea
          id="texte"
          name="texte"
          rows="1"
          maxlength="2000"
          required
          placeholder={dit.champ}
          autocomplete="off">{brouillon}</textarea>

        {/* Le vocal, chez la boutique comme chez le médecin (Arthur, 13 octobre
            2026). Un humain écoute : le moré et le dioula passent, et aucun son
            ne sort vers un service extérieur. */}
        <VocalSaisie sujet={sujet} />

        <button class="envoyer" type="submit" aria-label="Envoyer">
          <Icone nom="envoyer" taille={20} />
        </button>
      </div>
      </form>
      )
    }
  </main>
</Base>

<script>
  import '../../scripts/conversation';
  import '../../scripts/vocal';
</script>

<style>
  /* La photo d'en-tête remplit le rond du visage, sans le déborder. */
  .visage-photo {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  /* L'écran du médecin tant qu'il n'est pas ouvert. Posé, sans mouvement : on
     annonce une attente, on ne fait pas une réclame. */
  .attente {
    display: grid;
    justify-items: center;
    gap: var(--e2);
    padding: var(--e4) var(--e4) calc(var(--e5) + env(safe-area-inset-bottom, 0px));
    text-align: center;
    border-top: 1px solid var(--bordure);
    background: var(--surface-douce);
  }

  .attente-visages {
    display: flex;
    /* Les visages se chevauchent un peu : trois personnes, un seul groupe. */
    padding-left: 14px;
  }

  .attente-visage {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
    margin-left: -14px;
    box-shadow: 0 0 0 2px var(--surface-douce);
  }

  .attente-etiquette {
    margin: 0;
    font-weight: 600;
    color: var(--texte-2);
  }

  .attente-texte {
    margin: 0;
    max-width: 34ch;
    color: var(--texte-2);
    line-height: 1.5;
  }

  .attente-doux {
    color: var(--texte-3);
    font-size: 14px;
  }

  .conversation {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
    /* La barre basse, plus la zone d'écriture qui flotte au-dessus. */
    padding-bottom: calc(var(--nav-hauteur) + 118px);
  }

  /* --- La barre du haut --- */
  .barre {
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: var(--e2);
    padding: var(--e3) var(--e4);
    border-bottom: 1px solid var(--bordure);
    background: var(--surface);
  }

  .retour {
    display: flex;
    margin-left: -6px;
    color: var(--encre);
  }

  .visage {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 50%;
    background: var(--encre);
    color: var(--rose-clair);
  }

  /* Le médecin n'est pas la boutique : on le voit avant de lire. */
  .visage-medecin {
    background: var(--rose);
    color: #fff;
  }

  /* La boutique : le logo de Mousso Dambé sur un rond blanc. */
  .visage-boutique {
    width: 50px;
    height: 50px;
    background: #fff;
    border: 1px solid var(--bordure);
  }

  .qui b {
    display: block;
    font-size: 17px;
    line-height: 1.2;
  }

  .qui span {
    font-size: 13px;
    color: var(--texte-3);
  }

  /* --- Le fil --- */
  .fil-messages {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    padding: var(--e4) var(--e4) var(--e3);
  }

  .jour {
    align-self: center;
    margin: var(--e2) 0;
    padding: 3px 10px;
    border-radius: var(--r-ronde);
    background: var(--surface-douce);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--texte-2);
  }

  .ligne {
    display: flex;
  }

  .de-moi {
    justify-content: flex-end;
  }

  .bulle {
    max-width: 82%;
    padding: 10px 13px;
    border-radius: 18px;
    font-size: 16px;
    line-height: 1.45;
    animation: bulle-arrive 0.32s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .de-moi .bulle {
    border-bottom-right-radius: 6px;
    background: var(--rose);
    color: #fff;
  }

  .de-eux .bulle {
    border: 1px solid var(--bordure);
    border-bottom-left-radius: 6px;
    background: var(--surface);
  }

  .texte {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .pied {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 4px;
    margin-top: 3px;
    font-size: 12px;
    opacity: 0.7;
  }

  .statut-lu {
    font-weight: 600;
  }

  .statut-lu-vu {
    opacity: 1;
  }

  .coches {
    display: flex;
  }

  .coches :global(svg):last-child {
    margin-left: -7px;
  }

  .coches-lues {
    opacity: 1;
  }

  /* --- La carte produit attachée --- */
  .carte-jointe,
  .jointe-brouillon {
    display: flex;
    align-items: center;
    gap: var(--e2);
    margin-bottom: 8px;
    padding: 7px;
    border-radius: 13px;
    background: rgba(255, 255, 255, 0.22);
    color: inherit;
  }

  .de-eux .carte-jointe {
    background: var(--surface-douce);
  }

  .carte-jointe img,
  .jointe-brouillon img {
    border-radius: 9px;
    object-fit: cover;
  }

  .carte-sans-image {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 9px;
    background: var(--surface-douce);
    color: var(--rose);
  }

  .carte-jointe b,

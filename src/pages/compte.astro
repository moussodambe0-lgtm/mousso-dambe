---
/**
 * Mon compte.
 *
 * Deux séries de demandes d'Arthur, le 13 octobre 2026.
 *
 * LA PREMIÈRE, par écrit : il a recopié tout le contenu de cette page, sauf
 * la carte de profil et le bouton de déconnexion, en disant « supprime tous
 * ces éléments dans le menu compte ». C'était « Garde ton compte » (Google,
 * email, mot de passe), « Ma vie privée » (notifications, code à l'ouverture,
 * le lien vers la confidentialité), « Mon cycle » (les durées, le rappel) et
 * « Mes achats » (commandes, panier).
 *
 * CE QUE ÇA VEUT DIRE, et qu'il faut savoir : un compte anonyme n'a plus,
 * depuis cette page, aucun moyen de se rattacher une adresse email. Si elle
 * perd son téléphone ou en change, ce qu'elle a noté part avec lui, sans
 * recours. Rien n'est supprimé côté serveur (`enregistrer_reglages`,
 * `updateUser`), seul l'écran qui y menait l'est.
 *
 * LA SECONDE, par message vocal, juste après : « enlève le rectangle »
 * autour de la photo, du nom et de l'adresse ; « pas automatiquement une
 * image » (voir `src/components/Avatar.astro` et `/compte/avatar`) ; « un
 * petit logo de localisation » sous le nom ; « un endroit où on peut voir
 * les favoris » sous la photo et le nom ; une option paramètre en haut à
 * droite (`/parametres`) ; favoris ET panier côte à côte, en petits
 * rectangles, inspirés de l'écran compte de Jia ; une adresse de livraison en
 * dessous ; un bandeau de l'état des commandes, dans l'esprit de Jia mais
 * adapté à ce qui existe vraiment ici (pas de paiement en ligne, pas de
 * remboursement, pas d'avis : les états réels sont ceux de `/commandes`).
 *
 * Note honnête : je n'ai pas le code ni les captures exactes de Jia dans ce
 * projet, le bandeau ci-dessous est une adaptation à ce que Mousso Dambé sait
 * vraiment faire, pas une copie fidèle.
 *
 * Le cycle et ses durées se changent depuis « Mon cycle » (la carte de
 * proposition de moyenne y vit déjà), et « Ce que l'application sait de moi »
 * reste à `/confidentialite` pour qui en connaît l'adresse.
 */
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import Icone from '../components/Icone.astro';
import Alerte from '../components/Alerte.astro';
import CarteProduit from '../components/CarteProduit.astro';
import { visiteuse, lirePanier, comptePanier } from '../lib/session';
import { clientSession, clientPublic, baseConfiguree } from '../lib/supabase';
import { urlAdmin } from '../lib/hotes';
import BandeauCommandes from '../components/BandeauCommandes.astro';
import { ADMIN_HOST } from 'astro:env/server';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);
// UN VRAI COMPTE, PAS SEULEMENT UNE SESSION (Arthur, le 27 octobre 2026).
//
// « Pour accéder à la messagerie et au niveau de compte, la personne va devoir
// se connecter. » Celle qui est entrée par « Commencer » a bien une session,
// et tout le reste de l'application lui est ouvert : son cycle, son journal,
// la boutique, ses commandes. Mais ici il faut un email : sans lui, personne
// ne peut lui répondre, et elle ne retrouverait rien en changeant de
// téléphone. L'écran de connexion explique pourquoi grâce à `pour`.
if (!moi.compteReel) return Astro.redirect('/connexion?pour=compte', 302);

const client = clientSession(Astro)!;
const panier = comptePanier(lirePanier(Astro));

const { data: favorisData } = await client.rpc('mes_favoris');
const nombreFavoris = (favorisData?.ok ? favorisData.favoris.length : 0) as number;

// L'espace vendeur ne se montre qu'à qui y a droit. Une cliente ne voit même
// pas qu'il existe : c'est la base qui répond, pas cette page qui devine.
const { data: estAdmin } = await client.rpc('est_admin');
const vendeuse = estAdmin === true;
// La gestion a sa propre adresse depuis le 21 octobre 2026 : le lien sort du
// site. Calculé ici, et jamais écrit en dur, pour suivre le domaine du jour
// (localhost en développement, le vrai nom une fois acheté).
const lienGestion = vendeuse ? urlAdmin(Astro.url.origin, ADMIN_HOST) : '#';

const { data: commandesData } = await client.rpc('mes_commandes');
const commandes = (commandesData ?? []) as { etat: string }[];


const adresseResume = [moi.quartier, moi.repere].filter(Boolean).join(' · ');

// Les produits en bas de page (Arthur, 13 octobre 2026 : « les produits, les
// serviettes, culottes doivent apparaître dans compte tout en bas »). Lus avec
// le client public, comme la boutique : ce sont les mêmes fiches, le même
// catalogue, et personne n'a besoin d'être reconnue pour voir un prix.
const { data: produitsData } = await clientPublic(Astro)
  .from('produits')
  .select('slug, nom, prix_cfa, rayon, image, etiquette, stock')
  .eq('publie', true)
  .order('ordre')
  .limit(6);
const produits = produitsData ?? [];

// Le retour de « Réinitialiser mon compte » (nomme « Effacer mes donnees »
// jusqu'au 26 octobre 2026 au soir, renomme sur demande d'Arthur). Elle appuyait
// sur le bouton, arrivait ici, et RIEN ne lui disait que c'était
// fait : l'écran d'après ressemblait à l'écran d'avant. Sur l'action la plus
// définitive de l'application, et souvent faite dans l'urgence parce que
// quelqu'un va prendre le téléphone, c'est le pire endroit pour se taire.
//
// Le nombre de commandes encore en route vient de la fonction qui a effacé :
// leur adresse est la seule chose qui reste, et l'écran le dit plutôt que de
// laisser croire que tout est parti.
const efface = Astro.url.searchParams.get('efface') === '1';
const enRoute = Math.max(0, Math.trunc(Number(Astro.url.searchParams.get('enroute') ?? 0)) || 0);
const messageEfface = !efface
  ? ''
  : enRoute === 0
    ? `C'est fait. Ton journal, tes cycles, tes questions à Dambé, ta conversation avec le médecin et ton adresse ne sont plus là.`
    : enRoute === 1
      ? `C'est fait. Ta commande encore en route garde son adresse jusqu'à la livraison, sinon le livreur n'aurait plus où aller. Elle partira dès qu'elle sera livrée.`
      : `C'est fait. Tes ${enRoute} commandes encore en route gardent leur adresse jusqu'à la livraison, sinon le livreur n'aurait plus où aller. Elles partiront dès qu'elles seront livrées.`;
---

<Base titre="Mon compte" nav="compte" panier={panier}>
  <main class="page">
    {messageEfface && (
      <div class="marge-bas">
        <Alerte type="reussite" texte={messageEfface} />
      </div>
    )}
    {/* Ni flèche de retour, ni titre « Mon compte » (Arthur, 13 octobre
        2026) : on entre ici par l'onglet du bas et on en sort pareil, et le
        nom écrit en grand dit déjà chez qui on est. L'identité monte donc
        TOUT EN HAUT, à la hauteur de l'engrenage, qui est SON image détourée
        par `outils/icone-depuis-image.py` et posée nue, sans carré autour. */}
    <section class="identite apparait">
      {/* La photo se choisit, elle ne s'invente plus : touche le rond pour
          ouvrir la galerie (`/compte/avatar`). Tant qu'elle n'a rien choisi,
          `Avatar` montre un rond neutre, jamais un dessin généré. */}
      <a class="rond-photo" href="/compte/avatar" aria-label="Changer ma photo de profil">
        <Avatar
          fichier={moi.avatarFichier}
          choix={moi.avatarChoix}
          graine={moi.prenom}
          prenom={moi.prenom}
          taille={88}
          morph
        />
        <span class="rond-photo-crayon"><Icone nom="crayon" taille={14} /></span>
      </a>
      <div class="qui">
        {/* Le nom tient lieu de titre de la page, maintenant que « Mon
            compte » n'est plus écrit : la page garde donc un vrai titre pour
            un lecteur d'écran. */}
        <h1 class="prenom">{moi.prenom || 'Toi'}</h1>
        {/* L'email seulement si elle en a un. La phrase « Sans compte, sans
            mot de passe » qui s'affichait sinon est supprimée (Arthur, 13
            octobre 2026) : elle expliquait un manque à quelqu'un qui n'avait
            rien demandé. */}
        {moi.email && <div class="gris">{moi.email}</div>}
        {/* Le petit logo de localisation, demandé juste sous le nom. Lecture
            seule : le quartier se donne à la commande, pas ici. */}
        <div class="lieu">
          <Icone nom="lieu" taille={14} />
          <span>{moi.quartier || 'Quartier non renseigné'}</span>
        </div>
      </div>
      <a class="engrenage" href="/parametres" aria-label="Paramètres">
        <img src="/icones/parametres.png" alt="" width="26" height="26" decoding="async" />
      </a>
    </section>

    {/* Favoris et panier, côte à côte, en petits rectangles (Arthur, 13
        octobre 2026 : « il doit pas être écrit comme ça, il doit être dans un
        petit rectangle »), et AVANT les commandes : il a demandé le même jour
        d'échanger les deux blocs de place. La grille complète des favoris
        déménage à `/compte/favoris`, le panier garde le sien à `/panier`. */}
    <section class="tuiles apparait" aria-label="Favoris et panier">
      <a class="tuile" href="/compte/favoris">
        <Icone nom="coeur" taille={22} classe="tuile-icone" />
        <span class="tuile-mot">Mes favoris</span>
        {nombreFavoris > 0 && <span class="tuile-nombre">{nombreFavoris}</span>}
      </a>
      <a class="tuile" href="/panier">
        <Icone nom="panier" taille={22} classe="tuile-icone" />
        <span class="tuile-mot">Panier</span>
        {panier > 0 && <span class="tuile-nombre">{panier}</span>}
      </a>
    </section>

    <BandeauCommandes commandes={commandes} classe="apparait" />

    {/* L'espace vendeur, seulement pour Arthur. Personne d'autre ne voit cette
        ligne : `est_admin()` a déjà répondu non.

        Depuis le 21 octobre 2026, la gestion vit sur sa propre adresse : ce lien
        sort donc du site, et il faut s'y connecter à nouveau, puisque les deux
        adresses ne partagent pas de session. Le détail le dit, pour que la
        demande de mot de passe ne ressemble pas à une panne. */}
    {
      vendeuse && (
        <a class="adresse vendeur-lien apparait" href={lienGestion}>
          <span class="adresse-rond"><Icone nom="tableau" taille={20} /></span>
          <div class="adresse-texte">
            <div class="adresse-titre">Espace vendeur</div>
            <div class="adresse-detail">Sur son adresse à part. Une connexion y est demandée.</div>
          </div>
          <Icone nom="avant" taille={18} classe="adresse-fleche" />
        </a>
      )
    }

    {/* L'adresse de livraison : ce que `passer_commande` enregistrait déjà en
        silence depuis le premier jour a maintenant un endroit pour se voir et
        se changer, sans passer par une commande. */}
    <a class="adresse apparait" href="/compte/adresse">
      <span class="adresse-rond"><Icone nom="lieu" taille={20} /></span>
      <div class="adresse-texte">
        <div class="adresse-titre">Adresse de livraison</div>
        <div class="adresse-detail">{adresseResume || 'Ajouter une adresse de livraison'}</div>
      </div>
      <Icone nom="avant" taille={18} classe="adresse-fleche" />
    </a>

    {/* « Me déconnecter » a déménagé dans Paramètres le 13 octobre 2026, à la
        demande d'Arthur : ce n'est pas un geste de tous les jours, il n'a rien
        à faire au milieu de ce qu'elle ouvre souvent. */}

    {/* La boutique, tout en bas (Arthur, 13 octobre 2026). Les six premières
        fiches du catalogue, dans l'ordre de la boutique ; « Voir tout » mène
        au rayon complet. */}
    {
      produits.length > 0 && (
        <>
          <h2 class="section-titre apparait">
            Pour toi
            <a class="voir-tout" href="/boutique">Voir tout</a>
          </h2>
          <div class="produits apparait">
            {produits.map((p) => (
              <CarteProduit
                slug={p.slug}
                nom={p.nom}
                prixCfa={p.prix_cfa}
                rayon={p.rayon}
                image={p.image}
                etiquette={p.etiquette}
                stock={p.stock}
              />
            ))}
          </div>
        </>
      )
    }

    <div class="espace"></div>
  </main>
</Base>

<style>
  /* L'écart sous le message de confirmation d'effacement. Comme dans
     confidentialite.astro : cette classe n'est pas globale. */
  .marge-bas {
    margin-bottom: var(--e3);
  }

  .identite {
    display: flex;
    align-items: center;
    gap: var(--e4);
    padding: calc(var(--e5) + env(safe-area-inset-top, 0px)) 0 var(--e2);
  }

  /* Le logo seul, sans carré ni bordure (Arthur, 13 octobre 2026 : « je veux
     juste que ce soit le logo qui apparaisse »). La zone touchable reste
     grande, elle, sinon il devient impossible à viser au pouce. */
  .engrenage {
    display: grid;
    place-items: center;
    flex: none;
    align-self: flex-start;
    width: 44px;
    height: 44px;
    margin-left: auto;
    margin-right: -10px;
  }

  .engrenage img {
    display: block;
    width: 26px;
    height: 26px;
    object-fit: contain;
  }

  .engrenage:active {
    transform: scale(0.92);
  }

  .rond-photo {
    position: relative;
    flex: none;
    border-radius: 50%;
  }

  .rond-photo-crayon {
    position: absolute;
    right: -2px;
    bottom: -2px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid var(--fond);
    background: var(--rose);
    color: #fff;
  }

  .qui {
    min-width: 0;
  }

  /* Le nom en grand (Arthur, 13 octobre 2026) : c'est elle, c'est sa page,
     c'est la première chose qu'on doit lire. */
  .prenom {
    font-family: var(--titre);
    font-size: 27px;
    font-weight: 800;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  .gris {
    font-size: 14.5px;
    color: var(--texte-2);
    margin-top: 2px;
    overflow-wrap: anywhere;
  }

  .lieu {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-top: 5px;
    color: var(--texte-3);
    font-size: 14px;
  }

  .section-titre {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e3);
    margin: var(--e5) 0 var(--e2);
    font-size: 18px;
    font-weight: 700;
  }

  .voir-tout {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--rose);
  }

  .produits {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e3);
  }

  /* Les quatre états tiennent dans UN SEUL rectangle (Arthur, 13 octobre
     2026 : « tous les logos doivent être dans le même rectangle »), comme sur
     l'écran de compte de Jia. Chaque état reste touchable à l'intérieur. */
  
  .tuiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e3);
    margin-top: var(--e4);
  }

  .tuile {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--e2);
    padding: var(--e3) var(--e4);
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    background: var(--surface);
  }

  .tuile:active {
    transform: scale(0.98);
  }

  .tuile :global(.tuile-icone) {
    color: var(--rose);
    flex: none;
  }

  .tuile-mot {
    font-size: 15px;
    font-weight: 600;
  }

  .tuile-nombre {
    margin-left: auto;
    display: grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--rose);
    color: #fff;
    font-size: 12.5px;
    font-weight: 700;
  }

  .adresse {
    display: flex;
    align-items: center;
    gap: var(--e3);
    margin-top: var(--e3);
    padding: var(--e3) var(--e4);
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    background: var(--surface);
  }

  .adresse:active {
    transform: scale(0.99);
  }

  .adresse-rond {
    display: grid;
    place-items: center;
    flex: none;
    color: var(--rose);
  }

  .adresse-texte {
    min-width: 0;
    flex: 1;
  }

  .adresse-titre {
    font-size: 15px;
    font-weight: 600;
  }

  .adresse-detail {
    margin-top: 2px;
    font-size: 14px;
    color: var(--texte-2);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .adresse :global(.adresse-fleche) {
    flex: none;
    color: var(--texte-3);
  }

</style>

---
/**
 * CE QUE PÈSENT LES COMMANDES.
 *
 * Demandée par Arthur le 26 octobre 2026 : « un endroit où je pourrais voir
 * toutes les commandes », « celles qui ont été annulées », « celles qui ont
 * abouti », « le nombre de produits commandés ».
 *
 * POURQUOI CE N'EST PAS UN DOUBLON de `/vendeur/commandes`, alors que les deux
 * lisent les mêmes lignes : l'espace vendeur sert à AGIR sur une commande
 * (préparer, confier au livreur, marquer livrée), et il les montre donc une
 * par une, avec leurs boutons. Cette page-ci sert à SAVOIR : combien, pour
 * quelle somme, combien ont échoué, ce qui se vend. On ne touche à rien ici.
 * C'est la même coupure que chez Jia entre la console du vendeur et
 * l'administration, et c'est la seule raison acceptable d'avoir deux écrans
 * sur une même table.
 *
 * RÉÉCRITE LE 5 NOVEMBRE 2026 DANS LE LANGAGE VISUEL DE JIA. Arthur : « dans
 * espace administration, faut copier tout, tout ce que tu vas voir dans espace
 * administrateur, la manière dont c'est présenté, tout. Tu copies tout. Même
 * les couleurs. » Jia n'a pas cette page, il n'y avait donc rien à copier
 * ligne pour ligne : ce qui est copié, ce sont ses classes et sa façon de
 * montrer des chiffres. Les quatre cartes de chiffres sont celles du tableau
 * de bord de Jia (`.chiffres` + `.chiffre-carte`, la valeur en Outfit par
 * `.chiffre`, le mot dessous en gris), la rangée d'états est sa rangée de
 * filtres en pilules (`.rangee-filtres` + `.filtre`), et « Ce qui se vend »
 * reprend exactement son bloc « Ce qui se vend le mieux » (`.liste-stock`,
 * `.tete-liste`, `.ligne-stock`). Pas une couleur n'est inventée : tout vient
 * des variables de `styles/gestion/tokens.css`, copiées de Jia.
 *
 * LE CALCUL N'A PAS BOUGÉ. Il était juste, il est repris tel quel, commentaires
 * compris : seul l'habillage change. L'accès, lui, passe maintenant par
 * `exigerGestion()`, comme toutes les pages de la gestion depuis le 5 novembre.
 * L'ancienne page refaisait à la main la vérification et affichait son propre
 * écran de refus dans le gabarit des clientes : deux endroits à corriger le
 * jour où la règle d'entrée change, et un écran rose au milieu de la gestion.
 */
import Admin from '../../layouts/Admin.astro';
import Icone from '../../components/IconeJia.astro';
import { exigerGestion } from '../../lib/gestion';
import { entier, prix } from '../../lib/format-gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

const ETATS = [
  { id: 'nouvelle', libelle: 'Nouvelles' },
  { id: 'preparee', libelle: 'Préparées' },
  { id: 'envoyee', libelle: 'En livraison' },
  { id: 'livree', libelle: 'Livrées' },
  { id: 'annulee', libelle: 'Annulées' },
];

const { data, error } = await sb.rpc('commandes_admin', { p_etat: null });
if (error) console.error('commandes_admin', error.message);
const commandes = ((data as any)?.commandes ?? []) as any[];
const compte = ((data as any)?.compte ?? {}) as Record<string, number>;

// DEUX TOTAUX, ET IL FAUT LES DISTINGUER. `commandes_admin` ne rend que les
// cent dernières commandes : tout ce qui s'additionne ici (la somme vendue, les
// pièces, le taux) porte donc sur ces cent-là. Le compte par état, lui, est
// calculé par la base sur la table entière, et c'est celui qu'on affiche comme
// « Commandes en tout » : c'est le seul chiffre exact. L'ancienne version de
// cette page prenait `commandes.length` pour le total, et aurait annoncé
// « 100 commandes » pour toujours à partir de la centième.
const totalExact = ETATS.reduce((s, e) => s + Number(compte[e.id] ?? 0), 0);
const total = commandes.length;
const livrees = commandes.filter((c) => c.etat === 'livree');
const annulees = commandes.filter((c) => c.etat === 'annulee');
// `total_cfa` est ce que la cliente a payé, livraison comprise. On retire la
// livraison pour que le chiffre dise ce que la boutique a vendu, et non ce qui
// a transité par elle : le prix de la course n'est pas un revenu.
const encaisse = livrees.reduce((s, c) => s + Number(c.total_cfa ?? 0) - Number(c.livraison_cfa ?? 0), 0);

// Le taux qui compte vraiment : sur les commandes dont le sort est tranché
// (livrée ou annulée), combien sont allées au bout. Compter les annulations
// sur le total écraserait le chiffre tant que des commandes sont en cours.
const tranchees = livrees.length + annulees.length;
const tauxAbouti = tranchees > 0 ? Math.round((livrees.length / tranchees) * 100) : null;

// Ce qui se vend. `commandes_admin` rend les `articles` de chaque commande
// (nom, taille, quantite, prix_cfa) ; on les additionne par nom de produit,
// toutes tailles confondues : savoir que la serviette lavable part bien
// compte plus que de séparer la taille M de la taille L. Les commandes
// annulées ne comptent pas : elles n'ont rien vendu.
const parProduit = new Map<string, { nom: string; pieces: number; somme: number }>();
for (const c of commandes) {
  if (c.etat === 'annulee') continue;
  for (const a of (c.articles ?? []) as any[]) {
    const nom = String(a.nom ?? 'Produit');
    const avant = parProduit.get(nom) ?? { nom, pieces: 0, somme: 0 };
    const quantite = Number(a.quantite ?? 0);
    avant.pieces += quantite;
    avant.somme += quantite * Number(a.prix_cfa ?? 0);
    parProduit.set(nom, avant);
  }
}
const meilleurs = [...parProduit.values()].sort((a, b) => b.pieces - a.pieces).slice(0, 6);
const piecesVendues = [...parProduit.values()].reduce((s, p) => s + p.pieces, 0);
---

<Admin titre="Commandes" onglet="commandes">
  {total === 0 ? (
    <div class="etat-vide">
      <Icone name="receipt" size={34} class="icone-vide" />
      <div class="titre">Aucune commande pour l'instant</div>
    </div>
  ) : (
    <>
      <section class="section">
        <h2 class="titre-section">Le poids des commandes</h2>
        <div class="chiffres">
          <div class="chiffre-carte">
            <span class="valeur chiffre">{entier(encaisse)}</span>
            <span class="cle">FCFA vendus (livrées)</span>
          </div>
          <div class="chiffre-carte">
            <span class="valeur chiffre">{entier(totalExact)}</span>
            <span class="cle">Commandes en tout</span>
          </div>
          <div class="chiffre-carte">
            <span class="valeur chiffre">{entier(piecesVendues)}</span>
            <span class="cle">Pièces vendues</span>
          </div>
          <div class="chiffre-carte">
            {/* Pas de tiret à la place du chiffre quand rien n'est tranché : un
                zéro avec son mot qui l'explique se lit, un tiret laisse
                chercher. */}
            <span class="valeur chiffre">{tauxAbouti ?? 0} %</span>
            <span class="cle">{tauxAbouti === null ? 'Aucune commande tranchée' : 'Vont au bout'}</span>
          </div>
        </div>
      </section>

      <section class="section">
        <h2 class="titre-section">Où elles en sont</h2>
        {/* Les cinq états en pilules, celles de Jia. Chacune porte son compte,
            qui vient de `commandes_admin` et non de la liste chargée ici : la
            fonction ne rend que les cent dernières commandes, les comptes
            portent sur toutes. */}
        <nav class="rangee-filtres filtres" aria-label="Les commandes par état">
          {ETATS.map((e) => (
            <a class="filtre" href={`/vendeur/commandes?etat=${e.id}`}>
              {e.libelle}
              <span class="compte-filtre">{compte[e.id] ?? 0}</span>
            </a>
          ))}
        </nav>
      </section>

      <section class="section">
        <h2 class="titre-section">Ce qui se vend</h2>
        {meilleurs.length === 0 ? (
          <p class="note">Rien n'a encore été vendu.</p>
        ) : (
          <div class="liste-stock meilleurs">
            <div class="tete-liste">
              <Icone name="trend-up" size={16} />
              <strong>Sur 30 jours</strong>
            </div>
            {meilleurs.map((p, i) => (
              <div class="ligne-stock">
                <span class="rang">{i + 1}</span>
                <span class="nom">{p.nom}</span>
                <span class="etat">{p.pieces} pièce{p.pieces > 1 ? 's' : ''} · {prix(p.somme)}</span>
              </div>
            ))}
          </div>
        )}
      </section>
    </>
  )}
</Admin>

<style>
  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }

  /* Les quatre cartes de chiffres du tableau de bord de Jia, à l'identique :
     deux colonnes, valeur en Outfit 22 px, mot en gris 12,5 px dessous. */
  .titre-section { font-size: 16px; }
  .chiffres { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; margin-top: 12px; }
  .chiffre-carte { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 13px 14px; }
  .valeur { display: block; font-size: 22px; }
  .cle { display: block; font-size: 12.5px; color: var(--texte-secondaire); margin-top: 3px; }
  .note { font-size: 12.5px; color: var(--texte-tertiaire); line-height: 1.5; margin: 12px 0 0; }

  .filtres { margin-top: 12px; }
  /* Le compte dans la pilule : un rond discret plutôt qu'une pastille de
     couleur. Ici rien n'est urgent, on regarde ; l'urgence est dans l'espace
     vendeur, et c'est là que les pastilles rouges et orange ont leur place. */
  .compte-filtre {
    margin-left: 7px;
    padding: 1px 7px;
    border-radius: var(--r-pilule);
    background: var(--fond);
    color: var(--texte-secondaire);
    font-family: 'Outfit', sans-serif;
    font-size: 13px;
    font-weight: 800;
  }

  /* Le bloc « Ce qui se vend le mieux » de Jia, repris tel quel. */
  .liste-stock { margin-top: 12px; background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); overflow: hidden; }
  .tete-liste { display: flex; align-items: center; gap: 8px; padding: 11px 14px; border-bottom: 1px solid var(--bordure); font-size: 15px; background: var(--fond); color: var(--texte-corps); }
  .ligne-stock { display: flex; align-items: center; gap: 10px; padding: 12px 14px; min-height: 44px; border-top: 1px solid var(--bordure); }
  .ligne-stock:first-of-type { border-top: 0; }
  .ligne-stock .rang { width: 20px; font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--texte-tertiaire); flex: none; }
  .ligne-stock .nom { flex: 1; min-width: 0; font-size: 15px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ligne-stock .etat { font-size: 13px; color: var(--texte-secondaire); white-space: nowrap; }
</style>

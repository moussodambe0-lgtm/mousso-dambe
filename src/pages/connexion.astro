---
/**
 * Se connecter.
 *
 * Arthur, le 7 novembre 2026, captures d'écran de Jia à l'appui : « quand on
 * clique se connecter, ça doit être la même chose. Tu copies tout même chose.
 * À l'exception des couleurs. Sauf le nom, tu mets Mousso Dambé, le logo, tu
 * mets le logo de Mousso Dambé. Faut même pas essayer d'adapter. »
 *
 * CETTE PAGE EST LA COPIE DE L'ÉCRAN DE CONNEXION DE JIA tel qu'il tourne en
 * ligne (et non tel qu'il est dans le dépôt yaar, qui a une version plus
 * ancienne). De haut en bas, dans cet ordre exact :
 *
 *   la flèche de retour ronde, le logo, « Se connecter », une phrase, le
 *   numéro de téléphone avec l'indicatif +226, le bouton plein, « Ou »,
 *   le volet « Adresse email », le bouton Google, la mention légale,
 *   « Mot de passe oublié ? », puis « Pas encore inscrite ? Créer un compte ».
 *
 * ──────────────────────────────────────────────────────────────────────────
 * LE NUMÉRO DE TÉLÉPHONE EST LÀ, MAIS IL N'EST PAS ALLUMÉ
 * ──────────────────────────────────────────────────────────────────────────
 *
 * Chez Jia, entrer par son numéro envoie un code (par WhatsApp) qu'elle
 * recopie. Mousso Dambé n'a aucun moyen d'envoyer ce code : il faut un
 * service d'envoi, qui se paie au message et qui demande un compte à ouvrir.
 *
 * Le bloc est donc écrit, à sa place, prêt. `TELEPHONE_DISPONIBLE` l'allume
 * en un mot le jour où l'envoi est branché. Tant qu'il est éteint, c'est le
 * volet email qui s'ouvre d'emblée, pour que la page ne soit pas qu'une
 * promesse.
 *
 * C'est la même règle que pour Google, et elle vient d'une erreur du matin :
 * un bouton qui ne peut pas aboutir est pire que pas de bouton. Il occupe la
 * place du chemin qui marche et apprend à celle qui arrive que le site est
 * cassé, à l'instant précis où elle décide de confier son cycle.
 *
 * ──────────────────────────────────────────────────────────────────────────
 * CE QUI NE CHANGE PAS, ET QUI NE DOIT PAS CHANGER
 * ──────────────────────────────────────────────────────────────────────────
 *
 * LE MESSAGE D'ERREUR EST LE MÊME QUE L'ADRESSE EXISTE OU NON. Dire « cette
 * adresse n'a pas de compte » révélerait à un mari curieux si sa femme
 * utilise l'application. Ce n'est pas une précaution théorique ici. Un
 * garde-fou dans supabase/tests/connexion.test.mjs tombe si un second texte
 * réapparaît.
 *
 * SUR L'ADRESSE DE LA GESTION, il n'y a rien à créer : un administrateur se
 * connecte, il ne s'inscrit pas. Les liens vers /inscription y sont cachés.
 *
 * JIA VOUVOIE, Mousso Dambé tutoie partout ailleurs.
 */
import Base from '../layouts/Base.astro';
import Symbole from '../components/Symbole.astro';
import BoutonGoogle from '../components/BoutonGoogle.astro';
import Alerte from '../components/Alerte.astro';
import Icone from '../components/Icone.astro';
import { clientPublic, poserSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { hoteDemande, estHoteAdmin } from '../lib/hotes';
import { suiteSure } from '../lib/suite';
import { googleActif } from '../lib/google';
import DrapeauBF from '../components/DrapeauBF.astro';
import { ADMIN_HOST } from 'astro:env/server';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const surHoteAdmin = estHoteAdmin(
  hoteDemande(Astro.request.headers, Astro.url.hostname),
  ADMIN_HOST
);

const moi = baseConfiguree() ? await visiteuse(Astro) : null;
if (moi?.compteReel) return Astro.redirect('/', 302);

const suite = suiteSure(Astro.url.searchParams.get('suite'), '/compte');

// L'ANCIENNE ADRESSE, GARDÉE VIVANTE : des liens `?action=inscrire` sont déjà
// partis sur WhatsApp, et un lien partagé qui ne mène nulle part ne revient
// jamais.
if (Astro.url.searchParams.get('action') === 'inscrire' && !surHoteAdmin) {
  return Astro.redirect(`/inscription?suite=${encodeURIComponent(suite)}`, 301);
}

/** Entrer par son numéro : écrit, pas encore branché. Voir l'en-tête. */
const TELEPHONE_DISPONIBLE = false;

/*
 * LE BOUTON GOOGLE S'AFFICHE TOUT SEUL quand le fournisseur est allumé côté
 * base, et disparaît tout seul s'il est coupé. Plus de constante à changer,
 * plus rien à se rappeler : voir src/lib/google.ts.
 */
const GOOGLE_DISPONIBLE = await googleActif();

let erreur = '';

const venuDe = Astro.url.searchParams.get('erreur');
if (venuDe === 'google') {
  erreur = "La connexion avec Google n'a pas marché. Réessaie.";
} else if (venuDe === 'google-deja-pris') {
  erreur =
    "Cette adresse Google a déjà un compte Mousso Dambé. Choisis « Se connecter » "
    + 'pour le rejoindre.';
} else if (venuDe === 'liaison') {
  // « Nous n'avons pas pu attacher Google à ton compte » ne voulait rien dire
  // pour elle (Arthur : « ça veut dire quoi ? »). Attacher est un mot de
  // mécanique interne, et ce qu'elle veut savoir c'est quoi faire maintenant.
  erreur =
    "La connexion avec Google n'a pas marché. Réessaie, ou utilise un email et "
    + 'un mot de passe.';
} else if (venuDe === 'pas-de-base') {
  erreur = "L'application n'est pas encore branchée à sa base de données.";
}

/** Pourquoi on la lui demande, quand elle arrive depuis un écran fermé. */
const POURQUOI: Record<string, string> = {
  messagerie:
    "Pour écrire à Dambé ou à la boutique, il faut un compte : c'est ce qui "
    + 'permet de retrouver tes messages, et à la boutique de te répondre.',
  compte: "Pour voir ton compte, connecte-toi d'abord.",
};
const dOu = String(Astro.url.searchParams.get('pour') ?? '');
const pourquoi = POURQUOI[dOu] ?? '';

let emailSaisi = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  emailSaisi = String(f.get('email') ?? '').trim().toLowerCase();
  const motDePasse = String(f.get('motdepasse') ?? '');

  if (!emailSaisi || !motDePasse) {
    erreur = 'Remplis les deux champs.';
  } else {
    const { data, error } = await clientPublic(Astro).auth.signInWithPassword({
      email: emailSaisi,
      password: motDePasse,
    });
    if (error || !data.session) {
      // LE MÊME TEXTE DANS TOUS LES CAS. Il y en avait deux : « ton adresse
      // n'est pas encore confirmée » confirmait qu'un compte existe à cette
      // adresse. Un mari qui essaie l'adresse de sa femme avec n'importe quel
      // mot de passe apprenait qu'elle a un compte ici (Cyber, 26 octobre
      // 2026). Le texte unique dit les deux causes possibles, pour ne pas
      // laisser sans secours celle qui n'a pas encore confirmé.
      erreur =
        'Email ou mot de passe incorrect. Si tu viens de créer ton compte, '
        + "ouvre d'abord l'email de confirmation.";
    } else {
      poserSession(Astro, {
        access_token: data.session.access_token,
        refresh_token: data.session.refresh_token,
      });
      return Astro.redirect(suiteSure(String(f.get('suite') ?? ''), '/'), 303);
    }
  }
}

const versInscription = `/inscription?suite=${encodeURIComponent(suite)}`;

/*
 * LE VOLET EMAIL RESTE FERMÉ, ET C'EST ARTHUR QUI A TRANCHÉ.
 *
 * Le 7 novembre 2026 : « il faut pas que ça soit déballé, il faut que la
 * personne appuie pour que ça se déballe ». Il parlait de l'inscription et a
 * ajouté : « je pense que se connecter aussi, ça doit être un truc comme ça ».
 *
 * DEUX EXCEPTIONS, et chacune évite une impasse :
 *
 *   - une erreur venue du formulaire email ouvre le volet. Sinon elle lirait
 *     « email ou mot de passe incorrect » sans voir le champ à corriger ;
 *   - sur l'adresse de la gestion, l'email est le SEUL chemin : il n'y a ni
 *     téléphone, ni Google, ni inscription. Un volet fermé y serait une porte
 *     sans poignée.
 */
const emailOuvert = Boolean(erreur) || surHoteAdmin;
---

<Base titre="Connexion" description="Connecte-toi à ton compte Mousso Dambé." pleinEcran>
  <main class="auth">
    <a class="retour-rond" href="/compte" aria-label="Revenir en arrière">
      <Icone nom="retour" taille={22} epaisseur={2} />
    </a>

    <div class="tete">
      <Symbole taille={120} forme="nom" />
      <h1>Se connecter</h1>
      <p class="sous">Choisis comment te connecter.</p>
    </div>

    {pourquoi && (
      <div class="encadre doux">
        <Icone nom="info" taille={19} />
        <p>{pourquoi}</p>
      </div>
    )}

    {/* `Alerte` n'a pas de garde interne : sans cette condition, un encadré
        vide s'afficherait à chaque chargement. */}
    {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

    {/* CE QU'ELLE LAISSE DERRIÈRE ELLE, dit avant qu'elle touche au
        formulaire. Elle est entrée par « Commencer » et vient rejoindre un
        compte qui existe ailleurs : ce qu'elle a noté depuis ce téléphone ne
        suivra pas. Si ce n'est pas ce qu'elle veut, c'est /inscription qu'il
        lui faut, qui ATTACHE son email au compte où tout est déjà. */}
    {moi && (
      <div class="encadre doux">
        <Icone nom="info" taille={19} />
        <p>
          Ce que tu as noté depuis ce téléphone restera sur le compte commencé ici, et
          ne suivra pas. Pour le garder, <a href={versInscription}>crée plutôt ton compte</a>.
        </p>
      </div>
    )}

    {TELEPHONE_DISPONIBLE && (
      <form method="POST" class="bloc-tel">
        <input type="hidden" name="geste" value="telephone" />
        <div class="rangee-tel">
          <span class="indicatif"><DrapeauBF taille={22} /> +226</span>
          <label class="sr-seul" for="tel">Ton numéro de téléphone</label>
          <input class="champ-tel" id="tel" name="telephone" type="tel" inputmode="numeric" placeholder="70 12 34 56" maxlength="11" required />
        </div>
        <button type="submit" class="btn btn-rose btn-plein">Se connecter</button>
      </form>
    )}

    {TELEPHONE_DISPONIBLE && <div class="separateur"><span>Ou</span></div>}

    {/* LE VOLET EMAIL. Un `details`, donc du HTML seul : il s'ouvre sans une
        ligne de script, et il marche quand le JavaScript ne charge pas. */}
    <details class="volet" open={emailOuvert}>
      <summary>
        <span class="volet-rond" aria-hidden="true"><Icone nom="envoyer" taille={18} /></span>
        <span class="volet-mots"><span class="volet-titre">Adresse email</span></span>
        <Icone nom="bas" taille={18} />
      </summary>

      <form method="POST" class="volet-dedans">
        <input type="hidden" name="suite" value={suite} />

        <div class="champ-bloc">
          <label class="libelle" for="email">Ton email</label>
          <input class="champ" id="email" name="email" type="email" required autocomplete="email" inputmode="email" value={emailSaisi} />
        </div>

        <div class="champ-bloc">
          <label class="libelle" for="motdepasse">Ton mot de passe</label>
          <input class="champ" id="motdepasse" name="motdepasse" type="password" required autocomplete="current-password" />
        </div>

        <button type="submit" class="btn btn-rose btn-plein">Se connecter</button>
      </form>
    </details>

    {GOOGLE_DISPONIBLE && (
      <div class="bloc-google">
        <BoutonGoogle grand basculer={!!moi} texte="Continuer avec Google" />
      </div>
    )}

    {/* EN LOCAL, LA PORTE SANS MOT DE PASSE. Le banc local recrée sa base à
        chaque redémarrage, donc la session d'Arthur meurt et il retombe ici.
        Ce lien n'apparaît qu'en développement : src/pages/dev/admin.ts
        renvoie 404 en production. */}
    {import.meta.env.DEV && surHoteAdmin && (
      <a class="btn btn-contour btn-plein porte-locale" href="/dev/admin">
        Entrer sans mot de passe (local)
      </a>
    )}

    {/* LA MENTION LÉGALE, SANS LIENS POUR L'INSTANT. Les pages publiques
        correspondantes attendent 22 informations qu'Arthur seul possède
        (RCCM, IFU, siège, représentant légal…). Un lien vers une page
        introuvable, sur l'écran de connexion, vaut moins que pas de lien :
        les liens seront posés le jour où les pages existeront. */}
    <p class="legal">
      En te connectant, tu acceptes les conditions d’utilisation de Mousso Dambé et sa
      politique de confidentialité.
    </p>

    {!surHoteAdmin && (
      <p class="basculer">
        Pas encore de compte ? <a href={versInscription}>Créer un compte</a>
      </p>
    )}
  </main>
</Base>

<style>
  .auth {
    position: relative;
    max-width: 440px;
    margin: 0 auto;
    padding: calc(var(--e6) + 12px) var(--e4) var(--e6);
  }

  /* La flèche ronde, posée en haut à gauche par-dessus le contenu, comme sur
     la capture. 44 px : la cible que le pouce atteint sans viser. */
  .retour-rond {
    position: absolute;
    top: var(--e3);
    left: var(--e4);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--bordure);
    color: var(--encre);
  }

  .tete { text-align: center; padding: var(--e3) 0 var(--e4); }
  .tete h1 { margin: var(--e3) 0 0; font-size: 28px; line-height: 1.2; }
  .sous { margin: 6px 0 0; font-size: 15px; color: var(--texte-2); }

  .marge-bas { margin-bottom: var(--e3); }

  .doux {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: var(--e3);
    background: var(--surface-douce);
  }
  .doux p { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--texte-2); }
  .doux a { font-weight: 700; }

  /* ---------- Le numéro de téléphone ---------- */

  .bloc-tel { display: grid; gap: var(--e3); }

  .rangee-tel {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: stretch;
    border: 1px solid var(--bordure);
    border-radius: var(--r-champ);
    overflow: hidden;
    background: var(--surface);
  }

  .indicatif {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 var(--e3);
    font-weight: 700;
    font-size: 15px;
    border-right: 1px solid var(--bordure);
    white-space: nowrap;
  }
  .drapeau { font-size: 17px; line-height: 1; }

  .champ-tel {
    min-height: 52px;
    padding: 0 var(--e3);
    border: 0;
    background: var(--surface-douce);
    font: inherit;
    font-size: 16px; /* 16 px : en dessous, les iPhone zooment tout seuls. */
    color: var(--encre);
  }
  .champ-tel:focus { outline: 2px solid var(--rose); outline-offset: -2px; }

  .sr-seul {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- Le « Ou » ---------- */

  .separateur { display: flex; align-items: center; gap: 12px; margin: var(--e4) 0; }
  .separateur::before,
  .separateur::after { content: ''; flex: 1; height: 1px; background: var(--bordure); }
  .separateur span { font-size: 13px; color: var(--texte-3); }

  /* ---------- Le volet email ---------- */

  .volet {
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    background: var(--surface);
    padding: 0 var(--e3);
  }

  .volet summary {
    display: flex;
    align-items: center;
    gap: var(--e3);
    min-height: 64px;
    cursor: pointer;
    list-style: none;
    color: var(--encre);
  }
  .volet summary::-webkit-details-marker { display: none; }
  .volet summary::marker { content: ''; }
  .volet summary:focus-visible { outline: 2px solid var(--rose); outline-offset: 2px; border-radius: var(--r-champ); }

  .volet-rond {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--rose-clair);
    color: var(--rose);
  }
  .volet-mots { flex: 1; }
  .volet-titre { display: block; font-size: 16px; font-weight: 700; }

  .volet summary :global(svg:last-child) { transition: transform var(--vite) ease; }
  .volet[open] summary :global(svg:last-child) { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) {
    .volet summary :global(svg:last-child) { transition: none; }
  }

  .volet-dedans { padding: 0 0 var(--e3); }
  .volet-dedans .btn { margin-top: var(--e4); }
  .champ-bloc + .champ-bloc { margin-top: var(--e3); }

  .bloc-google { margin-top: var(--e3); }
  .porte-locale { margin-top: var(--e3); }

  .legal {
    margin: var(--e4) 0 0;
    text-align: center;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--texte-3);
  }

  .basculer {
    margin: var(--e4) 0 0;
    text-align: center;
    font-size: 14.5px;
    color: var(--texte-2);
  }
  .basculer a { font-weight: 700; }
</style>

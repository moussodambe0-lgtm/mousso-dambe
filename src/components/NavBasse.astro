---
/**
 * LA BARRE BASSE, NAVIGATION LIQUIDE.
 *
 * Code donné par Arthur le 12 octobre 2026 au soir, intégré ici. Un cercle
 * creuse une encoche dans la barre sous l'onglet actif, l'icône monte dedans,
 * son libellé apparaît en dessous, et le cercle s'étire pendant qu'il glisse.
 *
 * TROIS CHOSES ONT CHANGÉ PAR RAPPORT À SON CODE, et chacune pour une raison :
 *
 *   1. La position du cercle est posée PAR LE SERVEUR, dans `data-place`, et
 *      non par JavaScript au clic. Chaque onglet est une vraie page ici : si
 *      le cercle attendait un script, il partirait du premier onglet à chaque
 *      chargement, puis sauterait. Posé par le serveur, il est au bon endroit
 *      avant le premier pixel, et la barre reste juste même si le script ne
 *      se charge jamais.
 *
 *   2. La couleur de l'encoche suit la page. Dans son code, `--page-bg` est
 *      écrit en dur. Ici l'accueil a un fond différent du reste ; l'encoche
 *      lit donc `--encoche`, que chaque page règle. Avec une couleur figée,
 *      on verrait un rectangle d'une autre teinte autour du cercle.
 *
 *   3. Le libellé de l'onglet actif reste, mais les autres gardent leur
 *      texte dans la page, caché à l'œil et lu par les lecteurs d'écran.
 *      Une barre dont quatre onglets sur cinq n'ont plus de nom n'est pas
 *      utilisable par quelqu'un qui n'y voit pas.
 *
 * Le mouvement (étirement du cercle, rebond de l'icône, vibration) est un
 * confort ajouté par `src/scripts/nav.ts`. Sans lui, tout marche encore.
 */
import Icone from './Icone.astro';

interface Props {
  actif: 'accueil' | 'cycle' | 'discussions' | 'boutique' | 'compte';
  panier?: number;
  /** Messages non lus, pour la pastille de l'onglet Discussions. */
  messages?: number;
}

const { actif, panier = 0, messages = 0 } = Astro.props;

const ONGLETS = [
  { id: 'accueil', lien: '/', icone: 'accueil', libelle: 'Accueil' },
  { id: 'cycle', lien: '/cycle', icone: 'cycle', libelle: 'Mon cycle' },
  { id: 'discussions', lien: '/discussions', icone: 'dambe', libelle: 'Discussions' },
  { id: 'boutique', lien: '/boutique', icone: 'boutique', libelle: 'Boutique' },
  { id: 'compte', lien: '/compte', icone: 'compte', libelle: 'Compte' },
] as const;

const place = Math.max(
  0,
  ONGLETS.findIndex((o) => o.id === actif),
);
---

<nav class="nav-basse" aria-label="Navigation principale" data-place={place}>
  <ul class="nav-liste">
    {
      ONGLETS.map((o, i) => (
        <li class:list={['nav-item', i === place && 'nav-item-actif']}>
          <a href={o.lien} aria-label={o.libelle} aria-current={i === place ? 'page' : undefined}>
            <span class="nav-icone">
              <Icone nom={o.icone} taille={25} epaisseur={1.9} />
              {o.id === 'boutique' && panier > 0 && (
                <span class="nav-pastille">
                  {panier}
                  <span class="lecture-seule">articles dans ton panier</span>
                </span>
              )}
              {o.id === 'discussions' && messages > 0 && (
                <span class="nav-pastille">
                  {messages}
                  <span class="lecture-seule">messages non lus</span>
                </span>
              )}
            </span>
            {/* Le libellé est toujours dans la page : visible pour l'onglet
                actif, et lu par les lecteurs d'écran pour tous les autres. */}
            <span class="nav-texte">{o.libelle}</span>
          </a>
        </li>
      ))
    }
    <span class="nav-cercle" aria-hidden="true"></span>
  </ul>
</nav>

<script>
  import '../scripts/nav';
</script>

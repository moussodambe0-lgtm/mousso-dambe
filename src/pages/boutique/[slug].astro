---
/**
 * La fiche d'un produit.
 *
 * Elle dit trois choses qu'une fille se demande vraiment avant d'acheter ici :
 * combien ça coûte livré, si le colis se voit, et combien de temps ça dure.
 * Le reste est du détail.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import Alerte from '../../components/Alerte.astro';
import { clientPublic, clientSession, baseConfiguree, jetonDeSession } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import { prix } from '../../lib/format';

const { slug } = Astro.params;

if (!baseConfiguree()) return Astro.redirect('/boutique', 302);

const { data: produit } = await clientPublic(Astro)
  .from('produits')
  .select('slug, nom, resume, description, prix_cfa, rayon, image, etiquette, stock, tailles, reutilisable')
  .eq('slug', slug ?? '')
  .eq('publie', true)
  .maybeSingle();

if (!produit) {
  return new Response(null, { status: 404 });
}

// Lu en base, par la seule valeur des réglages ouverte en lecture. Le reste
// de la table, dont l'empreinte de la clé du serveur, reste fermé.

// Relevé AVANT de lire la session : si le cookie était périmé, `visiteuse()`
// demande au navigateur de l'effacer, et une réponse qui pose un cookie ne doit
// jamais être gardée par un cache partagé.
const avaitUnCookie = !!jetonDeSession(Astro);
const moi = await visiteuse(Astro);
const panier = comptePanier(lirePanier(Astro));
const rupture = produit.stock <= 0;

// Le cœur : rouge si ce produit est déjà dans SES favoris. Lu avec sa session,
// donc seulement les siens (la base ferme la table aux autres).
let favori = false;
if (moi) {
  const client = clientSession(Astro);
  if (client) {
    const { data } = await client
      .from('favoris')
      .select('produit_slug')
      .eq('produit_slug', produit.slug)
      .maybeSingle();
    favori = !!data;
  }
}
const tailles: string[] = produit.tailles ?? [];
const erreur = Astro.url.searchParams.get('erreur');

const DESSINS: Record<string, string> = {
  serviettes: 'paquet',
  culottes: 'culotte',
  lavables: 'tissu',
  kits: 'trousse',
};

if (!moi && !avaitUnCookie) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=120, stale-while-revalidate=600');
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
---

<Base titre={produit.nom} description={produit.resume} nav="boutique" panier={panier}>
  <main>
    <div class:list={['visuel-haut', produit.rayon === 'culottes' && 'sombre', produit.rayon === 'lavables' && 'violet']}>
      {
        produit.image ? (
          <img
            src={produit.image}
            srcset={`${produit.image} 600w, ${produit.image.replace('-600.webp', '-1200.webp')} 1200w`}
            sizes="(max-width: 480px) 100vw, 480px"
            alt={produit.nom}
            width="600"
            height="600"
            fetchpriority="high"
          />
        ) : (
          <span class:list={['dessin', produit.rayon === 'culottes' && 'clair']}>
            <Icone nom={DESSINS[produit.rayon] ?? 'paquet'} taille={128} epaisseur={1.4} />
          </span>
        )
      }
      <div class="coins">
        <a class="rond" href="/boutique" aria-label="Retour à la boutique">
          <Icone nom="retour" taille={20} epaisseur={2} />
        </a>
        <a class="rond" href="/panier" aria-label={`Mon panier, ${panier} articles`}>
          <Icone nom="panier" taille={20} />
          {panier > 0 && <span class="nav-pastille">{panier}</span>}
        </a>
      </div>
    </div>

    <div class="page">
      <h1>{produit.nom}</h1>

      <div class="ligne-prix">
        <span class="chiffre grand-prix">{prix(produit.prix_cfa)}</span>
        <span class="unite">FCFA</span>
        <span class:list={['pastille', rupture ? 'pastille-neutre' : 'pastille-verte', 'pousse']}>
          {rupture ? 'Bientôt de retour' : 'En stock'}
        </span>
      </div>

      {/* La description longue a été retirée de la fiche le 13 octobre 2026, à
          la demande d'Arthur (« quand je clique pour commander un produit, je
          vois ce genre de texte, supprime »). Le texte reste en base. */}

      {erreur && <div class="marge"><Alerte type="erreur" texte={erreur === 'taille' ? 'Choisis ta taille avant de continuer.' : 'Ce produit ne peut pas être ajouté.'} /></div>}

      <form method="POST" action="/panier">
        <input type="hidden" name="geste" value="ajouter" />
        <input type="hidden" name="slug" value={produit.slug} />

        {
          tailles.length > 0 && (
            <fieldset class="tailles">
              <legend class="libelle">Ta taille</legend>
              {tailles.map((t, i) => (
                <>
                  <input class="cache" type="radio" name="taille" id={`t-${t}`} value={t} checked={i === 1 || tailles.length === 1} required />
                  <label class="taille-label" for={`t-${t}`}>{t}</label>
                </>
              ))}
            </fieldset>
          )
        }

        {/* Les trois encadrés (livraison à 1 000 FCFA, emballage, réutilisable
            deux ans) ont été retirés de la fiche le 13 octobre 2026, à la
            demande d'Arthur. */}

        <a class="aide-dambe" href="/dambe">
          <span class="rond-sombre"><Icone nom="dambe" taille={20} /></span>
          <span>Tu hésites ? <strong>Demande à IA Dambé</strong></span>
        </a>

        <div class="place-barre"></div>

        <div class="barre-action">
          {/* « Écrire à la boutique », JUSTE AU-DESSUS de « Commander » (demande
              d'Arthur, 13 octobre 2026). Avant, c'était un petit carré à côté
              du bouton, sans un mot : on ne savait pas ce qu'il faisait. Celle
              qui hésite sur une taille ou un quartier de livraison doit voir
              tout de suite qu'elle peut écrire. Le lien emporte le produit,
              qui sera attaché en haut de son message. */}
          <div class="rangee-ecrire">
            <a class="btn btn-contour ecrire-vendeur" href={`/discussions/boutique?produit=${produit.slug}`}>
              <Icone nom="bulles" taille={18} />
              Écrire à la boutique
            </a>
            {/* Le cœur des favoris (Arthur, 13 octobre 2026) : un petit carré, sur
                la même ligne. Touché, il devient rouge. `type="button"` : il ne
                doit pas envoyer le formulaire de commande. */}
            <button
              class:list={['favori', favori && 'favori-actif']}
              type="button"
              data-slug={produit.slug}
              aria-pressed={favori ? 'true' : 'false'}
              aria-label={favori ? 'Retirer des favoris' : 'Mettre en favori'}
            >
              <Icone nom="coeur" taille={22} epaisseur={2} />
            </button>
          </div>
          <button class="btn btn-rose btn-plein" type="submit" name="quantite" value="1" disabled={rupture}>
            {rupture ? 'Bientôt de retour' : `Commander · ${prix(produit.prix_cfa)} F`}
          </button>
        </div>
      </form>
    </div>
  </main>
</Base>

<script>
  import '../../scripts/favori';
</script>

<style>
  /* Les deux boutons d'action, l'un au-dessus de l'autre : « Écrire à la
     boutique », puis « Commander ». */
  .barre-action {
    display: flex;
    flex-direction: column;
    gap: var(--e2);
    margin-top: var(--e4);
  }

  .rangee-ecrire {
    display: flex;
    gap: var(--e2);
  }

  /* Plus petit qu'avant (« réduis un peu le rectangle ») : 44 px de haut, un
     texte de 14 px, et il laisse sa place au cœur sur la même ligne. */
  .ecrire-vendeur {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    height: 44px;
    padding: 0 14px;
    border-radius: 14px;
    font-size: 14px;
  }

  /* Le cœur : un carré de la même hauteur. Au repos, un contour ; touché, il se
     remplit de rouge. */
  .favori {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex: none;
    border: 1px solid var(--bordure);
    border-radius: 14px;
    background: var(--surface);
    color: var(--encre);
    cursor: pointer;
    transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .favori:active {
    transform: scale(0.9);
  }

  .favori :global(svg) {
    fill: none;
    transition: fill 0.15s, stroke 0.15s;
  }

  .favori-actif {
    border-color: #e11d48;
  }

  .favori-actif :global(svg) {
    fill: #e11d48;
    stroke: #e11d48;
  }

  @media (prefers-reduced-motion: reduce) {
    .favori,
    .favori :global(svg) {
      transition: none;
    }
  }

  .visuel-haut {
    position: relative;
    height: 260px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-douce);
    color: var(--rose);
    overflow: hidden;
  }

  .visuel-haut img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sombre {
    background: var(--encre);
  }

  .violet {
    background: var(--violet-clair);
    color: var(--violet);
  }

  .clair {
    color: var(--rose-clair);
  }

  .coins {
    position: absolute;
    top: var(--e4);
    left: var(--e4);
    right: var(--e4);
    display: flex;
    justify-content: space-between;
  }

  h1 {
    margin-top: var(--e4);
    font-size: 22px;
  }

  .ligne-prix {
    display: flex;
    align-items: baseline;
    gap: var(--e2);
    margin-top: var(--e2);
  }

  .grand-prix {
    font-size: 28px;
    color: var(--rose);
  }

  .unite {
    font-size: 14px;
    font-weight: 600;
    color: var(--texte-2);
  }

  .tailles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e2);
    align-items: center;
    margin: var(--e5) 0 0;
    padding: 0;
    border: none;
  }

  .tailles legend {
    width: 100%;
  }

  .cache {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .taille-label {
    min-width: 56px;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--bordure);
    border-radius: var(--r-champ);
    background: var(--surface);
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background-color var(--vite) ease, border-color var(--vite) ease;
  }

  .cache:checked + .taille-label {
    background: var(--encre);
    border-color: var(--encre);
    color: #fff;
  }

  .cache:focus-visible + .taille-label {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
  }

  /* L'aide d'IA Dambé garde son espace au-dessus (les encadrés de livraison
     qui le précédaient ont été retirés). */
  .aide-dambe {
    display: flex;
    align-items: center;
    gap: var(--e3);
    margin-top: var(--e4);
    font-size: 13.5px;
    color: var(--encre);
  }

  .aide-dambe strong {
    color: var(--rose);
  }

  .rond-sombre {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex: none;
    border-radius: 12px;
    background: var(--encre);
    color: var(--rose-clair);
  }

  /* La barre d'action flotte au-dessus du contenu : on lui réserve sa hauteur
     entière, sinon la dernière ligne du texte finit cachée derrière. */
  .place-barre {
    height: 8px;
  }
</style>

---
/**
 * Mes produits, copié de `pages/vendeur/produits/index.astro` de Jia.
 *
 * Arthur, le 5 novembre 2026 : « tu copies tout, tu copies absolument tout,
 * même les couleurs ». Cet écran remplace l'ancien `vendeur/produits.astro`,
 * un fichier plat qui ouvrait le formulaire d'édition au milieu de la liste.
 * Chez Jia la liste ne fait que lister, et la fiche a sa propre page : c'est
 * ce découpage qui est repris ici, avec son dossier.
 *
 * CE QUI EST COPIÉ TEL QUEL : la barre de filtres qui défile avec son compte
 * par filtre, le bouton « Ajouter » à droite, le bandeau orange des ruptures,
 * les cartes à vignette carrée de 64 px, la pastille d'état, le prix, et
 * surtout le compteur de stock en bas de chaque carte. Le réglage du stock se
 * fait d'un tap, sans ouvrir la fiche : c'est l'opération la plus fréquente,
 * après chaque vente.
 *
 * QUATRE FILTRES ET NON CINQ. Jia en a cinq, le cinquième étant « Archivés ».
 * Il n'y a pas d'archive ici : `produits.publie` est un booléen, et un produit
 * qu'on retire redevient un brouillon. Le filtre « Archivés » ne pourrait
 * jamais afficher une seule ligne. Les quatre autres sont mot pour mot ceux
 * de Jia.
 *
 * POURQUOI LE « + » RENVOIE TOUTE LA FICHE EN BASE. Jia écrit directement
 * `update products set stock_quantity = …`. Ici aucune politique d'écriture
 * n'existe sur `produits` : tout passe par `enregistrer_produit()`, qui prend
 * la fiche entière. On relit donc la ligne et on la renvoie telle quelle avec
 * le seul stock changé. C'est volontaire : ajouter une fonction SQL juste pour
 * incrémenter un entier aurait demandé une migration, donc une relance du
 * serveur, pour un geste que la fonction existante fait déjà sans rien perdre
 * (`reutilisable` et `ordre` ne sont pas touchés par la mise à jour).
 */
import Vendeur from '../../../layouts/Vendeur.astro';
import Icone from '../../../components/IconeJia.astro';
import Alerte from '../../../components/AlerteJia.astro';
import { exigerGestion } from '../../../lib/gestion';
import { prix } from '../../../lib/format-gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

/** La fiche complète telle que `enregistrer_produit` la reprend. */
const fiche = (p: any, stock: number) => ({
  p_slug: p.slug,
  p_nom: p.nom,
  p_rayon: p.rayon,
  p_prix: p.prix_cfa,
  p_stock: stock,
  p_resume: p.resume ?? '',
  p_description: p.description ?? '',
  p_image: p.image ?? null,
  p_etiquette: p.etiquette ?? null,
  p_tailles: p.tailles ?? [],
  p_publie: p.publie === true,
});

let erreur: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const slug = String(form.get('produit') ?? '');
  const sens = String(form.get('stock') ?? '');
  const filtre = String(form.get('filtre') ?? 'tous');

  const { data: liste } = await sb.rpc('produits_admin');
  const p = ((liste?.ok ? liste.produits : []) as any[]).find((x) => x.slug === slug);
  if (p) {
    const stock = Math.max(0, Math.min(99999, Number(p.stock) + (sens === 'plus' ? 1 : -1)));
    const { data, error } = await sb.rpc('enregistrer_produit', fiche(p, stock));
    if (error || !data?.ok) console.error('stock produit', data?.erreur ?? error?.message);
  }
  return Astro.redirect(`/vendeur/produits?filtre=${filtre}#p-${slug}`, 303);
}

const { data: liste, error } = await sb.rpc('produits_admin');
if (error) console.error('produits_admin', error.message);
if (liste && liste.ok !== true) erreur = 'La liste des produits n’a pas pu être lue. Réessaie.';

const produits = ((liste?.ok ? liste.produits : []) as any[]).slice();

const FILTRES = [
  { cle: 'tous', libelle: 'Tous', garde: () => true },
  { cle: 'en-ligne', libelle: 'En ligne', garde: (p: any) => p.publie && p.stock > 0 },
  { cle: 'rupture', libelle: 'Rupture', garde: (p: any) => p.publie && p.stock === 0 },
  { cle: 'brouillons', libelle: 'Brouillons', garde: (p: any) => !p.publie },
];
const filtre = FILTRES.find((f) => f.cle === Astro.url.searchParams.get('filtre')) ?? FILTRES[0]!;
const affiches = produits.filter(filtre.garde);
const nbRupture = produits.filter(FILTRES[2]!.garde).length;

const MESSAGES: Record<string, string> = {
  enregistre: 'Modifications enregistrées. La boutique les montre tout de suite.',
  cree: 'Produit enregistré.',
  retire: 'Produit retiré de la boutique. Il reste ici, en brouillon.',
  remis: 'Produit remis en vente.',
};
const succes = MESSAGES[Astro.url.searchParams.get('ok') ?? ''] ?? null;

// Ce qui manque pour qu'un brouillon puisse être publié. Même règle que chez
// Jia : un produit sans visuel ni description ne se vend pas, et il abîme
// l'allure de tout le catalogue.
const manques = (p: any) => {
  const liste: string[] = [];
  if (!p.image) liste.push('un visuel');
  if (!p.description) liste.push('la description');
  return liste;
};
---

<Vendeur
  titre="Mes produits"
  onglet="produits"
  sb={sb}
  sousTitre={`${produits.length} produit${produits.length > 1 ? 's' : ''}`}
>
  <div class="section-serree barre-haut">
    <nav class="filtres" aria-label="Filtrer">
      {FILTRES.map((f) => (
        <a href={`/vendeur/produits?filtre=${f.cle}`} class:list={['filtre', { actif: f.cle === filtre.cle }]}>
          {f.libelle} · {produits.filter(f.garde).length}
        </a>
      ))}
    </nav>
    <a href="/vendeur/produits/nouveau" class="btn btn-action btn-petit ajouter">
      <Icone name="plus" size={16} stroke={2.4} /> Ajouter
    </a>
  </div>

  <div class="section-serree alertes">
    <Alerte message={succes} ton="succes" />
    <Alerte message={erreur} />
  </div>

  {nbRupture > 0 && filtre.cle !== 'rupture' && (
    <div class="section-serree">
      <Alerte
        message={`${nbRupture} produit${nbRupture > 1 ? 's' : ''} en rupture. Ils restent affichés « Rupture » et ne peuvent pas être commandés tant que le stock est à zéro.`}
      />
    </div>
  )}

  <section class="section liste">
    {
      affiches.length === 0 ? (
        <div class="etat-vide">
          <Icone name="box" size={34} class="icone-vide" />
          <div class="titre">{produits.length === 0 ? 'Aucun produit pour l’instant' : 'Rien dans ce filtre'}</div>
          {produits.length === 0 && (
            <>
              <p class="texte">Ajoute ton premier produit : un visuel, un prix, un stock. Deux minutes suffisent.</p>
              <a class="btn btn-action espace" href="/vendeur/produits/nouveau">Ajouter un produit</a>
            </>
          )}
        </div>
      ) : (
        affiches.map((p) => {
          const manque = manques(p);
          const etat =
            !p.publie ? { t: 'Brouillon', c: 'pastille-neutre' }
            : p.stock === 0 ? { t: 'Rupture', c: 'pastille-orange' }
            : { t: 'En ligne', c: 'pastille-action' };
          return (
            <article class="carte" id={`p-${p.slug}`}>
              <a href={`/vendeur/produits/${p.slug}`} class="haut">
                <span class="vignette">
                  {p.image ? (
                    <img src={p.image} alt="" width="64" height="64" class="photo-couvrante" loading="lazy" />
                  ) : (
                    <span class="vignette-vide remplit" />
                  )}
                </span>
                <span class="infos">
                  <strong>{p.nom}</strong>
                  <span class:list={['pastille', etat.c]}><span class="point" />{etat.t}</span>
                  <span class="prix">{prix(p.prix_cfa)}</span>
                </span>
                <Icone name="edit" size={17} class="crayon" />
              </a>

              {!p.publie && manque.length > 0 ? (
                <div class="manque">
                  Il manque {manque.join(' et ')} pour publier. <a href={`/vendeur/produits/${p.slug}`}>Terminer la fiche</a>
                </div>
              ) : (
                <form method="post" class="stock">
                  <input type="hidden" name="produit" value={p.slug} />
                  <input type="hidden" name="filtre" value={filtre.cle} />
                  <span class="libelle-stock">Stock</span>
                  <span class="compteur">
                    <button type="submit" name="stock" value="moins" aria-label="Retirer une unité" disabled={p.stock === 0}>−</button>
                    <span class="valeur">{p.stock}</span>
                    <button type="submit" name="stock" value="plus" aria-label="Ajouter une unité">+</button>
                  </span>
                </form>
              )}
            </article>
          );
        })
      )
    }
  </section>
</Vendeur>

<style>
  .barre-haut { display: flex; align-items: center; gap: 10px; background: var(--surface); border-bottom: 1px solid var(--bordure); }
  .filtres { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; flex: 1; }
  .filtres::-webkit-scrollbar { display: none; }
  .filtre { flex: 0 0 auto; font-size: 13px; font-weight: 700; color: var(--texte-secondaire); padding: 7px 11px; border-radius: var(--r-pilule); border: 1px solid var(--bordure); white-space: nowrap; }
  .filtre:hover { color: var(--encre); }
  .filtre.actif { background: var(--encre); border-color: var(--encre); color: #FFFFFF; }
  .ajouter { display: inline-flex; align-items: center; gap: 5px; flex: 0 0 auto; }

  .alertes { display: grid; padding-top: 0; padding-bottom: 0; }
  .alertes :global(.alerte) { margin-top: 12px; }

  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }
  .espace { margin-top: 16px; }

  .liste { display: grid; gap: 10px; }
  .carte { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 12px 13px; }
  .haut { display: flex; gap: 12px; align-items: center; color: inherit; }
  .haut:hover { color: inherit; }
  .vignette { width: 64px; height: 64px; border-radius: 10px; overflow: hidden; background: var(--fond); flex: 0 0 auto; }
  .remplit { display: block; width: 100%; height: 100%; }
  .infos { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 5px; }
  .infos strong { font-size: 15px; line-height: 1.3; }
  .infos .prix { font-size: 16px; }
  .haut :global(.crayon) { color: var(--texte-tertiaire); flex: 0 0 auto; }

  .stock { display: flex; align-items: center; justify-content: space-between; margin-top: 11px; padding-top: 10px; border-top: 1px solid var(--bordure); }
  .libelle-stock { font-size: 14px; font-weight: 700; color: var(--texte-secondaire); }
  .manque { margin-top: 11px; padding-top: 10px; border-top: 1px solid var(--bordure); font-size: 14px; color: var(--orange-fonce); }
  .manque a { font-weight: 700; }
</style>

---
/**
 * Choisir sa photo de profil, parmi les portraits.
 *
 * Arthur, le 26 octobre 2026, après avoir essayé le créateur : « au niveau des
 * avatars garde seulement les portraits. »
 *
 * C'est la DEUXIÈME fois qu'il écarte les avatars dessinés, après le 13 octobre
 * (« je ne veux pas des dessins bizarres, je veux des vrais avatars comme ma
 * mascotte »). Cette fois il a vu le créateur fonctionner, avec ses huit peaux,
 * ses dix coiffures et ses huit vêtements, et il préfère quand même les douze
 * portraits 3D produits par Motion. La question est donc tranchée pour de bon :
 * un avatar de Mousso Dambé est une photo, pas un dessin.
 *
 * CE QUI RESTE DU CRÉATEUR, ET POURQUOI : rien dans cette page. En base,
 * `composer_avatar()` est révoquée et `avatar_choix` est vidée (voir la
 * migration 20261026150000). Le générateur `src/lib/avatar.ts` reste dans le
 * dépôt avec ses 23 vérifications, parce que supprimer du code qui marche est
 * un geste qu'on ne défait pas : à retirer pour de bon si personne n'y revient
 * une troisième fois.
 *
 * La décision du 13 octobre tient toujours : « la personne n'aura pas
 * automatiquement une image. » Tant qu'elle n'a rien choisi, son compte garde
 * un rond neutre, et « Aucune » permet d'y revenir.
 */
import Base from '../../layouts/Base.astro';
import Entete from '../../components/Entete.astro';
import Avatar from '../../components/Avatar.astro';
import Alerte from '../../components/Alerte.astro';
import { clientSession, baseConfiguree } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import { messageErreur } from '../../lib/format';

export const prerender = false;

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);

const client = clientSession(Astro)!;
let erreur = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const choix = String(f.get('fichier') ?? '').trim();
  const { data, error } = await client.rpc('choisir_avatar', { p_fichier: choix || null });
  if (error || !data?.ok) erreur = messageErreur(data?.erreur);
  else return Astro.redirect('/compte', 303);
}

const { data: galerieData } = await client.rpc('galerie_avatars');
const galerie = (galerieData ?? []) as { fichier: string; genre: string }[];
const panier = comptePanier(lirePanier(Astro));
---

<Base titre="Ma photo de profil" nav="compte" panier={panier}>
  <main class="page">
    <Entete titre="Ma photo de profil" retour="/compte" />

    {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

    <form method="POST" class="grille">
      {/* « Aucune » d'abord : c'est l'état par défaut, et il doit être aussi
          facile à reprendre qu'à quitter. */}
      <button
        class:list={['case', 'case-vide', !moi.avatarFichier && 'case-actuelle']}
        type="submit"
        name="fichier"
        value=""
      >
        <Avatar fichier={null} taille={72} contour={false} titre="Aucune photo" />
        <span>Aucune</span>
      </button>

      {
        galerie.map((a) => (
          <button
            class:list={['case', a.fichier === moi.avatarFichier && 'case-actuelle']}
            type="submit"
            name="fichier"
            value={a.fichier}
          >
            <Avatar fichier={a.fichier} taille={72} contour={false} titre="Choisir ce portrait" />
          </button>
        ))
      }
    </form>

    <div class="espace"></div>
  </main>
</Base>

<style>
  .grille {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(92px, 1fr));
    gap: var(--e3);
  }

  .case {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: var(--e2);
    border: 2px solid transparent;
    border-radius: var(--r-carte);
    background: var(--surface);
  }

  .case:active {
    transform: scale(0.96);
  }

  .case-actuelle {
    border-color: var(--rose);
  }

  .case span {
    font-size: 13px;
    font-weight: 600;
    color: var(--texte-2);
  }

  .espace {
    height: var(--e6);
  }
</style>

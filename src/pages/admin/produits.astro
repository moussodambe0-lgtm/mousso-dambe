---
/**
 * Le catalogue, vu de l'administration. Copié de `pages/admin/produits.astro`
 * de Jia.
 *
 * Arthur, le 5 novembre 2026 : « dans espace administration, faut copier tout,
 * tout ce que tu vas voir dans espace administrateur, la manière dont c'est
 * présenté, tout. Tu copies tout. Même les couleurs. »
 *
 * CE QUI EST COPIÉ TEL QUEL : la barre de recherche sur fond gris sous les
 * onglets, les alertes de retour d'action, le titre de section avec son
 * paragraphe d'aide en petit, et les cartes en rangée : vignette carrée de
 * 64 px à gauche, nom en couleur de nom de produit, une ligne de méta, le prix,
 * puis les boutons. Le produit retiré passe à 60 % d'opacité, comme chez Jia.
 *
 * DEUX ÉCRANS POUR LE MÊME CATALOGUE, ET CE N'EST PAS UN DOUBLON. C'est le
 * découpage de Jia, et il tient ici pour la même raison. L'espace vendeur
 * FABRIQUE le catalogue : il ajoute, il écrit, il règle le stock. Cette page le
 * SURVEILLE : elle montre tout d'un coup, publié et retiré mélangés, elle se
 * cherche par le nom, et elle ne sait faire que deux gestes, retirer et
 * remettre. C'est l'écran qu'on ouvre pour répondre à « qu'est-ce qu'on vend,
 * au fait ».
 *
 * CE QUE JE N'AI PAS REPRIS DU FICHIER DE JIA, et pourquoi :
 *
 *   - LA MODÉRATION DES AVIS, qui occupe la moitié de sa page. Chez Jia un avis
 *     attend ici parce qu'un vendeur peut commander chez lui, déclarer la
 *     livraison et se noter tout seul. Ici un avis exige une commande À SOI et
 *     LIVRÉE, vérifié par `deposer_avis()` en base, et Mousso Dambé est le seul
 *     vendeur : il n'y a ni faux avis à attraper, ni personne à arbitrer. La
 *     file d'attente serait vide pour toujours. Les avis d'un produit se lisent
 *     sur sa fiche, dans l'espace vendeur.
 *   - « DEMANDER UNE PREUVE » par WhatsApp, qui écrit au vendeur du produit pour
 *     réclamer une facture fournisseur. Il n'y a pas de vendeur tiers : le
 *     bouton écrirait à la maison.
 *   - le soupçon de CONTREFAÇON qui tient tout son paragraphe d'aide. Rien
 *     n'entre dans ce catalogue sans qu'Arthur l'y mette lui-même.
 */
import Admin from '../../layouts/Admin.astro';
import Icone from '../../components/IconeJia.astro';
import Alerte from '../../components/AlerteJia.astro';
import { exigerGestion } from '../../lib/gestion';
import { prix, depuis } from '../../lib/format-gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  if (action === 'retirer' || action === 'republier') {
    const { data, error } = await sb.rpc('retirer_produit', {
      p_slug: String(form.get('produit') ?? ''),
      p_remettre: action === 'republier',
    });
    if (error || !data?.ok) return Astro.redirect('/admin/produits?erreur=1', 303);
  }
  return Astro.redirect(`/admin/produits?ok=${action}`, 303);
}

const recherche = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 80);

const { data: liste, error } = await sb.rpc('produits_admin');
if (error) console.error('produits_admin', error.message);

// Jia cherche en base, avec un `ilike` et une limite de 60 : son catalogue est
// celui de centaines de boutiques. Ici `produits_admin()` rend tout le
// catalogue en un appel, et il tient sur une main : on filtre donc en mémoire
// plutôt que d'ajouter une fonction SQL qui refait le même travail. L'ordre est
// celui du catalogue (`ordre`, puis le nom), pas celui de la création : c'est
// dans cet ordre que les clientes les voient.
const tous = (liste?.ok ? liste.produits : []) as any[];
const sansAccent = (t: string) =>
  t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
const produits = recherche
  ? tous.filter((p) => sansAccent(String(p.nom)).includes(sansAccent(recherche)))
  : tous;

const SUCCES: Record<string, string> = {
  retirer: 'Produit retiré de la boutique. Il reste dans l’espace vendeur, en brouillon.',
  republier: 'Produit remis en vente.',
};
const succes = SUCCES[Astro.url.searchParams.get('ok') ?? ''] ?? null;
const erreur = Astro.url.searchParams.get('erreur') ? 'Action impossible. Réessaie.' : null;
---

<Admin titre="Produits" onglet="produits">
  <form method="get" class="section-serree recherche">
    <label class="barre-recherche sur-fond">
      <Icone name="search" size={15} stroke={2} />
      <input
        type="search"
        name="q"
        value={recherche}
        placeholder="serviette, culotte, kit…"
        aria-label="Chercher un produit"
      />
    </label>
  </form>

  <div class="section-serree alertes">
    <Alerte message={succes} ton="succes" />
    <Alerte message={erreur} />
  </div>

  <section class="section liste">
    <h2 class="titre-section">
      {recherche ? `${produits.length} résultat${produits.length > 1 ? 's' : ''}` : 'Le catalogue'}
    </h2>
    <p class="aide">
      Tout le catalogue, en vente et retiré mélangés, dans l’ordre où les clientes le voient. Retirer n’efface
      pas : le produit disparaît de la boutique, ses anciennes commandes gardent leur contenu, et il se remet en
      vente d’un geste. Pour changer un prix, un stock ou un texte, c’est la fiche dans l’espace vendeur.
    </p>

    {produits.length === 0 && (
      <div class="etat-vide">
        <Icone name="box" size={34} class="icone-vide" />
        <div class="titre">{recherche ? 'Aucun produit de ce nom' : 'Catalogue vide'}</div>
        <p class="texte">
          {recherche
            ? 'Essaie avec un seul mot, ou vide la recherche pour revoir tout le catalogue.'
            : 'Les produits s’ajoutent depuis l’espace vendeur.'}
        </p>
        <a class="btn btn-action espace" href="/vendeur/produits">Aller aux produits</a>
      </div>
    )}

    {produits.map((p: any) => (
      <article class:list={['carte', { retire: !p.publie }]}>
        <span class="vignette">
          {p.image ? (
            <img src={p.image} alt="" width="64" height="64" class="photo-couvrante" loading="lazy" />
          ) : (
            <span class="vignette-vide remplit" />
          )}
        </span>
        <div class="infos">
          {/* Chez Jia le nom mène toujours à la fiche publique. Un produit
              retiré n'en a plus : le lien mène alors à sa fiche de gestion,
              qui est le seul endroit où il existe encore. */}
          <a href={p.publie ? `/boutique/${p.slug}` : `/vendeur/produits/${p.slug}`} class="titre">{p.nom}</a>
          <span class="meta">
            {p.rayon} · {depuis(p.cree_le)} ·{' '}
            {p.publie ? (p.stock > 0 ? `en vente, ${p.stock} en stock` : 'en vente, en rupture') : 'retiré'}
          </span>
          <span class="prix">{prix(p.prix_cfa)}</span>
          <div class="actions">
            <form method="post">
              <input type="hidden" name="produit" value={p.slug} />
              {p.publie ? (
                <button type="submit" name="action" value="retirer" class="btn btn-sombre btn-petit">Retirer</button>
              ) : (
                <button type="submit" name="action" value="republier" class="btn btn-contour btn-petit">
                  Remettre en vente
                </button>
              )}
            </form>
            <a class="btn btn-contour btn-petit" href={`/vendeur/produits/${p.slug}`}>Modifier la fiche</a>
          </div>
        </div>
      </article>
    ))}
  </section>
</Admin>

<style>
  .recherche { background: var(--surface); border-bottom: 1px solid var(--bordure); }
  .recherche :global(svg) { color: var(--texte-secondaire); flex: 0 0 auto; }
  .alertes { display: grid; padding-top: 0; padding-bottom: 0; }
  .alertes :global(.alerte) { margin-top: 12px; }
  .aide { margin: 0; font-size: 13px; color: var(--texte-secondaire); line-height: 1.5; }
  .liste { display: grid; gap: 10px; }
  .carte { display: flex; gap: 12px; background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 12px; }
  .carte.retire { opacity: .6; }
  .vignette { width: 64px; height: 64px; border-radius: 10px; overflow: hidden; background: var(--fond); flex: 0 0 auto; }
  .remplit { display: block; width: 100%; height: 100%; }
  .infos { flex: 1; min-width: 0; }
  .titre { display: block; font-weight: 700; font-size: 16.5px; color: var(--nom-produit); }
  .meta { display: block; font-size: 12.5px; color: var(--texte-secondaire); margin-top: 2px; }
  .infos .prix { display: block; font-size: 16px; margin-top: 4px; }
  .actions { display: flex; gap: 7px; flex-wrap: wrap; margin-top: 9px; }
  .titre-section { margin: 0; font-size: 16px; }
  .etat-vide :global(.icone-vide) { color: var(--texte-tertiaire); }
  .espace { margin-top: 16px; }
</style>

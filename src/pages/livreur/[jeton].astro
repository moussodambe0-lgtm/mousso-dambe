---
/**
 * La course, telle que le livreur la voit.
 *
 * Arthur, le 26 octobre 2026 : « lorsque la personne va taper marquer expédier,
 * ça va générer un lien. Et en fait, on envoie le lien au livreur. Et lorsque
 * le livreur clique sur le lien, il peut suivre directement la localisation de
 * la personne. »
 *
 * PAS DE COMPTE. Le livreur n'en a pas, et lui en demander un le jour d'une
 * course serait le plus sûr moyen qu'il n'ouvre jamais le lien. Le jeton de 48
 * caractères EST l'autorisation : il naît à l'expédition, meurt à l'arrivée, et
 * expire de toute façon au bout de deux jours. C'est la base qui tient ces
 * règles (`suivi_livreur`), pas cette page.
 *
 * CE QUE CETTE PAGE NE MONTRE PAS. Ni le prix des articles un par un, ni quoi
 * que ce soit d'autre que cette commande. Il porte un colis et encaisse un
 * total ; la marge de la boutique et les autres clientes ne le regardent pas.
 *
 * TOUJOURS PAS DE CARTE DESSINÉE ICI, ET C'EST RÉFLÉCHI. La cliente, elle, en
 * a une depuis le 8 novembre 2026. Lui n'en a pas besoin : une bibliothèque de
 * cartes pèse environ 150 Ko, il est dehors, sur un téléphone d'entrée de
 * gamme, avec un forfait compté. Surtout, il ne veut pas REGARDER une carte, il
 * veut que son application de navigation s'ouvre et lui dise où tourner. Le
 * bouton fait exactement cela, en une fois.
 *
 * CE QUI EST NOUVEAU LE 8 NOVEMBRE 2026 : il peut partager SA position. C'était
 * le chaînon manquant de toute l'affaire. Jusque-là tout allait dans un seul
 * sens, la cliente donnait son point et lui le recevait ; la carte de suivi
 * n'aurait donc montré qu'un point fixe, en promettant un suivi qui n'existe
 * pas. Un appui, une position, autant de fois qu'il veut. Jamais de relevé
 * continu : ce serait sa batterie, son forfait, et un traceur.
 *
 * LES BOUTONS SONT GROS parce qu'on appuie dessus debout, à moto arrêtée, au
 * soleil, souvent d'une main.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import { clientPublic, baseConfiguree } from '../../lib/supabase';
import { prix, messageErreur, heureCourte } from '../../lib/format';

export const prerender = false;

const jeton = String(Astro.params.jeton ?? '');

let course: any = null;
let erreur = '';
// DEUX ERREURS DIFFÉRENTES, ET IL FALLAIT LES SÉPARER. `erreur` veut dire « ce
// lien ne vaut plus rien », et la page n'affiche alors que cela. `ennui » veut
// dire « ta position n'est pas partie », ce qui n'empêche pas de livrer : la
// course doit rester affichée dessous, avec l'adresse et le numéro.
let ennui = '';
let partagee = '';

if (Astro.request.method === 'POST' && baseConfiguree()) {
  const f = await Astro.request.formData();
  const lat = Number(f.get('lat'));
  const lng = Number(f.get('lng'));
  if (!Number.isFinite(lat) || !Number.isFinite(lng) || (lat === 0 && lng === 0)) {
    ennui = "Appuie d'abord sur le bouton, puis laisse le téléphone répondre.";
  } else {
    const { data, error } = await clientPublic(Astro).rpc('livreur_partage_sa_position', {
      p_jeton: jeton,
      p_lat: lat,
      p_lng: lng,
    });
    if (error || !data?.ok) ennui = messageErreur(data?.erreur ?? error?.message);
    // Redirection après envoi : sans elle, un rafraîchissement renverrait la
    // même position, et le bouton retour du téléphone reposerait la question.
    else return Astro.redirect(`/livreur/${encodeURIComponent(jeton)}?ok=position`, 303);
  }
}

if (Astro.url.searchParams.get('ok') === 'position') {
  partagee = heureCourte(new Date());
}

if (!baseConfiguree()) {
  erreur = messageErreur('lien_invalide');
} else {
  const { data, error } = await clientPublic(Astro).rpc('suivi_livreur', { p_jeton: jeton });
  if (error || !data?.ok) erreur = messageErreur(data?.erreur ?? error?.message);
  else course = data;
}

// Une seule adresse de carte, construite une fois. `google.com/maps` ouvre
// l'application installée sur un Android, et le site sur tout le reste.
const lienCarte =
  course?.lat && course?.lng
    ? `https://www.google.com/maps/search/?api=1&query=${course.lat},${course.lng}`
    : '';

/*
 * PAS DE NUMÉRO DE COMMANDE ICI (Arthur, le 7 novembre 2026 : « je veux pas
 * de numéro de commande »).
 *
 * Cette page portait le numéro en gros, en haut, et dans le titre de l'onglet.
 * Ce qu'un livreur a besoin de distinguer quand il a trois courses ouvertes,
 * ce n'est pas une référence qu'il ne dictera jamais : c'est OÙ il va. Le
 * quartier remplace donc le numéro, et il est utile là où l'autre ne l'était
 * pas.
 */
const titre = course ? `Course · ${course.quartier || 'Quartier non donné'}` : 'Course';
---

<Base titre={titre} description="La course à livrer." pleinEcran>
  <main class="page">
    {
      erreur ? (
        <section class="ratee">
          <p class="ratee-mot">{erreur}</p>
          <p class="ratee-quoi">
            Appelle la boutique pour qu'elle t'en envoie un nouveau.
          </p>
        </section>
      ) : (
        <>
          <header class="haut">
            <p class="ou-grand">{course.quartier || 'Quartier non donné'}</p>
            {course.livreur_nom && <p class="pour">Pour {course.livreur_nom}</p>}
          </header>

          <section class="bloc">
            <h2 class="bloc-titre">Chez qui</h2>
            <p class="qui">{course.nom}</p>
            <p class="ou">
              {course.quartier || 'Quartier non donné'}
              {course.repere ? `, ${course.repere}` : ''}
            </p>
          </section>

          <div class="gestes">
            <a class="geste geste-rose" href={`tel:${course.telephone}`}>
              <Icone nom="telephone" taille={22} />
              Appeler {course.nom}
            </a>
            {lienCarte ? (
              <a class="geste" href={lienCarte} target="_blank" rel="noopener noreferrer">
                <Icone nom="lieu" taille={22} />
                Ouvrir la position
              </a>
            ) : (
              <p class="sans-point">
                Elle n'a pas partagé sa position. Appelle-la pour te faire guider.
              </p>
            )}
          </div>

          {/* SA POSITION À LUI, POUR QU'ELLE LE VOIE APPROCHER.
              Un appui, une position. Il peut appuyer en partant, puis en
              arrivant dans le quartier. Rien ne se relève dans son dos, et il
              peut livrer sans jamais appuyer : c'est un confort pour elle, pas
              une obligation pour lui. */}
          <form method="POST">
            {ennui && <p class="ennui">{ennui}</p>}
            {partagee && (
              <p class="partagee">
                <Icone nom="coche" taille={18} />
                Position envoyée à {partagee}. Elle te voit arriver.
              </p>
            )}
            <div class="lp" data-livreur-position hidden>
              <input type="hidden" class="lp-lat" name="lat" />
              <input type="hidden" class="lp-lng" name="lng" />
              <button class="geste lp-bouton" type="button">
                <Icone nom="lieu" taille={22} />
                {partagee ? 'Renvoyer ma position' : 'Partager ma position avec elle'}
              </button>
              <p class="lp-dit" hidden></p>
            </div>
          </form>

          <section class="bloc">
            <h2 class="bloc-titre">Ce que tu portes</h2>
            <ul class="articles">
              {(course.articles ?? []).map((a: any) => (
                <li>
                  <span class="chiffre">{a.quantite} ×</span> {a.nom}
                </li>
              ))}
            </ul>
          </section>

          <section class="bloc bloc-total">
            <p class="total-mot">À encaisser à la livraison</p>
            <p class="total chiffre">{prix(course.total_cfa ?? 0)} FCFA</p>
          </section>

          <p class="fin">
            Ce lien ne marche que pendant cette course. Quand la boutique marque
            la commande livrée, il s'arrête.
          </p>
        </>
      )
    }
  </main>
</Base>

<style>
  .page {
    display: grid;
    gap: var(--e3);
    max-width: 540px;
    margin: 0 auto;
    padding: var(--e4) var(--e4) calc(var(--e5) + env(safe-area-inset-bottom, 0px));
  }

  .haut {
    text-align: center;
  }

  /* Le quartier, en gros, à la place du numéro de commande retiré le
     7 novembre 2026. Un cran plus petit que le numéro ne l'était : un nom de
     quartier est plus long qu'une référence, et « Ouaga 2000 secteur 15 »
     tenait mal sur un petit téléphone à 27 pixels. */
  .ou-grand {
    margin: 0;
    font-size: 23px;
    font-weight: 800;
    line-height: 1.25;
    color: var(--rose);
  }

  .pour {
    margin: 2px 0 0;
    color: var(--texte-2);
    font-size: 14px;
  }

  .bloc {
    padding: var(--e3) var(--e4);
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    background: var(--surface);
  }

  .bloc-titre {
    margin: 0 0 var(--e2);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--texte-2);
  }

  .qui {
    margin: 0;
    font-size: 20px;
    font-weight: 700;
  }

  .ou {
    margin: 4px 0 0;
    font-size: 16px;
    color: var(--texte-2);
  }

  .gestes {
    display: grid;
    gap: var(--e2);
  }

  /* Hauteur bien au-delà des 44 px habituels : on vise ces boutons debout,
     d'une main, parfois avec des gants. */
  .geste {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--e2);
    min-height: 60px;
    border: 1px solid var(--bordure);
    border-radius: var(--r-champ);
    background: var(--surface);
    font-size: 17px;
    font-weight: 700;
    color: var(--texte);
  }

  .geste-rose {
    border-color: transparent;
    background: var(--rose);
    color: #fff;
  }

  .sans-point {
    margin: 0;
    padding: var(--e3);
    border: 1px dashed var(--bordure);
    border-radius: var(--r-champ);
    font-size: 14px;
    color: var(--texte-2);
    text-align: center;
  }

  .articles {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: 16px;
  }

  .bloc-total {
    text-align: center;
    background: var(--surface-douce);
  }

  .total-mot {
    margin: 0;
    font-size: 13px;
    color: var(--texte-2);
  }

  .total {
    margin: 2px 0 0;
    font-size: 28px;
    font-weight: 800;
    color: var(--rose);
  }

  .fin {
    margin: 0;
    font-size: 12.5px;
    color: var(--texte-2);
    text-align: center;
  }

  .ratee {
    padding: var(--e5) var(--e4);
    border: 1px dashed var(--bordure);
    border-radius: var(--r-carte);
    text-align: center;
  }

  .ratee-mot {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }

  .ratee-quoi {
    margin: var(--e2) 0 0;
    color: var(--texte-2);
  }

  /* --- Sa position à lui, partagée avec elle ------------------------------ */
  .lp {
    display: grid;
    gap: var(--e2);
  }

  .lp-dit {
    margin: 0;
    padding: var(--e2);
    border-radius: var(--r-champ);
    background: var(--surface-douce);
    font-size: 14px;
    text-align: center;
    color: var(--texte-2);
  }

  .partagee {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
    margin: 0 0 var(--e2);
    padding: var(--e3);
    border-radius: var(--r-champ);
    background: var(--surface-douce);
    color: var(--rose-fonce);
    font-size: 15px;
    font-weight: 700;
  }

  .ennui {
    margin: 0 0 var(--e2);
    padding: var(--e3);
    border: 1px solid var(--bordure-forte);
    border-radius: var(--r-champ);
    font-size: 14.5px;
    text-align: center;
    color: var(--texte);
  }
</style>

<script>
  import '../../scripts/livreur-position';
</script>

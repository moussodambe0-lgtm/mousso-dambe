---
/**
 * Créer un compte. Copie de l'écran de Jia, à l'identique.
 *
 * Arthur, le 7 novembre 2026 : « copie exactement la même chose. Jusqu'aux
 * couleurs. Tout. Je veux que tout soit identique. »
 *
 * Les couleurs, les polices, les rayons, les tailles et l'ordre des éléments
 * viennent de src/styles/auth-jia.css, qui explique d'où chaque valeur est
 * tirée. Le logo est celui de Mousso Dambé, comme demandé.
 *
 * DEUX ÉCARTS, ET AUCUN N'EST UNE RETOUCHE DE GOÛT :
 *
 * 1. PAS DE CHOIX « ACHETER / VENDRE ». Jia est une place de marché avec
 *    plusieurs boutiques ; Mousso Dambé est sa propre et unique boutique.
 * 2. S'INSCRIRE DEPUIS UN COMPTE COMMENCÉ L'ATTACHE, il n'en ouvre pas un
 *    second. Cela n'existe pas chez Jia, et c'est vital ici : on entre par
 *    « Commencer », donc une femme qui arrive ici a souvent DÉJÀ trois mois
 *    de règles notées. `signUp` lui donnerait un compte vide au moment précis
 *    où elle essaie de les mettre à l'abri. Voir src/lib/identite.ts.
 *
 * LE NUMÉRO DE TÉLÉPHONE est affiché comme sur la capture, dans son cadre à
 * bord orange. Il ne peut pas encore ouvrir de session : envoyer un code
 * demande un service payant au message. Le formulaire le dit en clair plutôt
 * que de faire semblant, et le numéro reste enregistré dans son profil, car
 * c'est lui que le livreur appellera.
 */
import Base from '../layouts/Base.astro';
import Symbole from '../components/Symbole.astro';
import BoutonGoogleJia from '../components/BoutonGoogleJia.astro';
import DrapeauBF from '../components/DrapeauBF.astro';
import Icone from '../components/Icone.astro';
import Alerte from '../components/Alerte.astro';
import { clientPublic, poserSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { clientAuthentifie, causeDeLEchec } from '../lib/identite';
import { suiteSure } from '../lib/suite';
import '../styles/auth-jia.css';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

if (!baseConfiguree()) return Astro.redirect('/', 302);

const moi = await visiteuse(Astro);
const suite = suiteSure(Astro.url.searchParams.get('suite'), '/compte');
if (moi?.compteReel) return Astro.redirect(suite, 303);

/** Elle est entrée par « Commencer » : on attache, on n'ouvre pas un second compte. */
const attache = Boolean(moi);

let erreur = '';
let reussite = '';
let saisie = {
  nom: '',
  prenom: moi?.prenom ?? '',
  telephone: moi?.telephone ?? '',
  email: '',
};

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  saisie = {
    nom: String(f.get('nom') ?? '').trim(),
    prenom: String(f.get('prenom') ?? '').trim(),
    telephone: String(f.get('telephone') ?? '').trim(),
    email: String(f.get('email') ?? '').trim().toLowerCase(),
  };

  if (String(f.get('geste') ?? '') === 'telephone') {
    // Le code n'a aucun moyen de partir : on le dit, on ne fait pas semblant.
    erreur =
      "La création par numéro de téléphone n'est pas encore ouverte. "
      + 'Ouvre « Connexion avec email » juste en dessous, ton numéro y est gardé.';
  } else {
    const motDePasse = String(f.get('motdepasse') ?? '');
    // Les mêmes règles que la base : 8 chiffres commençant par 5, 6 ou 7, et
    // l'indicatif accepté. `telephone_burkina` revérifie côté base.
    const numeroPropre = saisie.telephone.replace(/[^0-9]/g, '').replace(/^(00)?226/, '');
    const numeroValide = /^[567][0-9]{7}$/.test(numeroPropre);
    const nomLivraison = [saisie.prenom, saisie.nom].filter(Boolean).join(' ').trim();

    if (saisie.prenom.length < 2) {
      erreur = 'Dis-nous comment t’appeler, en toutes lettres.';
    } else if (!numeroValide) {
      erreur = 'Ce numéro n’existe pas au Burkina. 8 chiffres, commençant par 5, 6 ou 7.';
    } else if (!saisie.email) {
      erreur = 'Il nous faut ton adresse email.';
    } else if (motDePasse.length < 8) {
      erreur = 'Choisis un mot de passe d’au moins 8 caractères.';
    } else if (attache) {
      // ELLE A DÉJÀ UN COMPTE COMMENCÉ : on y attache l'email et le mot de
      // passe. Son identifiant ne change pas, donc rien n'est perdu.
      const sac: Record<string, string> = {};
      const client = await clientAuthentifie(Astro, sac);
      if (!client) {
        erreur = 'Ta session a expiré. Reviens à l’accueil et recommence.';
      } else {
        const { error } = await client.auth.updateUser({
          email: saisie.email,
          password: motDePasse,
          data: { prenom: saisie.prenom, nom: nomLivraison, telephone: numeroPropre },
        });
        const cause = error ? causeDeLEchec(error.message) : null;
        if (cause === 'deja-pris') {
          erreur = 'Cette adresse a déjà un compte. Choisis « Se connecter » pour le rejoindre.';
        } else if (cause === 'mot-de-passe-faible') {
          erreur = 'Choisis un mot de passe un peu plus long, au moins huit caractères.';
        } else if (error) {
          erreur = 'Nous n’avons pas pu enregistrer ton email. Réessaie dans un moment.';
        } else {
          reussite =
            'Nous venons d’envoyer un message à ' + saisie.email + '. Ouvre-le pour terminer.';
        }
      }
    } else {
      const { data, error } = await clientPublic(Astro).auth.signUp({
        email: saisie.email,
        password: motDePasse,
        options: { data: { prenom: saisie.prenom, nom: nomLivraison, telephone: numeroPropre } },
      });
      const cause = error ? causeDeLEchec(error.message) : null;
      if (cause === 'deja-pris') {
        erreur = 'Cette adresse a déjà un compte. Choisis « Se connecter » pour le rejoindre.';
      } else if (cause === 'mot-de-passe-faible') {
        erreur = 'Choisis un mot de passe un peu plus long, au moins huit caractères.';
      } else if (error) {
        erreur = 'Inscription impossible. Vérifie ton adresse et réessaie.';
      } else if (data.session) {
        poserSession(Astro, {
          access_token: data.session.access_token,
          refresh_token: data.session.refresh_token,
        });
        return Astro.redirect(suite, 303);
      } else {
        reussite =
          'Nous venons d’envoyer un message à ' + saisie.email + '. Ouvre-le pour terminer.';
      }
    }
  }
}

const versConnexion = `/connexion?suite=${encodeURIComponent(suite)}`;
/* Le volet reste fermé : « c'est la personne qui doit appuyer pour que ça se
   déballe ». Une erreur l'ouvre, sinon elle lirait le message sans voir le
   champ à corriger. */
const emailOuvert = Boolean(erreur) || Boolean(reussite);
---

<Base titre="Créer un compte" description="Crée ton compte Mousso Dambé pour retrouver ton cycle partout." pleinEcran>
  <main class="jia page-auth">
    <a class="j-retour" href="/compte" aria-label="Revenir en arrière">
      <Icone nom="retour" taille={24} epaisseur={2.5} />
    </a>

    <div class="tete">
      <Symbole taille={150} forme="nom" />
      <h1>Créer un compte</h1>
      <p class="sous">Une minute, et tes commandes te suivent sur tous tes téléphones.</p>
    </div>

    {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}
    {reussite && <div class="marge-bas"><Alerte type="reussite" texte={reussite} /></div>}

    {/* L'encadré « ce que tu as déjà noté reste sur ce compte, rien ne se
        perd » a été retiré le 7 novembre 2026 à la demande d'Arthur. La
        promesse, elle, tient toujours : s'inscrire depuis un compte commencé
        l'ATTACHE au lieu d'en ouvrir un second (voir `attache` plus haut, et
        src/lib/identite.ts). C'est le texte qui part, pas le comportement. */}

    <form method="POST" class="tout">
      <input type="hidden" name="suite" value={suite} />

      <h2 class="rubrique">Tes informations</h2>
      <div class="deux">
        <div>
          <label class="j-libelle" for="nom">Nom</label>
          <input class="j-champ" id="nom" name="nom" maxlength="40" autocomplete="family-name" value={saisie.nom} />
        </div>
        <div>
          <label class="j-libelle" for="prenom">Prénom</label>
          <input class="j-champ" id="prenom" name="prenom" required minlength="2" maxlength="40" autocomplete="given-name" value={saisie.prenom} />
        </div>
      </div>

      <section class="j-cadre">
        <div class="j-cadre-tete">
          <span class="j-rond" aria-hidden="true"><Icone nom="telephone" taille={20} /></span>
          <div>
            <p class="j-cadre-titre">Continuer avec un numéro de téléphone</p>
            <p class="j-cadre-note">C’est le numéro que le livreur appellera</p>
          </div>
        </div>
        <div class="j-tel">
          <span class="j-indicatif"><DrapeauBF taille={26} /> +226</span>
          <label class="sr-seul" for="telephone">Ton numéro de téléphone</label>
          <input class="j-champ-tel" id="telephone" name="telephone" type="tel" inputmode="numeric" maxlength="11" value={saisie.telephone} />
        </div>
        <button type="submit" name="geste" value="telephone" class="j-btn j-btn-action">Créer mon compte</button>
      </section>

      <div class="j-ou"><span>Ou</span></div>

      <details class="j-volet" open={emailOuvert}>
        <summary>
          <span class="j-rond" aria-hidden="true"><Icone nom="envoyer" taille={20} /></span>
          <span class="j-volet-mots">
            <span class="j-volet-titre">Connexion avec email</span>
            <span class="j-volet-sous">Ton email et un mot de passe</span>
          </span>
          <span class="j-chevron" aria-hidden="true"><Icone nom="bas" taille={20} /></span>
        </summary>

        <div class="j-volet-dedans">
          <div class="champ-bloc">
            <label class="j-libelle" for="email">Ton email</label>
            <input class="j-champ" id="email" name="email" type="email" autocomplete="email" inputmode="email" value={saisie.email} />
          </div>

          <div class="champ-bloc">
            <label class="j-libelle" for="motdepasse">Choisis un mot de passe</label>
            <input class="j-champ" id="motdepasse" name="motdepasse" type="password" minlength="8" autocomplete="new-password" />
            <span class="aide-jia">8 caractères minimum.</span>
          </div>

          <button type="submit" class="j-btn j-btn-action">Créer mon compte</button>
        </div>
      </details>
    </form>

    <div class="j-ou"><span>Ou</span></div>

    <BoutonGoogleJia texte="S’inscrire avec Google" />

    <p class="j-legal">
      En créant un compte, tu acceptes les conditions d’utilisation de Mousso Dambé et sa
      politique de confidentialité.
    </p>

    <p class="j-bas">Déjà un compte ? <a href={versConnexion}>Se connecter</a></p>
  </main>
</Base>

<style>
  .page-auth {
    position: relative;
    max-width: 480px;
    margin: 0 auto;
    padding: 90px 18px 40px;
  }

  .tete { text-align: center; padding: 0 0 26px; }
  .tete h1 { margin: 18px 0 0; font-size: 32px; line-height: 1.15; }
  .sous { margin: 8px 0 0; font-size: 16px; line-height: 1.4; color: #7a8290; }

  .marge-bas { margin-bottom: 14px; }

  .rubrique { margin: 0 0 14px; font-size: 20px; }

  /* Nom et prénom côte à côte, comme sur la capture. Ils passent l'un sous
     l'autre sur un très petit écran, où deux champs de 150 px seraient
     inutilisables. */
  .deux { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 340px) { .deux { grid-template-columns: 1fr; } }

  .j-cadre { margin-top: 18px; }

  .sr-seul {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .champ-bloc + .champ-bloc { margin-top: 16px; }
  .j-volet-dedans .j-btn { margin-top: 20px; }

  .aide-jia {
    display: block;
    margin-top: 6px;
    font-size: 13.5px;
    color: #9aa1ab;
  }
</style>

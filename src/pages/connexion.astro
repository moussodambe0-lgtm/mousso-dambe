---
/**
 * Se connecter, ou garder le compte déjà commencé.
 *
 * GOOGLE EN GRAND, LE MOT DE PASSE REPLIÉ (Arthur, le 27 octobre 2026)
 *
 * « Il y aura le bouton se connecter avec Google qui sera en grand, et il y
 * aura une petite option pour se connecter en écrivant son email et son mot de
 * passe, mais je veux qu'on mette en valeur se connecter avec Google. »
 *
 * Le second chemin est donc dans un `details` fermé : du HTML, pas une ligne
 * de JavaScript, et il s'ouvre en place sans quitter l'écran. Il n'est pas
 * caché pour autant, son libellé le nomme ; il est juste rangé.
 *
 * Et ce n'est pas qu'une affaire de hiérarchie visuelle : Google ouvre la
 * session immédiatement, alors que l'email oblige à sortir de l'application
 * pour aller chercher un message de confirmation. Mettre en avant le chemin
 * court, c'est mettre en avant celui qui aboutit.
 *
 * DEUX VISAGES, SELON QUI ARRIVE
 *
 *   - Personne derrière : « Te revoilà ». On la connecte.
 *   - Une visiteuse entrée par « Commencer », donc sans email : « Garde ton
 *     compte ». On ATTACHE Google ou un mot de passe au compte qu'elle a
 *     déjà, et son identifiant ne change pas. Voir src/lib/identite.ts.
 *
 * CETTE PAGE LUI ÉTAIT INTERDITE, ET C'ÉTAIT UN MUR. Jusqu'au 27 octobre
 * 2026, la seule présence d'une session renvoyait à l'accueil. Or « Commencer »
 * pose une session anonyme : une femme entrée par là ne pouvait donc JAMAIS
 * atteindre cet écran, et n'avait aucun moyen d'obtenir un vrai compte. On ne
 * renvoie plus que celles qui en ont déjà un.
 *
 * LE MESSAGE D'ERREUR EST LE MÊME QUE L'ADRESSE EXISTE OU NON : dire « cette
 * adresse n'a pas de compte » révélerait à un mari curieux si sa femme utilise
 * l'application. Ce n'est pas une précaution théorique ici.
 *
 * Cette phrase était fausse pour un cas, jusqu'à l'audit du 26 octobre 2026 :
 * une adresse non confirmée recevait « ton adresse n'est pas encore
 * confirmée », donc l'aveu qu'un compte existe. Il n'y a plus qu'un seul
 * texte, et un garde-fou dans supabase/tests/connexion.test.mjs tombe si un
 * second réapparaît.
 */
import Base from '../layouts/Base.astro';
import Symbole from '../components/Symbole.astro';
import BoutonGoogle from '../components/BoutonGoogle.astro';
import Alerte from '../components/Alerte.astro';
import Icone from '../components/Icone.astro';
import { clientPublic, poserSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { clientAuthentifie, causeDeLEchec } from '../lib/identite';
import { hoteDemande, estHoteAdmin } from '../lib/hotes';
import { ADMIN_HOST } from 'astro:env/server';

export const prerender = false;

// Sur l'adresse de la gestion, on ne crée pas de compte : il n'y a qu'un
// administrateur, nommé dans les réglages de la base. Le bouton « Je n'ai pas
// encore de compte » menait à /ouverture, qui n'existe pas sur ce sous-domaine,
// d'où « cette page n'est pas disponible » (Arthur, le 24 octobre 2026).
const surHoteAdmin = estHoteAdmin(
  hoteDemande(Astro.request.headers, Astro.url.hostname),
  ADMIN_HOST
);

const moi = baseConfiguree() ? await visiteuse(Astro) : null;

// Celle qui a DÉJÀ un vrai compte n'a rien à faire ici. Celle qui est entrée
// sans compte, elle, vient précisément ici pour en obtenir un.
if (moi?.compteReel) return Astro.redirect('/', 302);

/** Elle a un compte commencé à garder, plutôt qu'une connexion à retrouver. */
const aGarder = Boolean(moi) && !surHoteAdmin;

// Elle a demandé expressément un autre compte, après un échec de liaison.
const basculer = Astro.url.searchParams.get('retrouver') === '1';
const mode: 'garder' | 'retrouver' = aGarder && !basculer ? 'garder' : 'retrouver';

let erreur = '';
let reussite = '';

// Les retours de Google passent par l'adresse : on les traduit ici, sans
// jamais dire si un compte existe ou non.
const venuDe = Astro.url.searchParams.get('erreur');
if (venuDe === 'google') {
  erreur = "La connexion avec Google n'a pas abouti. Réessaie.";
} else if (venuDe === 'google-deja-pris') {
  erreur =
    "Cette adresse Google est déjà celle d'un autre compte Mousso Dambé. "
    + 'Tu peux te connecter à ce compte, mais ce que tu as noté depuis ce '
    + 'téléphone ne le suivra pas.';
} else if (venuDe === 'liaison') {
  erreur =
    "Nous n'avons pas pu attacher Google à ton compte. Réessaie dans un "
    + 'moment, ou garde ton compte avec un mot de passe.';
} else if (venuDe === 'pas-de-base') {
  erreur = "L'application n'est pas encore branchée à sa base de données.";
}

/** Pourquoi on la lui demande, quand elle arrive depuis un écran fermé. */
const POURQUOI: Record<string, string> = {
  messagerie:
    "Pour écrire à Dambé ou à la boutique, garde d'abord ton compte : c'est ce "
    + 'qui permet de retrouver tes messages, et à la boutique de te répondre.',
  compte: "Pour voir ton compte, garde-le d'abord.",
};
const pourquoi = POURQUOI[String(Astro.url.searchParams.get('pour') ?? '')] ?? '';

let emailSaisi = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  emailSaisi = String(f.get('email') ?? '').trim().toLowerCase();
  const motDePasse = String(f.get('motdepasse') ?? '');
  const geste = String(f.get('geste') ?? '');

  if (!emailSaisi || !motDePasse) {
    erreur = 'Remplis les deux champs.';
  } else if (geste === 'garder' && moi) {
    // ATTACHER un email et un mot de passe au compte qu'elle a déjà, au lieu
    // d'ouvrir une session sur un autre : son identifiant ne bouge pas, donc
    // son cycle, son journal et ses commandes restent les siens.
    const sac: Record<string, string> = {};
    const client = await clientAuthentifie(Astro, sac);
    if (!client) {
      erreur = "Ta session a expiré. Reviens à l'accueil et recommence.";
    } else {
      const { error } = await client.auth.updateUser({ email: emailSaisi, password: motDePasse });
      const cause = error ? causeDeLEchec(error.message) : null;
      if (cause === 'deja-pris') {
        erreur =
          "Cette adresse est déjà utilisée. Si c'est la tienne, ouvre « J'ai "
          + 'déjà un compte » plus bas.';
      } else if (cause === 'mot-de-passe-faible') {
        erreur = 'Choisis un mot de passe un peu plus long, au moins huit caractères.';
      } else if (error) {
        erreur = "Nous n'avons pas pu enregistrer ton email. Réessaie dans un moment.";
      } else {
        // Le compte reste anonyme jusqu'à ce qu'elle ouvre l'email : c'est
        // Supabase qui en décide, et c'est juste. On le lui dit franchement
        // plutôt que de la laisser croire que c'est fini.
        reussite =
          'Nous venons d\'envoyer un message à ' + emailSaisi
          + '. Ouvre-le pour terminer, et ton compte sera gardé.';
      }
    }
  } else {
    const { data, error } = await clientPublic(Astro).auth.signInWithPassword({
      email: emailSaisi,
      password: motDePasse,
    });
    if (error || !data.session) {
      // LE MÊME TEXTE DANS TOUS LES CAS. Il y en avait deux : « ton adresse
      // n'est pas encore confirmée » confirmait qu'un compte existe à cette
      // adresse, et c'est exactement ce que l'en-tête de ce fichier promet de
      // ne jamais dire. Un mari qui essaie l'adresse de sa femme avec
      // n'importe quel mot de passe apprenait qu'elle a un compte ici (Cyber,
      // 26 octobre 2026). Le texte unique dit les deux causes possibles, pour
      // ne pas laisser sans secours celle qui n'a pas encore confirmé.
      erreur =
        'Email ou mot de passe incorrect. Si tu viens de créer ton compte, '
        + "ouvre d'abord l'email de confirmation.";
    } else {
      poserSession(Astro, {
        access_token: data.session.access_token,
        refresh_token: data.session.refresh_token,
      });
      return Astro.redirect('/', 303);
    }
  }
}

const titre = mode === 'garder' ? 'Garde ton compte' : 'Te revoilà';
---

<Base titre={mode === 'garder' ? 'Garder mon compte' : 'Me connecter'} pleinEcran>
  <main class="page">
    <div class="haut">
      <Symbole taille={150} forme="nom" anime titre="Mousso Dambé" />
      <h1>{titre}</h1>
      {mode === 'garder' && (
        <p class="sous">
          Tes règles, ton journal et tes commandes sont déjà là. Attache-les à ton
          email pour les retrouver sur n'importe quel téléphone.
        </p>
      )}
    </div>

    <div class="apparait corps">
      {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}
      {reussite && <div class="marge-bas"><Alerte type="reussite" texte={reussite} /></div>}

      {pourquoi && !erreur && !reussite && (
        <p class="pourquoi">
          <Icone nom="info" taille={15} />
          {pourquoi}
        </p>
      )}

      <BoutonGoogle
        grand
        basculer={mode === 'retrouver' && aGarder}
        texte={mode === 'garder' ? 'Garder avec Google' : 'Me connecter avec Google'}
      />
      <p class="rapide">Deux touches, rien à retenir, et c'est tout de suite.</p>

      <details class="replie">
        <summary>
          <span>
            {mode === 'garder'
              ? 'Utiliser un email et un mot de passe'
              : 'Me connecter avec un mot de passe'}
          </span>
          <Icone nom="bas" taille={16} />
        </summary>

        <form method="POST" class="dedans">
          <input type="hidden" name="geste" value={mode === 'garder' ? 'garder' : 'retrouver'} />

          <div class="champ-bloc">
            <label class="libelle" for="email">Ton email</label>
            <input class="champ" id="email" name="email" type="email" autocomplete="email" required value={emailSaisi} />
          </div>

          <div class="champ-bloc">
            <label class="libelle" for="motdepasse">
              {mode === 'garder' ? 'Choisis un mot de passe' : 'Ton mot de passe'}
            </label>
            <input
              class="champ"
              id="motdepasse"
              name="motdepasse"
              type="password"
              autocomplete={mode === 'garder' ? 'new-password' : 'current-password'}
              minlength={mode === 'garder' ? 8 : undefined}
              required
            />
          </div>

          {mode === 'garder' && (
            <p class="aide">
              Tu devras ouvrir le message que nous t'enverrons pour terminer. Avec
              Google, il n'y a rien à ouvrir.
            </p>
          )}

          <button class="btn btn-rose btn-plein" type="submit">
            {mode === 'garder' ? 'Garder mon compte' : 'Me connecter'}
          </button>
        </form>
      </details>

      <p class="centre marge">
        {mode === 'garder' && (
          <a class="btn btn-texte" href="/connexion?retrouver=1">J'ai déjà un compte</a>
        )}
        {mode === 'retrouver' && aGarder && (
          <a class="btn btn-texte" href="/connexion">Revenir à mon compte commencé</a>
        )}
        {mode === 'retrouver' && !aGarder && !surHoteAdmin && (
          <a class="btn btn-texte" href="/ouverture">Je n'ai pas encore de compte</a>
        )}
      </p>
    </div>
  </main>
</Base>

<style>
  /* CENTRE VERTICALEMENT, ET AVEC DES MARGES AUTOMATIQUES PLUTOT QU'UN
     `justify-content: center`.
     Les deux centrent pareil tant que ca tient dans l'ecran. Mais quand la
     petite option est depliee, le formulaire depasse : `justify-content:
     center` deborde alors des DEUX cotes, et le haut de la page devient
     impossible a atteindre au defilement, logo et titre compris. Une marge
     automatique, elle, se reduit a zero des qu'il n'y a plus de place. */
  .page {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  .haut {
    margin-top: auto;
  }

  .corps {
    margin-bottom: auto;
    padding-bottom: var(--e5);
  }

  .haut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e3);
    padding: var(--e7) 0 var(--e4);
    text-align: center;
  }

  .haut h1 {
    font-size: 31.5px;
  }

  .sous {
    margin: 0;
    max-width: 30ch;
    font-size: 15px;
    line-height: 1.5;
    color: var(--texte-2);
  }

  .champ-bloc {
    margin-bottom: var(--e4);
  }

  .marge {
    margin-top: var(--e3);
  }

  .centre {
    text-align: center;
  }

  .marge-bas {
    margin-bottom: var(--e4);
  }

  .pourquoi {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0 0 var(--e4);
    padding: var(--e3);
    border-radius: var(--r-champ);
    background: var(--surface-douce);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--texte-2);
  }

  /* Sous le bouton, et non au-dessus : elle lit d'abord quoi faire, puis
     pourquoi c'est le bon choix. */
  .rapide {
    margin: var(--e2) 0 var(--e5);
    font-size: 13px;
    text-align: center;
    color: var(--texte-3);
  }

  /* LA PETITE OPTION. Un repli, pas un second bouton : deux boutons de même
     poids auraient annulé la mise en valeur demandée. */
  .replie {
    border-top: 1px solid var(--bordure);
    padding-top: var(--e3);
  }

  .replie summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    /* 44 px de haut : une cible que le pouce atteint, même repliée. */
    min-height: 44px;
    color: var(--texte-2);
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  /* Le triangle par défaut, retiré des deux façons que les navigateurs
     comprennent chacun. */
  .replie summary::-webkit-details-marker {
    display: none;
  }

  .replie summary::marker {
    content: '';
  }

  .replie summary:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
    border-radius: var(--r-champ);
  }

  .replie[open] summary {
    margin-bottom: var(--e3);
  }

  .replie summary :global(svg) {
    transition: transform var(--vite) ease;
  }

  .replie[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .replie summary :global(svg) {
      transition: none;
    }
  }

  .dedans {
    padding-top: var(--e2);
  }

  .aide {
    margin: calc(-1 * var(--e2)) 0 var(--e4);
    font-size: 13px;
    line-height: 1.45;
    color: var(--texte-3);
  }
</style>

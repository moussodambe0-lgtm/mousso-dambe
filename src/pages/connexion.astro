---
/**
 * Se connecter.
 *
 * Le message d'erreur est le même que l'adresse existe ou non : dire « cette
 * adresse n'a pas de compte » révélerait à un mari curieux si sa femme utilise
 * l'application. Ce n'est pas une précaution théorique ici.
 */
import Base from '../layouts/Base.astro';
import Symbole from '../components/Symbole.astro';
import BoutonGoogle from '../components/BoutonGoogle.astro';
import Alerte from '../components/Alerte.astro';
import { clientPublic, poserSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';

if (baseConfiguree() && (await visiteuse(Astro))) {
  return Astro.redirect('/', 302);
}

let erreur = '';

// Les retours de Google passent par l'adresse : on les traduit ici, sans
// jamais dire si un compte existe ou non.
const venuDe = Astro.url.searchParams.get('erreur');
if (venuDe === 'google') {
  erreur = "La connexion avec Google n'a pas abouti. Réessaie, ou connecte-toi avec ton mot de passe.";
} else if (venuDe === 'pas-de-base') {
  erreur = "L'application n'est pas encore branchée à sa base de données.";
}
let emailSaisi = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  emailSaisi = String(f.get('email') ?? '').trim().toLowerCase();
  const motDePasse = String(f.get('motdepasse') ?? '');

  if (!emailSaisi || !motDePasse) {
    erreur = 'Remplis les deux champs.';
  } else {
    const { data, error } = await clientPublic(Astro).auth.signInWithPassword({
      email: emailSaisi,
      password: motDePasse,
    });
    if (error || !data.session) {
      erreur = /not confirmed/i.test(error?.message ?? '')
        ? "Ton adresse n'est pas encore confirmée. Ouvre l'email qu'on t'a envoyé."
        : 'Email ou mot de passe incorrect.';
    } else {
      poserSession(Astro, {
        access_token: data.session.access_token,
        refresh_token: data.session.refresh_token,
      });
      return Astro.redirect('/', 303);
    }
  }
}
---

<Base titre="Me connecter" pleinEcran>
  <main class="page">
    <div class="haut">
      <Symbole taille={150} forme="nom" anime titre="Mousso Dambé" />
      <h1>Te revoilà</h1>
    </div>

    <div class="apparait">
      {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

      <BoutonGoogle texte="Me connecter avec Google" />

      <div class="ou" role="separator" aria-label="ou">
        <span>ou</span>
      </div>
    </div>

    <form method="POST" class="apparait">
      <div class="champ-bloc">
        <label class="libelle" for="email">Ton email</label>
        <input class="champ" id="email" name="email" type="email" autocomplete="email" required value={emailSaisi} />
      </div>

      <div class="champ-bloc">
        <label class="libelle" for="motdepasse">Ton mot de passe</label>
        <input class="champ" id="motdepasse" name="motdepasse" type="password" autocomplete="current-password" required />
      </div>

      <button class="btn btn-rose btn-plein" type="submit">Me connecter</button>

      <p class="centre marge">
        <a class="btn btn-texte" href="/ouverture">Je n'ai pas encore de compte</a>
      </p>
    </form>
  </main>
</Base>

<style>
  .haut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e3);
    padding: var(--e7) 0 var(--e5);
    text-align: center;
  }

  .haut h1 {
    font-size: 31.5px;
  }

  .champ-bloc {
    margin-bottom: var(--e4);
  }

  .marge {
    margin-top: var(--e3);
  }

  .centre {
    text-align: center;
  }

  .marge-bas {
    margin-bottom: var(--e4);
  }

  /* Le séparateur entre Google et le mot de passe : un trait de chaque côté
     du mot, pour que les deux chemins se lisent comme deux choix et non
     comme une suite d'étapes. */
  .ou {
    display: flex;
    align-items: center;
    gap: var(--e3);
    margin: var(--e4) 0;
    color: var(--texte-3);
    font-size: 14px;
    font-weight: 600;
  }

  .ou::before,
  .ou::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--bordure);
  }
</style>

---
/**
 * Se connecter. Copie de l'écran de Jia, à l'identique.
 *
 * Arthur, le 7 novembre 2026 : « copie exactement la même chose. Jusqu'aux
 * couleurs. Tout. Je veux que tout soit identique. Parfaitement identique.
 * N'essaie pas de modifier. Même chose à l'identique. »
 *
 * Les couleurs, les polices, les rayons, les tailles et l'ordre des éléments
 * viennent de src/styles/auth-jia.css, qui explique d'où chaque valeur est
 * tirée. Le logo est celui de Mousso Dambé, comme demandé.
 *
 * DEUX CHOSES QUI NE SONT PAS DU DESSIN, ET QUI RESTENT CELLES DE MOUSSO
 * DAMBÉ :
 *
 *   - le tutoiement, parce que les soixante autres pages tutoient ;
 *   - le message d'erreur UNIQUE, que l'adresse existe ou non. Dire « cette
 *     adresse n'a pas de compte » révélerait à un mari curieux si sa femme
 *     utilise l'application. Un garde-fou dans connexion.test.mjs tombe si un
 *     second texte réapparaît.
 *
 * LE NUMÉRO DE TÉLÉPHONE est affiché comme sur la capture. Il ne peut pas
 * encore ouvrir de session : envoyer un code demande un service payant au
 * message, qui n'existe pas dans ce projet. Le formulaire le dit en clair
 * plutôt que de faire semblant.
 */
import Base from '../layouts/Base.astro';
import Symbole from '../components/Symbole.astro';
import BoutonGoogleJia from '../components/BoutonGoogleJia.astro';
import DrapeauBF from '../components/DrapeauBF.astro';
import Alerte from '../components/Alerte.astro';
import Icone from '../components/Icone.astro';
import { clientPublic, poserSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { hoteDemande, estHoteAdmin } from '../lib/hotes';
import { suiteSure } from '../lib/suite';
import { ADMIN_HOST } from 'astro:env/server';
import '../styles/auth-jia.css';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const surHoteAdmin = estHoteAdmin(
  hoteDemande(Astro.request.headers, Astro.url.hostname),
  ADMIN_HOST
);

const moi = baseConfiguree() ? await visiteuse(Astro) : null;
if (moi?.compteReel) return Astro.redirect('/', 302);

const suite = suiteSure(Astro.url.searchParams.get('suite'), '/compte');

// L'ANCIENNE ADRESSE, GARDÉE VIVANTE : des liens `?action=inscrire` sont déjà
// partis sur WhatsApp, et un lien partagé qui ne mène nulle part ne revient
// jamais.
if (Astro.url.searchParams.get('action') === 'inscrire' && !surHoteAdmin) {
  return Astro.redirect(`/inscription?suite=${encodeURIComponent(suite)}`, 301);
}

let erreur = '';

const venuDe = Astro.url.searchParams.get('erreur');
if (venuDe === 'google') {
  erreur = "La connexion avec Google n'a pas marché. Réessaie.";
} else if (venuDe === 'google-deja-pris') {
  erreur =
    "Cette adresse Google a déjà un compte Mousso Dambé. Choisis « Se connecter » "
    + 'pour le rejoindre.';
} else if (venuDe === 'liaison') {
  erreur =
    "La connexion avec Google n'a pas marché. Réessaie, ou utilise un email et "
    + 'un mot de passe.';
} else if (venuDe === 'pas-de-base') {
  erreur = "L'application n'est pas encore branchée à sa base de données.";
}

const POURQUOI: Record<string, string> = {
  messagerie:
    "Pour écrire à Dambé ou à la boutique, il faut un compte : c'est ce qui "
    + 'permet de retrouver tes messages, et à la boutique de te répondre.',
  compte: "Pour voir ton compte, connecte-toi d'abord.",
};
const dOu = String(Astro.url.searchParams.get('pour') ?? '');
const pourquoi = POURQUOI[dOu] ?? '';

let emailSaisi = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();

  if (String(f.get('geste') ?? '') === 'telephone') {
    // Le code n'a aucun moyen de partir : on le dit, on ne fait pas semblant.
    erreur =
      "L'entrée par numéro de téléphone n'est pas encore ouverte. "
      + 'Utilise ton email et ton mot de passe, juste en dessous.';
  } else {
    emailSaisi = String(f.get('email') ?? '').trim().toLowerCase();
    const motDePasse = String(f.get('motdepasse') ?? '');

    if (!emailSaisi || !motDePasse) {
      erreur = 'Remplis les deux champs.';
    } else {
      const { data, error } = await clientPublic(Astro).auth.signInWithPassword({
        email: emailSaisi,
        password: motDePasse,
      });
      if (error || !data.session) {
        // LE MÊME TEXTE DANS TOUS LES CAS. Voir l'en-tête de ce fichier.
        erreur =
          'Email ou mot de passe incorrect. Si tu viens de créer ton compte, '
          + "ouvre d'abord l'email de confirmation.";
      } else {
        poserSession(Astro, {
          access_token: data.session.access_token,
          refresh_token: data.session.refresh_token,
        });
        return Astro.redirect(suiteSure(String(f.get('suite') ?? ''), '/'), 303);
      }
    }
  }
}

const versInscription = `/inscription?suite=${encodeURIComponent(suite)}`;

/*
 * LE VOLET EMAIL RESTE FERMÉ. Arthur, le 7 novembre 2026 : « il faut pas que
 * ça soit déballé, il faut que la personne appuie pour que ça se déballe. »
 *
 * DEUX EXCEPTIONS, chacune évitant une impasse : une erreur du formulaire
 * l'ouvre, sinon elle lirait « mot de passe incorrect » sans voir le champ à
 * corriger ; et sur l'adresse de la gestion il reste ouvert, l'email y étant
 * le seul chemin (ni téléphone, ni Google, ni inscription).
 */
const emailOuvert = Boolean(erreur) || surHoteAdmin;
---

<Base titre="Connexion" description="Connecte-toi à ton compte Mousso Dambé." pleinEcran>
  <main class="jia page-auth">
    <a class="j-retour" href="/compte" aria-label="Revenir en arrière">
      <Icone nom="retour" taille={24} epaisseur={2.5} />
    </a>

    <div class="tete">
      <Symbole taille={150} forme="nom" />
      <h1>Se connecter</h1>
      <p class="sous">Choisis comment te connecter.</p>
    </div>

    {pourquoi && (
      <div class="encadre doux">
        <Icone nom="info" taille={19} />
        <p>{pourquoi}</p>
      </div>
    )}

    {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

    {/* L'AVERTISSEMENT « ce que tu as noté ne suivra pas » A ÉTÉ RETIRÉ le
        7 novembre 2026, à la demande d'Arthur.

        CE QU'IL DISAIT, ET QUI RESTE VRAI : une femme entrée par
        « Commencer » qui se connecte ICI rejoint un AUTRE compte, et ce
        qu'elle a noté depuis ce téléphone reste sur le compte commencé. Pour
        le garder, c'est /inscription qu'il lui faut, qui ATTACHE son email au
        compte où tout est déjà (voir src/lib/identite.ts).

        Le comportement n'a pas changé, seul le texte part. Le lien
        « Créer un compte » en bas de page reste le chemin vers l'autre
        porte. */}

    <form method="POST" class="bloc-tel">
      <input type="hidden" name="geste" value="telephone" />
      <div class="j-tel">
        <span class="j-indicatif"><DrapeauBF taille={26} /> +226</span>
        <label class="sr-seul" for="tel">Ton numéro de téléphone</label>
        <input class="j-champ-tel" id="tel" name="telephone" type="tel" inputmode="numeric" placeholder="70 12 34 56" maxlength="11" />
      </div>
      <button type="submit" class="j-btn j-btn-action">Se connecter</button>
    </form>

    <div class="j-ou"><span>Ou</span></div>

    <details class="j-volet" open={emailOuvert}>
      <summary>
        <span class="j-rond" aria-hidden="true"><Icone nom="envoyer" taille={20} /></span>
        <span class="j-volet-mots"><span class="j-volet-titre">Adresse email</span></span>
        <span class="j-chevron" aria-hidden="true"><Icone nom="bas" taille={20} /></span>
      </summary>

      <form method="POST" class="j-volet-dedans">
        <input type="hidden" name="suite" value={suite} />

        <div class="champ-bloc">
          <label class="j-libelle" for="email">Ton email</label>
          <input class="j-champ" id="email" name="email" type="email" required autocomplete="email" inputmode="email" value={emailSaisi} />
        </div>

        <div class="champ-bloc">
          <label class="j-libelle" for="motdepasse">Ton mot de passe</label>
          <input class="j-champ" id="motdepasse" name="motdepasse" type="password" required autocomplete="current-password" />
        </div>

        <button type="submit" class="j-btn j-btn-action">Se connecter</button>
      </form>
    </details>

    <div class="apres-volet">
      <BoutonGoogleJia texte="Continuer avec Google" basculer={!!moi} />
    </div>

    {import.meta.env.DEV && surHoteAdmin && (
      <a class="j-btn j-btn-blanc porte-locale" href="/dev/admin">
        Entrer sans mot de passe (local)
      </a>
    )}

    <p class="j-legal">
      En te connectant, tu acceptes les conditions d’utilisation de Mousso Dambé et sa
      politique de confidentialité.
    </p>

    <a class="j-oubli" href="/connexion?oubli=1">Mot de passe oublié ?</a>

    {!surHoteAdmin && (
      <p class="j-bas">
        Pas encore inscrite ? <a href={versInscription}>Créer un compte</a>
      </p>
    )}
  </main>
</Base>

<style>
  .page-auth {
    position: relative;
    max-width: 480px;
    margin: 0 auto;
    padding: 90px 18px 40px;
  }

  .tete { text-align: center; padding: 0 0 26px; }
  .tete h1 { margin: 18px 0 0; font-size: 32px; line-height: 1.15; }
  .sous { margin: 8px 0 0; font-size: 16px; color: #7a8290; }

  .marge-bas { margin-bottom: 14px; }

  /* Les deux encadrés d'information, dans les roses de la page (voir
     src/styles/auth-jia.css : l'orange de Jia viré au rose de Mousso Dambé,
     à luminosité et saturation égales). */
  .doux {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 14px;
    background: #ffe9f1;
    border-color: #ffc9dd;
  }
  .doux p { margin: 0; font-size: 14px; line-height: 1.45; color: #3c4653; }
  .doux a { font-weight: 700; }

  .bloc-tel { display: grid; gap: 14px; }

  .sr-seul {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .champ-bloc + .champ-bloc { margin-top: 16px; }
  .j-volet-dedans .j-btn { margin-top: 20px; }

  .apres-volet { margin-top: 14px; }
  .porte-locale { margin-top: 14px; }
</style>

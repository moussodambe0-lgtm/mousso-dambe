---
/**
 * LE TABLEAU DE BORD DU CYCLE.
 *
 * Section 4 du cahier d'Arthur. Son reproche était net : « jour 1 sur 28,
 * c'est trop basique, je veux vraiment une amélioration ». Ce que cet écran
 * ajoute à un chiffre :
 *
 *   - l'anneau segmenté montre TOUT le cycle, pas seulement où on en est ;
 *   - les cartes disent les dates exactes, pas des « bientôt » ;
 *   - la jauge de risque répond à la question qu'on se pose vraiment ;
 *   - la saisie du jour est là, pas deux écrans plus loin ;
 *   - et quand les données montrent quelque chose d'inhabituel, l'écran le
 *     dit doucement, sans faire peur et sans diagnostiquer.
 *
 * Tout est calculé sur le serveur par `src/lib/cycle-calcul.ts`, le seul
 * endroit où vivent ces règles, et qui porte 69 vérifications.
 *
 * L'avertissement sur la contraception n'est PLUS sur cet écran (retiré à la
 * demande d'Arthur le 13 octobre 2026) ; il reste sur le calendrier.
 */
import Base from '../../layouts/Base.astro';
import Icone from '../../components/Icone.astro';
import AnneauSegmente from '../../components/AnneauSegmente.astro';
import VuesCycle from '../../components/VuesCycle.astro';
import GoutteJour from '../../components/GoutteJour.astro';
import BebeJour from '../../components/BebeJour.astro';
import OvuleJour from '../../components/OvuleJour.astro';
import DefsCycle from '../../components/DefsCycle.astro';
import Alerte from '../../components/Alerte.astro';
import { clientSession, baseConfiguree } from '../../lib/supabase';
import { visiteuse, lirePanier, comptePanier } from '../../lib/session';
import { FLUX } from '../../lib/cycle';
import {
  infoDuJour,
  prochainesRegles,
  prochaineOvulation,
  fenetreFertile,
  moyenneCycles,
  ecartEnJours,
  plusDeJours,
  alertesSante,
  type ReglagesCycle,
  type TypeJour,
} from '../../lib/cycle-calcul';
import { aujourdhui, dateLongue, dateCourte, dateDe, messageErreur } from '../../lib/format';
import { sansCompte } from '../../lib/porte';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return sansCompte(Astro);
if (!moi.questionnaireFini) return Astro.redirect('/bienvenue', 302);

const client = clientSession(Astro)!;
const panier = comptePanier(lirePanier(Astro));
const hui = aujourdhui();

let erreur = '';
let message = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const geste = String(f.get('geste') ?? '');

  if (geste === 'commencent') {
    const { data, error } = await client.rpc('declarer_regles', { p_debut: hui });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur);
    else return Astro.redirect('/cycle?ok=commencent', 303);
  } else if (geste === 'adopter') {
    // « Mettre à jour la durée de mon cycle » : la moyenne de ses cycles
    // réels devient la durée de son profil. Elle est relue côté serveur et
    // bornée : un nombre venu du formulaire n'est jamais cru sur parole.
    const demande = Number(f.get('cycle'));
    const cycleDemande = Number.isInteger(demande) ? demande : NaN;
    if (!(cycleDemande >= 21 && cycleDemande <= 45)) {
      erreur = messageErreur('cycle_invalide');
    } else {
      const { data, error } = await client.rpc('enregistrer_reglages', {
        p_rappel: null,
        p_discretes: null,
        p_code: null,
        p_cycle: cycleDemande,
        p_duree: null,
      });
      if (error || !data?.ok) erreur = messageErreur(data?.erreur);
      else return Astro.redirect('/cycle?ok=moyenne', 303);
    }
  } else if (geste === 'finies') {
    // « Mes règles sont terminées » : on note la journée d'hier comme la
    // dernière, en marquant aujourd'hui sans flux. C'est le geste le plus
    // proche de ce qu'elle veut dire, et il n'invente aucune date.
    const { data, error } = await client.rpc('noter_journee', {
      p_jour: hui,
      p_flux: 'rien',
      p_douleur: 0,
      p_signes: [],
      p_note: '',
    });
    if (error || !data?.ok) erreur = messageErreur(data?.erreur);
    else return Astro.redirect('/cycle?ok=finies', 303);
  }
}

if (Astro.url.searchParams.get('ok') === 'commencent') message = 'Tes règles sont notées. Les prévisions sont à jour.';
if (Astro.url.searchParams.get('ok') === 'finies') message = "C'est noté, bonne fin de journée.";
if (Astro.url.searchParams.get('ok') === 'moyenne') message = 'La durée de ton cycle est mise à jour. Les dates sont recalculées.';

// --- Ce que la base sait de son cycle ---------------------------------------
const { data: cyclesBase } = await client
  .from('cycles')
  .select('debut, fin')
  .order('debut', { ascending: false })
  .limit(14);

const debuts = (cyclesBase ?? []).map((c: { debut: string }) => c.debut);
const aDesDonnees = debuts.length > 0;

const { data: notesBase } = await client
  .from('journal')
  .select('jour, flux, douleur')
  .gte('jour', plusDeJours(hui, -90))
  .order('jour', { ascending: false });
const notes = (notesBase ?? []) as { jour: string; flux: string; douleur: number }[];

const confirmes = new Set<string>();
for (const c of (cyclesBase ?? []) as { debut: string; fin: string | null }[]) {
  const fin = c.fin ?? c.debut;
  for (let d = c.debut; d <= fin; d = plusDeJours(d, 1)) confirmes.add(d);
}
for (const n of notes) if (n.flux !== 'rien') confirmes.add(n.jour);

// La durée du cycle est CELLE DU PROFIL (prompt d'Arthur, 13 octobre 2026) :
// celle qu'elle a donnée, ou qu'elle a acceptée. La moyenne de ses cycles
// réels est seulement PROPOSÉE, plus bas ; avant, elle remplaçait la
// durée du profil sans rien dire.
const dureeCycle = moi.cycleMoyen;
const moyenneObservee = aDesDonnees ? moyenneCycles(debuts) : null;
const moyenneProposee = moyenneObservee !== null && moyenneObservee !== dureeCycle ? moyenneObservee : null;
const reglages: ReglagesCycle = { debuts, dureeRegles: moi.dureeRegles, dureeCycle };

const info = aDesDonnees ? infoDuJour(hui, reglages, confirmes, hui) : null;
const prochaines = aDesDonnees ? prochainesRegles(reglages, hui) : null;
const ovulation = aDesDonnees ? prochaineOvulation(reglages, hui) : null;

// La fenêtre fertile du cycle en cours, en dates.
let fertileDu: string | null = null;
let fertileAu: string | null = null;
if (aDesDonnees && info) {
  const debutDuCycle = plusDeJours(hui, -(info.jourDuCycle - 1));
  const f = fenetreFertile(dureeCycle);
  fertileDu = plusDeJours(debutDuCycle, f.debut - 1);
  fertileAu = plusDeJours(debutDuCycle, f.fin - 1);
}

const joursAvant = prochaines ? ecartEnJours(prochaines, hui) : 0;
const enRetard = joursAvant < 0;
const retard = enRetard ? -joursAvant : 0;

// --- Ce que l'écran annonce au centre de l'anneau ---------------------------
//
// LES DEUX LIGNES ONT ÉCHANGÉ LEUR PLACE le 5 novembre 2026, à la demande
// d'Arthur : « jour 9 de ton cycle devient en gras et en grand, et 20 jours
// avant tes prochaines règles devient en bas et en petit ; ils changent de
// place ».
//
// Pourquoi c'est le bon sens de lecture : le jour du cycle est un fait, il est
// vrai au moment où elle regarde. Le nombre de jours avant les prochaines
// règles est une prévision, calculée sur une moyenne qui peut se tromper de
// plusieurs jours. Mettre le fait en grand et la prévision en petit dit la
// vérité sur ce que l'application sait et ce qu'elle devine.
const jourDuCycle = info?.jourDuCycle ?? 0;

// La ligne du dessous : la prévision, ou l'état du jour quand il y en a un.
let sousPhrase: string;
if (info?.type === 'regles') {
  sousPhrase = `${jourDuCycle}${jourDuCycle === 1 ? 'er' : 'e'} jour de tes règles`;
} else if (info?.type === 'ovulation') {
  sousPhrase = 'Ovulation aujourd’hui';
} else if (enRetard) {
  sousPhrase = `${retard} jour${retard > 1 ? 's' : ''} de retard`;
} else if (joursAvant === 0) {
  sousPhrase = 'Tes règles sont attendues aujourd’hui';
} else {
  sousPhrase = `${joursAvant} jour${joursAvant > 1 ? 's' : ''} avant tes prochaines règles`;
}

// --- Le risque de grossesse -------------------------------------------------
// Trois niveaux seulement : au-delà, on donnerait une impression de précision
// que ce calcul n'a pas. L'avertissement en bas d'écran dit le reste.
const RISQUES: Record<TypeJour, { mot: string; part: number; classe: string }> = {
  ovulation: { mot: 'Élevé', part: 100, classe: 'risque-haut' },
  fertile: { mot: 'Élevé', part: 82, classe: 'risque-haut' },
  regles: { mot: 'Faible', part: 16, classe: 'risque-bas' },
  faible: { mot: 'Faible', part: 24, classe: 'risque-bas' },
};
// Les deux jours qui bordent la fenêtre fertile : ni l'un ni l'autre.
let risque = RISQUES[info?.type ?? 'faible'];
if (info && info.type === 'faible') {
  const f = fenetreFertile(dureeCycle);
  const distance = Math.min(Math.abs(info.jourDuCycle - f.debut), Math.abs(info.jourDuCycle - f.fin));
  if (distance <= 2) risque = { mot: 'Moyen', part: 52, classe: 'risque-moyen' };
}

// --- Les points qu'elle a notés, posés sur l'anneau -------------------------
const notesAnneau = notes
  .filter((n) => {
    const i = infoDuJour(n.jour, reglages, confirmes, hui);
    return i.jourDuCycle >= 1 && ecartEnJours(hui, n.jour) < dureeCycle;
  })
  .map((n) => ({
    jour: infoDuJour(n.jour, reglages, confirmes, hui).jourDuCycle,
    saigne: n.flux !== 'rien',
  }));

// --- La bande des quatorze prochains jours ----------------------------------
const JOURS_COURTS = ['Dim', 'Lun', 'Mar', 'Mer', 'Jeu', 'Ven', 'Sam'];
const bande = Array.from({ length: 14 }, (_, i) => {
  const iso = plusDeJours(hui, i - 2);
  const d = dateDe(iso);
  const j = aDesDonnees ? infoDuJour(iso, reglages, confirmes, hui) : null;
  return {
    iso,
    nom: JOURS_COURTS[d.getDay()],
    numero: d.getDate(),
    type: (j?.type ?? 'faible') as TypeJour,
    aujourdhui: iso === hui,
  };
});

// --- Les alertes santé ------------------------------------------------------
const dureesRegles: number[] = [];
for (const c of (cyclesBase ?? []) as { debut: string; fin: string | null }[]) {
  if (c.fin) dureesRegles.push(ecartEnJours(c.fin, c.debut) + 1);
}
const ecartsCycles: number[] = [];
for (let i = 0; i < debuts.length - 1; i += 1) ecartsCycles.push(ecartEnJours(debuts[i], debuts[i + 1]));

const alertes = aDesDonnees
  ? alertesSante({
      dureesRegles,
      ecartsCycles,
      retard,
      douleursFortes: notes.filter((n) => n.douleur >= 4).length,
      fluxAbondants: notes.filter((n) => n.flux === 'abondant').length,
    })
  : [];

const noteDuJour = notes.find((n) => n.jour === hui) ?? null;
const enRegles = info?.type === 'regles';
---

<Base titre="Mon cycle" nav="cycle" panier={panier} prenom={moi.prenom}>
  <DefsCycle />

  <main class="page tableau">
    {/* --- Les deux vues de « Mon cycle » --- */}
    <VuesCycle actif="tableau" />

    {message && <Alerte type="reussite" texte={message} />}
    {erreur && <Alerte type="erreur" texte={erreur} />}

    {
      !aDesDonnees && (
        <section class="carte bloc vide">
          <h1>On ne connaît pas encore ton cycle</h1>
          <p>
            Dis-moi quand tes dernières règles ont commencé, et cet écran se remplit : les dates à venir, la période
            fertile, et ce que ton corps fait en ce moment.
          </p>
          <form method="post">
            <button class="btn btn-rose btn-plein" type="submit" name="geste" value="commencent">
              Mes règles ont commencé aujourd'hui
            </button>
          </form>
          <a class="btn btn-texte" href="/cycle/calendrier">Choisir une autre date dans le calendrier</a>
        </section>
      )
    }

    {
      aDesDonnees && info && (
        <>
          {/* --- 4.1 Le grand anneau --- */}
          <section class="anneau-bloc" aria-label="Où en est ton cycle">
            <AnneauSegmente
              jourActuel={info.jourDuCycle}
              dureeRegles={moi.dureeRegles}
              dureeCycle={dureeCycle}
              notes={notesAnneau}
              lien="/cycle/calendrier"
            >
              <span class="grand-chiffre">
                <span class="grand-mot">Jour</span>
                {info.jourDuCycle}
              </span>
              <span class="grand-phrase">de ton cycle</span>
              <span class="grand-sous">{sousPhrase}</span>
            </AnneauSegmente>

            <ul class="legende-anneau">
              <li><span class="pion pion-regles"></span>Règles</li>
              <li><span class="pion pion-fertile"></span>Fenêtre fertile</li>
              <li><span class="pion pion-ovulation"></span>Ovulation</li>
              <li><span class="pion pion-faible"></span>Faible fertilité</li>
            </ul>
          </section>

          {/* --- 4.4 La saisie du jour, tout de suite sous l'anneau --- */}
          <section class="bloc-saisie">
            {/* « Noter ma journée » a été retiré le 13 octobre 2026, à la
                demande d'Arthur. Le carnet lui-même reste en place : on y
                entre depuis l'accueil et depuis la recherche. */}
            <form class="deux" method="post">
              {enRegles ? (
                <button class="btn btn-rose btn-plein" type="submit" name="geste" value="finies">
                  Mes règles sont terminées
                </button>
              ) : (
                <button class="btn btn-rose btn-plein" type="submit" name="geste" value="commencent">
                  Mes règles ont commencé
                </button>
              )}
            </form>

            {/* La rangée « Comment tu te sens aujourd'hui ? » (six pastilles de
                signes et « Tout noter ») a été retirée le 13 octobre 2026, à la
                demande d'Arthur. Elle faisait doublon avec « Noter ma journée »,
                juste au-dessus, qui mène au même carnet et le montre en entier.
                Il ne reste que la ligne qui dit ce qu'elle a déjà noté. */}
            <div class="humeur">
              {noteDuJour && (
                <p class="humeur-deja">
                  Noté aujourd'hui : flux {FLUX.find((f) => f.id === noteDuJour.flux)?.libelle.toLowerCase() ?? '—'},
                  douleur {noteDuJour.douleur} sur 5.
                </p>
              )}
            </div>
          </section>

          {/* La proposition de moyenne (prompt d'Arthur, 13 octobre 2026) : à
              partir de trois cycles complets, on PROPOSE de mettre la durée du
              cycle à la moyenne observée. Elle ne s'applique jamais toute seule. */}
          {
            moyenneProposee !== null && (
              <section class="proposition" aria-label="Mettre à jour la durée de ton cycle">
                <p>
                  Tes derniers cycles durent en moyenne <b>{moyenneProposee} jours</b>, et ton profil dit{' '}
                  <b>{dureeCycle} jours</b>. Veux-tu mettre à jour la durée de ton cycle ?
                </p>
                <form method="POST">
                  <input type="hidden" name="geste" value="adopter" />
                  <input type="hidden" name="cycle" value={moyenneProposee} />
                  <button class="btn btn-rose" type="submit">
                    Mettre à {moyenneProposee} jours
                  </button>
                </form>
              </section>
            )
          }

          {/* --- 4.2 Les cartes d'information --- */}
          <section class="cartes" aria-label="Les dates de ton cycle">
            <article class="info info-rose">
              <span class="info-icone"><GoutteJour largeur={22} hauteur={27} /></span>
              <h2>Prochaines règles</h2>
              <p class="info-grand">{prochaines ? dateLongue(prochaines) : '—'}</p>
              <p class="info-petit">
                {enRetard ? `${retard} jour${retard > 1 ? 's' : ''} de retard` : joursAvant === 0 ? "Attendues aujourd'hui" : `Dans ${joursAvant} jour${joursAvant > 1 ? 's' : ''}`}
              </p>
            </article>

            <article class="info info-fertile">
              <span class="info-icone"><BebeJour taille={32} /></span>
              <h2>Fenêtre fertile</h2>
              <p class="info-grand">
                {fertileDu && fertileAu ? `${dateCourte(fertileDu)} au ${dateCourte(fertileAu)}` : '—'}
              </p>
              <p class="info-petit">Les jours où une grossesse est possible</p>
            </article>

            <article class="info info-fertile">
              <span class="info-icone"><OvuleJour taille={34} /></span>
              <h2>Ovulation estimée</h2>
              <p class="info-grand">{ovulation ? dateLongue(ovulation) : '—'}</p>
              <p class="info-petit">Une estimation, pas une certitude</p>
            </article>

            {/* Le risque de grossesse, en GRAND et avec un signal d'alerte
                (demande d'Arthur du 13 octobre 2026 : « écrit en plus gros
                avec un emoji qui signifie alerte, genre un panneau rouge »).
                C'est la seule information de cet écran qui engage une
                décision, elle ne doit pas se lire comme les autres cartes.

                Le panneau est ROUGE quand le risque est élevé, orangé quand il
                est moyen et vert doux quand il est faible : un panneau rouge
                posé sur un risque faible ferait crier au loup, et la femme
                cesserait de le croire le jour où il dit vrai. */}
            <article class:list={['info', 'info-jauge', 'panneau-risque', risque.classe]}>
              <span class="info-icone panneau-emoji" aria-hidden="true">
                {risque.classe === 'risque-haut' ? '🚨' : '⚠️'}
              </span>
              <h2 class="panneau-titre">Risque de grossesse aujourd'hui</h2>
              <p class="info-grand panneau-mot">{risque.mot}</p>
              <div class="jauge" role="img" aria-label={`Risque ${risque.mot.toLowerCase()}`}>
                <span class:list={['jauge-pleine', `jauge-${risque.part}`]}></span>
              </div>
            </article>
          </section>

          {/* Le bloc « Tes règles / menstruations » (le nom savant de la phase,
              une explication et un conseil) a été retiré le 13 octobre 2026, à
              la demande d'Arthur. L'écran garde ce qui répond à « où j'en
              suis » : l'anneau, les dates, le risque. */}

          {/* --- 4.3 La bande des jours --- */}
          <section aria-label="Les jours à venir">
            <h2 class="titre-section">Les jours qui viennent</h2>
            <div class="semaine-jours">
              {bande.map((j) => (
                <a
                  class:list={['jour-case', j.aujourdhui && 'jour-case-aujourdhui', `jour-case-${j.type}`]}
                  href={`/cycle/calendrier?jour=${j.iso}`}
                  aria-label={dateLongue(j.iso)}
                >
                  <span class="jour-case-nom">{j.nom}</span>
                  <span class="jour-case-numero">{j.numero}</span>
                  <span class="jour-case-marque">
                    {j.type === 'regles' ? (
                      <GoutteJour largeur={11} hauteur={13} />
                    ) : j.type === 'ovulation' ? (
                      <BebeJour taille={15} ovulation />
                    ) : j.type === 'fertile' ? (
                      <BebeJour taille={15} />
                    ) : (
                      <span class="jour-case-point"></span>
                    )}
                  </span>
                </a>
              ))}
            </div>
          </section>

          {/* --- 4.5 Les alertes santé --- */}
          {alertes.length > 0 && (
            <section class="sante" aria-label="À signaler à une sage-femme">
              {alertes.map((a) => (
                <article class="sante-carte">
                  <span class="sante-icone"><Icone nom="coeur" taille={18} /></span>
                  <div>
                    <h3>{a.titre}</h3>
                    <p>{a.texte}</p>
                  </div>
                </article>
              ))}
            </section>
          )}
        </>
      )
    }

    {/* L'avertissement sur la contraception a été retiré de cet écran le
        13 octobre 2026, À LA DEMANDE D'ARTHUR (il l'avait lui-même exigé
        obligatoire le 12). Il reste sur le calendrier. Si une femme lit
        « risque plus faible » comme « sans risque », c'est ici que ça se
        paie : `AVERTISSEMENT_CONTRACEPTION` est toujours dans
        `cycle-calcul.ts`, il suffit de le réafficher. */}

    {/* La mention d'estimation a été retirée le 13 octobre 2026, à la demande
        d'Arthur sur l'écran du calendrier ; retirée ici aussi par cohérence,
        les deux écrans ayant reçu et perdu la même mention le même jour. */}

    <div class="espace"></div>
  </main>
</Base>

<style>
  .tableau {
    padding-top: var(--e4);
  }

  /* --- L'anneau et son centre --- */
  .anneau-bloc {
    padding: var(--e3) 0 var(--e4);
  }

  .grand-chiffre {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--titre);
    font-size: 57px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -2px;
  }

  .grand-mot {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: 0;
  }

  .grand-phrase {
    margin-top: 6px;
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.25;
  }

  /* La prévision, sous le jour du cycle. Elle tient maintenant une phrase
     entière là où il n'y avait que « Jour 9 de ton cycle » : le centre de
     l'anneau ne fait qu'environ 150 px de large, d'où un corps plus petit et
     une interligne serrée, pour qu'elle tienne en deux lignes sans toucher
     la couronne. */
  .grand-sous {
    margin-top: 3px;
    max-width: 15ch;
    font-size: 12.5px;
    line-height: 1.3;
    color: var(--texte-3);
  }

  .legende-anneau {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--e2) var(--e3);
    margin: var(--e4) 0 0;
    padding: 0;
    font-size: 13.5px;
    color: var(--texte-2);
  }

  .legende-anneau li {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .pion {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }

  .pion-regles { background: var(--grenat); }
  .pion-fertile { background: var(--fertile); }
  .pion-ovulation { background: var(--fertile-fort); }
  /* Les jours à risque plus faible sont BLANCS dans la couronne, comme sur
     la planche d'Arthur : la légende doit dire la même chose qu'elle. */
  .pion-faible {
    background: var(--surface);
    border: 1.5px solid var(--bordure);
  }

  /* --- La saisie du jour --- */
  .bloc-saisie {
    margin-bottom: var(--e5);
  }

  .deux {
    display: flex;
    gap: var(--e2);

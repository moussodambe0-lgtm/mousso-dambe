---
/**
 * L'adresse, puis la commande.
 *
 * Le livreur se déplace pour de vrai : une adresse approximative est une
 * livraison perdue et un colis payé pour rien. D'où le point de repère, qui
 * est ce qu'on utilise réellement à Ouaga, et le numéro vérifié par la base.
 *
 * Le total affiché ici est indicatif. Celui qui compte est calculé par la base
 * dans `passer_commande`, à partir des prix du catalogue.
 */
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Icone from '../components/Icone.astro';
import Alerte from '../components/Alerte.astro';
import { clientSession, clientPublic, baseConfiguree } from '../lib/supabase';
import { visiteuse, lirePanier, ecrirePanier, comptePanier } from '../lib/session';
import { prix, messageErreur } from '../lib/format';
import { prixLivraison } from '../lib/boutique';

if (!baseConfiguree()) return Astro.redirect('/', 302);
const moi = await visiteuse(Astro);
if (!moi) return Astro.redirect('/connexion', 302);

// Lu en base : c'est le même chiffre que celui que `passer_commande`
// appliquera, donc le total affiché est celui qu'elle paiera au livreur.
const LIVRAISON = await prixLivraison(clientPublic(Astro));
const lignes = lirePanier(Astro);
if (lignes.length === 0) return Astro.redirect('/panier', 302);

let erreur = '';
let nom = moi.nomLivraison || moi.prenom;
let telephone = moi.telephone ?? '';
let quartier = moi.quartier ?? '';
let repere = moi.repere ?? '';
// La position déjà enregistrée (« Mes adresses ») pré-remplit les champs
// cachés : elle n'a pas besoin de la repartager à chaque commande.
let positionLat = moi.positionLat;
let positionLng = moi.positionLng;

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  nom = String(f.get('nom') ?? '').trim();
  telephone = String(f.get('telephone') ?? '').trim();
  quartier = String(f.get('quartier') ?? '').trim();
  repere = String(f.get('repere') ?? '').trim();
  const latBrut = f.get('lat');
  const lngBrut = f.get('lng');
  positionLat = latBrut ? Number(latBrut) : null;
  positionLng = lngBrut ? Number(lngBrut) : null;
  // « Garder cette adresse dans mon compte », cochée par défaut (Arthur, 13
  // octobre 2026). C'est déjà ce qui se passait avant que la case existe ;
  // elle donne juste le choix de dire non.
  const garder = f.get('garder') === 'oui';

  const client = clientSession(Astro)!;
  const { data, error } = await client.rpc('passer_commande', {
    p_panier: lignes,
    p_nom: nom,
    p_telephone: telephone,
    p_quartier: quartier,
    p_repere: repere,
    p_lat: positionLat,
    p_lng: positionLng,
    p_garder: garder,
  });

  if (error || !data?.ok) {
    erreur = messageErreur(data?.erreur ?? error?.message);
  } else {
    ecrirePanier(Astro, []);
    return Astro.redirect(`/commande-confirmee?numero=${encodeURIComponent(data.numero)}`, 303);
  }
}

const { data: donnees } = await clientPublic(Astro)
  .from('produits')
  .select('slug, nom, prix_cfa')
  .in('slug', lignes.map((l) => l.slug));
const produits: Record<string, any> = {};
for (const p of donnees ?? []) produits[p.slug] = p;

const articles = lignes.reduce((s, l) => s + (produits[l.slug]?.prix_cfa ?? 0) * l.quantite, 0);
const total = articles + LIVRAISON;
const nombre = comptePanier(lignes);

// Les quartiers de Ouagadougou les plus demandés, pour éviter la saisie
// libre dans la plupart des cas. La liste reste ouverte : un quartier qui
// manque ne doit pas empêcher une commande.
const QUARTIERS = [
  'Dassasgho', 'Tanghin', 'Zogona', 'Gounghin', 'Pissy', 'Cissin', 'Karpala',
  'Ouaga 2000', 'Somgandé', 'Kossodo', 'Nonsin', 'Patte d’Oie', 'Saaba',
  'Tampouy', 'Wemtenga', 'Zone du bois', 'Nioko', 'Bonheur-ville',
];
---

<Base titre="Ma commande" nav="boutique" panier={nombre}>
  <main class="page">
    <Entete titre="Où on te livre" retour="/panier" />

    {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

    <form method="POST" class="apparait">
      <input type="hidden" name="lat" class="position-lat" value={positionLat ?? ''} />
      <input type="hidden" name="lng" class="position-lng" value={positionLng ?? ''} />

      <div class="champ-bloc">
        <label class="libelle" for="nom">Ton nom pour le livreur</label>
        <input class="champ" id="nom" name="nom" type="text" required maxlength="60" value={nom} autocomplete="name" />
      </div>

      <div class="champ-bloc">
        <label class="libelle" for="telephone">Ton numéro</label>
        <input
          class="champ"
          id="telephone"
          name="telephone"
          type="tel"
          inputmode="numeric"
          required
          value={telephone}
          autocomplete="tel-national"
          placeholder="70 12 34 56"
        />
      </div>

      {/* « Partager ma position », au lieu du quartier (Arthur, 13 octobre
          2026). Le bouton n'apparaît que si le navigateur sait géolocaliser ;
          rien ne part avant qu'elle appuie elle-même, et c'est le navigateur
          qui lui demande la permission, jamais nous à sa place. */}
      <div class="position-bloc" data-position>
        <button
          class:list={['btn', 'btn-contour', 'btn-plein', 'position-bouton', positionLat !== null && 'position-ok']}
          type="button"
          hidden
        >
          <Icone nom="lieu" taille={18} />
          <span class="position-mot">{positionLat !== null ? 'Position partagée' : 'Partager ma position'}</span>
        </button>
        <p class="position-dit" hidden={positionLat === null}>
          {positionLat !== null && 'Ta position est partagée. Le quartier n’est plus obligatoire.'}
        </p>
      </div>

      <div
        class:list={['champ-bloc', 'position-quartier', positionLat !== null && 'position-quartier-facultatif']}
        hidden={positionLat !== null}
      >
        <label class="libelle" for="quartier">Ton quartier</label>
        <input
          class="champ"
          id="quartier"
          name="quartier"
          type="text"
          required={positionLat === null}
          maxlength="60"
          value={quartier}
          list="quartiers"
          autocomplete="address-level3"
        />
        <datalist id="quartiers">
          {QUARTIERS.map((q) => <option value={q} />)}
        </datalist>
      </div>

      <div class="champ-bloc position-repere" hidden={positionLat !== null}>
        <label class="libelle" for="repere">Un point de repère</label>
        <input
          class="champ"
          id="repere"
          name="repere"
          type="text"
          maxlength="120"
          value={repere}
          placeholder="À côté de la pharmacie, après le marché…"
        />
      </div>

      {/* « Garder cette adresse dans mon compte » (Arthur, 13 octobre 2026).
          Cochée par défaut : c'est déjà ce que faisait la commande avant que
          la case existe, personne ne doit perdre une habitude qui marchait. */}
      <label class="garder-ligne">
        <input type="checkbox" name="garder" value="oui" checked />
        <span>Garder cette adresse dans mon compte</span>
      </label>

      <h2 class="rangee-titre">Comment tu paies</h2>
      <div class="rangees">
        <div class="rangee">
          <span class="radio-pose" aria-hidden="true"><i></i></span>
          <div>
            <div class="fort">En espèces, à la livraison</div>
            <div class="gris">Tu paies quand le colis est dans ta main</div>
          </div>
        </div>
        <div class="rangee inactive">
          <span class="radio-vide" aria-hidden="true"></span>
          <div>
            <div class="fort">Orange Money ou Moov Money</div>
            <div class="gris">Pas encore disponible</div>
          </div>
        </div>
      </div>

      <section class="carte recap">
        {
          lignes.map((l) => (
            <div class="ligne-recap">
              <span>
                {produits[l.slug]?.nom ?? l.slug}
                {l.taille ? ` · ${l.taille}` : ''}
                {l.quantite > 1 ? ` × ${l.quantite}` : ''}
              </span>
              <span class="chiffre">{prix((produits[l.slug]?.prix_cfa ?? 0) * l.quantite)}</span>
            </div>
          ))
        }
        <div class="ligne-recap">
          <span>Livraison</span>
          <span class="chiffre">{prix(LIVRAISON)}</span>
        </div>
        <div class="trait"></div>
        <div class="ligne-total">
          <span>À payer à la livraison</span>
          <span class="chiffre grand">{prix(total)} F</span>
        </div>
      </section>

      <div class="place-barre"></div>

      <div class="barre-action">
        <button class="btn btn-rose btn-plein" type="submit">
          Commander {nombre === 1 ? '1 article' : `${nombre} articles`} · {prix(total)} F
        </button>
      </div>
    </form>
  </main>
</Base>

<script>
  import '../scripts/position';
</script>

<style>
  .champ-bloc {
    margin-bottom: var(--e4);
  }

  .fort {
    font-size: 15.5px;
    font-weight: 600;
  }

  .gris {
    font-size: 14px;
    color: var(--texte-2);
    margin-top: 2px;
  }

  .radio-pose,
  .radio-vide {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--rose);
  }

  .radio-pose i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--rose);
  }

  .radio-vide {
    border-color: var(--bordure-forte);
  }

  .inactive {
    opacity: 0.55;
  }

  .recap {
    margin-top: var(--e4);
    padding: var(--e3) var(--e4);
  }

  .ligne-recap {
    display: flex;
    justify-content: space-between;
    gap: var(--e3);
    padding: 5px 0;
    font-size: 15px;
    color: var(--texte-2);
  }

  .ligne-recap .chiffre {
    font-size: 15px;
    font-weight: 600;
    color: var(--encre);
    flex: none;
  }

  .trait {
    height: 1px;
    background: var(--bordure);
    margin: 7px 0;
  }

  .ligne-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: 17px;
    font-weight: 700;
  }

  .grand {
    font-size: 24.5px;
    color: var(--rose);
  }

  .encadre {
    margin-top: var(--e4);
  }

  .place-barre {
    height: 96px;
  }

  .marge-bas {
    margin-bottom: var(--e3);
  }

  .position-bloc {
    margin-bottom: var(--e4);
  }

  .position-bouton[hidden] {
    display: none;
  }

  .position-ok {
    border-color: var(--vert, #2f9e5b);
    color: var(--vert, #2f9e5b);
  }

  .position-dit {
    margin-top: 8px;
    font-size: 14px;
    color: var(--texte-2);
  }

  .position-quartier-facultatif .libelle::after {
    content: ' (facultatif)';
    font-weight: 400;
    color: var(--texte-3);
  }

  .garder-ligne {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--e4);
    font-size: 15px;
    color: var(--texte-2);
  }
</style>

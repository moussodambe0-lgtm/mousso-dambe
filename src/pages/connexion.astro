---
/**
 * Son compte : s'inscrire, ou se connecter.
 *
 * DEUX ÉCRANS, ET ARTHUR A DEMANDÉ LES DEUX (27 octobre 2026)
 *
 * « Quand la personne vient sur la page, la personne doit voir s'inscrire ou
 * se connecter. Les deux options. Deux boutons. Quand la personne clique sur
 * s'inscrire, c'est là qu'elle va voir la page avec Google. Quand la personne
 * clique sur se connecter aussi, la personne voit la même page avec Google. »
 *
 * D'où un premier écran qui ne fait que demander laquelle des deux, puis le
 * même second écran pour les deux. Techniquement c'est le même chemin, mais
 * les deux situations ne se ressemblent pas dans la tête de celle qui arrive :
 * celle qui n'a jamais eu de compte cherche « s'inscrire », et ne clique pas
 * sur « se connecter » de peur de se tromper.
 *
 * GOOGLE EN GRAND, LE MOT DE PASSE REPLIÉ
 *
 * « Il y aura le bouton se connecter avec Google en grand, et une petite
 * option pour écrire son email et son mot de passe, mais je veux qu'on mette
 * en valeur se connecter avec Google. »
 *
 * Le second chemin est dans un `details` fermé : du HTML, pas une ligne de
 * script, et il s'ouvre en place. Google ouvre la session tout de suite quand
 * l'email oblige à sortir chercher un message de confirmation.
 *
 * S'INSCRIRE N'OUVRE PAS UN AUTRE COMPTE, IL GARDE CELUI-LÀ
 *
 * « Commencer » pose une identité anonyme : son cycle, son journal et ses
 * commandes y sont déjà rattachés. S'inscrire ATTACHE donc Google (ou un mot
 * de passe) à ce compte, au lieu d'en ouvrir un second. Sans ça, une femme qui
 * a noté trois mois de règles arriverait sur un compte vide au moment précis
 * où elle essaie de les mettre à l'abri. Voir src/lib/identite.ts.
 *
 * Se connecter, lui, rejoint un compte qui existe déjà ailleurs, et l'écran
 * dit alors ce qu'elle laisse derrière elle.
 *
 * LA BARRE DU BAS RESTE (Arthur, le même jour) : « quand j'arrive là-bas, la
 * barre en bas disparaît, c'est comme si c'était une nouvelle page, et il n'y
 * a pas un truc pour revenir en arrière. Faut pas que les gens aillent là-bas
 * se bloquer. » C'était un cul-de-sac : le seul moyen de sortir était le
 * bouton « précédent » du navigateur, qui n'existe plus une fois
 * l'application posée sur l'écran d'accueil.
 *
 * LE MESSAGE D'ERREUR EST LE MÊME QUE L'ADRESSE EXISTE OU NON : dire « cette
 * adresse n'a pas de compte » révélerait à un mari curieux si sa femme utilise
 * l'application. Ce n'est pas une précaution théorique ici.
 *
 * Cette phrase était fausse pour un cas, jusqu'à l'audit du 26 octobre 2026 :
 * une adresse non confirmée recevait « ton adresse n'est pas encore
 * confirmée », donc l'aveu qu'un compte existe. Il n'y a plus qu'un seul
 * texte, et un garde-fou dans supabase/tests/connexion.test.mjs tombe si un
 * second réapparaît.
 */
import Base from '../layouts/Base.astro';
import Symbole from '../components/Symbole.astro';
import BoutonGoogle from '../components/BoutonGoogle.astro';
import Alerte from '../components/Alerte.astro';
import Icone from '../components/Icone.astro';
import { clientPublic, poserSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { clientAuthentifie, causeDeLEchec } from '../lib/identite';
import { hoteDemande, estHoteAdmin } from '../lib/hotes';
import { ADMIN_HOST } from 'astro:env/server';

export const prerender = false;

// Sur l'adresse de la gestion, on ne crée pas de compte : il n'y a qu'un
// administrateur, nommé dans les réglages de la base. Le bouton « Je n'ai pas
// encore de compte » menait à /ouverture, qui n'existe pas sur ce sous-domaine,
// d'où « cette page n'est pas disponible » (Arthur, le 24 octobre 2026).
const surHoteAdmin = estHoteAdmin(
  hoteDemande(Astro.request.headers, Astro.url.hostname),
  ADMIN_HOST
);

const moi = baseConfiguree() ? await visiteuse(Astro) : null;

// Celle qui a DÉJÀ un vrai compte n'a rien à faire ici. Celle qui est entrée
// sans compte, elle, vient précisément ici pour en obtenir un.
if (moi?.compteReel) return Astro.redirect('/', 302);

/**
 * Où on en est : le choix, puis l'écran de Google.
 *
 * Sur l'adresse de la gestion, il n'y a rien à choisir : un administrateur se
 * connecte, il ne s'inscrit pas. On saute donc directement au second écran.
 */
type Etape = 'choix' | 'inscrire' | 'connecter';
const demandee = String(Astro.url.searchParams.get('action') ?? '');
let etape: Etape = demandee === 'inscrire' || demandee === 'connecter' ? demandee : 'choix';
if (surHoteAdmin) etape = 'connecter';

/** S'inscrire depuis un compte commencé, c'est l'attacher, pas en ouvrir un autre. */
const attache = etape === 'inscrire' && Boolean(moi) && !surHoteAdmin;

let erreur = '';
let reussite = '';

// Les retours de Google passent par l'adresse : on les traduit ici, sans
// jamais dire si un compte existe ou non.
const venuDe = Astro.url.searchParams.get('erreur');
if (venuDe === 'google') {
  erreur = "La connexion avec Google n'a pas marché. Réessaie.";
} else if (venuDe === 'google-deja-pris') {
  erreur =
    "Cette adresse Google a déjà un compte Mousso Dambé. Choisis « Se connecter » "
    + 'pour le rejoindre.';
} else if (venuDe === 'liaison') {
  // « Nous n'avons pas pu attacher Google à ton compte » ne voulait rien dire
  // pour elle (Arthur : « ça veut dire quoi ? »). Attacher est un mot de
  // mécanique interne, et ce qu'elle veut savoir c'est quoi faire maintenant.
  erreur =
    "La connexion avec Google n'a pas marché. Réessaie, ou utilise un email et "
    + 'un mot de passe.';
} else if (venuDe === 'pas-de-base') {
  erreur = "L'application n'est pas encore branchée à sa base de données.";
}

/** Pourquoi on la lui demande, quand elle arrive depuis un écran fermé. */
const POURQUOI: Record<string, string> = {
  messagerie:
    "Pour écrire à Dambé ou à la boutique, il faut un compte : c'est ce qui "
    + 'permet de retrouver tes messages, et à la boutique de te répondre.',
  compte: "Pour voir ton compte, connecte-toi d'abord.",
};
const dOu = String(Astro.url.searchParams.get('pour') ?? '');
const pourquoi = POURQUOI[dOu] ?? '';

let emailSaisi = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  emailSaisi = String(f.get('email') ?? '').trim().toLowerCase();
  const motDePasse = String(f.get('motdepasse') ?? '');
  const geste = String(f.get('geste') ?? '');

  if (!emailSaisi || !motDePasse) {
    erreur = 'Remplis les deux champs.';
  } else if (geste === 'attacher' && moi) {
    // ATTACHER un email et un mot de passe au compte qu'elle a déjà, au lieu
    // d'ouvrir une session sur un autre : son identifiant ne bouge pas, donc
    // son cycle, son journal et ses commandes restent les siens.
    const sac: Record<string, string> = {};
    const client = await clientAuthentifie(Astro, sac);
    if (!client) {
      erreur = "Ta session a expiré. Reviens à l'accueil et recommence.";
    } else {
      const { error } = await client.auth.updateUser({ email: emailSaisi, password: motDePasse });
      const cause = error ? causeDeLEchec(error.message) : null;
      if (cause === 'deja-pris') {
        erreur = 'Cette adresse a déjà un compte. Choisis « Se connecter » pour le rejoindre.';
      } else if (cause === 'mot-de-passe-faible') {
        erreur = 'Choisis un mot de passe un peu plus long, au moins huit caractères.';
      } else if (error) {
        erreur = "Nous n'avons pas pu enregistrer ton email. Réessaie dans un moment.";
      } else {
        // Le compte reste anonyme jusqu'à ce qu'elle ouvre l'email : c'est
        // Supabase qui en décide, et c'est juste. On le lui dit franchement
        // plutôt que de la laisser croire que c'est fini.
        reussite =
          "Nous venons d'envoyer un message à " + emailSaisi
          + '. Ouvre-le pour terminer.';
      }
    }
  } else {
    const { data, error } = await clientPublic(Astro).auth.signInWithPassword({
      email: emailSaisi,
      password: motDePasse,
    });
    if (error || !data.session) {
      // LE MÊME TEXTE DANS TOUS LES CAS. Il y en avait deux : « ton adresse
      // n'est pas encore confirmée » confirmait qu'un compte existe à cette
      // adresse, et c'est exactement ce que l'en-tête de ce fichier promet de
      // ne jamais dire. Un mari qui essaie l'adresse de sa femme avec
      // n'importe quel mot de passe apprenait qu'elle a un compte ici (Cyber,
      // 26 octobre 2026). Le texte unique dit les deux causes possibles, pour
      // ne pas laisser sans secours celle qui n'a pas encore confirmé.
      erreur =
        'Email ou mot de passe incorrect. Si tu viens de créer ton compte, '
        + "ouvre d'abord l'email de confirmation.";
    } else {
      poserSession(Astro, {
        access_token: data.session.access_token,
        refresh_token: data.session.refresh_token,
      });
      return Astro.redirect('/', 303);
    }
  }
}

const TITRES: Record<Etape, string> = {
  choix: 'Ton compte',
  inscrire: "S'inscrire",
  connecter: 'Se connecter',
};
const titre = TITRES[etape];

// Ce qu'on garde dans l'adresse en passant d'un écran à l'autre, pour que
// l'explication « pour écrire à Dambé… » ne se perde pas en route.
const suite = dOu ? `&pour=${encodeURIComponent(dOu)}` : '';
const retourAuChoix = dOu ? `/connexion?pour=${encodeURIComponent(dOu)}` : '/connexion';

// LA BARRE DU BAS RESTE pour celle qui est déjà dans l'application. Celle qui
// arrive de dehors n'a pas de barre à garder, et l'écran plein est le bon.
const ONGLET_DORIGINE: Record<string, 'discussions' | 'compte'> = {
  messagerie: 'discussions',
  compte: 'compte',
};
const onglet = moi ? (ONGLET_DORIGINE[dOu] ?? 'compte') : null;
---

<Base titre={titre} nav={onglet} pleinEcran={!onglet}>
  <main class:list={['page', onglet && 'avec-nav']}>
    {/* Le retour, en plus de la barre : la barre ramène vers un onglet, ce
        lien ramène d'où elle vient. Ni l'un ni l'autre n'existe quand
        l'application est posée sur l'écran d'accueil, puisqu'il n'y a plus de
        bouton « précédent » de navigateur. */}
    {(onglet || etape !== 'choix') && (
      <a
        class="revenir"
        href={etape === 'choix' ? '/' : retourAuChoix}
        aria-label={etape === 'choix' ? "Revenir à l'accueil" : 'Revenir au choix'}
      >
        <Icone nom="retour" taille={22} />
      </a>
    )}

    <div class="haut">
      <Symbole taille={150} forme="nom" anime titre="Mousso Dambé" />
      <h1>{titre}</h1>
    </div>

    <div class="corps apparait">
      {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}
      {reussite && <div class="marge-bas"><Alerte type="reussite" texte={reussite} /></div>}

      {pourquoi && !erreur && !reussite && (
        <p class="pourquoi">
          <Icone nom="info" taille={15} />
          {pourquoi}
        </p>
      )}

      {etape === 'choix' ? (
        <div class="choix">
          <a class="btn btn-rose btn-plein" href={`/connexion?action=inscrire${suite}`}>
            S'inscrire
          </a>
          <a class="btn btn-contour btn-plein" href={`/connexion?action=connecter${suite}`}>
            Se connecter
          </a>
        </div>
      ) : (
        <>
          <BoutonGoogle grand basculer={!attache && Boolean(moi)} texte="Se connecter avec Google" />

          {/* Elle a un compte commencé et choisit d'en rejoindre un autre :
              elle doit savoir ce qu'elle laisse, AVANT de toucher le bouton. */}
          {moi && !attache && (
            <p class="prudence">
              <Icone nom="info" taille={15} />
              Ce que tu as noté depuis ce téléphone restera sur le compte commencé
              ici, et ne suivra pas.
            </p>
          )}

          <details class="replie">
            <summary>
              <span>Utiliser un email et un mot de passe</span>
              <Icone nom="bas" taille={16} />
            </summary>

            <form method="POST" class="dedans">
              <input type="hidden" name="geste" value={attache ? 'attacher' : 'connecter'} />

              <div class="champ-bloc">
                <label class="libelle" for="email">Ton email</label>
                <input class="champ" id="email" name="email" type="email" autocomplete="email" required value={emailSaisi} />
              </div>

              <div class="champ-bloc">
                <label class="libelle" for="motdepasse">
                  {etape === 'inscrire' ? 'Choisis un mot de passe' : 'Ton mot de passe'}
                </label>
                <input
                  class="champ"
                  id="motdepasse"
                  name="motdepasse"
                  type="password"
                  autocomplete={etape === 'inscrire' ? 'new-password' : 'current-password'}
                  minlength={etape === 'inscrire' ? 8 : undefined}
                  required
                />
              </div>

              {etape === 'inscrire' && (
                <p class="aide">
                  Tu devras ouvrir le message que nous t'enverrons pour terminer. Avec
                  Google, il n'y a rien à ouvrir.
                </p>
              )}

              <button class="btn btn-rose btn-plein" type="submit">{titre}</button>
            </form>
          </details>
        </>
      )}
    </div>
  </main>
</Base>

<style>
  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  /* Avec la barre du bas, le corps de la page s'arrête au-dessus d'elle :
     sinon la page mesure un écran PLUS la hauteur de la barre, et le contenu
     centré se retrouve décalé, avec un défilement qui ne mène à rien. */
  .page.avec-nav {
    min-height: calc(100svh - var(--nav-hauteur));
  }

  .revenir {
    position: absolute;
    top: var(--e3);
    left: 0;
    display: grid;
    place-items: center;
    /* 44 px : la cible que le pouce atteint sans viser. */
    width: 44px;
    height: 44px;
    color: var(--texte-2);
    border-radius: 50%;
  }

  .revenir:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
  }

  /* CENTRÉ VERTICALEMENT, ET AVEC DES MARGES AUTOMATIQUES PLUTÔT QU'UN
     `justify-content: center`.
     Les deux centrent pareil tant que ça tient dans l'écran. Mais quand la
     petite option est dépliée, le formulaire dépasse : `justify-content:
     center` déborde alors des DEUX côtés, et le haut de la page devient
     impossible à atteindre au défilement, logo et titre compris. Une marge
     automatique, elle, se réduit à zéro dès qu'il n'y a plus de place. */
  .haut {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--e3);
    margin-top: auto;
    padding: var(--e5) 0 var(--e4);
    text-align: center;
  }

  .haut h1 {
    font-size: 31.5px;
  }

  .corps {
    margin-bottom: auto;
    padding-bottom: var(--e5);
  }

  /* Les deux chemins, de même largeur et l'un sous l'autre : côte à côte, les
     libellés se seraient coupés en deux lignes sur un écran de 390 px. */
  .choix {
    display: grid;
    gap: var(--e3);
  }

  .champ-bloc {
    margin-bottom: var(--e4);
  }

  .marge-bas {
    margin-bottom: var(--e4);
  }

  .pourquoi,
  .prudence {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    margin: 0 0 var(--e4);
    padding: var(--e3);
    border-radius: var(--r-champ);
    background: var(--surface-douce);
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--texte-2);
  }

  .prudence {
    margin: var(--e3) 0 0;
  }

  /* LA PETITE OPTION. Un repli, pas un second bouton : deux boutons de même
     poids auraient annulé la mise en valeur demandée. */
  .replie {
    margin-top: var(--e5);
    border-top: 1px solid var(--bordure);
    padding-top: var(--e3);
  }

  .replie summary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    /* 44 px de haut : une cible que le pouce atteint, même repliée. */
    min-height: 44px;
    color: var(--texte-2);
    font-size: 14.5px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  /* Le triangle par défaut, retiré des deux façons que les navigateurs
     comprennent chacun. */
  .replie summary::-webkit-details-marker {
    display: none;
  }

  .replie summary::marker {
    content: '';
  }

  .replie summary:focus-visible {
    outline: 2px solid var(--rose);
    outline-offset: 2px;
    border-radius: var(--r-champ);
  }

  .replie[open] summary {
    margin-bottom: var(--e3);
  }

  .replie summary :global(svg) {
    transition: transform var(--vite) ease;
  }

  .replie[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .replie summary :global(svg) {
      transition: none;
    }
  }

  .dedans {
    padding-top: var(--e2);
  }

  .aide {
    margin: calc(-1 * var(--e2)) 0 var(--e4);
    font-size: 13px;
    line-height: 1.45;
    color: var(--texte-3);
  }
</style>

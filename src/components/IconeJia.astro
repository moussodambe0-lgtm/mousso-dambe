  {name === 'shield' && (<><path d="M12 3l7 3v6c0 4-3 7-7 9-4-2-7-5-7-9V6l7-3z" /><path d="M9 12l2 2 4-4" /></>)}
  {name === 'info' && (<><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></>)}

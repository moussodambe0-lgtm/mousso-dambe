---
// Le Résumé de l'espace vendeur, copié de `pages/vendeur/index.astro` de Jia.
//
// Arthur, le 5 novembre 2026 : « quand tu rentres dans espace vendeur de Jia,
// tu as d'abord le dashboard, tu as un tableau qui te montre tes ventes, tu as
// l'historique de tes ventes, tu as tout ».
//
// L'ORDRE EST CELUI DE JIA, et il n'est pas décoratif : le bandeau noir des
// ventes de la semaine, puis ce qu'il faut faire aujourd'hui, puis le stock,
// puis les ventes. On ouvre cette page pour savoir s'il y a des colis à
// préparer, pas pour contempler un graphique ; mais le graphique est en haut
// parce qu'il se lit en une seconde et donne le moral ou l'alerte.
//
// CE QUI N'EST PAS REPRIS DU FICHIER DE JIA, et pourquoi : la tâche « demandes
// de remboursement ». Elle mène à l'onglet litiges, qui suppose un arbitre
// entre une acheteuse et un vendeur tiers. Il n'y a pas de tiers ici : le
// compteur vaudrait zéro pour toujours et le lien ne mènerait nulle part.
//
// Le bloc « Paiements en ligne » est gardé tel quel : il ne s'affiche que si de
// l'argent attend d'être versé, donc jamais aujourd'hui puisqu'on est payé à la
// livraison, et il sera prêt le jour où Orange Money arrivera.

import Vendeur from '../../layouts/Vendeur.astro';
import Icone from '../../components/IconeJia.astro';
import { exigerGestion } from '../../lib/gestion';
import { prix, entier, depuis, dateCourte } from '../../lib/format-gestion';

const acces = await exigerGestion(Astro);
if (acces instanceof Response) return acces;
const { sb } = acces;

const [{ data: tdb, error }, { data: boite }, { data: stk, error: errStock }] = await Promise.all([
  sb.rpc('tableau_de_bord_vendeur'),
  sb.rpc('boite_de_reception', { p_recherche: null, p_sujet: null }),
  sb.rpc('tableau_de_bord_stock'),
]);
if (error) console.error('tableau_de_bord_vendeur', error.message);
if (errStock) console.error('tableau_de_bord_stock', errStock.message);

const st = (stk ?? {}) as any;
const ruptures = (st.ruptures ?? []) as { id: string; titre: string; vendus_30j: number }[];
const stockBas = (st.stock_bas ?? []) as { id: string; titre: string; stock: number }[];
const brouillons = (st.brouillons ?? []) as { id: string; titre: string }[];
const dorment = (st.dorment ?? []) as { id: string; titre: string; stock: number }[];
const meilleurs = (st.meilleurs ?? []) as { id: string; titre: string; qte: number; chiffre_cfa: number }[];
const ventes = (st.ventes ?? {}) as Record<string, number>;

const messagesNonLus = Number((boite as any)?.non_lus ?? 0);
const t = (tdb ?? {}) as any;

const jours = (t.ventes_7j ?? []) as { jour: string; total_cfa: number }[];
const total7j = jours.reduce((s, j) => s + Number(j.total_cfa), 0);
const precedent = Number(t.ventes_7j_precedents ?? 0);
const evolution = precedent > 0 ? Math.round(((total7j - precedent) / precedent) * 100) : null;
const max = Math.max(1, ...jours.map((j) => Number(j.total_cfa)));
const initiales = ['D', 'L', 'M', 'M', 'J', 'V', 'S'];
---

<Vendeur titre="Résumé" onglet="resume" sb={sb}>
  <section class="ventes">
    <div class="libelle-clair">Ventes des 7 derniers jours</div>
    <div class="ligne-montant">
      <span class="montant">{entier(total7j)}</span>
      <span class="devise">FCFA</span>
      {evolution !== null && (
        <span class:list={['evolution', { baisse: evolution < 0 }]}>
          {evolution >= 0 ? '+' : ''}{evolution} %
        </span>
      )}
    </div>

    <svg class="histogramme" viewBox="0 0 280 84" role="img" aria-label="Ventes par jour sur 7 jours">
      {jours.map((j, i) => {
        const h = Math.max(3, Math.round((Number(j.total_cfa) / max) * 62));
        return (
          <g>
            <title>{`${new Date(j.jour).toLocaleDateString('fr-FR', { weekday: 'long' })} : ${prix(Number(j.total_cfa))}`}</title>
            <rect x={i * 40 + 8} y={66 - h} width="24" height={h} rx="4" class:list={['barre', { aujourdhui: i === jours.length - 1 }]} />
            <text x={i * 40 + 20} y="81" text-anchor="middle" class="jour">{initiales[new Date(j.jour).getUTCDay()]}</text>
          </g>
        );
      })}
    </svg>
  </section>

  <section class="section">
    <h2 class="titre-section">À traiter aujourd'hui</h2>
    <div class="taches">
      <a href="/vendeur/commandes" class:list={['tache', { urgente: (t.a_expedier ?? 0) > 0 }]}>
        <span class="icone orange"><Icone name="package" size={20} /></span>
        <span class="texte">
          <strong>{t.a_expedier ?? 0} commande{(t.a_expedier ?? 0) > 1 ? 's' : ''} à expédier</strong>
          <span>{t.plus_ancienne ? `La plus ancienne attend depuis ${depuis(t.plus_ancienne).replace('il y a ', '')}` : 'Rien en attente'}</span>
        </span>
        <Icone name="chevron-right" size={18} stroke={2} class="fleche" />
      </a>
      {messagesNonLus > 0 && (
        <a href="/vendeur/messages" class="tache urgente">
          <span class="icone orange"><Icone name="message" size={20} /></span>
          <span class="texte">
            <strong>{messagesNonLus} message{messagesNonLus > 1 ? 's' : ''} cliente{messagesNonLus > 1 ? 's' : ''}</strong>
            <span>Réponds vite, une cliente qui attend achète ailleurs</span>
          </span>
          <Icone name="chevron-right" size={18} stroke={2} class="fleche" />
        </a>
      )}
      {brouillons.length > 0 && (
        <a href="/vendeur/produits" class="tache">
          <span class="icone gris"><Icone name="edit" size={20} /></span>
          <span class="texte">
            <strong>{brouillons.length} produit{brouillons.length > 1 ? 's' : ''} en brouillon</strong>
            <span>Personne ne les voit tant qu'ils ne sont pas publiés</span>
          </span>
          <Icone name="chevron-right" size={18} stroke={2} class="fleche" />
        </a>
      )}
    </div>
  </section>

  {/* ---------------- Le stock ----------------
      Ce qui fait perdre de l'argent tous les jours : une rupture laissée en
      ligne, un stock bas qu'on ne voit pas venir, un produit qui dort. */}
  <section class="section">
    <h2 class="titre-section">Mon stock</h2>

    <div class="chiffres chiffres-stock">
      <div class="chiffre-carte">
        <span class="valeur chiffre">{entier(st.valeur_stock_cfa ?? 0)}</span>
        <span class="cle">FCFA en magasin</span>
      </div>
      <div class="chiffre-carte">
        <span class="valeur chiffre">{entier(st.articles_en_stock ?? 0)}</span>
        <span class="cle">Articles en stock</span>
      </div>
      <div class="chiffre-carte">
        <span class:list={['valeur', 'chiffre', { alerte: ruptures.length > 0 }]}>{ruptures.length}</span>
        <span class="cle">En rupture</span>
      </div>
      <div class="chiffre-carte">
        <span class:list={['valeur', 'chiffre', { attention: stockBas.length > 0 }]}>{stockBas.length}</span>
        <span class="cle">Stock bas</span>
      </div>
    </div>

    {ruptures.length > 0 && (
      <div class="liste-stock rupture">
        <div class="tete-liste">
          <Icone name="warning" size={16} />
          <strong>À réapprovisionner</strong>
        </div>
        {ruptures.slice(0, 5).map((p) => (
          <a href={`/vendeur/produits/${p.id}`} class="ligne-stock">
            <span class="nom">{p.titre}</span>
            <span class="etat">
              {p.vendus_30j > 0 ? `${p.vendus_30j} vendu${p.vendus_30j > 1 ? 's' : ''} ce mois` : 'Aucune vente'}
            </span>
          </a>
        ))}
        {ruptures.length > 5 && <p class="reste">et {ruptures.length - 5} autre{ruptures.length - 5 > 1 ? 's' : ''}</p>}
      </div>
    )}

    {stockBas.length > 0 && (
      <div class="liste-stock bas">
        <div class="tete-liste">
          <Icone name="box" size={16} />
          <strong>Bientôt épuisés</strong>
        </div>
        {stockBas.slice(0, 5).map((p) => (
          <a href={`/vendeur/produits/${p.id}`} class="ligne-stock">
            <span class="nom">{p.titre}</span>
            <span class="etat">{p.stock} restant{p.stock > 1 ? 's' : ''}</span>
          </a>
        ))}
      </div>
    )}

    {dorment.length > 0 && (
      <div class="liste-stock dort">
        <div class="tete-liste">
          <Icone name="clock" size={16} />
          <strong>Ne se vendent pas</strong>
        </div>
        <p class="explication-liste">
          En ligne depuis plus d'un mois sans une seule vente. Baisse le prix, change la photo, ou retire-les.
        </p>
        {dorment.slice(0, 5).map((p) => (
          <a href={`/vendeur/produits/${p.id}`} class="ligne-stock">
            <span class="nom">{p.titre}</span>
            <span class="etat">{p.stock} en stock</span>
          </a>
        ))}
      </div>
    )}

    {ruptures.length === 0 && stockBas.length === 0 && dorment.length === 0 && (
      <p class="stock-sain">
        <Icone name="check-circle" size={16} /> Rien à surveiller : aucune rupture, aucun stock bas.
      </p>
    )}
  </section>

  {/* ---------------- Les ventes ---------------- */}
  <section class="section">
    <h2 class="titre-section">Mes ventes</h2>
    <div class="chiffres chiffres-stock">
      <div class="chiffre-carte">
        <span class="valeur chiffre">{entier(ventes.aujourdhui_cfa ?? 0)}</span>
        <span class="cle">Aujourd'hui (FCFA)</span>
      </div>
      <div class="chiffre-carte">
        <span class="valeur chiffre">{entier(ventes.mois_cfa ?? 0)}</span>
        <span class="cle">Ce mois (FCFA)</span>
      </div>
      <div class="chiffre-carte">
        <span class="valeur chiffre">{entier(ventes.panier_moyen_cfa ?? 0)}</span>
        <span class="cle">Panier moyen</span>
      </div>
      <div class="chiffre-carte">
        <span class="valeur chiffre">{ventes.commandes_mois ?? 0}</span>
        <span class="cle">Commandes du mois</span>
      </div>
    </div>

    {meilleurs.length > 0 && (
      <div class="liste-stock meilleurs">
        <div class="tete-liste">
          <Icone name="trend-up" size={16} />
          <strong>Ce qui se vend le mieux (30 jours)</strong>
        </div>
        {meilleurs.map((p, i) => (
          <a href={`/vendeur/produits/${p.id}`} class="ligne-stock">
            <span class="rang">{i + 1}</span>
            <span class="nom">{p.titre}</span>
            <span class="etat">{p.qte} vendu{p.qte > 1 ? 's' : ''} · {prix(p.chiffre_cfa)}</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section chiffres-section">
    <div class="chiffres">
      <div class="chiffre-carte">
        <span class="valeur chiffre">{t.commandes_mois ?? 0}</span>
        <span class="cle">Commandes du mois</span>
      </div>
      <div class="chiffre-carte">
        <span class="valeur chiffre">
          {Number(t.shop?.rating_avg ?? 0).toFixed(1).replace('.', ',')} <span class="etoiles">★</span>
        </span>
        <span class="cle">{t.shop?.rating_count ?? 0} avis</span>
      </div>
      <div class="chiffre-carte">
        <span class="valeur chiffre">{t.produits_en_ligne ?? 0}</span>
        <span class="cle">Produits en ligne</span>
      </div>
      <div class="chiffre-carte">
        <span class="valeur chiffre">{t.taux_annulation ?? 0} %</span>
        <span class="cle">Annulations (30 j)</span>
      </div>
    </div>
  </section>

  {t.en_ligne && (t.en_ligne.a_recevoir_cfa > 0 || t.en_ligne.verse_cfa > 0) && (
    <section class="section">
      <div class="reglement">
        <h2 class="titre-section">Paiements en ligne</h2>
        <div class="ligne-recap"><span>À recevoir</span><span class="valeur">{prix(t.en_ligne.a_recevoir_cfa)}</span></div>
        <div class="ligne-recap"><span>Dont versable maintenant</span><span class="valeur">{prix(t.en_ligne.versable_cfa)}</span></div>
        <div class="ligne-recap"><span>Déjà versé</span><span class="valeur">{prix(t.en_ligne.verse_cfa)}</span></div>
        <p class="note">
          Les commandes payées par Orange Money ou Moov Money sont encaissées puis versées 7 jours après la livraison.
          {t.en_ligne.dernier && ` Dernier versement : ${prix(t.en_ligne.dernier.montant_cfa)} le ${dateCourte(t.en_ligne.dernier.verse_le)}.`}
        </p>
      </div>
    </section>
  )}
</Vendeur>

<style>
  .chiffres-stock { margin-top: 12px; }
  .valeur.alerte { color: var(--rouge); }
  .valeur.attention { color: var(--orange-fonce); }

  .liste-stock { margin-top: 14px; background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); overflow: hidden; }
  .liste-stock.rupture { border-color: #F0BCB8; }
  .liste-stock.bas { border-color: var(--orange-bordure); }
  .tete-liste { display: flex; align-items: center; gap: 8px; padding: 11px 14px; border-bottom: 1px solid var(--bordure); font-size: 15px; }
  .liste-stock.rupture .tete-liste { background: var(--rouge-clair); color: #8A1D16; }
  .liste-stock.bas .tete-liste { background: var(--orange-clair); color: var(--orange-fonce); }
  .liste-stock.dort .tete-liste, .liste-stock.meilleurs .tete-liste { background: var(--fond); color: var(--texte-corps); }
  .explication-liste { font-size: 13px; color: var(--texte-secondaire); line-height: 1.45; margin: 0; padding: 10px 14px 2px; }
  .ligne-stock { display: flex; align-items: center; gap: 10px; padding: 12px 14px; min-height: 44px; color: inherit; border-top: 1px solid var(--bordure); }
  .ligne-stock:hover { color: inherit; background: var(--surface-douce); }
  .ligne-stock .rang { width: 20px; font-family: 'Outfit', sans-serif; font-weight: 800; color: var(--texte-tertiaire); flex: none; }
  .ligne-stock .nom { flex: 1; min-width: 0; font-size: 15px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ligne-stock .etat { font-size: 13px; color: var(--texte-secondaire); white-space: nowrap; }
  .reste { font-size: 13px; color: var(--texte-secondaire); margin: 0; padding: 10px 14px; }
  /* Le vert, et pas le rose : c'est la seule ligne de cet écran qui dit « tout
     va bien ». En rose elle ressemblait à une action à faire. */
  .stock-sain { display: flex; align-items: center; gap: 7px; font-size: 14.5px; color: var(--vert); margin: 14px 0 0; }

  .ventes { background: var(--encre); color: #FFFFFF; padding: 4px var(--gouttiere) 16px; }
  .libelle-clair { font-size: 13px; color: var(--sur-sombre); }
  .ligne-montant { display: flex; align-items: baseline; gap: 6px; margin-top: 4px; }
  .montant { font-family: 'Outfit', sans-serif; font-weight: 800; font-size: 30px; letter-spacing: -0.02em; }
  .devise { font-size: 14.5px; color: var(--sur-sombre); font-weight: 700; }
  .evolution { margin-left: auto; background: rgba(47, 143, 91, 0.35); color: var(--vert-trait); font-size: 13px; font-weight: 700; padding: 3px 9px; border-radius: var(--r-pilule); }
  .evolution.baisse { background: rgba(234, 25, 78, 0.28); color: #FFB3C8; }
  .histogramme { display: block; width: 100%; height: auto; margin-top: 12px; }
  .barre { fill: rgba(255, 255, 255, 0.18); }
  .barre.aujourdhui { fill: var(--action); }
  .jour { fill: var(--sur-sombre-faible); font-size: 11px; font-family: 'Karla', sans-serif; font-weight: 700; }

  .titre-section { font-size: 16px; }
  .taches { display: grid; gap: 9px; margin-top: 12px; }
  .tache {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--surface);
    border: 1px solid var(--bordure);
    border-radius: var(--r-grand);
    padding: 13px 14px;
    color: inherit;
  }
  .tache:hover { color: inherit; border-color: var(--texte-tertiaire); }
  .tache.urgente { border-left: 4px solid var(--orange); }
  .icone { width: 38px; height: 38px; border-radius: 10px; display: flex; align-items: center; justify-content: center; flex: 0 0 auto; }
  .icone.orange { background: var(--orange-clair); color: var(--orange-fonce); }
  .icone.action { background: var(--action-clair); color: var(--action); }
  .icone.gris { background: var(--fond); color: var(--texte-secondaire); }
  .texte { flex: 1; min-width: 0; }
  .texte strong { display: block; font-size: 15px; }
  .texte span { display: block; font-size: 13px; color: var(--texte-secondaire); margin-top: 2px; }
  .tache :global(.fleche) { color: var(--texte-tertiaire); }

  .chiffres-section { padding-top: 0; }
  .chiffres { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
  .chiffre-carte { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 13px 14px; }
  .valeur { display: block; font-size: 22px; }
  .cle { display: block; font-size: 12.5px; color: var(--texte-secondaire); margin-top: 3px; }
  .valeur .etoiles { font-size: 16px; }

  .reglement { background: var(--surface); border: 1px solid var(--bordure); border-radius: var(--r-grand); padding: 15px; }
  .reglement h2 { margin-bottom: 12px; }
  .ligne-recap { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; font-size: 14.5px; }
  .note { font-size: 12.5px; color: var(--texte-tertiaire); line-height: 1.5; margin: 12px 0 0; }
</style>

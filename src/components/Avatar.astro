---
/**
 * La photo de profil d'une utilisatrice.
 *
 * Décision d'Arthur du 13 octobre 2026, par message vocal : « je ne veux pas
 * des dessins bizarres comme ce qui est ici, je veux des vrais avatars comme
 * ma mascotte. [...] La personne n'aura pas automatiquement une image ».
 *
 * AVANT ce jour, ce composant dessinait un visage en SVG à partir d'une
 * graine de texte (`src/lib/avatar.ts`) : chacune en avait un, qu'elle le
 * veuille ou non. Ce n'est plus le cas. Tant qu'elle n'a rien choisi dans la
 * galerie (`/compte/avatar`, `public/avatars/`), ce composant montre un rond
 * NEUTRE, sans visage inventé. `src/lib/avatar.ts` reste dans le dépôt
 * (sa propre suite de tests passe toujours), mais plus aucune page ne
 * l'appelle : il est à retirer pour de bon si personne n'y revient.
 *
 * `morph` pose un nom de transition partagé entre deux pages : le navigateur
 * fait alors grandir l'avatar de l'en-tête vers le grand avatar du compte,
 * sans une ligne de script.
 */
import Icone from './Icone.astro';

interface Props {
  /** Le fichier choisi dans `avatars_disponibles` (sans le dossier), ou vide
   * tant qu'elle n'a rien choisi. */
  fichier?: string | null;
  /**
   * Gardés pour que les pages n'aient pas à changer, mais IGNORÉS depuis le
   * 26 octobre 2026 : « au niveau des avatars garde seulement les portraits ».
   * Arthur a écarté les avatars dessinés pour la deuxième fois, après les avoir
   * essayés. Deux cas désormais : un portrait de la galerie, ou un rond neutre.
   */
  choix?: unknown;
  graine?: string | null;
  prenom?: string;
  taille?: number;
  contour?: boolean;
  morph?: boolean;
  titre?: string;
  /**
   * Charger l'image seulement quand elle approche de l'écran.
   *
   * Posé par la galerie (`/compte/avatar`) depuis le 26 octobre 2026 : elle
   * montre 62 portraits, soit 1 Mo d'images. Sur un forfait compté en 3G, les
   * télécharger tous à l'ouverture de la page coûterait à une femme l'essentiel
   * de ce qu'elle a acheté, pour voir six vignettes. Un portrait déjà à l'écran
   * est chargé tout de suite malgré cet attribut : le navigateur ne diffère que
   * ce qui est en dessous.
   *
   * Laissé à faux partout ailleurs : l'avatar de l'en-tête est la première
   * chose qu'on voit, il ne doit pas apparaître après le reste.
   */
  differe?: boolean;
}

const { fichier, prenom = '', taille = 48, contour = true, morph = false, titre, differe = false } = Astro.props;

const etiquette = titre ?? (prenom ? `Photo de profil de ${prenom}` : 'Photo de profil');
---

<span
  class:list={['avatar', contour && 'avatar-contour', morph && 'avatar-morph', !fichier && 'avatar-neutre']}
  data-taille={taille}
>
  {
    fichier ? (
      <img
        src={`/avatars/${fichier}`}
        alt={etiquette}
        width={taille}
        height={taille}
        loading={differe ? 'lazy' : 'eager'}
        decoding={differe ? 'async' : 'auto'}
      />
    ) : (
      <Icone nom="compte" taille={Math.round(taille * 0.56)} titre={etiquette} />
    )
  }
</span>

<style>
  .avatar {
    display: grid;
    place-items: center;
    width: var(--taille, 48px);
    height: var(--taille, 48px);
    flex: none;
    border-radius: 50%;
    overflow: hidden;
  }

  .avatar-contour {
    box-shadow: 0 0 0 2px #fff, 0 0 0 3.5px var(--bordure);
  }

  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* L'avatar composé est un SVG sans largeur ni hauteur, seulement un viewBox :
     sans cette règle il s'afficherait à la taille que le navigateur lui donne
     par défaut, et déborderait du rond ou flotterait dedans. */
  .avatar > :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Le rond neutre : tant qu'elle n'a rien choisi, pas de visage inventé. */
  .avatar-neutre {
    background: var(--surface-douce);
    color: var(--texte-3);
  }

  /* La transition d'une page à l'autre : le navigateur relie les deux
     avatars qui portent ce nom et fait grandir l'un vers l'autre. */
  .avatar-morph {
    view-transition-name: avatar-utilisatrice;
  }

  /* Les tailles servies, posées en classes plutôt qu'en style en ligne, que
     la politique de sécurité du contenu refuse. */
  .avatar[data-taille='32'] { --taille: 32px; }
  .avatar[data-taille='38'] { --taille: 38px; }
  .avatar[data-taille='44'] { --taille: 44px; }
  .avatar[data-taille='48'] { --taille: 48px; }
  .avatar[data-taille='56'] { --taille: 56px; }
  .avatar[data-taille='88'] { --taille: 88px; }
  .avatar[data-taille='132'] { --taille: 132px; }
</style>

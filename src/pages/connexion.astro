---
/**
 * Se connecter.
 *
 * Arthur, le 7 novembre 2026 : « comment la page pour s'inscrire ou bien se
 * connecter de Jia est, je veux la même chose chez Mousso Dambé. Sauf les
 * couleurs que tu vas utiliser. Faut pas essayer d'adapter. »
 *
 * CETTE PAGE EST LA COPIE DE `src/pages/connexion.astro` DE JIA (dépôt
 * yaar) : même en-tête de retour, même logo centré, même carte de formulaire,
 * même séparateur, même ligne « Pas encore de compte ? ». Les couleurs sont
 * celles de Mousso Dambé.
 *
 * ──────────────────────────────────────────────────────────────────────────
 * CE QUE CETTE PAGE NE FAIT PLUS, ET QUI EST PARTI AILLEURS
 * ──────────────────────────────────────────────────────────────────────────
 *
 * Elle portait TROIS écrans en un, avec un paramètre `?action=` : un écran de
 * choix, puis l'inscription, puis la connexion. Arthur veut la séparation de
 * Jia, un bouton et une vraie page derrière chacun :
 *
 *   - l'écran de choix est devenu `src/pages/compte/visiteur.astro`, affiché
 *     à la place de /compte quand elle n'est pas connectée ;
 *   - l'inscription est redevenue `src/pages/inscription.astro`.
 *
 * Les anciennes adresses `?action=inscrire` et `?action=connecter` continuent
 * de fonctionner : la première redirige vers /inscription, la seconde tombe
 * simplement ici. Des liens de ce genre sont déjà partis sur WhatsApp, et un
 * lien partagé qui ne mène nulle part ne revient jamais.
 *
 * ──────────────────────────────────────────────────────────────────────────
 * CE QUI NE CHANGE PAS, ET QUI NE DOIT PAS CHANGER
 * ──────────────────────────────────────────────────────────────────────────
 *
 * LE MESSAGE D'ERREUR EST LE MÊME QUE L'ADRESSE EXISTE OU NON. Dire « cette
 * adresse n'a pas de compte » révélerait à un mari curieux si sa femme
 * utilise l'application. Ce n'est pas une précaution théorique ici.
 *
 * Cette phrase était fausse pour un cas, jusqu'à l'audit du 26 octobre 2026 :
 * une adresse non confirmée recevait « ton adresse n'est pas encore
 * confirmée », donc l'aveu qu'un compte existe. Il n'y a plus qu'un seul
 * texte, et un garde-fou dans supabase/tests/connexion.test.mjs tombe si un
 * second réapparaît.
 *
 * SUR L'ADRESSE DE LA GESTION, il n'y a rien à créer : un administrateur se
 * connecte, il ne s'inscrit pas. Les liens vers /inscription sont donc
 * cachés là-bas (Arthur, le 24 octobre 2026 : « cette page n'est pas
 * disponible »).
 *
 * JIA VOUVOIE, Mousso Dambé tutoie partout ailleurs. Vouvoyer sur cette seule
 * page sonnerait faux pour celle qui vient de traverser l'application.
 */
import Base from '../layouts/Base.astro';
import Entete from '../components/Entete.astro';
import Symbole from '../components/Symbole.astro';
import BoutonGoogle from '../components/BoutonGoogle.astro';
import Alerte from '../components/Alerte.astro';
import Icone from '../components/Icone.astro';
import { clientPublic, poserSession, baseConfiguree } from '../lib/supabase';
import { visiteuse } from '../lib/session';
import { hoteDemande, estHoteAdmin } from '../lib/hotes';
import { suiteSure } from '../lib/suite';
import { ADMIN_HOST } from 'astro:env/server';

export const prerender = false;

Astro.response.headers.set('Cache-Control', 'private, no-store');

const surHoteAdmin = estHoteAdmin(
  hoteDemande(Astro.request.headers, Astro.url.hostname),
  ADMIN_HOST
);

const moi = baseConfiguree() ? await visiteuse(Astro) : null;

// Celle qui a DÉJÀ un vrai compte n'a rien à faire ici.
if (moi?.compteReel) return Astro.redirect('/', 302);

const suite = suiteSure(Astro.url.searchParams.get('suite'), '/compte');

// L'ANCIENNE ADRESSE, GARDÉE VIVANTE. `?action=inscrire` menait au formulaire
// de création ; il vit maintenant sur sa propre page.
if (Astro.url.searchParams.get('action') === 'inscrire' && !surHoteAdmin) {
  return Astro.redirect(`/inscription?suite=${encodeURIComponent(suite)}`, 301);
}

/**
 * LE BOUTON GOOGLE EST-IL MONTRÉ ?
 *
 * Mettre `true` ici le fait réapparaître, sur cette page et sur
 * /inscription. C'est le seul geste à faire.
 *
 * POURQUOI IL EST ÉTEINT, LE 7 NOVEMBRE 2026. La base de Mousso Dambé a été
 * remontée de zéro le 6 novembre, l'ancienne ayant disparu. Le code est
 * revenu intact de GitHub, mais les RÉGLAGES ne vivent pas dans le code : ils
 * étaient dans l'ancien projet Supabase. Le fournisseur Google est donc
 * éteint côté base, et aucune connexion Google ne peut aboutir.
 *
 * Un bouton qui ne peut pas aboutir est pire que pas de bouton : il occupe la
 * place du chemin qui marche, et il apprend à celle qui arrive que le site
 * est cassé, à l'instant précis où elle décide de confier son cycle.
 *
 * POUR LE RALLUMER : un client OAuth dans la console Google Cloud, puis le
 * fournisseur activé côté Supabase, avec le rattachement manuel pour que les
 * femmes entrées par « Commencer » ne perdent pas ce qu'elles ont noté.
 */
const GOOGLE_DISPONIBLE = false;

let erreur = '';

// Les retours de Google passent par l'adresse : on les traduit ici, sans
// jamais dire si un compte existe ou non.
const venuDe = Astro.url.searchParams.get('erreur');
if (venuDe === 'google') {
  erreur = "La connexion avec Google n'a pas marché. Réessaie.";
} else if (venuDe === 'google-deja-pris') {
  erreur =
    "Cette adresse Google a déjà un compte Mousso Dambé. Choisis « Se connecter » "
    + 'pour le rejoindre.';
} else if (venuDe === 'liaison') {
  // « Nous n'avons pas pu attacher Google à ton compte » ne voulait rien dire
  // pour elle (Arthur : « ça veut dire quoi ? »). Attacher est un mot de
  // mécanique interne, et ce qu'elle veut savoir c'est quoi faire maintenant.
  erreur =
    "La connexion avec Google n'a pas marché. Réessaie, ou utilise un email et "
    + 'un mot de passe.';
} else if (venuDe === 'pas-de-base') {
  erreur = "L'application n'est pas encore branchée à sa base de données.";
}

/** Pourquoi on la lui demande, quand elle arrive depuis un écran fermé. */
const POURQUOI: Record<string, string> = {
  messagerie:
    "Pour écrire à Dambé ou à la boutique, il faut un compte : c'est ce qui "
    + 'permet de retrouver tes messages, et à la boutique de te répondre.',
  compte: "Pour voir ton compte, connecte-toi d'abord.",
};
const dOu = String(Astro.url.searchParams.get('pour') ?? '');
const pourquoi = POURQUOI[dOu] ?? '';

let emailSaisi = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  emailSaisi = String(f.get('email') ?? '').trim().toLowerCase();
  const motDePasse = String(f.get('motdepasse') ?? '');

  if (!emailSaisi || !motDePasse) {
    erreur = 'Remplis les deux champs.';
  } else {
    const { data, error } = await clientPublic(Astro).auth.signInWithPassword({
      email: emailSaisi,
      password: motDePasse,
    });
    if (error || !data.session) {
      // LE MÊME TEXTE DANS TOUS LES CAS. Il y en avait deux : « ton adresse
      // n'est pas encore confirmée » confirmait qu'un compte existe à cette
      // adresse, et c'est exactement ce que l'en-tête de ce fichier promet de
      // ne jamais dire. Un mari qui essaie l'adresse de sa femme avec
      // n'importe quel mot de passe apprenait qu'elle a un compte ici (Cyber,
      // 26 octobre 2026). Le texte unique dit les deux causes possibles, pour
      // ne pas laisser sans secours celle qui n'a pas encore confirmé.
      erreur =
        'Email ou mot de passe incorrect. Si tu viens de créer ton compte, '
        + "ouvre d'abord l'email de confirmation.";
    } else {
      poserSession(Astro, {
        access_token: data.session.access_token,
        refresh_token: data.session.refresh_token,
      });
      return Astro.redirect(suiteSure(String(f.get('suite') ?? ''), '/'), 303);
    }
  }
}

const versInscription = `/inscription?suite=${encodeURIComponent(suite)}`;
---

<Base titre="Connexion" description="Connecte-toi à ton compte Mousso Dambé." pleinEcran>
  <Entete titre="Se connecter" retour="/compte" />

  <div class="section">
    <div class="tete">
      <Symbole taille={56} />
    </div>

    {pourquoi && (
      <div class="encadre pourquoi">
        <Icone nom="info" taille={19} />
        <p>{pourquoi}</p>
      </div>
    )}

    {/* `Alerte` n'a pas de garde interne : sans cette condition, un encadré
        vide s'afficherait à chaque chargement. */}
    {erreur && <div class="marge-bas"><Alerte type="erreur" texte={erreur} /></div>}

    {/* CE QU'ELLE LAISSE DERRIÈRE ELLE, DIT AVANT QU'ELLE TOUCHE AU
        FORMULAIRE.

        Elle est entrée par « Commencer » et vient se connecter à un compte
        qui existe ailleurs : son cycle, son journal et ses commandes notés
        depuis ce téléphone resteront sur le compte commencé ici, et ne
        suivront pas. Si ce n'est pas ce qu'elle veut, c'est /inscription
        qu'il lui faut, qui ATTACHE son email au compte où tout est déjà.

        Cet avertissement a disparu une heure en coupant la page en deux, le
        7 novembre 2026. Une vérification de garder-son-compte.test.mjs l'a
        rattrapé : c'est exactement pour ça qu'elle existe. */}
    {moi && (
      <div class="encadre prudence">
        <Icone nom="info" taille={19} />
        <p>
          Ce que tu as noté depuis ce téléphone restera sur le compte commencé ici, et
          ne suivra pas. Pour le garder, <a href={versInscription}>crée plutôt ton compte</a>.
        </p>
      </div>
    )}

    <form method="POST" class="formulaire">
      <input type="hidden" name="suite" value={suite} />

      <div class="champ-bloc">
        <label class="libelle" for="email">Ton email</label>
        <input class="champ" id="email" name="email" type="email" required autocomplete="email" inputmode="email" value={emailSaisi} />
      </div>

      <div class="champ-bloc">
        <label class="libelle" for="motdepasse">Ton mot de passe</label>
        <input class="champ" id="motdepasse" name="motdepasse" type="password" required autocomplete="current-password" />
      </div>

      <button type="submit" class="btn btn-rose btn-plein">Se connecter</button>
    </form>

    {/* GOOGLE APRÈS LE FORMULAIRE, ET C'EST LE SEUL ENDROIT OÙ JE M'ÉCARTE DE
        JIA. Jia met Google en premier, puis « ou avec votre email », puis le
        formulaire.

        Deux consignes d'Arthur se croisent ici, le même jour.
        Le matin : « il doit avoir une partie où on renseigne à la main son
        email, et en bas mot de passe. Et maintenant en bas encore, on va voir
        se connecter ou s'inscrire avec Google. »
        L'après-midi : « je veux la même chose chez Mousso Dambé, sauf les
        couleurs, faut pas essayer d'adapter. »

        La seconde porte sur l'allure de la page entière, la première sur
        cette question précise, et elle a été donnée après avoir vu l'écran.
        On garde donc l'ordre qu'il a demandé expressément, et le reste de la
        page suit Jia à la lettre. À inverser en deux lignes s'il préfère. */}
    {GOOGLE_DISPONIBLE && (
      <>
        <div class="separateur"><span>ou</span></div>
        <BoutonGoogle grand basculer={!!moi} texte="Se connecter avec Google" />
      </>
    )}

    {/* EN LOCAL, LA PORTE SANS MOT DE PASSE. Arthur, le 5 novembre 2026 :
        « j'arrive pas à me connecter à admin Mousso Dambé ». Le banc local
        recrée sa base à chaque redémarrage, donc sa session meurt et il
        retombe ici. Ce lien n'apparaît qu'en développement :
        src/pages/dev/admin.ts renvoie 404 en production. */}
    {import.meta.env.DEV && surHoteAdmin && (
      <a class="btn btn-contour btn-plein porte-locale" href="/dev/admin">
        Entrer sans mot de passe (local)
      </a>
    )}

    {!surHoteAdmin && (
      <div class="encadre acheteuse">
        <Icone nom="info" taille={19} />
        <p>
          Pas encore de compte ? <a href={versInscription}>En créer un</a> prend une minute, et
          garde ton cycle et tes commandes sur tous tes téléphones.
        </p>
      </div>
    )}
  </div>
</Base>

<style>
  .section { padding: var(--e4); }
  .marge-bas { margin-bottom: var(--e3); }

  .tete { text-align: center; padding: 14px 0 20px; }

  .pourquoi {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: var(--e3);
    background: var(--surface-douce);
  }
  .pourquoi p { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--texte-2); }

  .prudence {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: var(--e3);
    background: var(--surface-douce);
  }
  .prudence p { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--texte-2); }
  .prudence a { font-weight: 700; }

  .separateur { display: flex; align-items: center; gap: 12px; margin: 18px 0 14px; }
  .separateur::before,
  .separateur::after { content: ''; flex: 1; height: 1px; background: var(--bordure); }
  .separateur span { font-size: 12.5px; color: var(--texte-3); }

  .formulaire {
    background: var(--surface);
    border: 1px solid var(--bordure);
    border-radius: var(--r-carte);
    padding: 16px;
  }
  .formulaire .btn { margin-top: 18px; }
  .champ-bloc + .champ-bloc { margin-top: 16px; }

  .porte-locale { margin-top: var(--e3); }

  .acheteuse {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-top: 16px;
  }
  .acheteuse p { margin: 0; font-size: 13.5px; line-height: 1.45; color: var(--texte-2); }
  .acheteuse a { font-weight: 700; }
</style>
